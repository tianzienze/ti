#include "ti_msp_dl_config.h"
#include <stdint.h>
#include <stdbool.h>

/*
 * MSPM0G3507 + Hiwonder 六路巡线传感器
 *
 * ============================================================
 * 当前 SysConfig 引脚
 * ============================================================
 *
 * 左电机：
 *   IN1 -> PB2
 *   IN2 -> PA7
 *   ENA -> PB8
 *
 * 右电机：
 *   IN3 -> PB9
 *   IN4 -> PB14
 *   ENB -> PB7
 *
 * 六路巡线传感器：
 *   SDA -> PA23
 *   SCL -> PB24
 *
 * 传感器：
 *   I2C地址             = 0x5C
 *   六路数字结果寄存器 = 0x05
 *
 * 状态LED：
 *   LED -> PA5
 *
 * ============================================================
 * 六路传感器方向
 * ============================================================
 *
 * 按照传感器正面文字正常的安装方向：
 *
 * 小车左侧                              小车右侧
 *
 * 通道6   通道5   通道4   通道3   通道2   通道1
 *
 * 本代码假定：
 *   原始 bit0 = 通道1
 *   原始 bit1 = 通道2
 *   ...
 *   原始 bit5 = 通道6
 *
 * 软件会转换为：
 *   bit0 = 最左
 *   bit5 = 最右
 *
 * ============================================================
 * 工作方式
 * ============================================================
 *
 * 1. 读取六路数字结果。
 * 2. 使用加权误差进行PD循迹。
 * 3. 中间两路压线时小幅调整。
 * 4. 外侧传感器压线时大幅转向。
 * 5. 短暂丢线时按照最后方向继续找线。
 * 6. I2C连续读取失败约100ms后停车。
 * 7. 软件PWM频率为100Hz，速度范围0~100。
 */


/*============================================================
 * 系统时钟
 *============================================================*/

#ifndef CPUCLK_FREQ
#define CPUCLK_FREQ                         (32000000UL)
#endif


/*============================================================
 * SysTick与软件PWM
 *============================================================*/

/* SysTick每100us进入一次中断。 */
#define SYSTICK_FREQUENCY_HZ                (10000U)

/* PWM分成100级，因此PWM频率为100Hz。 */
#define PWM_PERIOD_COUNT                    (100U)

/* 每50个SysTick执行一次循迹，即5ms。 */
#define CONTROL_INTERVAL_TICKS              (50U)


/*============================================================
 * 电机方向配置
 *============================================================*/

/*
 * 烧录后先把车轮架空测试。
 *
 * 如果左轮“前进”方向反了：
 * LEFT_MOTOR_REVERSE 改成1。
 *
 * 如果右轮“前进”方向反了：
 * RIGHT_MOTOR_REVERSE 改成1。
 */

#define LEFT_MOTOR_REVERSE                  (0)
#define RIGHT_MOTOR_REVERSE                 (0)


/*============================================================
 * 六路巡线传感器配置
 *============================================================*/

/*
 * 默认认为：
 *
 * 检测到学习过的目标颜色，也就是黑线时，对应位为1。
 *
 * 如果实际测试发现：
 *   全部放在白色区域时返回63；
 *   放到黑线上对应位反而变成0；
 *
 * 就把这个宏改成0。
 */
#define LINE_DETECTED_IS_1                  (1)


/*
 * 传感器板正面朝前，并且文字方向正常时保持为0。
 *
 * 如果传感器左右装反，小车左边变成通道1，
 * 就把此宏改成1。
 */
#define SENSOR_INSTALL_REVERSE              (1)


/*
 * 六路全部检测到黑线时：
 *
 * 0：当作十字线或较粗黑线，继续直行。
 * 1：立即停车。
 */
#define STOP_ON_ALL_BLACK                   (0)


/*============================================================
 * 循迹速度参数
 *============================================================*/

/*
 * 所有PWM范围均为0~100。
 *
 * 车速太快：
 *   减小 MOTOR_BASE_PWM。
 *
 * 车速太慢：
 *   增大 MOTOR_BASE_PWM。
 */

#define MOTOR_BASE_PWM                      (17)
#define MOTOR_MAX_PWM                       (28)

/*
 * 小于这个PWM时电机通常无法启动。
 * 因此低于该值时直接按0处理。
 */
#define MOTOR_MIN_EFFECTIVE_PWM             (8)


/*============================================================
 * 丢线后的找线速度
 *============================================================*/

/*
 * 黑线最后在左侧：
 *   左轮慢、右轮快，继续向左找线。
 *
 * 黑线最后在右侧：
 *   左轮快、右轮慢，继续向右找线。
 */

#define LOST_LINE_OUTER_PWM                 (30)
#define LOST_LINE_INNER_PWM                 (5)
/* 直线状态短暂丢线时继续慢速直行。 */
#define LOST_LINE_STRAIGHT_PWM              (32)


/*============================================================
 * PWM平滑参数
 *============================================================*/

/*
 * 每5ms速度最多变化多少。
 *
 * 数值小：
 *   更平滑，但转弯反应稍慢。
 *
 * 数值大：
 *   转弯灵敏，但可能摇头。
 */
#define PWM_SLEW_STEP                       (6)


/*============================================================
 * PD循迹参数
 *============================================================*/

/*
 * 六路传感器位置权重：
 *
 * 最左     左中     左内     右内     右中     最右
 * -500     -300     -100     +100     +300     +500
 *
 * correction =
 *     error × 7 / 100
 *   + error变化量 × 4 / 100
 *
 * 左右摇晃较大：
 *   减小 LINE_KP_NUM；
 *   或者减小 LINE_KD_NUM。
 *
 * 转弯不够灵敏：
 *   增大 LINE_KP_NUM；
 *   或者增大 MAX_STEERING_CORRECTION。
 */

#define LINE_KP_NUM                         (4)
#define LINE_KP_DEN                         (120)

#define LINE_KD_NUM                         (5)
#define LINE_KD_DEN                         (100)

#define MAX_STEERING_CORRECTION             (45)


/*============================================================
 * I2C错误保护
 *============================================================*/

/*
 * 5ms读取一次。
 * 连续20次失败约等于100ms，随后停车。
 */
#define SENSOR_FAIL_STOP_COUNT              (20U)


/*============================================================
 * 六路传感器I2C参数
 *============================================================*/

#define LINE_SENSOR_I2C_ADDRESS             (0x5CU)
#define LINE_SENSOR_DIGITAL_REGISTER        (0x05U)

/*
 * 软件I2C延时。
 *
 * CPU为32MHz时，实际通信速率大约50~100kHz。
 */
#define SOFT_I2C_DELAY_LOOPS                 (36U)

#define SOFT_I2C_CLOCK_STRETCH_TIMEOUT       (3000U)


/*============================================================
 * 引脚定义
 *============================================================*/

/*---------------- 左电机 ----------------*/

#define LEFT_IN1_PORT                       (GPIOB)
#define LEFT_IN1_PIN                        (DL_GPIO_PIN_2)

#define LEFT_IN2_PORT                       (GPIOA)
#define LEFT_IN2_PIN                        (DL_GPIO_PIN_7)

#define LEFT_EN_PORT                        (GPIOB)
#define LEFT_EN_PIN                         (DL_GPIO_PIN_8)


/*---------------- 右电机 ----------------*/

#define RIGHT_IN3_PORT                      (GPIOB)
#define RIGHT_IN3_PIN                       (DL_GPIO_PIN_9)

#define RIGHT_IN4_PORT                      (GPIOB)
#define RIGHT_IN4_PIN                       (DL_GPIO_PIN_14)

#define RIGHT_EN_PORT                       (GPIOB)
#define RIGHT_EN_PIN                        (DL_GPIO_PIN_7)


/*---------------- 状态LED ----------------*/

#define STATUS_LED_PORT                     (GPIOA)
#define STATUS_LED_PIN                      (DL_GPIO_PIN_5)


/*---------------- 六路传感器 ----------------*/

#define LINE_SDA_PORT                       (GPIOA)
#define LINE_SDA_PIN                        (DL_GPIO_PIN_23)

#define LINE_SCL_PORT                       (GPIOB)
#define LINE_SCL_PIN                        (DL_GPIO_PIN_24)


/*============================================================
 * 全局变量
 *============================================================*/

/* 软件PWM相位，范围0~99。 */
static volatile uint8_t g_pwm_phase = 0U;

/* 当前真正输出的左右PWM。 */
static volatile uint8_t g_left_pwm = 0U;
static volatile uint8_t g_right_pwm = 0U;

/* 循迹控制周期计数。 */
static volatile uint16_t g_control_tick = 0U;
static volatile uint8_t g_control_due = 0U;

/* 系统毫秒计时。 */
static volatile uint8_t g_ms_divider = 0U;
static volatile uint32_t g_system_ms = 0U;


/* 当前平滑后的左右电机指令。 */
static int16_t g_left_current_cmd = 0;
static int16_t g_right_current_cmd = 0;

/* 最后一次有效循迹误差。 */
static int16_t g_last_valid_error = 0;

/* 滤波后的误差。 */
static int16_t g_filtered_error = 0;

/* 上一次滤波误差，用于D项。 */
static int16_t g_previous_filtered_error = 0;

/* 连续通信失败次数。 */
static uint8_t g_sensor_fail_count = 0U;

/* 最近一次六路检测结果，调试时可观察。 */
static uint8_t g_last_line_bits = 0U;


/*============================================================
 * 基础工具函数
 *============================================================*/

static int16_t ClampI16(
    int16_t value,
    int16_t minimum,
    int16_t maximum)
{
    if (value < minimum)
    {
        return minimum;
    }

    if (value > maximum)
    {
        return maximum;
    }

    return value;
}


static uint8_t AbsToU8(int16_t value)
{
    if (value < 0)
    {
        value = (int16_t)(-value);
    }

    if (value > 100)
    {
        value = 100;
    }

    return (uint8_t)value;
}


static int16_t ApproachI16(
    int16_t current,
    int16_t target,
    int16_t step)
{
    if (current < target)
    {
        current = (int16_t)(current + step);

        if (current > target)
        {
            current = target;
        }
    }
    else if (current > target)
    {
        current = (int16_t)(current - step);

        if (current < target)
        {
            current = target;
        }
    }

    return current;
}


static void ShortDelay(volatile uint32_t loops)
{
    while (loops > 0U)
    {
        __NOP();
        loops--;
    }
}


/*============================================================
 * 左电机方向控制
 *============================================================*/

static void LeftMotor_SetDirection(int16_t command)
{
#if LEFT_MOTOR_REVERSE
    command = (int16_t)(-command);
#endif

    if (command > 0)
    {
        /* 左电机前进。 */
        DL_GPIO_setPins(
            LEFT_IN1_PORT,
            LEFT_IN1_PIN);

        DL_GPIO_clearPins(
            LEFT_IN2_PORT,
            LEFT_IN2_PIN);
    }
    else if (command < 0)
    {
        /* 左电机后退。 */
        DL_GPIO_clearPins(
            LEFT_IN1_PORT,
            LEFT_IN1_PIN);

        DL_GPIO_setPins(
            LEFT_IN2_PORT,
            LEFT_IN2_PIN);
    }
    else
    {
        /* 左电机停止。 */
        DL_GPIO_clearPins(
            LEFT_IN1_PORT,
            LEFT_IN1_PIN);

        DL_GPIO_clearPins(
            LEFT_IN2_PORT,
            LEFT_IN2_PIN);
    }
}


/*============================================================
 * 右电机方向控制
 *============================================================*/

static void RightMotor_SetDirection(int16_t command)
{
#if RIGHT_MOTOR_REVERSE
    command = (int16_t)(-command);
#endif

    if (command > 0)
    {
        /* 右电机前进。 */
        DL_GPIO_setPins(
            RIGHT_IN3_PORT,
            RIGHT_IN3_PIN);

        DL_GPIO_clearPins(
            RIGHT_IN4_PORT,
            RIGHT_IN4_PIN);
    }
    else if (command < 0)
    {
        /* 右电机后退。 */
        DL_GPIO_clearPins(
            RIGHT_IN3_PORT,
            RIGHT_IN3_PIN);

        DL_GPIO_setPins(
            RIGHT_IN4_PORT,
            RIGHT_IN4_PIN);
    }
    else
    {
        /* 右电机停止。 */
        DL_GPIO_clearPins(
            RIGHT_IN3_PORT,
            RIGHT_IN3_PIN);

        DL_GPIO_clearPins(
            RIGHT_IN4_PORT,
            RIGHT_IN4_PIN);
    }
}


/*============================================================
 * 提交电机指令
 *============================================================*/

static void Motor_CommitCommand(
    int16_t left_command,
    int16_t right_command)
{
    uint8_t left_pwm;
    uint8_t right_pwm;

    left_command = ClampI16(
        left_command,
        -100,
        100);

    right_command = ClampI16(
        right_command,
        -100,
        100);

    left_pwm = AbsToU8(left_command);
    right_pwm = AbsToU8(right_command);

    /*
     * PWM太小时电机无法克服静摩擦，
     * 直接按照0处理。
     */
    if ((left_pwm > 0U) &&
        (left_pwm < MOTOR_MIN_EFFECTIVE_PWM))
    {
        left_pwm = 0U;
        left_command = 0;
    }

    if ((right_pwm > 0U) &&
        (right_pwm < MOTOR_MIN_EFFECTIVE_PWM))
    {
        right_pwm = 0U;
        right_command = 0;
    }

    /*
     * 切换方向之前先关闭使能，
     * 防止电机切换时突然冲击。
     */
    __disable_irq();

    DL_GPIO_clearPins(
        LEFT_EN_PORT,
        LEFT_EN_PIN);

    DL_GPIO_clearPins(
        RIGHT_EN_PORT,
        RIGHT_EN_PIN);

    LeftMotor_SetDirection(left_command);
    RightMotor_SetDirection(right_command);

    g_left_pwm = left_pwm;
    g_right_pwm = right_pwm;

    __enable_irq();
}


/*============================================================
 * 平滑改变电机速度
 *============================================================*/

static void Motor_RampTo(
    int16_t left_target,
    int16_t right_target)
{
    g_left_current_cmd = ApproachI16(
        g_left_current_cmd,
        left_target,
        PWM_SLEW_STEP);

    g_right_current_cmd = ApproachI16(
        g_right_current_cmd,
        right_target,
        PWM_SLEW_STEP);

    Motor_CommitCommand(
        g_left_current_cmd,
        g_right_current_cmd);
}


/*============================================================
 * 立即停车
 *============================================================*/

static void Motor_StopImmediately(void)
{
    g_left_current_cmd = 0;
    g_right_current_cmd = 0;

    Motor_CommitCommand(0, 0);
}


/*============================================================
 * 软件I2C
 *
 * I2C要求开漏输出：
 *
 * 输出低电平：
 *   将GPIO设置为输出，并输出0。
 *
 * 输出高电平：
 *   将GPIO切换为输入，释放总线，
 *   由外部上拉电阻拉高。
 *============================================================*/

static void I2C_Delay(void)
{
    ShortDelay(SOFT_I2C_DELAY_LOOPS);
}


/*---------------- SDA控制 ----------------*/

static void SDA_DriveLow(void)
{
    DL_GPIO_clearPins(
        LINE_SDA_PORT,
        LINE_SDA_PIN);

    DL_GPIO_enableOutput(
        LINE_SDA_PORT,
        LINE_SDA_PIN);
}


static void SDA_Release(void)
{
    DL_GPIO_disableOutput(
        LINE_SDA_PORT,
        LINE_SDA_PIN);
}


static bool SDA_Read(void)
{
    return (
        (DL_GPIO_readPins(
            LINE_SDA_PORT,
            LINE_SDA_PIN) &
         LINE_SDA_PIN) != 0U);
}


/*---------------- SCL控制 ----------------*/

static void SCL_DriveLow(void)
{
    DL_GPIO_clearPins(
        LINE_SCL_PORT,
        LINE_SCL_PIN);

    DL_GPIO_enableOutput(
        LINE_SCL_PORT,
        LINE_SCL_PIN);
}


static void SCL_Release(void)
{
    DL_GPIO_disableOutput(
        LINE_SCL_PORT,
        LINE_SCL_PIN);
}


static bool SCL_Read(void)
{
    return (
        (DL_GPIO_readPins(
            LINE_SCL_PORT,
            LINE_SCL_PIN) &
         LINE_SCL_PIN) != 0U);
}


/*============================================================
 * 释放SCL并等待其真正变成高电平
 *============================================================*/

static bool SCL_ReleaseAndWaitHigh(void)
{
    uint32_t timeout =
        SOFT_I2C_CLOCK_STRETCH_TIMEOUT;

    SCL_Release();

    while (timeout > 0U)
    {
        if (SCL_Read())
        {
            return true;
        }

        timeout--;
    }

    return false;
}


/*============================================================
 * I2C停止信号
 *============================================================*/

static void SoftI2C_Stop(void)
{
    SDA_DriveLow();
    I2C_Delay();

    (void)SCL_ReleaseAndWaitHigh();
    I2C_Delay();

    SDA_Release();
    I2C_Delay();
}


/*============================================================
 * I2C起始或重复起始信号
 *============================================================*/

static bool SoftI2C_Start(void)
{
    SDA_Release();

    if (!SCL_ReleaseAndWaitHigh())
    {
        return false;
    }

    I2C_Delay();

    /*
     * SCL和SDA均应该为高电平。
     * 如果SDA仍然是低电平，说明总线被占用。
     */
    if (!SDA_Read())
    {
        return false;
    }

    SDA_DriveLow();
    I2C_Delay();

    SCL_DriveLow();
    I2C_Delay();

    return true;
}


/*============================================================
 * I2C发送一个字节
 *============================================================*/

static bool SoftI2C_WriteByte(uint8_t data)
{
    uint8_t i;
    bool ack;

    for (i = 0U; i < 8U; i++)
    {
        if ((data & 0x80U) != 0U)
        {
            SDA_Release();
        }
        else
        {
            SDA_DriveLow();
        }

        I2C_Delay();

        if (!SCL_ReleaseAndWaitHigh())
        {
            SCL_DriveLow();
            SDA_Release();

            return false;
        }

        I2C_Delay();

        SCL_DriveLow();
        I2C_Delay();

        data <<= 1U;
    }

    /*
     * 第9个时钟读取ACK。
     * 从机拉低SDA代表应答。
     */
    SDA_Release();
    I2C_Delay();

    if (!SCL_ReleaseAndWaitHigh())
    {
        SCL_DriveLow();

        return false;
    }

    I2C_Delay();

    ack = !SDA_Read();

    SCL_DriveLow();
    I2C_Delay();

    return ack;
}


/*============================================================
 * I2C读取一个字节
 *============================================================*/

static bool SoftI2C_ReadByte(
    uint8_t *data,
    bool send_ack)
{
    uint8_t i;
    uint8_t value = 0U;

    if (data == (void *)0)
    {
        return false;
    }

    SDA_Release();

    for (i = 0U; i < 8U; i++)
    {
        value <<= 1U;

        I2C_Delay();

        if (!SCL_ReleaseAndWaitHigh())
        {
            SCL_DriveLow();

            return false;
        }

        I2C_Delay();

        if (SDA_Read())
        {
            value |= 0x01U;
        }

        SCL_DriveLow();
        I2C_Delay();
    }

    /*
     * 继续读取时发送ACK；
     * 最后一个字节发送NACK。
     */
    if (send_ack)
    {
        SDA_DriveLow();
    }
    else
    {
        SDA_Release();
    }

    I2C_Delay();

    if (!SCL_ReleaseAndWaitHigh())
    {
        SCL_DriveLow();
        SDA_Release();

        return false;
    }

    I2C_Delay();

    SCL_DriveLow();
    SDA_Release();
    I2C_Delay();

    *data = value;

    return true;
}


/*============================================================
 * I2C总线恢复
 *============================================================*/

static void SoftI2C_BusRecover(void)
{
    uint8_t i;

    SDA_Release();
    SCL_Release();

    I2C_Delay();

    /*
     * SDA被从机一直拉低时，
     * 发送9个恢复时钟。
     */
    for (i = 0U; i < 9U; i++)
    {
        SCL_DriveLow();
        I2C_Delay();

        SCL_Release();
        I2C_Delay();
    }

    SoftI2C_Stop();
}


/*============================================================
 * 读取六路巡线数字结果
 *============================================================*/

static bool LineSensor_ReadDigital(
    uint8_t *digital_result)
{
    uint8_t attempt;
    uint8_t value = 0U;

    if (digital_result == (void *)0)
    {
        return false;
    }

    /*
     * 每次最多尝试3次，
     * 增强I2C通信稳定性。
     */
    for (attempt = 0U;
         attempt < 3U;
         attempt++)
    {
        /*
         * 起始信号。
         */
        if (!SoftI2C_Start())
        {
            SoftI2C_BusRecover();
            continue;
        }

        /*
         * 发送从机地址，写方向：
         *
         * 0x5C << 1 = 0xB8。
         */
        if (!SoftI2C_WriteByte(
                (uint8_t)(
                    LINE_SENSOR_I2C_ADDRESS
                    << 1U)))
        {
            SoftI2C_Stop();
            continue;
        }

        /*
         * 发送需要读取的寄存器地址0x05。
         */
        if (!SoftI2C_WriteByte(
                LINE_SENSOR_DIGITAL_REGISTER))
        {
            SoftI2C_Stop();
            continue;
        }

        /*
         * 重复起始信号。
         */
        if (!SoftI2C_Start())
        {
            SoftI2C_Stop();
            continue;
        }

        /*
         * 发送从机地址，读方向：
         *
         * 0xB8 | 1 = 0xB9。
         */
        if (!SoftI2C_WriteByte(
                (uint8_t)(
                    (LINE_SENSOR_I2C_ADDRESS
                     << 1U) |
                    0x01U)))
        {
            SoftI2C_Stop();
            continue;
        }

        /*
         * 只读取1字节。
         * 最后一个字节发送NACK。
         */
        if (!SoftI2C_ReadByte(
                &value,
                false))
        {
            SoftI2C_Stop();
            continue;
        }

        SoftI2C_Stop();

        /*
         * 只保留低6位。
         */
        *digital_result =
            (uint8_t)(value & 0x3FU);

        return true;
    }

    SoftI2C_BusRecover();

    return false;
}


/*============================================================
 * 反转六个bit
 *============================================================*/

static uint8_t Reverse6Bits(uint8_t value)
{
    uint8_t result = 0U;
    uint8_t i;

    value &= 0x3FU;

    for (i = 0U; i < 6U; i++)
    {
        if ((value &
             (uint8_t)(1U << i)) != 0U)
        {
            result |=
                (uint8_t)(
                    1U << (5U - i));
        }
    }

    return result;
}


/*============================================================
 * 将传感器结果统一为：
 *
 * bit0 = 小车最左侧
 * bit1 = 左中
 * bit2 = 左内
 * bit3 = 右内
 * bit4 = 右中
 * bit5 = 小车最右侧
 *============================================================*/

static uint8_t NormalizeLineBits(
    uint8_t raw_bits)
{
    uint8_t bits =
        (uint8_t)(raw_bits & 0x3FU);

#if (LINE_DETECTED_IS_1 == 0)

    bits =
        (uint8_t)((~bits) & 0x3FU);

#endif

    /*
     * 手册中通道1在物理最右边，
     * 通道6在物理最左边。
     *
     * 所以先将6bit反转。
     */
    bits = Reverse6Bits(bits);

#if SENSOR_INSTALL_REVERSE

    /*
     * 如果传感器在车上左右装反，
     * 再反转一次。
     */
    bits = Reverse6Bits(bits);

#endif

    return bits;
}


/*============================================================
 * 计算六路巡线误差
 *============================================================*/

static bool CalculateLineError(
    uint8_t line_bits,
    int16_t *error)
{
    /*
     * 从小车左侧到右侧：
     *
     * bit0  bit1  bit2  bit3  bit4  bit5
     * -500  -300  -100  +100  +300  +500
     */
    static const int16_t weights[6] =
    {
        -500,
        -300,
        -100,
         100,
         300,
         500
    };

    int32_t weighted_sum = 0;
    uint8_t active_count = 0U;
    uint8_t i;

    if (error == (void *)0)
    {
        return false;
    }

    for (i = 0U; i < 6U; i++)
    {
        if ((line_bits &
             (uint8_t)(1U << i)) != 0U)
        {
            weighted_sum += weights[i];
            active_count++;
        }
    }

    if (active_count == 0U)
    {
        return false;
    }

    /*
     * 多路同时压线时取平均位置。
     */
    *error =
        (int16_t)(
            weighted_sum /
            (int32_t)active_count);

    return true;
}


/*============================================================
 * 丢线处理
 *============================================================*/

static void LineLost_Control(void)
{
    int16_t left_target;
    int16_t right_target;

    if (g_last_valid_error < -60)
    {
        /*
         * 黑线最后出现在左侧：
         * 左轮慢、右轮快。
         */
        left_target =
            LOST_LINE_INNER_PWM;

        right_target =
            LOST_LINE_OUTER_PWM;
    }
    else if (g_last_valid_error > 60)
    {
        /*
         * 黑线最后出现在右侧：
         * 左轮快、右轮慢。
         */
        left_target =
            LOST_LINE_OUTER_PWM;

        right_target =
            LOST_LINE_INNER_PWM;
    }
    else
    {
        /*
         * 直线状态下短暂丢线：
         * 继续缓慢直行。
         */
        left_target =
            LOST_LINE_STRAIGHT_PWM;

        right_target =
            LOST_LINE_STRAIGHT_PWM;
    }

    Motor_RampTo(
        left_target,
        right_target);
}


/*============================================================
 * 六路循迹控制
 *============================================================*/

static void LineFollow_Control(
    uint8_t raw_bits)
{
    uint8_t line_bits;

    int16_t current_error;
    int16_t delta_error;

    int32_t correction_32;
    int16_t correction;

    int16_t left_target;
    int16_t right_target;

    line_bits =
        NormalizeLineBits(raw_bits);

    g_last_line_bits = line_bits;

    /*
     * 六路全部没有检测到黑线。
     */
    if (line_bits == 0U)
    {
        LineLost_Control();

        return;
    }

    /*
     * 六路全部检测到黑线。
     */
    if (line_bits == 0x3FU)
    {
#if STOP_ON_ALL_BLACK

        Motor_StopImmediately();

        return;

#else

        /*
         * 当作十字线或宽黑线，
         * 保持直行。
         */
        current_error = 0;

#endif
    }
    else if (!CalculateLineError(
                 line_bits,
                 &current_error))
    {
        LineLost_Control();

        return;
    }

    /*
     * 保存最后一次有效误差，
     * 丢线时按照这个方向找线。
     */
    g_last_valid_error =
        current_error;

    /*
     * 一阶低通滤波：
     *
     * 新误差 =
     *   2/3旧误差 + 1/3当前误差。
     *
     * 可以减小左右摇头。
     */
    g_filtered_error =
        (int16_t)(
            ((int32_t)g_filtered_error * 2 +
             current_error) /
            3);

    /*
     * 计算误差变化量。
     */
    delta_error =
        (int16_t)(
            g_filtered_error -
            g_previous_filtered_error);

    g_previous_filtered_error =
        g_filtered_error;

    /*
     * PD控制。
     */
    correction_32 =
        ((int32_t)g_filtered_error *
         LINE_KP_NUM) /
        LINE_KP_DEN +

        ((int32_t)delta_error *
         LINE_KD_NUM) /
        LINE_KD_DEN;

    correction =
        ClampI16(
            (int16_t)correction_32,
            -MAX_STEERING_CORRECTION,
            MAX_STEERING_CORRECTION);

    /*
     * error > 0：
     *   黑线在右侧。
     *   左轮加速、右轮减速，向右转。
     *
     * error < 0：
     *   黑线在左侧。
     *   左轮减速、右轮加速，向左转。
     */
    left_target =
        (int16_t)(
            MOTOR_BASE_PWM +
            correction);

    right_target =
        (int16_t)(
            MOTOR_BASE_PWM -
            correction);

    /*
     * 限制左右轮速度。
     */
    left_target =
        ClampI16(
            left_target,
            0,
            MOTOR_MAX_PWM);

    right_target =
        ClampI16(
            right_target,
            0,
            MOTOR_MAX_PWM);

    /*
     * 平滑更新电机速度。
     */
    Motor_RampTo(
        left_target,
        right_target);
}


/*============================================================
 * GPIO初始化
 *============================================================*/

static void ApplicationGPIO_Init(void)
{
    /*
     * 先把所有电机引脚拉低。
     */
    DL_GPIO_clearPins(
        GPIOB,
        LEFT_IN1_PIN |
        RIGHT_IN3_PIN |
        RIGHT_IN4_PIN |
        LEFT_EN_PIN |
        RIGHT_EN_PIN);

    DL_GPIO_clearPins(
        GPIOA,
        LEFT_IN2_PIN |
        STATUS_LED_PIN);

    /*
     * 将电机相关GPIO设置为输出。
     */
    DL_GPIO_enableOutput(
        GPIOB,
        LEFT_IN1_PIN |
        RIGHT_IN3_PIN |
        RIGHT_IN4_PIN |
        LEFT_EN_PIN |
        RIGHT_EN_PIN);

    DL_GPIO_enableOutput(
        GPIOA,
        LEFT_IN2_PIN |
        STATUS_LED_PIN);

    /*
     * 软件I2C空闲状态：
     * SDA和SCL均释放。
     */
    DL_GPIO_clearPins(
        LINE_SDA_PORT,
        LINE_SDA_PIN);

    DL_GPIO_clearPins(
        LINE_SCL_PORT,
        LINE_SCL_PIN);

    SDA_Release();
    SCL_Release();

    Motor_StopImmediately();

    SoftI2C_BusRecover();
}


/*============================================================
 * SysTick中断
 *============================================================*/

void SysTick_Handler(void)
{
    /*
     * 左电机软件PWM。
     */
    if (g_left_pwm > g_pwm_phase)
    {
        DL_GPIO_setPins(
            LEFT_EN_PORT,
            LEFT_EN_PIN);
    }
    else
    {
        DL_GPIO_clearPins(
            LEFT_EN_PORT,
            LEFT_EN_PIN);
    }

    /*
     * 右电机软件PWM。
     */
    if (g_right_pwm > g_pwm_phase)
    {
        DL_GPIO_setPins(
            RIGHT_EN_PORT,
            RIGHT_EN_PIN);
    }
    else
    {
        DL_GPIO_clearPins(
            RIGHT_EN_PORT,
            RIGHT_EN_PIN);
    }

    /*
     * 软件PWM相位更新。
     */
    g_pwm_phase++;

    if (g_pwm_phase >=
        PWM_PERIOD_COUNT)
    {
        g_pwm_phase = 0U;
    }

    /*
     * 每5ms启动一次循迹计算。
     */
    g_control_tick++;

    if (g_control_tick >=
        CONTROL_INTERVAL_TICKS)
    {
        g_control_tick = 0U;
        g_control_due = 1U;
    }

    /*
     * 100us累计成1ms。
     */
    g_ms_divider++;

    if (g_ms_divider >= 10U)
    {
        g_ms_divider = 0U;
        g_system_ms++;
    }
}


/*============================================================
 * 主函数
 *============================================================*/

int main(void)
{
    uint8_t raw_line_bits = 0U;

    /*
     * 初始化SysConfig生成的外设。
     */
    SYSCFG_DL_init();

    /*
     * 初始化电机、LED和软件I2C。
     */
    ApplicationGPIO_Init();

    /*
     * 启动10kHz SysTick。
     */
    DL_SYSTICK_config(
        CPUCLK_FREQ /
        SYSTICK_FREQUENCY_HZ);

    DL_SYSTICK_enable();

    /*
     * 上电等待300ms，
     * 让六路传感器稳定。
     */
    while (g_system_ms < 300U)
    {
        __WFI();
    }

    while (1)
    {
        if (g_control_due != 0U)
        {
            g_control_due = 0U;

            /*
             * 读取六路数字结果。
             */
            if (LineSensor_ReadDigital(
                    &raw_line_bits))
            {
                /*
                 * 通信成功。
                 */
                g_sensor_fail_count = 0U;

                DL_GPIO_setPins(
                    STATUS_LED_PORT,
                    STATUS_LED_PIN);

                LineFollow_Control(
                    raw_line_bits);
            }
            else
            {
                /*
                 * 通信失败，LED熄灭。
                 */
                DL_GPIO_clearPins(
                    STATUS_LED_PORT,
                    STATUS_LED_PIN);

                if (g_sensor_fail_count <
                    255U)
                {
                    g_sensor_fail_count++;
                }

                /*
                 * 偶发一次读取失败：
                 * 保持当前运动状态。
                 *
                 * 连续失败约100ms：
                 * 立即停车。
                 */
                if (g_sensor_fail_count >=
                    SENSOR_FAIL_STOP_COUNT)
                {
                    Motor_StopImmediately();
                }
            }
        }

        __WFI();
    }
}
