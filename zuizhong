    LeftStop();
    RightStop();
}

/*
 * 软件 PWM 向前。
 * leftSpeed / rightSpeed 范围：0 ~ 10。
 */
static void MotorForwardPWM(uint8_t leftSpeed, uint8_t rightSpeed)
{
    uint8_t i;

    if (leftSpeed > PWM_MAX)
    {
        leftSpeed = PWM_MAX;
    }

    if (rightSpeed > PWM_MAX)
    {
        rightSpeed = PWM_MAX;
    }

    LeftForward();
    RightForward();

    for (i = 0; i < PWM_MAX; i++)
    {
        if (i < leftSpeed)
        {
            LeftPWM_On();
        }
        else
        {
            LeftPWM_Off();
        }

        if (i < rightSpeed)
        {
            RightPWM_On();
        }
        else
        {
            RightPWM_Off();
        }

        SoftDelay(SOFT_DELAY);
    }

    MotorPWM_Off();
}

/* ================= I2C 底层函数 ================= */

static bool I2C_WaitFree(void)
{
    uint32_t timeout = I2C_TIMEOUT;

    while ((DL_I2C_getControllerStatus(MPU_I2C_INST) &
            DL_I2C_CONTROLLER_STATUS_BUSY_BUS) && timeout)
    {
        timeout--;
    }

    if (timeout == 0)
    {
        return false;
    }

    return true;
}

static bool I2C_WriteBytes(uint8_t dev_addr, uint8_t *data, uint8_t len)
{
    if (!I2C_WaitFree())
    {
        return false;
    }

    DL_I2C_flushControllerTXFIFO(MPU_I2C_INST);
    DL_I2C_fillControllerTXFIFO(MPU_I2C_INST, data, len);

    DL_I2C_startControllerTransfer(
        MPU_I2C_INST,
        dev_addr,
        DL_I2C_CONTROLLER_DIRECTION_TX,
        len
    );

    if (!I2C_WaitFree())
    {
        return false;
    }

    return true;
}

static bool I2C_ReadBytes(uint8_t dev_addr, uint8_t reg_addr, uint8_t *data, uint8_t len)
{
    uint8_t i;
    uint32_t timeout;

    if (!I2C_WriteBytes(dev_addr, &reg_addr, 1))
    {
        return false;
    }

    DelayMs(1);

    if (!I2C_WaitFree())
    {
        return false;
    }

    DL_I2C_flushControllerRXFIFO(MPU_I2C_INST);

    DL_I2C_startControllerTransfer(
        MPU_I2C_INST,
        dev_addr,
        DL_I2C_CONTROLLER_DIRECTION_RX,
        len
    );

    for (i = 0; i < len; i++)
    {
        timeout = I2C_TIMEOUT;

        while (DL_I2C_isControllerRXFIFOEmpty(MPU_I2C_INST) && timeout)
        {
            timeout--;
        }

        if (timeout == 0)
        {
            return false;
        }

        data[i] = DL_I2C_receiveControllerData(MPU_I2C_INST);
    }

    if (!I2C_WaitFree())
    {
        return false;
    }

    return true;
}

/* ================= MPU6050 寄存器读写 ================= */

static bool MPU6050_WriteReg(uint8_t reg, uint8_t value)
{
    uint8_t buf[2];

    buf[0] = reg;
    buf[1] = value;

    return I2C_WriteBytes(g_mpu_addr, buf, 2);
}

static bool MPU6050_ReadReg(uint8_t reg, uint8_t *value)
{
    return I2C_ReadBytes(g_mpu_addr, reg, value, 1);
}

static bool MPU6050_ReadRegs(uint8_t reg, uint8_t *buf, uint8_t len)
{
    return I2C_ReadBytes(g_mpu_addr, reg, buf, len);
}

/* ================= MPU6050 基本函数 ================= */

static bool MPU6050_FindDevice(void)
{
    uint8_t who = 0;

    /*
     * 先试地址 0x68
     */
    g_mpu_addr = MPU6050_ADDR_LOW;
    g_current_addr = g_mpu_addr;

    if (MPU6050_ReadReg(MPU6050_REG_WHO_AM_I, &who))
    {
        g_who_am_i = who;

        if (who == 0x68)
        {
            return true;
        }
    }

    /*
     * 再试地址 0x69
     */
    g_mpu_addr = MPU6050_ADDR_HIGH;
    g_current_addr = g_mpu_addr;

    if (MPU6050_ReadReg(MPU6050_REG_WHO_AM_I, &who))
    {
        g_who_am_i = who;

        if (who == 0x68)
        {
            return true;
        }
    }

    return false;
}

static bool MPU6050_Init(void)
{
    /*
     * 退出睡眠模式
     */
    if (!MPU6050_WriteReg(MPU6050_REG_PWR_MGMT_1, 0x00))
    {
        return false;
    }

    DelayMs(100);

    /*
     * 加速度 ±2g
     */
    if (!MPU6050_WriteReg(MPU6050_REG_ACCEL_CONFIG, 0x00))
    {
        return false;
    }

    /*
     * 陀螺仪 ±250°/s
     */
    if (!MPU6050_WriteReg(MPU6050_REG_GYRO_CONFIG, 0x00))
    {
        return false;
    }

    DelayMs(50);

    return true;
}

/*
 * 从 0x3B 开始连续读取 14 个字节：
 * 加速度 X/Y/Z、温度、陀螺仪 X/Y/Z。
 */
static bool MPU6050_ReadAll(
    int16_t *ax,
    int16_t *ay,
    int16_t *az,
    int16_t *temp,
    int16_t *gx,
    int16_t *gy,
    int16_t *gz
)
{
    uint8_t buf[14];

    if (!MPU6050_ReadRegs(MPU6050_REG_ACCEL_XOUT_H, buf, 14))
    {
        return false;
    }

    *ax   = MakeInt16(buf[0],  buf[1]);
    *ay   = MakeInt16(buf[2],  buf[3]);
    *az   = MakeInt16(buf[4],  buf[5]);
    *temp = MakeInt16(buf[6],  buf[7]);
    *gx   = MakeInt16(buf[8],  buf[9]);
    *gy   = MakeInt16(buf[10], buf[11]);
    *gz   = MakeInt16(buf[12], buf[13]);

    return true;
}

/* ================= MPU6050 校准和读取 ================= */

static bool MPU6050_Calibrate(void)
{
    int32_t sum_gx = 0;
    int32_t sum_gy = 0;
    int32_t sum_gz = 0;

    int16_t ax = 0;
    int16_t ay = 0;
    int16_t az = 0;
    int16_t temp = 0;
    int16_t gx = 0;
    int16_t gy = 0;
    int16_t gz = 0;

    uint32_t i;

    /*
     * 校准前 LED 快闪 5 下。
     * 这时候小车和 MPU6050 必须静止。
     */
    LED_Blink(5, 80);
    DelayMs(500);

    for (i = 0; i < CALIB_SAMPLES; i++)
    {
        if (!MPU6050_ReadAll(&ax, &ay, &az, &temp, &gx, &gy, &gz))
        {
            return false;
        }

        sum_gx += gx;
        sum_gy += gy;
        sum_gz += gz;

        DelayMs(10);
    }

    g_base_gx = (int16_t)(sum_gx / CALIB_SAMPLES);
    g_base_gy = (int16_t)(sum_gy / CALIB_SAMPLES);
    g_base_gz = (int16_t)(sum_gz / CALIB_SAMPLES);

    /*
     * 校准完成，LED 亮 1 秒。
     */
    LED_On();
    DelayMs(1000);
    LED_Off();

    return true;
}

static bool MPU6050_UpdateXYZ(void)
{
    int16_t ax = 0;
    int16_t ay = 0;
    int16_t az = 0;
    int16_t temp = 0;
    int16_t gx = 0;
    int16_t gy = 0;
    int16_t gz = 0;

    if (!MPU6050_ReadAll(&ax, &ay, &az, &temp, &gx, &gy, &gz))
    {
        return false;
    }

    g_ax_raw = ax;
    g_ay_raw = ay;
    g_az_raw = az;

    g_gx_raw = gx;
    g_gy_raw = gy;
    g_gz_raw = gz;

    g_temp_raw = temp;

    g_ax_mg = ((int32_t)ax * 1000L) / ACC_LSB_PER_G;
    g_ay_mg = ((int32_t)ay * 1000L) / ACC_LSB_PER_G;
    g_az_mg = ((int32_t)az * 1000L) / ACC_LSB_PER_G;

    g_gx_dps100 = ((int32_t)(gx - g_base_gx) * 100L) / GYRO_LSB_PER_DPS;
    g_gy_dps100 = ((int32_t)(gy - g_base_gy) * 100L) / GYRO_LSB_PER_DPS;
    g_gz_dps100 = ((int32_t)(gz - g_base_gz) * 100L) / GYRO_LSB_PER_DPS;

    g_temp_c100 = ((int32_t)temp * 100L) / 340L + 3653L;

    g_read_count++;

    return true;
}

/* ================= 陀螺仪直线修正 ================= */

static void Gyro_ResetYaw(void)
{
    g_yaw_mdeg = 0;
    g_correct_dir = 0;
    g_correction = 0;
    g_yaw_last_ms = millis();
}

static void Gyro_UpdateYaw(void)
{
    uint32_t now;
    uint32_t dt;
    int32_t gz_dps100;

    now = millis();
    dt = now - g_yaw_last_ms;

    if (dt == 0)
    {
        return;
    }

    g_yaw_last_ms = now;

    gz_dps100 = g_gz_dps100;

    /*
     * 过滤很小的静止漂移。
     */
    if ((gz_dps100 > -GYRO_DPS100_DEADBAND) &&
        (gz_dps100 <  GYRO_DPS100_DEADBAND))
    {
        gz_dps100 = 0;
    }

    /*
     * g_gz_dps100 单位：0.01°/s
     *
     * 1 个 dps100 = 0.01°/s = 10 毫度/s
     * dt 单位 ms
     *
     * yaw_mdeg += gz_dps100 * dt / 100
     */
    g_yaw_mdeg += (gz_dps100 * (int32_t)dt) / 100;
}

/*
 * 低速强制修正：
 *
 * 正常：
 * 左轮 = 2
 * 右轮 = 2
 *
 * 检测到往右偏：
 * 左轮 = 0
 * 右轮 = 2
 *
 * 检测到往左偏：
 * 左轮 = 2
 * 右轮 = 0
 */
static bool CarForwardGyroCorrectStep(void)
{
    uint8_t left;
    uint8_t right;

    if (!MPU6050_UpdateXYZ())
    {
        return false;
    }

    Gyro_UpdateYaw();

    /*
     * 默认低速直行。
     */
    left = MOTOR_BASE_SPEED;
    right = MOTOR_BASE_SPEED;
    g_correct_dir = 0;
    g_correction = 0;

#if GYRO_CORRECT_REVERSE

    /*
     * 反向修正版。
     * 如果默认版本越修越偏，就把 GYRO_CORRECT_REVERSE 改成 1。
     */
    if (g_yaw_mdeg > YAW_DEADBAND_MDEG)
    {
        /*
         * 偏到一侧：左轮走，右轮停。
         */
        g_correct_dir = 1;
        g_correction = 100;

        left  = STRONG_CORRECT_SPEED;
        right = STRONG_STOP_SPEED;
    }
    else if (g_yaw_mdeg < -YAW_DEADBAND_MDEG)
    {
        /*
         * 偏到另一侧：右轮走，左轮停。
         */
        g_correct_dir = -1;
        g_correction = 100;

        left  = STRONG_STOP_SPEED;
        right = STRONG_CORRECT_SPEED;
    }

#else

    /*
     * 默认强制修正版。
     *
     * 默认认为：
     * g_yaw_mdeg > 0 表示小车往右偏。
     *
     * 往右偏：
     * 左轮停，右轮走，把车头往左拉回来。
     *
     * 往左偏：
     * 右轮停，左轮走，把车头往右拉回来。
     */
    if (g_yaw_mdeg > YAW_DEADBAND_MDEG)
    {
        g_correct_dir = 1;
        g_correction = 100;

        left  = STRONG_STOP_SPEED;
        right = STRONG_CORRECT_SPEED;
    }
    else if (g_yaw_mdeg < -YAW_DEADBAND_MDEG)
    {
        g_correct_dir = -1;
        g_correction = 100;

        left  = STRONG_CORRECT_SPEED;
        right = STRONG_STOP_SPEED;
    }

#endif

    g_left_speed = left;
    g_right_speed = right;

    MotorForwardPWM(g_left_speed, g_right_speed);

    return true;
}

static void RunStraightGyroForever(void)
{
    Gyro_ResetYaw();

    while (1)
    {
        if (!CarForwardGyroCorrectStep())
        {
            g_mpu_state = 400;
            LED_ErrorFastBlink();
        }

        g_mpu_state = 4;
    }
}

static void RunStraightGyroMs(uint32_t duration_ms)
{
    uint32_t start;

    Gyro_ResetYaw();
    start = millis();

    while ((millis() - start) < duration_ms)
    {
        if (!CarForwardGyroCorrectStep())
        {
            g_mpu_state = 400;
            LED_ErrorFastBlink();
        }

        g_mpu_state = 4;
    }

    CarStop();
}

/* ================= 主函数 ================= */

int main(void)
{
    SYSCFG_DL_init();

    /*
     * 1ms 系统计时。
     */
    SysTick_Config(CPU_CLOCK_HZ / 1000U);

    /*
     * 使能 LED 输出。
     */
    DL_GPIO_enableOutput(LED_PORT, LED_PIN);

    /*
     * 使能电机相关引脚输出。
     */
    DL_GPIO_enableOutput(GPIOB,
                         LEFT_IN1_PIN  |
                         LEFT_IN2_PIN  |
                         RIGHT_IN3_PIN |
                         RIGHT_IN4_PIN |
                         PWM_RIGHT_PIN |
                         PWM_LEFT_PIN);

    LED_Off();
    CarStop();

    DelayMs(300);

    /*
     * 开机闪 1 下。
     */
    g_mpu_state = 0;
    LED_Blink(1, 200);

    /*
     * 查找 MPU6050。
     */
    if (!MPU6050_FindDevice())
    {
        g_mpu_state = 100;
        LED_ErrorSlowBlink();
    }

    g_mpu_state = 1;
    LED_Blink(3, 150);

    /*
     * 初始化 MPU6050。
     */
    if (!MPU6050_Init())
    {
        g_mpu_state = 200;
        LED_ErrorFastBlink();
    }

    g_mpu_state = 2;

    /*
     * 校准。
     * 这个阶段不要碰小车，也不要碰 MPU6050。
     */
    if (!MPU6050_Calibrate())
    {
        g_mpu_state = 300;
        LED_ErrorFastBlink();
    }

    g_mpu_state = 3;

    DelayMs(500);

#if DRIVE_FOREVER

    /*
     * 一直低速直线行驶，并强制修正。
     */
    RunStraightGyroForever();

#else

    /*
     * 只直线行驶指定时间。
     */
    RunStraightGyroMs(DRIVE_STRAIGHT_MS);

    LED_Blink(2, 200);

    while (1)
    {
        CarStop();
    }

#endif
}
