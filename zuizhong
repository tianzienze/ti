/*
 * MSPM0G3507 + MPU6050 + 小车低速强制直线修正
 *
 * 功能：
 * 1. 读取 MPU6050
 * 2. 开机静止校准陀螺仪
 * 3. 小车低速直线行驶，速度约为原来的 1/3
 * 4. 只要检测到偏航角有明显偏移，就让一边轮子停，另一边继续走
 *
 * MPU6050 接线：
 * VCC -> 3.3V
 * GND -> GND
 * SDA -> 你的 I2C SDA
 * SCL -> 你的 I2C SCL
 * XDA / XCL 不接
 *
 * LED:
 * PA24
 *
 * 电机方向：
 * L_IN1 -> PB8
 * L_IN2 -> PB9
 * R_IN3 -> PB2
 * R_IN4 -> PB3
 *
 * 电机使能 / PWM：
 * PWM_RIGHT -> PB4
 * PWM_LEFT  -> PB6
 *
 * 注意：
 * 电机建议单独供电。
 * 开发板 GND、MPU6050 GND、电机驱动 GND 必须共地。
 */

/* ================= 用户配置区 ================= */

#define LED_PORT                    GPIOA
#define LED_PIN                     DL_GPIO_PIN_24
#define LED_ACTIVE_LOW              0

/*
 * 自动选择 SysConfig 生成的 I2C 实例
 */
#if defined(I2C_0_INST)
#define MPU_I2C_INST                I2C_0_INST
#elif defined(I2C_1_INST)
#define MPU_I2C_INST                I2C_1_INST
#else
#error "No I2C instance found. Please check SysConfig."
#endif

#define MPU6050_ADDR_LOW            0x68
#define MPU6050_ADDR_HIGH           0x69

#define MPU6050_REG_WHO_AM_I        0x75
#define MPU6050_REG_PWR_MGMT_1      0x6B
#define MPU6050_REG_ACCEL_CONFIG    0x1C
#define MPU6050_REG_GYRO_CONFIG     0x1B
#define MPU6050_REG_ACCEL_XOUT_H    0x3B

#define I2C_TIMEOUT                 1000000UL
#define CPU_CLOCK_HZ                32000000UL

#define ACC_LSB_PER_G               16384L
#define GYRO_LSB_PER_DPS            131L

#define CALIB_SAMPLES               120

/* ================= 小车电机配置区 ================= */

#define LEFT_IN1_PIN                DL_GPIO_PIN_8
#define LEFT_IN2_PIN                DL_GPIO_PIN_9

#define RIGHT_IN3_PIN               DL_GPIO_PIN_2
#define RIGHT_IN4_PIN               DL_GPIO_PIN_3

#define PWM_RIGHT_PIN               DL_GPIO_PIN_4
#define PWM_LEFT_PIN                DL_GPIO_PIN_6

/*
 * 如果某个电机前进方向反了，把对应的 0 改成 1
 */
#define LEFT_MOTOR_REVERSE          0
#define RIGHT_MOTOR_REVERSE         0

/*
 * 一般电机驱动 ENA / ENB 高电平使能，所以填 1
 */
#define MOTOR_EN_ACTIVE_HIGH        1

/*
 * 软件 PWM 最大值。
 * 速度范围：0 ~ 10
 */
#define PWM_MAX                     10

/*
 * 软件 PWM 延时。
 * 数值越大，PWM 周期越慢。
 */
#define SOFT_DELAY                  1000

/*
 * 正常直行速度。
 * 之前如果大概是 5~6，现在改成 2，约为原来的 1/3。
 */
#define MOTOR_BASE_SPEED            2

/*
 * 允许某个轮子完全停下来。
 */
#define MOTOR_MIN_SPEED             0

/*
 * 限制最大速度，防止修正太猛。
 */
#define MOTOR_MAX_SPEED             4

/*
 * 偏航角死区，单位：毫度。
 * 1000 = 1 度。
 *
 * 200 = 0.2 度。
 * 数值越小，越容易触发修正。
 */
#define YAW_DEADBAND_MDEG           200

/*
 * 陀螺仪角速度死区。
 * 单位：0.01°/s。
 * 20 = 0.20°/s。
 */
#define GYRO_DPS100_DEADBAND        20

/*
 * 强制修正时，继续转的那个轮子的速度。
 */
#define STRONG_CORRECT_SPEED        2

/*
 * 强制修正时，另一边轮子完全停。
 */
#define STRONG_STOP_SPEED           0

/*
 * 如果发现小车越修越偏，把 0 改成 1。
 */
#define GYRO_CORRECT_REVERSE        0

/*
 * 1 = 一直直线行驶
 * 0 = 只行驶 DRIVE_STRAIGHT_MS 毫秒
 */
#define DRIVE_FOREVER               1
#define DRIVE_STRAIGHT_MS           2700u

/* ================= CCS Expressions 观察变量 ================= */

/*
 * 状态：
 * 0 = 启动
 * 1 = 找到 MPU6050
 * 2 = 初始化完成
 * 3 = 校准完成
 * 4 = 正常直线修正
 * 100 = 找不到 MPU6050
 * 200 = 初始化失败
 * 300 = 校准失败
 * 400 = 读取失败
 */
volatile uint32_t g_mpu_state = 0;

volatile uint8_t g_who_am_i = 0;
volatile uint8_t g_current_addr = 0;

volatile int16_t g_ax_raw = 0;
volatile int16_t g_ay_raw = 0;
volatile int16_t g_az_raw = 0;

volatile int32_t g_ax_mg = 0;
volatile int32_t g_ay_mg = 0;
volatile int32_t g_az_mg = 0;

volatile int16_t g_gx_raw = 0;
volatile int16_t g_gy_raw = 0;
volatile int16_t g_gz_raw = 0;

volatile int32_t g_gx_dps100 = 0;
volatile int32_t g_gy_dps100 = 0;
volatile int32_t g_gz_dps100 = 0;

volatile int16_t g_temp_raw = 0;
volatile int32_t g_temp_c100 = 0;

volatile uint32_t g_read_count = 0;

/*
 * g_yaw_mdeg：
 * 偏航角，单位毫度。
 * 1000 = 1 度。
 *
 * g_correct_dir：
 * 0 = 不修正
 * 1 = 一种方向修正
 * -1 = 另一种方向修正
 */
volatile int32_t g_yaw_mdeg = 0;
volatile int8_t g_correct_dir = 0;

volatile int32_t g_correction = 0;
volatile uint8_t g_left_speed = 0;
volatile uint8_t g_right_speed = 0;

volatile uint32_t g_ms = 0;

/* ================= 内部变量 ================= */

static uint8_t g_mpu_addr = MPU6050_ADDR_LOW;

static int16_t g_base_gx = 0;
static int16_t g_base_gy = 0;
static int16_t g_base_gz = 0;

static uint32_t g_yaw_last_ms = 0;

/*
 * 提前声明，防止前面 LED_Error 函数调用 CarStop 时报错。
 */
static void CarStop(void);

/* ================= SysTick 毫秒计时 ================= */

void SysTick_Handler(void)
{
    g_ms++;
}

static uint32_t millis(void)
{
    return g_ms;
}

/* ================= 延时函数 ================= */

static void DelayMs(uint32_t ms)
{
    while (ms--)
    {
        delay_cycles(CPU_CLOCK_HZ / 1000);
    }
}

static void SoftDelay(uint32_t n)
{
    while (n--)
    {
        __asm(" nop");
    }
}

/* ================= LED 控制 ================= */

static void LED_On(void)
{
#if LED_ACTIVE_LOW
    DL_GPIO_clearPins(LED_PORT, LED_PIN);
#else
    DL_GPIO_setPins(LED_PORT, LED_PIN);
#endif
}

static void LED_Off(void)
{
#if LED_ACTIVE_LOW
    DL_GPIO_setPins(LED_PORT, LED_PIN);
#else
    DL_GPIO_clearPins(LED_PORT, LED_PIN);
#endif
}

static void LED_Blink(uint32_t times, uint32_t interval_ms)
{
    uint32_t i;

    for (i = 0; i < times; i++)
    {
        LED_On();
        DelayMs(interval_ms);
        LED_Off();
        DelayMs(interval_ms);
    }
}

static void LED_ErrorSlowBlink(void)
{
    while (1)
    {
        CarStop();
        LED_On();
        DelayMs(500);
        LED_Off();
        DelayMs(500);
    }
}

static void LED_ErrorFastBlink(void)
{
    while (1)
    {
        CarStop();
        LED_On();
        DelayMs(100);
        LED_Off();
        DelayMs(100);
    }
}

/* ================= 工具函数 ================= */

static int16_t MakeInt16(uint8_t high, uint8_t low)
{
    return (int16_t)(((uint16_t)high << 8) | low);
}

