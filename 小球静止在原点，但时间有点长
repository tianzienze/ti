/*
 * ================================================================
 * MSPM0G3507 + D36A + MS42C + K230
 * 钢球持续回原点控制程序
 *
 * K230发送格式：
 *
 *      -114\n
 *      0\n
 *      25\n
 *
 * 单位：mm
 *
 * 坐标定义：
 *
 *      x < 0：钢球位于原点负方向
 *      x > 0：钢球位于原点正方向
 *      x = 0：钢球位于原点
 *
 * 接线：
 *
 *      K230 TX -> PA1，MSPM0 UART0 RX
 *      K230 RX <- PA0，MSPM0 UART0 TX
 *      K230 GND与MSPM0 GND共地
 *
 *      PB1 -> D36A ST1
 *      PB2 -> D36A DIR1
 *      PB4 -> D36A EN1
 *
 * 控制特点：
 *
 * 1. 回中位置直接使用K230最新原始坐标；
 * 2. 滤波位置只用于速度估计，不再影响远近判断；
 * 3. 钢球静止在非零坐标时，轨道坡度继续增加；
 * 4. 钢球向原点运动时，逐渐撤销附加坡度；
 * 5. 只有真正接近原点并向原点运动时才制动；
 * 6. 进入±3mm并且速度较低后，轨道回到水平；
 * 7. 超过±6mm才退出保持，防止边界抖动；
 * 8. 钢球外环100Hz，电机内环1kHz；
 * 9. STEP脉冲服务10kHz；
 * 10. 当前不使用编码器，通过累计STEP脉冲估算电机位置。
 *
 * 上电后驱动关闭2秒，请手动将轨道调到水平。
 * ================================================================
 */


/*==============================================================
 * 1. 系统时钟及控制周期
 *==============================================================*/

#ifndef CPUCLK_FREQ
#define CPUCLK_FREQ                         (32000000UL)
#endif


/*
 * SysTick频率10kHz，每100us进入一次中断。
 */
#define SYSTICK_FREQUENCY_HZ                (10000U)


/*
 * 钢球位置外环100Hz，每10ms执行一次。
 *
 * 即使K230坐标没有变化，只要钢球不在原点，
 * 控制器仍然会持续运行。
 */
#define BALL_CONTROL_FREQUENCY_HZ           (100U)

#define BALL_CONTROL_INTERVAL_TICKS         \
    (SYSTICK_FREQUENCY_HZ /                 \
     BALL_CONTROL_FREQUENCY_HZ)

#define BALL_CONTROL_DT_S                   (0.01f)


/*
 * 步进电机位置内环1kHz，每1ms执行一次。
 */
#define MOTOR_CONTROL_FREQUENCY_HZ          (1000U)

#define MOTOR_CONTROL_INTERVAL_TICKS        \
    (SYSTICK_FREQUENCY_HZ /                 \
     MOTOR_CONTROL_FREQUENCY_HZ)

#define MOTOR_CONTROL_DT_S                  (0.001f)


/*==============================================================
 * 2. D36A控制引脚
 *==============================================================*/

#define STEP_PORT                           (GPIOB)
#define STEP_PIN                            (DL_GPIO_PIN_1)

#define DIR_PORT                            (GPIOB)
#define DIR_PIN                             (DL_GPIO_PIN_2)

#define EN_PORT                             (GPIOB)
#define EN_PIN                              (DL_GPIO_PIN_4)


/*==============================================================
 * 3. 步进电机参数
 *==============================================================*/

/*
 * MS42C步距角1.8°，一圈200整步。
 */
#define MOTOR_FULL_STEPS_PER_REV            (200.0f)


/*
 * D36A使用16细分。
 */
#define MOTOR_MICROSTEP                     (16.0f)


/*
 * 一圈脉冲数：
 *
 * 200 × 16 = 3200。
 */
#define MOTOR_PULSES_PER_REV                \
    (MOTOR_FULL_STEPS_PER_REV *             \
     MOTOR_MICROSTEP)


/*
 * 每1°电机角度对应的STEP脉冲数：
 *
 * 3200 / 360 = 8.8889。
 */
#define MOTOR_PULSES_PER_DEG                \
    (MOTOR_PULSES_PER_REV / 360.0f)


