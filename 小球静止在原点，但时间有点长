/*==============================================================
 * 18. 基础数学函数
 *==============================================================*/

static float FloatAbs(float value)
{
    if (value < 0.0f)
    {
        return -value;
    }

    return value;
}


static float FloatClamp(
    float value,
    float minimum,
    float maximum)
{
    if (value > maximum)
    {
        return maximum;
    }

    if (value < minimum)
    {
        return minimum;
    }

    return value;
}


static int32_t Int32Abs(int32_t value)
{
    if (value < 0)
    {
        return -value;
    }

    return value;
}


static int32_t FloatToInt32(float value)
{
    if (value >= 0.0f)
    {
        return (int32_t)(value + 0.5f);
    }

    return (int32_t)(value - 0.5f);
}


static float FloatSign(float value)
{
    if (value > 0.0f)
    {
        return 1.0f;
    }

    if (value < 0.0f)
    {
        return -1.0f;
    }

    return 0.0f;
}


/*==============================================================
 * 19. 延时函数
 *==============================================================*/

static void DelayMs(uint32_t milliseconds)
{
    while (milliseconds > 0U)
    {
        DL_Common_delayCycles(
            CPUCLK_FREQ / 1000U);

        milliseconds--;
    }
}


/*==============================================================
 * 20. 步进电机GPIO初始化
 *==============================================================*/

static void StepperGPIOInit(void)
{
    DL_GPIO_enableOutput(
        GPIOB,
        STEP_PIN |
        DIR_PIN |
        EN_PIN);

    DL_GPIO_clearPins(
        STEP_PORT,
        STEP_PIN);

    DL_GPIO_clearPins(
        DIR_PORT,
        DIR_PIN);

    g_step_output_level = 0U;
    g_direction_output_level = 0U;
}


/*==============================================================
 * 21. D36A使能
 *==============================================================*/

static void StepperEnable(uint32_t enable)
{
#if ENABLE_ACTIVE_HIGH == 1U

    if (enable != 0U)
    {
        DL_GPIO_setPins(
            EN_PORT,
            EN_PIN);

        g_enable_output_level = 1U;
    }
    else
    {
        DL_GPIO_clearPins(
            EN_PORT,
            EN_PIN);

        g_enable_output_level = 0U;
    }

#else

    if (enable != 0U)
    {
        DL_GPIO_clearPins(
            EN_PORT,
            EN_PIN);

        g_enable_output_level = 0U;
    }
    else
    {
        DL_GPIO_setPins(
            EN_PORT,
            EN_PIN);

        g_enable_output_level = 1U;
    }

#endif
}


/*==============================================================
 * 22. 设置电机方向
 *==============================================================*/

static void SetMotorDirection(int32_t direction)
{
    uint32_t outputLevel;

    if (direction > 0)
    {
        outputLevel =
            POSITIVE_DIRECTION_LEVEL;
    }
    else
    {
        outputLevel =
            (POSITIVE_DIRECTION_LEVEL == 0U) ?
            1U : 0U;
    }

    if (outputLevel != 0U)
    {
        DL_GPIO_setPins(
            DIR_PORT,
            DIR_PIN);

        g_direction_output_level = 1U;
    }
    else
    {
        DL_GPIO_clearPins(
            DIR_PORT,
            DIR_PIN);

        g_direction_output_level = 0U;
    }
}


/*==============================================================
 * 23. 角度与脉冲换算
 *==============================================================*/

static int32_t MotorAngleToPulse(float angleDeg)
{
    return FloatToInt32(
        angleDeg *
        MOTOR_PULSES_PER_DEG);
}


static float MotorPulseToAngle(int32_t pulse)
{
    return
        (float)pulse /
        MOTOR_PULSES_PER_DEG;
}


/*==============================================================
 * 24. STEP脉冲发生器
 *
 * 调用频率：10kHz。
 *==============================================================*/

static void StepPulseService100us(void)
{
    static uint32_t phaseAccumulator = 0U;

    static uint8_t stepPinHigh = 0U;

    static int32_t appliedDirection = 0;


    int32_t requestedRate;

    int32_t direction;

    uint32_t magnitude;


    requestedRate =
        g_step_rate_sps;


    /*
     * 停止状态：
     *
     * 清除STEP并清空相位。
     */
    if (requestedRate == 0)
    {
        if (stepPinHigh != 0U)
        {
            DL_GPIO_clearPins(
                STEP_PORT,
                STEP_PIN);

            stepPinHigh = 0U;

            g_step_output_level = 0U;
        }

        phaseAccumulator = 0U;

        return;
    }


    if (requestedRate > 0)
    {
        direction = 1;

        magnitude =
            (uint32_t)requestedRate;
    }
    else
    {
        direction = -1;

        magnitude =
            (uint32_t)(-requestedRate);
    }


    /*
     * 相位每个100us周期都累加。
     */
    phaseAccumulator += magnitude;


    /*
     * 上一次STEP为高电平：
     *
     * 本周期只拉低STEP，保证高电平至少100us。
     */
    if (stepPinHigh != 0U)
    {
        DL_GPIO_clearPins(
            STEP_PORT,
            STEP_PIN);

        stepPinHigh = 0U;

        g_step_output_level = 0U;

        return;
    }


    /*
     * 已经达到目标脉冲位置：
     * 立即停止输出。
     */
    if ((direction > 0) &&
        (g_motor_current_pulse >=
         g_motor_target_pulse))
    {
        g_step_rate_sps = 0;

        phaseAccumulator = 0U;

        return;
    }


    if ((direction < 0) &&
        (g_motor_current_pulse <=
         g_motor_target_pulse))
    {
        g_step_rate_sps = 0;

        phaseAccumulator = 0U;

        return;
    }


    /*
     * 方向切换时：
     *
     * 当前周期只更新DIR，
     * 下一周期再输出STEP。
     */
    if (direction != appliedDirection)
    {
        SetMotorDirection(direction);

        appliedDirection = direction;

        phaseAccumulator = 0U;

        return;
    }


    /*
     * 软件绝对角度限位。
     */
    if ((direction > 0) &&
        (g_motor_current_pulse >=
         MotorAngleToPulse(
             MAX_MOTOR_ANGLE_DEG)))
    {
        g_step_rate_sps = 0;

        phaseAccumulator = 0U;

        return;
    }


    if ((direction < 0) &&
        (g_motor_current_pulse <=
         MotorAngleToPulse(
             -MAX_MOTOR_ANGLE_DEG)))
    {
        g_step_rate_sps = 0;

        phaseAccumulator = 0U;

        return;
    }


    /*
     * 到达一个完整脉冲周期。
     */
    if (phaseAccumulator >=
        SYSTICK_FREQUENCY_HZ)
    {
        phaseAccumulator -=
            SYSTICK_FREQUENCY_HZ;


        DL_GPIO_setPins(
            STEP_PORT,
            STEP_PIN);


        stepPinHigh = 1U;

        g_step_output_level = 1U;


        g_motor_current_pulse +=
            direction;
    }
}


/*==============================================================
 * 25. 提交K230坐标
 *==============================================================*/

static void CommitK230Coordinate(
    int32_t coordinateMm)
{
    if (coordinateMm >
        BALL_POSITION_LIMIT_MM)
    {
        coordinateMm =
            BALL_POSITION_LIMIT_MM;
    }


    if (coordinateMm <
        -BALL_POSITION_LIMIT_MM)
    {
        coordinateMm =
            -BALL_POSITION_LIMIT_MM;
    }


    g_k230_position_mm =
        coordinateMm;


    g_k230_last_rx_ms =
        g_system_ms;


    g_k230_new_sample = 1U;


    g_k230_valid_count++;
}


/*==============================================================
 * 26. K230字符串解析
 *==============================================================*/

static void ParseK230Byte(uint8_t data)
{
    static int32_t value = 0;

    static int32_t sign = 1;

    static uint8_t receivingNumber = 0U;

    static uint8_t hasDigit = 0U;


    if (data == '-')
    {
        value = 0;

        sign = -1;

        receivingNumber = 1U;

        hasDigit = 0U;

        return;
    }


    if (data == '+')
    {
        value = 0;

        sign = 1;

        receivingNumber = 1U;

        hasDigit = 0U;

        return;
    }


    if ((data >= '0') &&
        (data <= '9'))
    {
        if (receivingNumber == 0U)
        {
            value = 0;

            sign = 1;

            receivingNumber = 1U;

            hasDigit = 0U;
        }


        value =
            value * 10 +
            (int32_t)(data - '0');


        if (value > 999)
        {
            value = 999;
        }


        hasDigit = 1U;

        return;
    }


    /*
     * 以下字符都可以结束一帧：
     *
     * 回车、换行、空格、逗号、分号。
     */
    if ((data == '\r') ||
        (data == '\n') ||
        (data == ' ')  ||
        (data == ',')  ||
        (data == ';'))
    {
        if ((receivingNumber != 0U) &&
            (hasDigit != 0U))
        {
            CommitK230Coordinate(
                sign * value);
        }


        value = 0;

        sign = 1;

        receivingNumber = 0U;

        hasDigit = 0U;
    }
}


/*==============================================================
 * 27. UART0接收中断
 *==============================================================*/

void UART0_IRQHandler(void)
{
    uint32_t pendingInterrupt;


    pendingInterrupt =
        DL_UART_Main_getPendingInterrupt(
            K230_UART_INST);


    switch (pendingInterrupt)
    {
        case DL_UART_MAIN_IIDX_RX:

            while (!DL_UART_Main_isRXFIFOEmpty(
                        K230_UART_INST))
            {
                uint8_t receivedByte;


                receivedByte =
                    (uint8_t)
                    DL_UART_Main_receiveData(
                        K230_UART_INST);


                ParseK230Byte(
                    receivedByte);
            }

            break;


        default:

            break;
    }
}


/*==============================================================
 * 28. 更新位置滤波及速度估计
 *
 * 注意：
 *
 * 这里的滤波位置不再用于回中距离控制。
 * 回中控制直接使用g_k230_position_mm。
 *==============================================================*/

static void UpdateBallMeasurement(
    float measurementMm,
    uint32_t sampleTimeMs)
{
    float dt;

    float measurementJump;

    float acceptedMeasurement;

    float rawVelocity;


    /*
     * 第一帧坐标。
     */
    if (g_observer_initialized == 0U)
    {
        g_last_accepted_position_mm =
            measurementMm;


        g_filtered_position_mm =
            measurementMm;


        g_previous_filtered_position_mm =
            measurementMm;


        g_filtered_velocity_mm_s =
            0.0f;


        g_last_measurement_time_ms =
            sampleTimeMs;


        g_observer_initialized = 1U;


        g_measurement_updated_for_control =
            1U;


        g_debug_frame_dt_ms = 0U;


        g_frame_process_count++;


        return;
    }


    dt =
        (float)(
            sampleTimeMs -
            g_last_measurement_time_ms) /
        1000.0f;


    /*
     * 限制帧间隔。
     */
    if (dt < 0.005f)
    {
        dt = 0.005f;
    }


    if (dt > 0.150f)
    {
        dt = 0.150f;
    }


    g_debug_frame_dt_ms =
        (uint32_t)(
            dt *
            1000.0f);


    /*
     * 坐标跳变限制。
     *
     * 当前设置为125mm，因此正常坐标可以一步到位。
     */
    measurementJump =
        measurementMm -
        g_last_accepted_position_mm;


    measurementJump =
        FloatClamp(
            measurementJump,
            -MAX_POSITION_JUMP_PER_FRAME_MM,
            MAX_POSITION_JUMP_PER_FRAME_MM);


    acceptedMeasurement =
        g_last_accepted_position_mm +
        measurementJump;


    g_last_accepted_position_mm =
        acceptedMeasurement;


    /*
     * 更新滤波位置。
     */
    g_filtered_position_mm +=
        POSITION_FILTER_ALPHA *
        (
            acceptedMeasurement -
            g_filtered_position_mm
        );


    /*
     * 根据滤波位置计算速度。
     */
    rawVelocity =
        (
            g_filtered_position_mm -
            g_previous_filtered_position_mm
        ) /
        dt;


    rawVelocity =
        FloatClamp(
            rawVelocity,
            -MAX_BALL_SPEED_MM_S,
            MAX_BALL_SPEED_MM_S);


    /*
     * 速度低通滤波。
     */
    g_filtered_velocity_mm_s +=
        VELOCITY_FILTER_ALPHA *
        (
            rawVelocity -
            g_filtered_velocity_mm_s
        );


    g_previous_filtered_position_mm =
        g_filtered_position_mm;


    g_last_measurement_time_ms =
        sampleTimeMs;


    g_measurement_updated_for_control =
        1U;


    g_frame_process_count++;
}


/*==============================================================
 * 29. 目标角度斜率限制
 *==============================================================*/

static float ApplyAngleSlewLimit(
    float currentAngle,
    float requestedAngle,
    float slewRateDegS)
{
    float maximumChange;

    float difference;


    maximumChange =
        slewRateDegS *
        BALL_CONTROL_DT_S;


    difference =
        requestedAngle -
        currentAngle;


    difference =
        FloatClamp(
            difference,
            -maximumChange,
            maximumChange);


    return
        currentAngle +
        difference;
}


/*==============================================================
 * 30. 钢球100Hz位置控制
 *
 * 即使钢球坐标不变化，
 * 该函数也会持续运行。
 *==============================================================*/

static void BallPositionControl100Hz(
    uint8_t receivedNewMeasurement)
{
    float controlPosition;

    float velocity;

    float absPosition;

    float absVelocity;

    float positionSign;

    float positionTerm;

    float velocityTerm;

    float requestedAngleBeforePolarity;

    float angleLimit;

    uint32_t uartAgeMs;

    uint8_t movingTowardCenter;

    uint8_t useBrakeControl;

    uint8_t stuckRamping;


    uartAgeMs =
        g_system_ms -
        g_k230_last_rx_ms;


    g_debug_uart_age_ms =
        uartAgeMs;


    /*
     * 没收到第一帧或者通信超时：
     * 轨道返回水平。
     */
    if ((g_observer_initialized == 0U) ||
        (uartAgeMs >
         K230_TIMEOUT_MS))
    {
        g_balance_state =
            BALL_STATE_WAITING;


        g_center_confirm_count = 0U;

        g_ball_stationary_ms = 0U;


        g_return_ramp_angle_deg *=
            0.90f;


        g_requested_motor_angle_deg =
            0.0f;


        g_applied_motor_angle_deg =
            ApplyAngleSlewLimit(
                g_applied_motor_angle_deg,
                0.0f,
                LEVEL_RETURN_SLEW_DEG_S);


        g_debug_target_angle_x100 =
            FloatToInt32(
                g_applied_motor_angle_deg *
                100.0f);


        g_debug_stuck_angle_x100 =
            FloatToInt32(
                g_return_ramp_angle_deg *
                100.0f);


        return;
    }


    /*
     * ==========================================================
     * 关键：
     *
     * 回中位置直接使用K230最新原始坐标。
     *
     * 例如K230坐标为125：
     *
     * controlPosition就是125，
     * g_debug_position_x10就是1250。
     * ==========================================================
     */
    controlPosition =
        (float)g_k230_position_mm;


    /*
     * 速度使用滤波后的估计值。
     */
    velocity =
        g_filtered_velocity_mm_s;


    absPosition =
        FloatAbs(
            controlPosition);


    absVelocity =
        FloatAbs(
            velocity);


    positionSign =
        FloatSign(
            controlPosition);


    /*
     * 位置与速度异号：
     * 钢球正在向0移动。
     */
    if ((controlPosition * velocity) <
        0.0f)
    {
        movingTowardCenter = 1U;
    }
    else
    {
        movingTowardCenter = 0U;
    }


    /*
     * ==========================================================
     * 已经处于原点保持状态
     * ==========================================================
     */
    if (g_balance_state ==
        BALL_STATE_HOLDING)
    {
        if ((absPosition <=
             BALL_CENTER_EXIT_MM) &&
            (absVelocity <=
             BALL_CENTER_EXIT_SPEED_MM_S))
        {
            g_return_ramp_angle_deg =
                0.0f;


            g_ball_stationary_ms = 0U;


            g_requested_motor_angle_deg =
                0.0f;


            g_applied_motor_angle_deg =
                ApplyAngleSlewLimit(
                    g_applied_motor_angle_deg,
                    0.0f,
                    LEVEL_RETURN_SLEW_DEG_S);


            g_debug_position_x10 =
                FloatToInt32(
                    controlPosition *
                    10.0f);


            g_debug_velocity_x10 =
                FloatToInt32(
                    velocity *
                    10.0f);


            g_debug_filtered_position_x10 =
                FloatToInt32(
                    g_filtered_position_mm *
                    10.0f);


            g_debug_target_angle_x100 =
                FloatToInt32(
                    g_applied_motor_angle_deg *
                    100.0f);


            g_debug_stuck_angle_x100 = 0;


            return;
        }


        /*
         * 钢球重新偏离，退出保持。
         */
        g_center_confirm_count = 0U;
    }


    /*
     * ==========================================================
     * 判断是否真正进入原点附近
     * ==========================================================
     *
     * 只有收到K230新坐标时才增加确认帧数。
     */
    if (receivedNewMeasurement != 0U)
    {
        if ((absPosition <=
             BALL_CENTER_ENTER_MM) &&
            (absVelocity <=
             BALL_CENTER_ENTER_SPEED_MM_S))
        {
            g_center_confirm_count++;


            if (g_center_confirm_count >=
                BALL_CENTER_CONFIRM_FRAMES)
            {
                g_balance_state =
                    BALL_STATE_HOLDING;


                g_return_ramp_angle_deg =
                    0.0f;


                g_ball_stationary_ms = 0U;


                g_requested_motor_angle_deg =
                    0.0f;


                g_applied_motor_angle_deg =
                    ApplyAngleSlewLimit(
                        g_applied_motor_angle_deg,
                        0.0f,
                        LEVEL_RETURN_SLEW_DEG_S);


                g_debug_target_angle_x100 =
                    FloatToInt32(
                        g_applied_motor_angle_deg *
                        100.0f);


                g_debug_stuck_angle_x100 = 0;


                return;
            }
        }
        else
        {
            g_center_confirm_count = 0U;
        }
    }


    /*
     * ==========================================================
     * 判断钢球是否静止在非零位置
     * ==========================================================
     */
    if ((absPosition >=
         BALL_STUCK_MIN_POSITION_MM) &&
        (absVelocity <=
         BALL_STUCK_SPEED_MM_S))
    {
        if (g_ball_stationary_ms <
            10000U)
        {
            g_ball_stationary_ms +=
                10U;
        }
    }
    else
    {
        g_ball_stationary_ms = 0U;
    }


    stuckRamping = 0U;


    /*
     * 静止超过100ms：
     * 继续增加坡度。
     */
    if (g_ball_stationary_ms >=
        BALL_STUCK_CONFIRM_MS)
    {
        /*
         * 钢球已经换到另一侧时，
         * 清除旧方向的坡度补偿。
         */
        if ((g_return_ramp_angle_deg *
             positionSign) < 0.0f)
        {
            g_return_ramp_angle_deg =
                0.0f;
        }


        g_return_ramp_angle_deg +=
            positionSign *
            BALL_STUCK_RAMP_DEG_S *
            BALL_CONTROL_DT_S;


        g_return_ramp_angle_deg =
            FloatClamp(
                g_return_ramp_angle_deg,
                -BALL_STUCK_MAX_ANGLE_DEG,
                BALL_STUCK_MAX_ANGLE_DEG);


        g_balance_state =
            BALL_STATE_STUCK_RAMP;


        stuckRamping = 1U;
    }
    else
    {
        /*
         * 钢球开始向0移动后，
         * 逐渐撤销静止附加坡度。
         */
        if ((movingTowardCenter != 0U) &&
            (absVelocity > 10.0f))
        {
            g_return_ramp_angle_deg *=
                BALL_STUCK_DECAY;
        }
    }


    /*
     * ==========================================================
     * 判断是否进入制动
     * ==========================================================
     *
     * 只有同时满足：
     *
     * 1. 已经进入±15mm；
     * 2. 钢球正在向0移动；
     *
     * 才进入制动。
     *
     * 钢球静止在±15mm内时不会错误制动，
     * 而是继续增加坡度。
     */
    useBrakeControl = 0U;


    if ((absPosition <=
         BALL_BRAKE_ZONE_MM) &&
        (movingTowardCenter != 0U))
    {
        useBrakeControl = 1U;
    }


    /*
     * ==========================================================
     * 计算目标角度
     * ==========================================================
     */
    if (useBrakeControl != 0U)
    {
        g_balance_state =
            BALL_STATE_BRAKING;


        positionTerm =
            BALL_BRAKE_KP *
            controlPosition;


        velocityTerm =
            BALL_BRAKE_KD *
            velocity;


        requestedAngleBeforePolarity =
            positionTerm +
            velocityTerm;


        angleLimit =
            MAX_BRAKE_ANGLE_DEG;
    }
    else
    {
        if (stuckRamping == 0U)
        {
            g_balance_state =
                BALL_STATE_PULLING;
        }


        positionTerm =
            BALL_PULL_KP *
            controlPosition;


        velocityTerm =
            BALL_PULL_KD *
            velocity;


        requestedAngleBeforePolarity =
            positionTerm +
            velocityTerm +
            g_return_ramp_angle_deg;


        /*
         * 根据真实坐标距离分段限制角度。
         */
        if (absPosition >
            FAR_POSITION_MM)
        {
            angleLimit =
                FAR_MAX_ANGLE_DEG;
        }
        else if (absPosition >
                 MIDDLE_POSITION_MM)
        {
            angleLimit =
                MIDDLE_MAX_ANGLE_DEG;
        }
        else
        {
            angleLimit =
                NEAR_MAX_ANGLE_DEG;
        }
    }


    requestedAngleBeforePolarity =
        FloatClamp(
            requestedAngleBeforePolarity,
            -angleLimit,
            angleLimit);


    /*
     * 修正实际机械方向。
     */
    g_requested_motor_angle_deg =
        requestedAngleBeforePolarity *
        BALL_CONTROL_POLARITY;


    /*
     * 限制角度变化速度。
     */
    g_applied_motor_angle_deg =
        ApplyAngleSlewLimit(
            g_applied_motor_angle_deg,
            g_requested_motor_angle_deg,
            MAX_TARGET_SLEW_DEG_S);


    /*
     * 更新调试变量。
     */
    g_debug_position_x10 =
        FloatToInt32(
            controlPosition *
            10.0f);


    g_debug_velocity_x10 =
        FloatToInt32(
            velocity *
            10.0f);


    g_debug_filtered_position_x10 =
        FloatToInt32(
            g_filtered_position_mm *
            10.0f);


    g_debug_target_angle_x100 =
        FloatToInt32(
            g_applied_motor_angle_deg *
            100.0f);


    g_debug_stuck_angle_x100 =
        FloatToInt32(
            g_return_ramp_angle_deg *
            100.0f);
}


/*==============================================================
 * 31. 步进电机1kHz位置内环
 *==============================================================*/

static void MotorPositionControl1ms(
    float targetAngleDeg)
{
    static float previousRate = 0.0f;


    int32_t targetPulse;

    int32_t positionError;


    float requestedRate;

    float maximumRateChange;


    /*
     * 目标角度换算成目标脉冲。
     */
    targetPulse =
        MotorAngleToPulse(
            targetAngleDeg);


    /*
     * 总软件角度限制。
     */
    if (targetPulse >
        MotorAngleToPulse(
            MAX_MOTOR_ANGLE_DEG))
    {
        targetPulse =
            MotorAngleToPulse(
                MAX_MOTOR_ANGLE_DEG);
    }


    if (targetPulse <
        MotorAngleToPulse(
            -MAX_MOTOR_ANGLE_DEG))
    {
        targetPulse =
            MotorAngleToPulse(
                -MAX_MOTOR_ANGLE_DEG);
    }


    g_motor_target_pulse =
        targetPulse;


    positionError =
        targetPulse -
        g_motor_current_pulse;


    /*
     * 已经到达目标脉冲附近：
     * 立即停止。
     */
    if (Int32Abs(positionError) <=
        MOTOR_POSITION_DEADBAND_PULSE)
    {
        g_step_rate_sps = 0;


        previousRate = 0.0f;


        g_debug_motor_angle_x100 =
            FloatToInt32(
                MotorPulseToAngle(
                    g_motor_current_pulse) *
                100.0f);


        return;
    }


    /*
     * 目标方向反转时，
     * 立即清除旧方向速度。
     */
    if (((positionError > 0) &&
         (previousRate < 0.0f)) ||
        ((positionError < 0) &&
         (previousRate > 0.0f)))
    {
        previousRate = 0.0f;
    }


    requestedRate =
        MOTOR_POSITION_KP *
        (float)positionError;


    /*
     * 保证有误差时具有最低运动速度。
     */
    if ((requestedRate > 0.0f) &&
        (requestedRate <
         MOTOR_MIN_STEP_RATE_SPS))
    {
        requestedRate =
            MOTOR_MIN_STEP_RATE_SPS;
    }


    if ((requestedRate < 0.0f) &&
        (requestedRate >
         -MOTOR_MIN_STEP_RATE_SPS))
    {
        requestedRate =
            -MOTOR_MIN_STEP_RATE_SPS;
    }


    requestedRate =
        FloatClamp(
            requestedRate,
            -MOTOR_MAX_STEP_RATE_SPS,
            MOTOR_MAX_STEP_RATE_SPS);


    /*
     * STEP频率加速度限制。
     */
    maximumRateChange =
        MOTOR_MAX_ACCEL_SPS2 *
        MOTOR_CONTROL_DT_S;


    requestedRate =
        FloatClamp(
            requestedRate,
            previousRate -
            maximumRateChange,
            previousRate +
            maximumRateChange);


    g_step_rate_sps =
        FloatToInt32(
            requestedRate);


    previousRate =
        requestedRate;


    g_debug_motor_angle_x100 =
        FloatToInt32(
            MotorPulseToAngle(
                g_motor_current_pulse) *
            100.0f);
}


/*==============================================================
 * 32. SysTick中断
 *==============================================================*/

void SysTick_Handler(void)
{
    static uint32_t millisecondDivider = 0U;

    static uint32_t ballControlDivider = 0U;

    static uint32_t motorControlDivider = 0U;


    /*
     * STEP脉冲服务10kHz。
     */
    StepPulseService100us();


    /*
     * 毫秒计时。
     */
    millisecondDivider++;


    if (millisecondDivider >= 10U)
    {
        millisecondDivider = 0U;

        g_system_ms++;
    }


    /*
     * 钢球外环100Hz。
     */
    ballControlDivider++;


    if (ballControlDivider >=
        BALL_CONTROL_INTERVAL_TICKS)
    {
        ballControlDivider = 0U;

        g_ball_control_due = 1U;
    }


    /*
     * 步进电机内环1kHz。
     */
    motorControlDivider++;


    if (motorControlDivider >=
        MOTOR_CONTROL_INTERVAL_TICKS)
    {
        motorControlDivider = 0U;

        g_motor_control_due = 1U;
    }
}


/*==============================================================
 * 33. 主函数
 *==============================================================*/

int main(void)
{
    uint8_t hasNewSample;

    uint8_t ballControlDue;

    uint8_t motorControlDue;

    uint8_t measurementUpdated;


    int32_t receivedPosition;

    uint32_t receivedTime;


    /*
     * SysConfig初始化。
     */
    SYSCFG_DL_init();


    /*
     * 初始化D36A引脚。
     */
    StepperGPIOInit();


    /*
     * 上电先关闭D36A。
     *
     * 这时手动将轨道调到水平。
     */
    StepperEnable(0U);


    /*
     * 打开UART0接收中断。
     */
    DL_UART_Main_enableInterrupt(
        K230_UART_INST,
        DL_UART_MAIN_INTERRUPT_RX);


    NVIC_ClearPendingIRQ(
        K230_UART_INST_INT_IRQN);


    NVIC_EnableIRQ(
        K230_UART_INST_INT_IRQN);


    /*
     * 启动10kHz SysTick。
     */
    if (SysTick_Config(
            CPUCLK_FREQ /
            SYSTICK_FREQUENCY_HZ) != 0U)
    {
        while (1)
        {
            __WFI();
        }
    }


    __enable_irq();


    /*
     * 等待2秒。
     *
     * 在此期间手动把轨道调水平。
     */
    DelayMs(
        START_DELAY_MS);


    /*
     * 当前水平位置作为软件0°。
     */
    g_motor_current_pulse = 0;

    g_motor_target_pulse = 0;

    g_step_rate_sps = 0;


    g_requested_motor_angle_deg = 0.0f;

    g_applied_motor_angle_deg = 0.0f;

    g_return_ramp_angle_deg = 0.0f;


    g_filtered_position_mm = 0.0f;

    g_previous_filtered_position_mm = 0.0f;

    g_filtered_velocity_mm_s = 0.0f;


    g_observer_initialized = 0U;


    g_balance_state =
        BALL_STATE_WAITING;


    g_center_confirm_count = 0U;

    g_ball_stationary_ms = 0U;


    /*
     * 清除启动等待期间留下的新帧标志。
     */
    __disable_irq();


    g_k230_new_sample = 0U;


    __enable_irq();


    /*
     * 使能D36A并锁轴。
     */
    StepperEnable(1U);


    DelayMs(
        ENABLE_SETTLE_MS);


    while (1)
    {
        /*
         * ======================================================
         * 读取K230新坐标
         * ======================================================
         */
        __disable_irq();


        hasNewSample =
            g_k230_new_sample;


        receivedPosition =
            g_k230_position_mm;


        receivedTime =
            g_k230_last_rx_ms;


        if (hasNewSample != 0U)
        {
            g_k230_new_sample = 0U;
        }


        __enable_irq();


        /*
         * 每收到一帧坐标，
         * 更新滤波位置和速度。
         */
        if (hasNewSample != 0U)
        {
            UpdateBallMeasurement(
                (float)receivedPosition,
                receivedTime);
        }


        /*
         * ======================================================
         * 读取100Hz钢球控制标志
         * ======================================================
         */
        __disable_irq();


        ballControlDue =
            g_ball_control_due;


        if (ballControlDue != 0U)
        {
            g_ball_control_due = 0U;
        }


        __enable_irq();


        if (ballControlDue != 0U)
        {
            measurementUpdated =
                g_measurement_updated_for_control;


            g_measurement_updated_for_control =
                0U;


            /*
             * 即使这一周期没有新坐标，
             * 仍然继续执行回原点控制。
             */
            BallPositionControl100Hz(
                measurementUpdated);
        }


        /*
         * ======================================================
         * 读取1kHz电机控制标志
         * ======================================================
         */
        __disable_irq();


        motorControlDue =
            g_motor_control_due;


        if (motorControlDue != 0U)
        {
            g_motor_control_due = 0U;
        }


        __enable_irq();


        if (motorControlDue != 0U)
        {
            MotorPositionControl1ms(
                g_applied_motor_angle_deg);
        }


        __WFI();
    }
}
