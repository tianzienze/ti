/*==============================================================
 * 11. 基础数学函数
 *==============================================================*/

static float FloatAbs(float value)
{
    if (value < 0.0f)
    {
        return -value;
    }

    return value;
}


static float FloatClamp(
    float value,
    float minimum,
    float maximum)
{
    if (value > maximum)
    {
        return maximum;
    }

    if (value < minimum)
    {
        return minimum;
    }

    return value;
}


static int32_t Int32Abs(int32_t value)
{
    if (value < 0)
    {
        return -value;
    }

    return value;
}


static int32_t FloatToInt32(float value)
{
    if (value >= 0.0f)
    {
        return (int32_t)(value + 0.5f);
    }

    return (int32_t)(value - 0.5f);
}


/*
 * atan近似。
 *
 * 本项目只使用|a/g|<=0.30，
 * x-x^3/3+x^5/5在这个范围内精度足够，
 * 不需要链接math库。
 */
static float AtanApproxRad(float value)
{
    float squared;

    value =
        FloatClamp(
            value,
            -0.50f,
            0.50f);

    squared =
        value *
        value;

    return
        value *
        (
            1.0f -
            squared / 3.0f +
            squared * squared / 5.0f
        );
}


/* 根据宏选择JY60的纵向轴。 */
static int16_t SelectJY60ForwardRaw(
    int16_t rawX,
    int16_t rawY,
    int16_t rawZ)
{
#if JY60_FORWARD_AXIS == 0U

    (void)rawY;
    (void)rawZ;
    return rawX;

#elif JY60_FORWARD_AXIS == 1U

    (void)rawX;
    (void)rawZ;
    return rawY;

#else

    (void)rawX;
    (void)rawY;
    return rawZ;

#endif
}


/*==============================================================
 * 12. 延时函数
 *==============================================================*/

static void DelayMs(uint32_t milliseconds)
{
    while (milliseconds > 0U)
    {
        DL_Common_delayCycles(
            CPUCLK_FREQ / 1000U);

        milliseconds--;
    }
}


/*==============================================================
 * 13. 电机GPIO和使能
 *==============================================================*/

static void StepperGPIOInit(void)
{
    DL_GPIO_enableOutput(
        GPIOB,
        STEP_PIN |
        DIR_PIN |
        EN_PIN);

    DL_GPIO_clearPins(
        STEP_PORT,
        STEP_PIN);

    DL_GPIO_clearPins(
        DIR_PORT,
        DIR_PIN);

    g_step_output_level = 0U;
    g_direction_output_level = 0U;
}


static void StepperEnable(uint32_t enable)
{
#if ENABLE_ACTIVE_HIGH == 1U

    if (enable != 0U)
    {
        DL_GPIO_setPins(
            EN_PORT,
            EN_PIN);

        g_enable_output_level = 1U;
    }
    else
    {
        DL_GPIO_clearPins(
            EN_PORT,
            EN_PIN);

        g_enable_output_level = 0U;
    }

#else

    if (enable != 0U)
    {
        DL_GPIO_clearPins(
            EN_PORT,
            EN_PIN);

        g_enable_output_level = 0U;
    }
    else
    {
        DL_GPIO_setPins(
            EN_PORT,
            EN_PIN);

        g_enable_output_level = 1U;
    }

#endif
}


static void SetMotorDirection(int32_t direction)
{
    uint32_t outputLevel;

    if (direction > 0)
    {
        outputLevel =
            POSITIVE_DIRECTION_LEVEL;
    }
    else
    {
        outputLevel =
            (POSITIVE_DIRECTION_LEVEL == 0U) ?
            1U : 0U;
    }

    if (outputLevel != 0U)
    {
        DL_GPIO_setPins(
            DIR_PORT,
            DIR_PIN);

        g_direction_output_level = 1U;
    }
    else
    {
        DL_GPIO_clearPins(
            DIR_PORT,
            DIR_PIN);

        g_direction_output_level = 0U;
    }
}


/*==============================================================
 * 14. 角度与脉冲换算
 *==============================================================*/

static int32_t MotorAngleToPulse(float angleDeg)
{
    return
        FloatToInt32(
            angleDeg *
            MOTOR_PULSES_PER_DEG);
}


static float MotorPulseToAngle(int32_t pulse)
{
    return
        (float)pulse /
        MOTOR_PULSES_PER_DEG;
}


/*==============================================================
 * 15. STEP脉冲服务，调用频率10kHz
 *==============================================================*/

static void StepPulseService100us(void)
{
    static uint32_t phaseAccumulator = 0U;
    static uint8_t stepPinHigh = 0U;
    static int32_t appliedDirection = 0;

    int32_t requestedRate;
    int32_t direction;
    uint32_t magnitude;

    requestedRate =
        g_step_rate_sps;

    /*
     * STEP高电平保持一个100us周期，
     * 下一次中断先拉低。
     */
    if (stepPinHigh != 0U)
    {
        DL_GPIO_clearPins(
            STEP_PORT,
            STEP_PIN);

        stepPinHigh = 0U;
        g_step_output_level = 0U;
    }

    if (requestedRate == 0)
    {
        phaseAccumulator = 0U;
        return;
    }

    if (requestedRate > 0)
    {
        direction = 1;
        magnitude = (uint32_t)requestedRate;
    }
    else
    {
        direction = -1;
        magnitude = (uint32_t)(-requestedRate);
    }

    /* 已经到达目标脉冲位置。 */
    if ((direction > 0) &&
        (g_motor_current_pulse >=
         g_motor_target_pulse))
    {
        g_step_rate_sps = 0;
        phaseAccumulator = 0U;
        return;
    }

    if ((direction < 0) &&
        (g_motor_current_pulse <=
         g_motor_target_pulse))
    {
        g_step_rate_sps = 0;
        phaseAccumulator = 0U;
        return;
    }

    /*
     * 改变方向后先空一个100us周期，
     * 给D36A留DIR建立时间。
     */
    if (direction != appliedDirection)
    {
        SetMotorDirection(
            direction);

        appliedDirection =
            direction;

        phaseAccumulator = 0U;
        return;
    }

    /* 软件正负角度限位。 */
    if ((direction > 0) &&
        (g_motor_current_pulse >=
         MotorAngleToPulse(
             MAX_MOTOR_ANGLE_DEG)))
    {
        g_step_rate_sps = 0;
        phaseAccumulator = 0U;
        return;
    }

    if ((direction < 0) &&
        (g_motor_current_pulse <=
         MotorAngleToPulse(
             -MAX_MOTOR_ANGLE_DEG)))
    {
        g_step_rate_sps = 0;
        phaseAccumulator = 0U;
        return;
    }

    phaseAccumulator +=
        magnitude;

    if (phaseAccumulator >=
        SYSTICK_FREQUENCY_HZ)
    {
        phaseAccumulator -=
            SYSTICK_FREQUENCY_HZ;

        DL_GPIO_setPins(
            STEP_PORT,
            STEP_PIN);

        stepPinHigh = 1U;
        g_step_output_level = 1U;

        g_motor_current_pulse +=
            direction;
    }
}


/*==============================================================
 * 16. JY60加速度帧提交
 *==============================================================*/

static void CommitJY60AccelerationFrame(
    const uint8_t *frame)
{
    int16_t rawX;
    int16_t rawY;
    int16_t rawZ;
    int16_t forwardRaw;

    rawX =
        (int16_t)(
            (uint16_t)frame[2] |
            ((uint16_t)frame[3] << 8));

    rawY =
        (int16_t)(
            (uint16_t)frame[4] |
            ((uint16_t)frame[5] << 8));

    rawZ =
        (int16_t)(
            (uint16_t)frame[6] |
            ((uint16_t)frame[7] << 8));

    g_jy60_accel_raw_x = rawX;
    g_jy60_accel_raw_y = rawY;
    g_jy60_accel_raw_z = rawZ;

    g_jy60_last_rx_ms =
        g_system_ms;

    g_jy60_valid_count++;

    /*
     * 上电标定期间直接累计纵向轴原始值。
     * 这段时间小车必须保持静止。
     */
    if ((g_jy60_collect_calibration != 0U) &&
        (g_jy60_calibration_count <
         JY60_CALIBRATION_MAX_SAMPLES))
    {
        forwardRaw =
            SelectJY60ForwardRaw(
                rawX,
                rawY,
                rawZ);

        g_jy60_calibration_sum_raw +=
            (int32_t)forwardRaw;

        g_jy60_calibration_count++;
    }
}


/*==============================================================
 * 17. JY60字节流解析
 *==============================================================*/

static void ParseJY60Byte(uint8_t data)
{
    static uint8_t frame[
        JY60_FRAME_LENGTH];

    static uint8_t index = 0U;

    uint8_t checksum;
    uint32_t i;

    /* 等待帧头0x55。 */
    if (index == 0U)
    {
        if (data ==
            JY60_FRAME_HEADER)
        {
            frame[0] = data;
            index = 1U;
        }

        return;
    }

    frame[index] = data;
    index++;

    if (index <
        JY60_FRAME_LENGTH)
    {
        return;
    }

    checksum = 0U;

    for (i = 0U;
         i < 10U;
         i++)
    {
        checksum =
            (uint8_t)(
                checksum +
                frame[i]);
    }

    if (checksum ==
        frame[10])
    {
        if (frame[1] ==
            JY60_FRAME_ACCELERATION)
        {
            CommitJY60AccelerationFrame(
                frame);
        }
    }
    else
    {
        g_jy60_checksum_error_count++;
    }

    /*
     * 处理完一帧后重新等待帧头。
     * JY60会连续发送0x51、0x52、0x53等不同类型帧。
     */
    index = 0U;
}


/*==============================================================
 * 18. UART1中断：只接收JY60
 *==============================================================*/

void UART1_IRQHandler(void)
{
    uint32_t pendingInterrupt;

    pendingInterrupt =
        DL_UART_Main_getPendingInterrupt(
            JY60_UART_INST);

    switch (pendingInterrupt)
    {
        case DL_UART_MAIN_IIDX_RX:

            while (!DL_UART_Main_isRXFIFOEmpty(
                        JY60_UART_INST))
            {
                uint8_t receivedByte;

                receivedByte =
                    (uint8_t)
                    DL_UART_Main_receiveData(
                        JY60_UART_INST);

                ParseJY60Byte(
                    receivedByte);
            }

            break;

        default:

            break;
    }
}


/*==============================================================
 * 19. 补偿角斜率限制
 *==============================================================*/

static float ApplyCompensationSlewLimit(
    float currentAngle,
    float requestedAngle,
    float slewRateDegS)
{
    float maximumChange;
    float difference;

    maximumChange =
        slewRateDegS *
        COMPENSATION_CONTROL_DT_S;

    difference =
        requestedAngle -
        currentAngle;

    difference =
        FloatClamp(
            difference,
            -maximumChange,
            maximumChange);

    return
        currentAngle +
        difference;
}


/*==============================================================
 * 20. 完成JY60上电静止标定
 *==============================================================*/

static void FinishJY60Calibration(void)
{
    int32_t calibrationSum;
    uint32_t calibrationCount;

    int16_t rawX;
    int16_t rawY;
    int16_t rawZ;

    __disable_irq();

    g_jy60_collect_calibration = 0U;

    calibrationSum =
        g_jy60_calibration_sum_raw;

    calibrationCount =
        g_jy60_calibration_count;

    rawX = g_jy60_accel_raw_x;
    rawY = g_jy60_accel_raw_y;
    rawZ = g_jy60_accel_raw_z;

    __enable_irq();

    if (calibrationCount >=
        JY60_CALIBRATION_MIN_SAMPLES)
    {
        g_jy60_zero_raw =
            calibrationSum /
            (int32_t)calibrationCount;

        g_jy60_calibrated = 1U;
    }
    else
    {
        /*
         * 帧数不足时记录当前值，但不启用补偿，
         * 防止串口未工作时电机突然转动。
         */
        g_jy60_zero_raw =
            (int32_t)
            SelectJY60ForwardRaw(
                rawX,
                rawY,
                rawZ);

        g_jy60_calibrated = 0U;
    }

    g_vehicle_accel_filtered_g = 0.0f;
    g_vehicle_comp_target_angle_deg = 0.0f;
    g_vehicle_comp_angle_deg = 0.0f;
    g_motor_command_angle_deg = MOTOR_LEVEL_OFFSET_DEG;

    g_debug_jy60_zero_raw =
        g_jy60_zero_raw;

    g_debug_jy60_calibrated =
        g_jy60_calibrated;
}


/*==============================================================
 * 21. 100Hz：JY60加速度转步进电机目标角
 *==============================================================*/

static void UpdateJY60Compensation100Hz(void)
{
    int16_t rawX;
    int16_t rawY;
    int16_t rawZ;
    int16_t forwardRaw;

    uint32_t lastRxMs;
    uint32_t ageMs;
    uint8_t calibrated;

    float measuredAccelG;
    float filteredForControl;
    float filterAlpha;
    float compensationGain;
    float compensationSlewDegS;
    float targetAngleDeg;
    float finalMotorAngleDeg;

    uint32_t compensationPhase;

    __disable_irq();

    rawX = g_jy60_accel_raw_x;
    rawY = g_jy60_accel_raw_y;
    rawZ = g_jy60_accel_raw_z;

    lastRxMs = g_jy60_last_rx_ms;
    calibrated = g_jy60_calibrated;

    __enable_irq();

    ageMs =
        g_system_ms -
        lastRxMs;

    g_debug_jy60_age_ms =
        ageMs;

    forwardRaw =
        SelectJY60ForwardRaw(
            rawX,
            rawY,
            rawZ);

    g_debug_jy60_forward_raw =
        (int32_t)forwardRaw;

    /*
     * 未完成标定或JY60掉线：
     * 不再使用传感器数据，目标角安全回到水平。
     */
    if ((calibrated == 0U) ||
        (ageMs >
         JY60_TIMEOUT_MS))
    {
        g_debug_jy60_online = 0U;

        g_vehicle_accel_filtered_g *=
            0.82f;

        g_vehicle_comp_target_angle_deg =
            0.0f;

        g_vehicle_comp_angle_deg =
            ApplyCompensationSlewLimit(
                g_vehicle_comp_angle_deg,
                0.0f,
                VEHICLE_OFFLINE_RETURN_DEG_S);

        finalMotorAngleDeg =
            MOTOR_LEVEL_OFFSET_DEG +
            MOTOR_COMPENSATION_POLARITY *
            g_vehicle_comp_angle_deg;

        g_motor_command_angle_deg =
            FloatClamp(
                finalMotorAngleDeg,
                -MAX_MOTOR_ANGLE_DEG,
                MAX_MOTOR_ANGLE_DEG);

        g_debug_raw_accel_mg = 0;

        g_debug_filtered_accel_mg =
            FloatToInt32(
                g_vehicle_accel_filtered_g *
                1000.0f);

        g_debug_compensation_phase = 3U;
        g_debug_filter_alpha_x1000 = 0;
        g_debug_compensation_gain_x1000 = 0;

        g_debug_compensation_slew_deg_s =
            FloatToInt32(
                VEHICLE_OFFLINE_RETURN_DEG_S);

        g_debug_comp_target_angle_x100 = 0;

        g_debug_motor_command_angle_x100 =
            FloatToInt32(
                g_motor_command_angle_deg *
                100.0f);

        return;
    }

    g_debug_jy60_online = 1U;

    /*
     * 去除上电静止零偏，并换算为g。
     */
    measuredAccelG =
        (
            (float)(
                (int32_t)forwardRaw -
                g_jy60_zero_raw)
        ) *
        JY60_ACCEL_RAW_TO_G *
        JY60_ACCEL_AXIS_POLARITY;

    measuredAccelG =
        FloatClamp(
            measuredAccelG,
            -VEHICLE_ACCEL_LIMIT_G,
            VEHICLE_ACCEL_LIMIT_G);

    g_debug_raw_accel_mg =
        FloatToInt32(
            measuredAccelG *
            1000.0f);

    /*
     * 负加速度按停车参数滤波，
     * 正加速度按启动参数滤波。
     */
    if (measuredAccelG <
        -VEHICLE_ACCEL_DEADBAND_G)
    {
        filterAlpha =
            VEHICLE_STOP_FILTER_ALPHA;
    }
    else
    {
        filterAlpha =
            VEHICLE_START_FILTER_ALPHA;
    }

    g_vehicle_accel_filtered_g +=
        filterAlpha *
        (
            measuredAccelG -
            g_vehicle_accel_filtered_g
        );

    filteredForControl =
        g_vehicle_accel_filtered_g;

    if (FloatAbs(
            filteredForControl) <
        VEHICLE_ACCEL_DEADBAND_G)
    {
        filteredForControl = 0.0f;
    }

    /*
     * 根据滤波后的加速度方向选择增益和角速度。
     */
    if (filteredForControl <
        -VEHICLE_ACCEL_DEADBAND_G)
    {
        compensationPhase = 2U;

        compensationGain =
            VEHICLE_STOP_COMPENSATION_GAIN;

        compensationSlewDegS =
            VEHICLE_STOP_SLEW_DEG_S;
    }
    else if (filteredForControl >
             VEHICLE_ACCEL_DEADBAND_G)
    {
        compensationPhase = 1U;

        compensationGain =
            VEHICLE_START_COMPENSATION_GAIN;

        compensationSlewDegS =
            VEHICLE_START_SLEW_DEG_S;
    }
    else
    {
        compensationPhase = 0U;

        compensationGain =
            VEHICLE_START_COMPENSATION_GAIN;

        compensationSlewDegS =
            VEHICLE_ZERO_RETURN_SLEW_DEG_S;
    }

    /*
     * 对沿轨道方向的惯性进行近似补偿：
     *
     *   a_ball = g*sin(theta) - a_car*cos(theta)
     *
     * 令a_ball=0：
     *
     *   tan(theta) = a_car/g
     *   theta = atan(acceleration_g)
     */
    targetAngleDeg =
        AtanApproxRad(
            filteredForControl) *
        RAD_TO_DEG *
        compensationGain;

    targetAngleDeg =
        FloatClamp(
            targetAngleDeg,
            -VEHICLE_COMPENSATION_MAX_ANGLE_DEG,
            VEHICLE_COMPENSATION_MAX_ANGLE_DEG);

    g_vehicle_comp_target_angle_deg =
        targetAngleDeg;

    g_vehicle_comp_angle_deg =
        ApplyCompensationSlewLimit(
            g_vehicle_comp_angle_deg,
            g_vehicle_comp_target_angle_deg,
            compensationSlewDegS);

    finalMotorAngleDeg =
        MOTOR_LEVEL_OFFSET_DEG +
        MOTOR_COMPENSATION_POLARITY *
        g_vehicle_comp_angle_deg;

    g_motor_command_angle_deg =
        FloatClamp(
            finalMotorAngleDeg,
            -MAX_MOTOR_ANGLE_DEG,
            MAX_MOTOR_ANGLE_DEG);

    g_debug_filtered_accel_mg =
        FloatToInt32(
            g_vehicle_accel_filtered_g *
            1000.0f);

    g_debug_compensation_phase =
        compensationPhase;

    g_debug_filter_alpha_x1000 =
        FloatToInt32(
            filterAlpha *
            1000.0f);

    g_debug_compensation_gain_x1000 =
        FloatToInt32(
            compensationGain *
            1000.0f);

    g_debug_compensation_slew_deg_s =
        FloatToInt32(
            compensationSlewDegS);

    g_debug_comp_target_angle_x100 =
        FloatToInt32(
            g_vehicle_comp_target_angle_deg *
            100.0f);

    g_debug_motor_command_angle_x100 =
        FloatToInt32(
            g_motor_command_angle_deg *
            100.0f);
}


/*==============================================================
 * 22. 1kHz：步进电机软件位置控制
 *==============================================================*/

static void MotorPositionControl1ms(
    float targetAngleDeg)
{
    static float previousRate = 0.0f;

    int32_t targetPulse;
    int32_t positionError;

    float requestedRate;
    float maximumRateChange;

    targetAngleDeg =
        FloatClamp(
            targetAngleDeg,
            -MAX_MOTOR_ANGLE_DEG,
            MAX_MOTOR_ANGLE_DEG);

    targetPulse =
        MotorAngleToPulse(
            targetAngleDeg);

    g_motor_target_pulse =
        targetPulse;

    positionError =
        targetPulse -
        g_motor_current_pulse;

    /* 到达目标位置后停止发脉冲，电机仍保持使能锁轴。 */
    if (Int32Abs(positionError) <=
        MOTOR_POSITION_DEADBAND_PULSE)
    {
        g_step_rate_sps = 0;
        previousRate = 0.0f;

        g_debug_motor_actual_angle_x100 =
            FloatToInt32(
                MotorPulseToAngle(
                    g_motor_current_pulse) *
                100.0f);

        return;
    }

    /* 目标方向反转时清除旧方向速度。 */
    if (((positionError > 0) &&
         (previousRate < 0.0f)) ||
        ((positionError < 0) &&
         (previousRate > 0.0f)))
    {
        previousRate = 0.0f;
    }

    requestedRate =
        MOTOR_POSITION_KP *
        (float)positionError;

    /* 小误差时仍给出最低STEP频率。 */
    if ((requestedRate > 0.0f) &&
        (requestedRate <
         MOTOR_MIN_STEP_RATE_SPS))
    {
        requestedRate =
            MOTOR_MIN_STEP_RATE_SPS;
    }

    if ((requestedRate < 0.0f) &&
        (requestedRate >
         -MOTOR_MIN_STEP_RATE_SPS))
    {
        requestedRate =
            -MOTOR_MIN_STEP_RATE_SPS;
    }

    requestedRate =
        FloatClamp(
            requestedRate,
            -MOTOR_MAX_STEP_RATE_SPS,
            MOTOR_MAX_STEP_RATE_SPS);

    maximumRateChange =
        MOTOR_MAX_ACCEL_SPS2 *
        MOTOR_CONTROL_DT_S;

    requestedRate =
        FloatClamp(
            requestedRate,
            previousRate -
            maximumRateChange,
            previousRate +
            maximumRateChange);

    g_step_rate_sps =
        FloatToInt32(
            requestedRate);

    previousRate =
        requestedRate;

    g_debug_motor_actual_angle_x100 =
        FloatToInt32(
            MotorPulseToAngle(
                g_motor_current_pulse) *
            100.0f);
}


/*==============================================================
 * 23. SysTick中断
 *==============================================================*/

void SysTick_Handler(void)
{
    static uint32_t millisecondDivider = 0U;
    static uint32_t compensationDivider = 0U;
    static uint32_t motorControlDivider = 0U;

    /* STEP脉冲服务10kHz。 */
    StepPulseService100us();

    /* 毫秒计时。 */
    millisecondDivider++;

    if (millisecondDivider >= 10U)
    {
        millisecondDivider = 0U;
        g_system_ms++;
    }

    /* JY60补偿控制100Hz。 */
    compensationDivider++;

    if (compensationDivider >=
        COMPENSATION_CONTROL_INTERVAL_TICKS)
    {
        compensationDivider = 0U;
        g_compensation_control_due = 1U;
    }

    /* 电机位置控制1kHz。 */
    motorControlDivider++;

    if (motorControlDivider >=
        MOTOR_CONTROL_INTERVAL_TICKS)
    {
        motorControlDivider = 0U;
        g_motor_control_due = 1U;
    }
}


/*==============================================================
 * 24. 主函数
 *==============================================================*/

int main(void)
{
    uint8_t compensationControlDue;
    uint8_t motorControlDue;

    SYSCFG_DL_init();

    StepperGPIOInit();

    /* 上电先关闭D36A。 */
    StepperEnable(0U);

    /*
     * 只打开JY60 UART1接收中断。
     * 本程序没有K230 UART0中断。
     */
    DL_UART_Main_enableInterrupt(
        JY60_UART_INST,
        DL_UART_MAIN_INTERRUPT_RX);

    NVIC_ClearPendingIRQ(
        JY60_UART_INST_INT_IRQN);

    NVIC_EnableIRQ(
        JY60_UART_INST_INT_IRQN);

    /* 开启10kHz SysTick。 */
    if (SysTick_Config(
            CPUCLK_FREQ /
            SYSTICK_FREQUENCY_HZ) != 0U)
    {
        while (1)
        {
            __WFI();
        }
    }

    __enable_irq();

    /*
     * 前2秒保持静止并手动调平。
     * 此时UART中断持续接收JY60数据并累计零偏。
     */
    DelayMs(
        START_DELAY_MS);

    FinishJY60Calibration();

    /*
     * 把当前机械水平位置作为软件零点。
     * 本程序没有编码器，位置由已发送的STEP脉冲累计估算。
     */
    g_motor_current_pulse = 0;
    g_motor_target_pulse = 0;
    g_step_rate_sps = 0;

    g_vehicle_accel_filtered_g = 0.0f;
    g_vehicle_comp_target_angle_deg = 0.0f;
    g_vehicle_comp_angle_deg = 0.0f;
    g_motor_command_angle_deg = MOTOR_LEVEL_OFFSET_DEG;

    g_debug_comp_target_angle_x100 = 0;

    g_debug_motor_command_angle_x100 =
        FloatToInt32(
            MOTOR_LEVEL_OFFSET_DEG *
            100.0f);

    g_debug_motor_actual_angle_x100 = 0;

    /* 使能D36A并锁轴。 */
    StepperEnable(1U);

    DelayMs(
        ENABLE_SETTLE_MS);

    while (1)
    {
        /*
         * 读取并清除100Hz补偿控制标志。
         */
        __disable_irq();

        compensationControlDue =
            g_compensation_control_due;

        if (compensationControlDue != 0U)
        {
            g_compensation_control_due = 0U;
        }

        __enable_irq();

        if (compensationControlDue != 0U)
        {
            UpdateJY60Compensation100Hz();
        }

        /*
         * 读取并清除1kHz电机位置控制标志。
         */
        __disable_irq();

        motorControlDue =
            g_motor_control_due;

        if (motorControlDue != 0U)
        {
            g_motor_control_due = 0U;
        }

        __enable_irq();

        if (motorControlDue != 0U)
        {
            MotorPositionControl1ms(
                g_motor_command_angle_deg);
        }

        __WFI();
    }
}
