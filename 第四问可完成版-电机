 * 越大响应越快，但噪声也越明显。
 * 推荐范围：0.25～0.50。
 */
#define VEHICLE_START_FILTER_ALPHA          (0.80f)

/*
 * 减速/停车滤波系数。
 * 停车通常更突然，所以设置得更大。
 * 推荐范围：0.40～0.70。
 */
#define VEHICLE_STOP_FILTER_ALPHA           (0.65f)

/*
 * 小于0.015g约等于0.147m/s²，视为噪声。
 * 原点附近电机频繁小动时可适当增大。
 */
#define VEHICLE_ACCEL_DEADBAND_G            (0.015f)

/* 最大只使用±0.30g进行计算。 */
#define VEHICLE_ACCEL_LIMIT_G               (0.30f)

/*
 * 启动/加速补偿增益。
 *
 * 启动时钢球仍明显向后移动：逐步增大。
 * 启动时钢球反而明显向前移动：逐步减小。
 */
#define VEHICLE_START_COMPENSATION_GAIN     (6.00f)

/*
 * 减速/停车补偿增益。
 *
 * 停车时钢球仍向车头冲：逐步增大。
 * 停车时钢球反而向车尾冲：逐步减小。
 *
 * 原代码为8.00，先保留。
 */
#define VEHICLE_STOP_COMPENSATION_GAIN      (8.00f)

/* JY60补偿角最多使用±8°。 */
#define VEHICLE_COMPENSATION_MAX_ANGLE_DEG  (8.0f)

/* 启动补偿角最大变化速度。 */
#define VEHICLE_START_SLEW_DEG_S            (520.0f)

/* 停车补偿角最大变化速度。 */
