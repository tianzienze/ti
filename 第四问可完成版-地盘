    OLED_WriteCommand(0x40U);
    OLED_WriteCommand(0x8DU);
    OLED_WriteCommand(0x14U);
    OLED_WriteCommand(0xAFU);

    OLED_Clear();

    OLED_WriteFixedText(
        2U,
        40U,
        "RUN TIME",
        8U);
}

static void OLED_ShowElapsedTime(uint32_t elapsed_ms)
{
    char text[8];

    uint32_t total_centiseconds =
        elapsed_ms / 10U;

    uint32_t minutes =
        total_centiseconds / 6000U;

    uint32_t seconds =
        (total_centiseconds / 100U) % 60U;

    uint32_t centiseconds =
        total_centiseconds % 100U;

    if (minutes > 99U) minutes = 99U;

    text[0] = (char)('0' + minutes / 10U);
    text[1] = (char)('0' + minutes % 10U);
    text[2] = ':';
    text[3] = (char)('0' + seconds / 10U);
    text[4] = (char)('0' + seconds % 10U);
    text[5] = '.';
    text[6] = (char)('0' + centiseconds / 10U);
    text[7] = (char)('0' + centiseconds % 10U);

    OLED_WriteFixedText(
        4U,
        40U,
        text,
        8U);
}


/*======================== 任务控制 ========================*/

static void Mission_StartFromA(void)
{
    Motor_StopImmediately();

    g_last_valid_error = 0;
    g_filtered_error = 0;
    g_previous_filtered_error = 0;

    g_sensor_fail_count = 0U;
    g_b_detect_count = 0U;
    g_center_line_seen = 0U;
    g_final_elapsed_ms = 0U;

    OLED_ShowElapsedTime(0U);

    g_mission_start_ms = g_system_ms;
    g_last_oled_refresh_ms = g_system_ms;

    g_mission_state = MISSION_ORIGINAL_RUNNING;

    DL_GPIO_setPins(
        STATUS_LED_PORT,
        STATUS_LED_PIN);
}

static void Mission_BeginFinalSoftStop(int16_t current_base_pwm)
{
    if (g_mission_state == MISSION_FINAL_SOFT_STOP)
    {
        return;
    }

    current_base_pwm =
        ClampI16(
            current_base_pwm,
            MOTOR_MIN_EFFECTIVE_PWM,
            MOTOR_BASE_PWM);

    g_final_stop_start_pwm = current_base_pwm;
    g_final_stop_start_ms = g_system_ms;
    g_mission_state = MISSION_FINAL_SOFT_STOP;
}

static void Mission_Finish(void)
{
    if (g_mission_state != MISSION_WAITING)
    {
        g_final_elapsed_ms =
            g_system_ms - g_mission_start_ms;
    }
    else
    {
        g_final_elapsed_ms = 0U;
    }

    g_mission_state = MISSION_FINISHED;

    Motor_StopImmediately();

    DL_GPIO_clearPins(
        STATUS_LED_PORT,
        STATUS_LED_PIN);

    OLED_ShowElapsedTime(g_final_elapsed_ms);
}

static void Mission_Control(uint8_t raw_bits)
{
    uint32_t run_time_ms =
        g_system_ms - g_mission_start_ms;

    int16_t approach_base_pwm;

    Mission_UpdateCenterLineSeen(raw_bits);

    if (g_mission_state == MISSION_FINISHED)
    {
        Motor_StopImmediately();
        return;
    }

    /*
     * 起步阶段：预紧、破静摩擦、回落、S形加速，
     * 同时逐渐放开循迹修正，降低小球受到的冲击。
     */
    if (run_time_ms < STARTUP_CONTROL_TIME_MS)
    {
        g_mission_state = MISSION_ORIGINAL_RUNNING;
        g_b_detect_count = 0U;

        StartupLineFollow_Control(
            raw_bits,
            run_time_ms);
        return;
    }

    /* 起步结束到5秒之间，恢复原来的正常PD循迹。 */
    if (run_time_ms < ORIGINAL_RUN_TIME_MS)
    {
        g_mission_state = MISSION_ORIGINAL_RUNNING;
        g_b_detect_count = 0U;

        LineFollow_Control(raw_bits);
        return;
    }

    /*
     * 5秒以后逐渐减速并检测右弯。
     */
    if ((g_mission_state == MISSION_ORIGINAL_RUNNING) ||
        (g_mission_state == MISSION_APPROACH_DECEL))
    {
        g_mission_state = MISSION_APPROACH_DECEL;

        approach_base_pwm =
            GetApproachBasePWM(run_time_ms);

        if (run_time_ms >= MISSION_MAX_RUN_TIME_MS)
        {
            Mission_BeginFinalSoftStop(
                approach_base_pwm);
        }
        else if (Mission_DetectBPoint(
                     raw_bits,
                     run_time_ms))
        {
            Mission_BeginFinalSoftStop(
                approach_base_pwm);
        }
        else
        {
            DecelLineFollow_Control(
                raw_bits,
                approach_base_pwm);

            return;
        }
    }

    /*
     * 检测到右弯以后再用900ms平滑停车。
     */
    if (g_mission_state == MISSION_FINAL_SOFT_STOP)
    {
        uint32_t stop_elapsed_ms =
            g_system_ms - g_final_stop_start_ms;

        if (stop_elapsed_ms >= FINAL_SOFT_STOP_TIME_MS)
        {
            Mission_Finish();
            return;
        }

        DecelLineFollow_Control(
            raw_bits,
            GetFinalStopBasePWM(
                stop_elapsed_ms));
    }
}


/*======================== GPIO初始化 ========================*/

static void ApplicationGPIO_Init(void)
{
    DL_GPIO_clearPins(
        GPIOB,
        LEFT_IN1_PIN |
        RIGHT_IN3_PIN |
        RIGHT_IN4_PIN |
        LEFT_EN_PIN |
        RIGHT_EN_PIN);

    DL_GPIO_clearPins(
        GPIOA,
        LEFT_IN2_PIN |
        STATUS_LED_PIN |
        OLED_SDA_PIN |
        OLED_SCL_PIN);

    DL_GPIO_enableOutput(
        GPIOB,
        LEFT_IN1_PIN |
        RIGHT_IN3_PIN |
        RIGHT_IN4_PIN |
        LEFT_EN_PIN |
        RIGHT_EN_PIN);

    DL_GPIO_enableOutput(
        GPIOA,
        LEFT_IN2_PIN |
        STATUS_LED_PIN);

    DL_GPIO_clearPins(
        LINE_SDA_PORT,
        LINE_SDA_PIN);

    DL_GPIO_clearPins(
        LINE_SCL_PORT,
        LINE_SCL_PIN);

    LineSDA_Release();
    LineSCL_Release();

    DL_GPIO_clearPins(
        OLED_SDA_PORT,
        OLED_SDA_PIN);

    DL_GPIO_clearPins(
        OLED_SCL_PORT,
        OLED_SCL_PIN);

    OLED_SDA_Release();
    OLED_SCL_Release();

    Motor_StopImmediately();
    LineI2C_BusRecover();
}


/*======================== SysTick中断 ========================*/

void SysTick_Handler(void)
{
    if (g_left_pwm > g_pwm_phase)
        DL_GPIO_setPins(LEFT_EN_PORT, LEFT_EN_PIN);
    else
        DL_GPIO_clearPins(LEFT_EN_PORT, LEFT_EN_PIN);

    if (g_right_pwm > g_pwm_phase)
        DL_GPIO_setPins(RIGHT_EN_PORT, RIGHT_EN_PIN);
    else
        DL_GPIO_clearPins(RIGHT_EN_PORT, RIGHT_EN_PIN);

    g_pwm_phase++;

    if (g_pwm_phase >= PWM_PERIOD_COUNT)
    {
        g_pwm_phase = 0U;
    }

    g_control_tick++;

    if (g_control_tick >= CONTROL_INTERVAL_TICKS)
    {
        g_control_tick = 0U;
        g_control_due = 1U;
    }

    g_ms_divider++;

    if (g_ms_divider >= 10U)
    {
        g_ms_divider = 0U;
        g_system_ms++;
    }
}


/*======================== 主函数 ========================*/

int main(void)
{
    uint8_t raw_line_bits = 0U;
    uint32_t display_elapsed_ms;

    SYSCFG_DL_init();
    ApplicationGPIO_Init();

    DL_SYSTICK_config(
        CPUCLK_FREQ /
        SYSTICK_FREQUENCY_HZ);

    DL_SYSTICK_enable();

    OLED_Init();
    OLED_ShowElapsedTime(0U);

    /*
     * 通电后先等待 POWER_ON_START_DELAY_MS。
     * 当前宏定义为1000ms；若要13秒，改成13000U。
     * 等待时间不计入运动时间。
     */
    Motor_StopImmediately();
    g_mission_state = MISSION_WAITING;

    while (g_system_ms < POWER_ON_START_DELAY_MS)
    {
        __WFI();
    }

    Mission_StartFromA();

    while (1)
    {
        /*
         * OLED显示实际运动时间。
         */
        if ((g_mission_state != MISSION_WAITING) &&
            (g_mission_state != MISSION_FINISHED) &&
            ((uint32_t)(g_system_ms -
                        g_last_oled_refresh_ms) >=
             OLED_REFRESH_INTERVAL_MS))
        {
            g_last_oled_refresh_ms = g_system_ms;

            display_elapsed_ms =
                g_system_ms - g_mission_start_ms;

            OLED_ShowElapsedTime(
                display_elapsed_ms);
        }

        if (g_control_due != 0U)
        {
            g_control_due = 0U;

            if (g_mission_state == MISSION_FINISHED)
            {
                Motor_StopImmediately();
            }
            else if (LineSensor_ReadDigital(
                         &raw_line_bits))
            {
                g_sensor_fail_count = 0U;

                DL_GPIO_setPins(
                    STATUS_LED_PORT,
                    STATUS_LED_PIN);

                Mission_Control(
                    raw_line_bits);
            }
            else
            {
                DL_GPIO_clearPins(
                    STATUS_LED_PORT,
                    STATUS_LED_PIN);

                if (g_sensor_fail_count < 255U)
                {
                    g_sensor_fail_count++;
                }

                /*
                 * 连续约100ms通信失败时安全停车。
                 */
                if (g_sensor_fail_count >=
                    SENSOR_FAIL_STOP_COUNT)
                {
                    Mission_Finish();
                }
            }
        }

        __WFI();
    }
}
