/*======================== 柔和起步参数 ========================*/

/*
 * 起步思路：
 *   低PWM预紧 -> S形升到破静摩擦PWM -> 短暂保持 ->
 *   S形回落到低速 -> S形升到正常速度 -> 逐渐放开转向。
 *
 * 这样不会长时间卡在“电机有声音但车不动”的静摩擦区，
 * 也不会从0直接跳到很高PWM而猛推轨道上的小球。
 */
#define STARTUP_PRELOAD_PWM                 (8)
#define STARTUP_BREAKAWAY_PWM               (21)
#define STARTUP_LOW_RUN_PWM                 (12)

#define STARTUP_PRELOAD_TIME_MS             (120U)
#define STARTUP_BREAKAWAY_RAMP_MS            (160U)
#define STARTUP_BREAKAWAY_HOLD_MS            (80U)
#define STARTUP_RELEASE_TIME_MS              (260U)
#define STARTUP_SOFT_ACCEL_TIME_MS           (1000U)
#define STARTUP_STEERING_BLEND_TIME_MS       (600U)

#define STARTUP_BASE_PROFILE_TIME_MS         \
    (STARTUP_PRELOAD_TIME_MS +                \
     STARTUP_BREAKAWAY_RAMP_MS +              \
     STARTUP_BREAKAWAY_HOLD_MS +              \
     STARTUP_RELEASE_TIME_MS +                \
     STARTUP_SOFT_ACCEL_TIME_MS)

#define STARTUP_CONTROL_TIME_MS              \
    (STARTUP_BASE_PROFILE_TIME_MS +           \
     STARTUP_STEERING_BLEND_TIME_MS)

/* 起步时每5ms最多改变1个PWM，避免Motor_RampTo原来的快速跳变。 */
#define STARTUP_PWM_SLEW_STEP                (1)

/* 起步转向修正逐渐由0放开到18，防止刚起步左右轮差速过大。 */
#define STARTUP_RELEASE_CORRECTION_MAX       (4)
#define STARTUP_ACCEL_CORRECTION_MAX         (10)
#define STARTUP_FINAL_CORRECTION_MAX         (18)
#define STARTUP_LOST_TURN_MAX                (3)

/* 两侧电机静摩擦不一致时，只需微调这两个量，通常保持0。 */
