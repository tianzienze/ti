#include "ti_msp_dl_config.h"
#include <stdint.h>

/*
 * MSPM0G3507 八路低速大差速循迹
 *
 * 传感器顺序：
 * S1 = 小车最左侧
 * S8 = 小车最右侧
 *
 * 黑线低电平有效，白色高电平。
 *
 * 已经开始循迹后：
 * 八路全部检测不到黑线，立即永久停车。
 */

/*==================================================
 * 系统参数
 *==================================================*/

#ifndef CPUCLK_FREQ
#define CPUCLK_FREQ                    32000000UL
#endif

#define SYSTICK_FREQUENCY_HZ           10000U
#define PWM_PERIOD_COUNT               100U
#define CONTROL_INTERVAL_TICKS         50U

/*
 * 黑线低电平有效。
 */
#define BLACK_IS_HIGH                  0

/*==================================================
 * 速度参数
 *==================================================*/

/*
 * 直线低速。
 */
#define STRAIGHT_LEFT_PWM              15
#define STRAIGHT_RIGHT_PWM             15

/*
 * 小弯：
 * 外轮14，内轮6。
 */
#define SLIGHT_OUTER_PWM               18
#define SLIGHT_INNER_PWM               10

/*
 * 中弯：
 * 外轮17，内轮2。
 */
#define MEDIUM_OUTER_PWM               20
#define MEDIUM_INNER_PWM               6

/*
 * 急弯：
 * 外轮20，内轮停止。
 */
#define HARD_OUTER_PWM                 20
#define HARD_INNER_PWM                 0

/*
 * 误差分区。
 */
#define CENTER_ERROR_LIMIT             120
#define SLIGHT_ERROR_LIMIT             300
#define MEDIUM_ERROR_LIMIT             500

/*==================================================
 * 左电机
 *
 * PB8  -> IN1
 * PB9  -> IN2
 * PA31 -> ENA
 *==================================================*/

#define LEFT_IN1_PORT                  GPIOB
#define LEFT_IN1_PIN                   DL_GPIO_PIN_8

#define LEFT_IN2_PORT                  GPIOB
#define LEFT_IN2_PIN                   DL_GPIO_PIN_9

#define LEFT_EN_PORT                   GPIOA
#define LEFT_EN_PIN                    DL_GPIO_PIN_31

/*==================================================
 * 右电机
 *
 * PB2  -> IN3
 * PB3  -> IN4
 * PB16 -> ENB
 *==================================================*/

#define RIGHT_IN3_PORT                 GPIOB
#define RIGHT_IN3_PIN                  DL_GPIO_PIN_2

#define RIGHT_IN4_PORT                 GPIOB
#define RIGHT_IN4_PIN                  DL_GPIO_PIN_3

#define RIGHT_EN_PORT                  GPIOB
#define RIGHT_EN_PIN                   DL_GPIO_PIN_16

/*==================================================
 * 八路循迹传感器
 *
 * S1 -> PA23，最左侧
 * S2 -> PB23
 * S3 -> PB21
 * S4 -> PA22
 * S5 -> PB19
 * S6 -> PB17
 * S7 -> PA17
 * S8 -> PA15，最右侧
 *==================================================*/

#define TRACK_S1_PIN                   DL_GPIO_PIN_23
#define TRACK_S2_PIN                   DL_GPIO_PIN_23
#define TRACK_S3_PIN                   DL_GPIO_PIN_21
#define TRACK_S4_PIN                   DL_GPIO_PIN_22
#define TRACK_S5_PIN                   DL_GPIO_PIN_19
#define TRACK_S6_PIN                   DL_GPIO_PIN_17
#define TRACK_S7_PIN                   DL_GPIO_PIN_17
#define TRACK_S8_PIN                   DL_GPIO_PIN_15

#define TRACK_GPIOA_MASK               (TRACK_S1_PIN | \
                                        TRACK_S4_PIN | \
                                        TRACK_S7_PIN | \
                                        TRACK_S8_PIN)

#define TRACK_GPIOB_MASK               (TRACK_S2_PIN | \
                                        TRACK_S3_PIN | \
                                        TRACK_S5_PIN | \
                                        TRACK_S6_PIN)

/*==================================================
 * 电机前进方向
 *==================================================*/

#define LEFT_FORWARD_REVERSE           0
#define RIGHT_FORWARD_REVERSE          0

/*==================================================
 * 调试变量
 *==================================================*/

/*
 * 运行状态：
 *
 * 0   初始化
 * 10  等待第一次检测到黑线
 * 20  正在循迹
 * 99  八路全白，永久停车
 * 900 SysTick配置失败
 */
volatile uint32_t g_run_state = 0U;

/*
 * 原始电平：
 * bit0～bit7对应S1～S8。
 *
 * 白色时通常为255。
 */
volatile uint32_t g_raw_sensor_mask = 0U;

/*
 * 黑线有效状态：
 * 位为1表示检测到黑线。
 *
 * 八路全白时等于0。
 */
volatile uint32_t g_active_sensor_mask = 0U;

volatile uint32_t g_active_sensor_count = 0U;

/*
 * 当前循迹误差：
 *
 * 负数：黑线在左边
 * 正数：黑线在右边
 */
volatile int32_t g_line_error = 0;

volatile int32_t g_left_pwm = 0;
volatile int32_t g_right_pwm = 0;

/*
 * 是否已经检测到过黑线。
 */
volatile uint32_t g_line_armed = 0U;

/*
 * 是否已经永久停车。
 */
volatile uint32_t g_stop_latched = 0U;

volatile uint32_t g_stop_count = 0U;
volatile uint32_t g_systick_heartbeat = 0U;

/*==================================================
 * 内部变量
 *==================================================*/

static volatile uint32_t g_pwm_phase = 0U;
static volatile uint32_t g_control_tick = 0U;
static volatile uint32_t g_control_due = 0U;

static volatile uint32_t g_motor_output_enabled = 0U;
static volatile uint32_t g_detection_enabled = 0U;

/*==================================================
 * 工具函数
 *==================================================*/

static int32_t AbsInt32(int32_t value)
{
    if (value < 0) {
        return -value;
    }

    return value;
}

static int32_t ClampPWM(int32_t pwm)
{
    if (pwm < 0) {
        return 0;
    }

    if (pwm > 100) {
        return 100;
    }

    return pwm;
}

/*==================================================
 * 电机使能
 *==================================================*/

static void LeftMotor_Enable(void)
{
    DL_GPIO_setPins(
        LEFT_EN_PORT,
        LEFT_EN_PIN
    );
}

static void LeftMotor_Disable(void)
{
    DL_GPIO_clearPins(
        LEFT_EN_PORT,
        LEFT_EN_PIN
    );
}

static void RightMotor_Enable(void)
{
    DL_GPIO_setPins(
        RIGHT_EN_PORT,
        RIGHT_EN_PIN
    );
}

static void RightMotor_Disable(void)
{
    DL_GPIO_clearPins(
        RIGHT_EN_PORT,
        RIGHT_EN_PIN
    );
}

/*==================================================
 * 电机GPIO初始化
 *==================================================*/

static void Motor_GPIO_Init(void)
{
    DL_GPIO_clearPins(
        GPIOA,
        LEFT_EN_PIN
    );

    DL_GPIO_clearPins(
        GPIOB,
        LEFT_IN1_PIN |
        LEFT_IN2_PIN |
        RIGHT_IN3_PIN |
        RIGHT_IN4_PIN |
        RIGHT_EN_PIN
    );

    DL_GPIO_enableOutput(
        GPIOA,
        LEFT_EN_PIN
    );

    DL_GPIO_enableOutput(
        GPIOB,
        LEFT_IN1_PIN |
        LEFT_IN2_PIN |
        RIGHT_IN3_PIN |
        RIGHT_IN4_PIN |
        RIGHT_EN_PIN
    );
}

/*==================================================
 * 设置前进方向
 *==================================================*/

static void Motor_SetForwardDirection(void)
{
    LeftMotor_Disable();
    RightMotor_Disable();

#if LEFT_FORWARD_REVERSE == 0

    DL_GPIO_clearPins(
        LEFT_IN2_PORT,
        LEFT_IN2_PIN
    );

    DL_GPIO_setPins(
        LEFT_IN1_PORT,
        LEFT_IN1_PIN
    );

#else

    DL_GPIO_clearPins(
        LEFT_IN1_PORT,
        LEFT_IN1_PIN
    );

    DL_GPIO_setPins(
        LEFT_IN2_PORT,
        LEFT_IN2_PIN
    );

#endif

#if RIGHT_FORWARD_REVERSE == 0

    DL_GPIO_clearPins(
        RIGHT_IN4_PORT,
        RIGHT_IN4_PIN
    );

    DL_GPIO_setPins(
        RIGHT_IN3_PORT,
        RIGHT_IN3_PIN
    );

#else

    DL_GPIO_clearPins(
        RIGHT_IN3_PORT,
        RIGHT_IN3_PIN
    );

    DL_GPIO_setPins(
        RIGHT_IN4_PORT,
        RIGHT_IN4_PIN
    );

#endif
}

/*==================================================
 * 普通停车
 *==================================================*/

static void Motor_Stop(void)
{
    g_motor_output_enabled = 0U;

    g_left_pwm = 0;
    g_right_pwm = 0;

    LeftMotor_Disable();
    RightMotor_Disable();
}

/*==================================================
 * 丢线永久停车
 *==================================================*/

static void Emergency_Stop(void)
{
    if (g_stop_latched == 0U) {
        g_stop_count++;
    }

    g_stop_latched = 1U;
    g_run_state = 99U;

    Motor_Stop();

    /*
     * IN1、IN2、IN3、IN4同时拉低。
     */
    DL_GPIO_clearPins(
        GPIOB,
        LEFT_IN1_PIN |
        LEFT_IN2_PIN |
        RIGHT_IN3_PIN |
        RIGHT_IN4_PIN
    );
}

/*==================================================
 * 设置左右轮PWM
 *==================================================*/

static void Motor_SetPWM(
    int32_t leftPWM,
    int32_t rightPWM)
{
    leftPWM = ClampPWM(leftPWM);
    rightPWM = ClampPWM(rightPWM);

    if (g_stop_latched != 0U) {
        Emergency_Stop();
        return;
    }

    g_left_pwm = leftPWM;
    g_right_pwm = rightPWM;

    __disable_irq();

    if (g_stop_latched == 0U) {
        g_motor_output_enabled = 1U;
    } else {
        g_motor_output_enabled = 0U;
    }

    __enable_irq();
}

/*==================================================
 * 读取八路原始电平
 *==================================================*/

static uint32_t ReadRawSensorMask(void)
{
    uint32_t levelA;
    uint32_t levelB;
    uint32_t mask;

    levelA = DL_GPIO_readPins(
        GPIOA,
        TRACK_GPIOA_MASK
    );

    levelB = DL_GPIO_readPins(
        GPIOB,
        TRACK_GPIOB_MASK
    );

    mask = 0U;

    /*
     * bit0：S1，最左侧。
     */
    if ((levelA & TRACK_S1_PIN) != 0U) {
        mask |= (1UL << 0);
    }

    /*
     * bit1：S2。
     */
    if ((levelB & TRACK_S2_PIN) != 0U) {
        mask |= (1UL << 1);
    }

    /*
     * bit2：S3。
     */
    if ((levelB & TRACK_S3_PIN) != 0U) {
        mask |= (1UL << 2);
    }

    /*
     * bit3：S4。
     */
    if ((levelA & TRACK_S4_PIN) != 0U) {
        mask |= (1UL << 3);
    }

    /*
     * bit4：S5。
     */
    if ((levelB & TRACK_S5_PIN) != 0U) {
        mask |= (1UL << 4);
    }

    /*
     * bit5：S6。
     */
    if ((levelB & TRACK_S6_PIN) != 0U) {
        mask |= (1UL << 5);
    }

    /*
     * bit6：S7。
     */
    if ((levelA & TRACK_S7_PIN) != 0U) {
        mask |= (1UL << 6);
    }

    /*
     * bit7：S8，最右侧。
     */
    if ((levelA & TRACK_S8_PIN) != 0U) {
        mask |= (1UL << 7);
    }

    return mask;
}

/*==================================================
 * 统计有效传感器数量
 *==================================================*/

static uint32_t CountActiveSensors(uint32_t mask)
{
    uint32_t count;
    uint32_t i;

    count = 0U;

    for (i = 0U; i < 8U; i++) {
        if ((mask & (1UL << i)) != 0U) {
            count++;
        }
    }

    return count;
}

/*==================================================
 * 更新传感器状态
 *==================================================*/

static void Sensor_Update(void)
{
    uint32_t rawMask;
    uint32_t activeMask;

    rawMask = ReadRawSensorMask();

    g_raw_sensor_mask = rawMask;

#if BLACK_IS_HIGH == 1

    activeMask = rawMask;

#else

    /*
     * 黑线低电平有效。
     */
    activeMask = (~rawMask) & 0xFFU;

#endif

    g_active_sensor_mask = activeMask;

    g_active_sensor_count =
        CountActiveSensors(activeMask);
}

/*==================================================
 * 计算循迹误差
 *==================================================*/

static int32_t CalculateLineError(uint32_t activeMask)
{
    /*
     * 明确固定传感器方向：
     *
     * S1 = 最左侧  = -700
     * S2          = -500
     * S3          = -300
     * S4          = -100
     * S5          =  100
     * S6          =  300
     * S7          =  500
     * S8 = 最右侧  =  700
     */
    static const int32_t positionWeight[8] = {
        -700,
        -500,
        -300,
        -100,
         100,
         300,
         500,
         700
    };

    uint32_t i;
    uint32_t count;

    int32_t weightedSum;

    count = 0U;
    weightedSum = 0;

    for (i = 0U; i < 8U; i++) {
        if ((activeMask & (1UL << i)) != 0U) {
            weightedSum += positionWeight[i];
            count++;
        }
    }

    if (count == 0U) {
        return 0;
    }

    return weightedSum / (int32_t) count;
}

/*==================================================
 * 低速大差速循迹
 *==================================================*/

static void LineFollow_Update(void)
{
    uint32_t sensorMask;

    int32_t error;
    int32_t absoluteError;

    int32_t leftPWM;
    int32_t rightPWM;

    if (g_stop_latched != 0U) {
        Emergency_Stop();
        return;
    }

    sensorMask = g_active_sensor_mask;

    /*
     * 第一次检测到黑线之前保持停车。
     */
    if (g_line_armed == 0U) {
        g_run_state = 10U;

        Motor_Stop();
        return;
    }

    /*
     * 已经开始循迹后，八路全白立即停车。
     */
    if (sensorMask == 0U) {
        Emergency_Stop();
        return;
    }

    g_run_state = 20U;

    error = CalculateLineError(sensorMask);

    g_line_error = error;
    absoluteError = AbsInt32(error);

    /*
     * 中心区域：
     * 两轮低速直行。
     */
    if (absoluteError <= CENTER_ERROR_LIMIT) {
        leftPWM = STRAIGHT_LEFT_PWM;
        rightPWM = STRAIGHT_RIGHT_PWM;
    }

    /*
     * 小弯。
     */
    else if (absoluteError <= SLIGHT_ERROR_LIMIT) {
        if (error < 0) {
            /*
             * 黑线在左侧：
             * 左轮慢，右轮快，向左转。
             */
            leftPWM = SLIGHT_INNER_PWM;
            rightPWM = SLIGHT_OUTER_PWM;
        } else {
            /*
             * 黑线在右侧：
             * 左轮快，右轮慢，向右转。
             */
            leftPWM = SLIGHT_OUTER_PWM;
            rightPWM = SLIGHT_INNER_PWM;
        }
    }

    /*
     * 中弯。
     */
    else if (absoluteError <= MEDIUM_ERROR_LIMIT) {
        if (error < 0) {
            leftPWM = MEDIUM_INNER_PWM;
            rightPWM = MEDIUM_OUTER_PWM;
        } else {
            leftPWM = MEDIUM_OUTER_PWM;
            rightPWM = MEDIUM_INNER_PWM;
        }
    }

    /*
     * 急弯。
     */
    else {
        if (error < 0) {
            /*
             * S1、S2附近检测到黑线：
             * 左轮停止，右轮转动，向左急转。
             */
            leftPWM = HARD_INNER_PWM;
            rightPWM = HARD_OUTER_PWM;
        } else {
            /*
             * S7、S8附近检测到黑线：
             * 左轮转动，右轮停止，向右急转。
             */
            leftPWM = HARD_OUTER_PWM;
            rightPWM = HARD_INNER_PWM;
        }
    }

    Motor_SetPWM(
        leftPWM,
        rightPWM
    );
}

/*==================================================
 * SysTick中断
 *==================================================*/

void SysTick_Handler(void)
{
    g_systick_heartbeat++;

    /*
     * 每100微秒读取一次八路传感器。
     */
    if (g_detection_enabled != 0U) {
        Sensor_Update();

        /*
         * 第一次检测到黑线后，允许循迹。
         */
        if ((g_line_armed == 0U) &&
            (g_active_sensor_mask != 0U)) {

            g_line_armed = 1U;
        }

        /*
         * 已经开始循迹后八路全白，
         * 立即在中断中停车。
         */
        if ((g_line_armed != 0U) &&
            (g_stop_latched == 0U) &&
            (g_active_sensor_mask == 0U)) {

            Emergency_Stop();
        }
    }

    /*
     * 软件PWM。
     */
    g_pwm_phase++;

    if (g_pwm_phase >= PWM_PERIOD_COUNT) {
        g_pwm_phase = 0U;
    }

    if ((g_motor_output_enabled == 0U) ||
        (g_stop_latched != 0U)) {

        LeftMotor_Disable();
        RightMotor_Disable();
    } else {
        if (g_pwm_phase <
            (uint32_t) g_left_pwm) {

            LeftMotor_Enable();
        } else {
            LeftMotor_Disable();
        }

        if (g_pwm_phase <
            (uint32_t) g_right_pwm) {

            RightMotor_Enable();
        } else {
            RightMotor_Disable();
        }
    }

    /*
     * 每5ms执行一次循迹控制。
     */
    g_control_tick++;

    if (g_control_tick >= CONTROL_INTERVAL_TICKS) {
        g_control_tick = 0U;
        g_control_due = 1U;
    }
}

/*==================================================
 * 主函数
 *==================================================*/

int main(void)
{
    uint32_t systickResult;

    SYSCFG_DL_init();

    Motor_GPIO_Init();
    Motor_SetForwardDirection();
    Motor_Stop();

    g_run_state = 0U;
    g_line_armed = 0U;
    g_stop_latched = 0U;
    g_detection_enabled = 0U;

    systickResult = SysTick_Config(
        CPUCLK_FREQ /
        SYSTICK_FREQUENCY_HZ
    );

    if (systickResult != 0U) {
        g_run_state = 900U;

        Motor_Stop();

        while (1) {
            __WFI();
        }
    }

    /*
     * 上电等待1秒。
     */
    delay_cycles(CPUCLK_FREQ);

    Sensor_Update();

    g_detection_enabled = 1U;
    g_run_state = 10U;

    while (1) {
        if (g_control_due != 0U) {
            __disable_irq();

            g_control_due = 0U;

            __enable_irq();

            LineFollow_Update();
        }

        __WFI();
    }
}
