/*============================================================
 * 基础工具函数
 *============================================================*/

static int16_t ClampI16(
    int16_t value,
    int16_t minimum,
    int16_t maximum)
{
    if (value < minimum)
    {
        return minimum;
    }

    if (value > maximum)
    {
        return maximum;
    }

    return value;
}


static uint8_t AbsToU8(int16_t value)
{
    if (value < 0)
    {
        value = (int16_t)(-value);
    }

    if (value > 100)
    {
        value = 100;
    }

    return (uint8_t)value;
}


static int16_t ApproachI16(
    int16_t current,
    int16_t target,
    int16_t step)
{
    if (current < target)
    {
        current = (int16_t)(current + step);

        if (current > target)
        {
            current = target;
        }
    }
    else if (current > target)
    {
        current = (int16_t)(current - step);

        if (current < target)
        {
            current = target;
        }
    }

    return current;
}


static void ShortDelay(volatile uint32_t loops)
{
    while (loops > 0U)
    {
        __NOP();
        loops--;
    }
}


/*============================================================
 * 左电机方向控制
 *============================================================*/

static void LeftMotor_SetDirection(int16_t command)
{
#if LEFT_MOTOR_REVERSE
    command = (int16_t)(-command);
#endif

    if (command > 0)
    {
        /* 左电机前进。 */
        DL_GPIO_setPins(
            LEFT_IN1_PORT,
            LEFT_IN1_PIN);

        DL_GPIO_clearPins(
            LEFT_IN2_PORT,
            LEFT_IN2_PIN);
    }
    else if (command < 0)
    {
        /* 左电机后退。 */
        DL_GPIO_clearPins(
            LEFT_IN1_PORT,
            LEFT_IN1_PIN);

        DL_GPIO_setPins(
            LEFT_IN2_PORT,
            LEFT_IN2_PIN);
    }
    else
    {
        /* 左电机停止。 */
        DL_GPIO_clearPins(
            LEFT_IN1_PORT,
            LEFT_IN1_PIN);

        DL_GPIO_clearPins(
            LEFT_IN2_PORT,
            LEFT_IN2_PIN);
    }
}


/*============================================================
 * 右电机方向控制
 *============================================================*/

static void RightMotor_SetDirection(int16_t command)
{
#if RIGHT_MOTOR_REVERSE
    command = (int16_t)(-command);
#endif

    if (command > 0)
    {
        /* 右电机前进。 */
        DL_GPIO_setPins(
            RIGHT_IN3_PORT,
            RIGHT_IN3_PIN);

        DL_GPIO_clearPins(
            RIGHT_IN4_PORT,
            RIGHT_IN4_PIN);
    }
    else if (command < 0)
    {
        /* 右电机后退。 */
        DL_GPIO_clearPins(
            RIGHT_IN3_PORT,
            RIGHT_IN3_PIN);

        DL_GPIO_setPins(
            RIGHT_IN4_PORT,
            RIGHT_IN4_PIN);
    }
    else
    {
        /* 右电机停止。 */
        DL_GPIO_clearPins(
            RIGHT_IN3_PORT,
            RIGHT_IN3_PIN);

        DL_GPIO_clearPins(
            RIGHT_IN4_PORT,
            RIGHT_IN4_PIN);
    }
}


/*============================================================
 * 提交电机指令
 *============================================================*/

static void Motor_CommitCommand(
    int16_t left_command,
    int16_t right_command)
{
    uint8_t left_pwm;
    uint8_t right_pwm;

    left_command = ClampI16(
        left_command,
        -100,
        100);

    right_command = ClampI16(
        right_command,
        -100,
        100);

    left_pwm = AbsToU8(left_command);
    right_pwm = AbsToU8(right_command);

    /*
     * PWM太小时电机无法克服静摩擦，
     * 直接按照0处理。
     */
    if ((left_pwm > 0U) &&
        (left_pwm < MOTOR_MIN_EFFECTIVE_PWM))
    {
        left_pwm = 0U;
        left_command = 0;
    }

    if ((right_pwm > 0U) &&
        (right_pwm < MOTOR_MIN_EFFECTIVE_PWM))
    {
        right_pwm = 0U;
        right_command = 0;
    }

    /*
     * 切换方向之前先关闭使能，
     * 防止电机切换时突然冲击。
     */
    __disable_irq();

    DL_GPIO_clearPins(
        LEFT_EN_PORT,
        LEFT_EN_PIN);

    DL_GPIO_clearPins(
        RIGHT_EN_PORT,
        RIGHT_EN_PIN);

    LeftMotor_SetDirection(left_command);
    RightMotor_SetDirection(right_command);

    g_left_pwm = left_pwm;
    g_right_pwm = right_pwm;

    __enable_irq();
}


/*============================================================
 * 平滑改变电机速度
 *============================================================*/

static void Motor_RampTo(
    int16_t left_target,
    int16_t right_target)
{
    uint32_t startup_elapsed;
    int16_t pwm_limit = 100;
    int16_t slew_step = PWM_SLEW_STEP;

    /*
     * 停车线触发后锁存，后续任何循迹指令都不能重新启动。
     */
    if (g_stop_latched)
    {
        g_left_current_cmd = 0;
        g_right_current_cmd = 0;
        Motor_CommitCommand(0, 0);
        return;
    }

    /*
     * 第一次出现非零目标速度时开始计时。
     */
    if ((!g_run_started) &&
        ((left_target != 0) ||
         (right_target != 0)))
    {
        g_run_started = true;
        g_run_elapsed_ms = 0U;
        g_run_start_ms = g_system_ms;
        g_oled_force_refresh = true;
    }

    /*
     * 起步阶段：
     * 1. 前150ms把最大PWM限制在13，避免突然冲出；
     * 2. 随后1050ms线性放开到MOTOR_MAX_PWM；
     * 3. 起步阶段每5ms只改变1个PWM，进一步减小冲击。
     */
    if (g_run_started)
    {
        startup_elapsed =
            g_system_ms - g_run_start_ms;

        if (startup_elapsed <
            STARTUP_HOLD_TIME_MS)
        {
            pwm_limit =
                STARTUP_INITIAL_PWM_LIMIT;

            slew_step =
                STARTUP_SLEW_STEP;
        }
        else if (startup_elapsed <
                 (STARTUP_HOLD_TIME_MS +
                  STARTUP_RAMP_TIME_MS))
        {
            uint32_t ramp_elapsed =
                startup_elapsed -
                STARTUP_HOLD_TIME_MS;

            pwm_limit =
                (int16_t)(
                    STARTUP_INITIAL_PWM_LIMIT +
                    ((uint32_t)(
                        MOTOR_MAX_PWM -
                        STARTUP_INITIAL_PWM_LIMIT) *
                     ramp_elapsed) /
                    STARTUP_RAMP_TIME_MS);

            slew_step =
                STARTUP_SLEW_STEP;
        }
    }

    left_target =
        ClampI16(
            left_target,
            (int16_t)(-pwm_limit),
            pwm_limit);

    right_target =
        ClampI16(
            right_target,
            (int16_t)(-pwm_limit),
            pwm_limit);

    g_left_current_cmd = ApproachI16(
        g_left_current_cmd,
        left_target,
        slew_step);

    g_right_current_cmd = ApproachI16(
        g_right_current_cmd,
        right_target,
        slew_step);

    Motor_CommitCommand(
        g_left_current_cmd,
        g_right_current_cmd);
}


/*============================================================
 * 立即停车
 *============================================================*/

static void Motor_StopImmediately(void)
{
    g_left_current_cmd = 0;
    g_right_current_cmd = 0;

    Motor_CommitCommand(0, 0);
}


/*============================================================
 * 软件I2C
 *
 * I2C要求开漏输出：
 *
 * 输出低电平：
 *   将GPIO设置为输出，并输出0。
 *
 * 输出高电平：
 *   将GPIO切换为输入，释放总线，
 *   由外部上拉电阻拉高。
 *============================================================*/

static void I2C_Delay(void)
{
    ShortDelay(SOFT_I2C_DELAY_LOOPS);
}


/*---------------- SDA控制 ----------------*/

static void SDA_DriveLow(void)
{
    DL_GPIO_clearPins(
        LINE_SDA_PORT,
        LINE_SDA_PIN);

    DL_GPIO_enableOutput(
        LINE_SDA_PORT,
        LINE_SDA_PIN);
}


static void SDA_Release(void)
{
    DL_GPIO_disableOutput(
        LINE_SDA_PORT,
        LINE_SDA_PIN);
}


static bool SDA_Read(void)
{
    return (
        (DL_GPIO_readPins(
            LINE_SDA_PORT,
            LINE_SDA_PIN) &
         LINE_SDA_PIN) != 0U);
}


/*---------------- SCL控制 ----------------*/

static void SCL_DriveLow(void)
{
    DL_GPIO_clearPins(
        LINE_SCL_PORT,
        LINE_SCL_PIN);

    DL_GPIO_enableOutput(
        LINE_SCL_PORT,
        LINE_SCL_PIN);
}


static void SCL_Release(void)
{
    DL_GPIO_disableOutput(
        LINE_SCL_PORT,
        LINE_SCL_PIN);
}


static bool SCL_Read(void)
{
    return (
        (DL_GPIO_readPins(
            LINE_SCL_PORT,
            LINE_SCL_PIN) &
         LINE_SCL_PIN) != 0U);
}


/*============================================================
 * 释放SCL并等待其真正变成高电平
 *============================================================*/

static bool SCL_ReleaseAndWaitHigh(void)
{
    uint32_t timeout =
        SOFT_I2C_CLOCK_STRETCH_TIMEOUT;

    SCL_Release();

    while (timeout > 0U)
    {
        if (SCL_Read())
        {
            return true;
        }

        timeout--;
    }

    return false;
}


/*============================================================
 * I2C停止信号
 *============================================================*/

static void SoftI2C_Stop(void)
{
    SDA_DriveLow();
    I2C_Delay();

    (void)SCL_ReleaseAndWaitHigh();
    I2C_Delay();

    SDA_Release();
    I2C_Delay();
}


/*============================================================
 * I2C起始或重复起始信号
 *============================================================*/

static bool SoftI2C_Start(void)
{
    SDA_Release();

    if (!SCL_ReleaseAndWaitHigh())
    {
        return false;
    }

    I2C_Delay();

    /*
     * SCL和SDA均应该为高电平。
     * 如果SDA仍然是低电平，说明总线被占用。
     */
    if (!SDA_Read())
    {
        return false;
    }

    SDA_DriveLow();
    I2C_Delay();

    SCL_DriveLow();
    I2C_Delay();

    return true;
}


/*============================================================
 * I2C发送一个字节
 *============================================================*/

static bool SoftI2C_WriteByte(uint8_t data)
{
    uint8_t i;
    bool ack;

    for (i = 0U; i < 8U; i++)
    {
        if ((data & 0x80U) != 0U)
        {
            SDA_Release();
        }
        else
        {
            SDA_DriveLow();
        }

        I2C_Delay();

        if (!SCL_ReleaseAndWaitHigh())
        {
            SCL_DriveLow();
            SDA_Release();

            return false;
        }

        I2C_Delay();

        SCL_DriveLow();
        I2C_Delay();

        data <<= 1U;
    }

    /*
     * 第9个时钟读取ACK。
     * 从机拉低SDA代表应答。
     */
    SDA_Release();
    I2C_Delay();

    if (!SCL_ReleaseAndWaitHigh())
    {
        SCL_DriveLow();

        return false;
    }

    I2C_Delay();

    ack = !SDA_Read();

    SCL_DriveLow();
    I2C_Delay();

    return ack;
}


/*============================================================
 * I2C读取一个字节
 *============================================================*/

static bool SoftI2C_ReadByte(
    uint8_t *data,
    bool send_ack)
{
    uint8_t i;
    uint8_t value = 0U;

    if (data == (void *)0)
    {
        return false;
    }

    SDA_Release();

    for (i = 0U; i < 8U; i++)
    {
        value <<= 1U;

        I2C_Delay();

        if (!SCL_ReleaseAndWaitHigh())
        {
            SCL_DriveLow();

            return false;
        }

        I2C_Delay();

        if (SDA_Read())
        {
            value |= 0x01U;
        }

        SCL_DriveLow();
        I2C_Delay();
    }

    /*
     * 继续读取时发送ACK；
     * 最后一个字节发送NACK。
     */
    if (send_ack)
    {
        SDA_DriveLow();
    }
    else
    {
        SDA_Release();
    }

    I2C_Delay();

    if (!SCL_ReleaseAndWaitHigh())
    {
        SCL_DriveLow();
        SDA_Release();

        return false;
    }

    I2C_Delay();

    SCL_DriveLow();
    SDA_Release();
    I2C_Delay();

    *data = value;

    return true;
}


/*============================================================
 * I2C总线恢复
 *============================================================*/

static void SoftI2C_BusRecover(void)
{
    uint8_t i;

    SDA_Release();
    SCL_Release();

    I2C_Delay();

    /*
     * SDA被从机一直拉低时，
     * 发送9个恢复时钟。
     */
    for (i = 0U; i < 9U; i++)
    {
        SCL_DriveLow();
        I2C_Delay();

        SCL_Release();
        I2C_Delay();
    }

    SoftI2C_Stop();
}


/*============================================================
 * 读取六路巡线数字结果
 *============================================================*/

static bool LineSensor_ReadDigital(
    uint8_t *digital_result)
{
    uint8_t attempt;
    uint8_t value = 0U;

    if (digital_result == (void *)0)
    {
        return false;
    }

    /*
     * 每次最多尝试3次，
     * 增强I2C通信稳定性。
     */
    for (attempt = 0U;
         attempt < 3U;
         attempt++)
    {
        /*
         * 起始信号。
         */
        if (!SoftI2C_Start())
        {
            SoftI2C_BusRecover();
            continue;
        }

        /*
         * 发送从机地址，写方向：
         *
         * 0x5C << 1 = 0xB8。
         */
        if (!SoftI2C_WriteByte(
                (uint8_t)(
                    LINE_SENSOR_I2C_ADDRESS
                    << 1U)))
        {
            SoftI2C_Stop();
            continue;
        }

        /*
         * 发送需要读取的寄存器地址0x05。
         */
        if (!SoftI2C_WriteByte(
                LINE_SENSOR_DIGITAL_REGISTER))
        {
            SoftI2C_Stop();
            continue;
        }

        /*
         * 重复起始信号。
         */
        if (!SoftI2C_Start())
        {
            SoftI2C_Stop();
            continue;
        }

        /*
         * 发送从机地址，读方向：
         *
         * 0xB8 | 1 = 0xB9。
         */
        if (!SoftI2C_WriteByte(
                (uint8_t)(
                    (LINE_SENSOR_I2C_ADDRESS
                     << 1U) |
                    0x01U)))
        {
            SoftI2C_Stop();
            continue;
        }

        /*
         * 只读取1字节。
         * 最后一个字节发送NACK。
         */
        if (!SoftI2C_ReadByte(
                &value,
                false))
        {
            SoftI2C_Stop();
            continue;
        }

        SoftI2C_Stop();

        /*
         * 只保留低6位。
         */
        *digital_result =
            (uint8_t)(value & 0x3FU);

        return true;
    }

    SoftI2C_BusRecover();

    return false;
}


/*============================================================
 * 反转六个bit
 *============================================================*/

static uint8_t Reverse6Bits(uint8_t value)
{
    uint8_t result = 0U;
    uint8_t i;

    value &= 0x3FU;

    for (i = 0U; i < 6U; i++)
    {
        if ((value &
             (uint8_t)(1U << i)) != 0U)
        {
            result |=
                (uint8_t)(
                    1U << (5U - i));
        }
    }

    return result;
}


/*============================================================
 * 将传感器结果统一为：
 *
 * bit0 = 小车最左侧
 * bit1 = 左中
 * bit2 = 左内
 * bit3 = 右内
 * bit4 = 右中
 * bit5 = 小车最右侧
 *============================================================*/

static uint8_t NormalizeLineBits(
    uint8_t raw_bits)
{
    uint8_t bits =
        (uint8_t)(raw_bits & 0x3FU);

#if (LINE_DETECTED_IS_1 == 0)

    bits =
        (uint8_t)((~bits) & 0x3FU);

#endif

    /*
     * 手册中通道1在物理最右边，
     * 通道6在物理最左边。
     *
     * 所以先将6bit反转。
     */
    bits = Reverse6Bits(bits);

#if SENSOR_INSTALL_REVERSE

    /*
     * 如果传感器在车上左右装反，
     * 再反转一次。
     */
    bits = Reverse6Bits(bits);

#endif

    return bits;
}


/*============================================================
 * 计算六路巡线误差
 *============================================================*/

static bool CalculateLineError(
    uint8_t line_bits,
    int16_t *error)
{
    /*
     * 从小车左侧到右侧：
     *
     * bit0  bit1  bit2  bit3  bit4  bit5
     * -500  -300  -100  +100  +300  +500
     */
    static const int16_t weights[6] =
    {
        -500,
        -300,
        -100,
         100,
         300,
         500
    };

    int32_t weighted_sum = 0;
    uint8_t active_count = 0U;
    uint8_t i;

    if (error == (void *)0)
    {
        return false;
    }

    for (i = 0U; i < 6U; i++)
    {
        if ((line_bits &
             (uint8_t)(1U << i)) != 0U)
        {
            weighted_sum += weights[i];
            active_count++;
        }
    }

    if (active_count == 0U)
    {
        return false;
    }

    /*
     * 多路同时压线时取平均位置。
     */
    *error =
        (int16_t)(
            weighted_sum /
            (int32_t)active_count);

    return true;
}


/*============================================================
 * 丢线处理
 *============================================================*/

static void LineLost_Control(void)
{
    int16_t left_target;
    int16_t right_target;
    int16_t hold_correction;

    if (g_line_lost_count < 255U)
    {
        g_line_lost_count++;
    }

    /*
     * 刚刚丢线的约20ms内，不立即做大幅找线。
     * 先保持上一次圆弧，避免传感器在弯道缝隙中短暂丢线时顿挫。
     */
    if (g_line_lost_count <=
        LOST_LINE_HOLD_CYCLES)
    {
        hold_correction =
            g_smoothed_correction;

        if ((hold_correction == 0) &&
            (g_curve_direction != 0))
        {
            hold_correction =
                (int16_t)(
                    g_curve_direction *
                    CURVE_CENTER_HOLD_CORRECTION);
        }

        left_target =
            (int16_t)(
                MOTOR_CURVE_BASE_PWM +
                hold_correction);

        right_target =
            (int16_t)(
                MOTOR_CURVE_BASE_PWM -
                hold_correction);

        left_target =
            ClampI16(
                left_target,
                VISIBLE_LINE_INNER_MIN_PWM,
                MOTOR_MAX_PWM);

        right_target =
            ClampI16(
                right_target,
                VISIBLE_LINE_INNER_MIN_PWM,
                MOTOR_MAX_PWM);

        Motor_RampTo(
            left_target,
            right_target);

        return;
    }

    /*
     * 丢线持续后，按照最后的弯道方向或最后有效误差找线。
     * 内轮仍保留9 PWM，不做突然原地转向。
     */
    if ((g_curve_direction < 0) ||
        (g_last_valid_error < -60))
    {
        left_target =
            LOST_LINE_INNER_PWM;

        right_target =
            LOST_LINE_OUTER_PWM;
    }
    else if ((g_curve_direction > 0) ||
             (g_last_valid_error > 60))
    {
        left_target =
            LOST_LINE_OUTER_PWM;

        right_target =
            LOST_LINE_INNER_PWM;
    }
    else
    {
        left_target =
            LOST_LINE_STRAIGHT_PWM;

        right_target =
            LOST_LINE_STRAIGHT_PWM;
    }

    Motor_RampTo(
        left_target,
        right_target);
}


/*============================================================
 * 统计六路中检测到黑线的数量
 *============================================================*/

static uint8_t CountBlackBits(uint8_t line_bits)
{
    uint8_t count = 0U;
    uint8_t i;

    line_bits &= 0x3FU;

    for (i = 0U; i < 6U; i++)
    {
        if ((line_bits &
             (uint8_t)(1U << i)) != 0U)
        {
            count++;
        }
    }

    return count;
}


/*============================================================
 * 锁存停车
 *============================================================*/

static void StopSystem_Latch(void)
{
    if (!g_stop_latched)
    {
        g_stop_latched = true;
        g_stop_confirm_count = 0U;

        Motor_StopImmediately();

        DL_GPIO_clearPins(
            STATUS_LED_PORT,
            STATUS_LED_PIN);

        g_oled_force_refresh = true;
    }
}


/*============================================================
 * 判断中间两路是否已经稳定抓住黑线
 *
 * bit2 = 左内，bit3 = 右内。
 * 允许左中/右中也同时检测，但最外侧bit0/bit5不能压线。
 *============================================================*/

static bool IsStrongCenterLock(uint8_t line_bits)
{
    bool center_pair;
    bool far_outer_active;

    center_pair =
        ((line_bits & 0x0CU) == 0x0CU);

    far_outer_active =
        ((line_bits & 0x21U) != 0U);

    return
        center_pair &&
        (!far_outer_active);
}


/*============================================================
 * 判断最外侧传感器是否压线
 *============================================================*/

static bool IsFarOuterActive(uint8_t line_bits)
{
    return
        ((line_bits & 0x21U) != 0U);
}


/*============================================================
 * 更新弯道状态
 *
 * 弯道进入快、退出慢，形成滞环。
 * 这样中间两路在圆弧上短暂同时压线时，
 * 不会立刻把转向量清零而冲出黑线。
 *============================================================*/

static void UpdateCurveState(
    uint8_t line_bits,
    int16_t current_error,
    bool strong_center)
{
    int16_t abs_error;

    abs_error =
        current_error;

    if (abs_error < 0)
    {
        abs_error =
            (int16_t)(-abs_error);
    }

    /*
     * 最外侧压线或误差较大时，立即进入弯道。
     */
    if (IsFarOuterActive(line_bits) ||
        (abs_error >= CURVE_ENTER_ERROR))
    {
        g_curve_mode = true;
        g_center_lock_count = 0U;
        g_curve_exit_recovery_count = 0U;

        if (current_error < 0)
        {
            g_curve_direction = -1;
        }
        else if (current_error > 0)
        {
            g_curve_direction = 1;
        }
        else if (g_last_valid_error < 0)
        {
            g_curve_direction = -1;
        }
        else if (g_last_valid_error > 0)
        {
            g_curve_direction = 1;
        }

        return;
    }

    if (g_curve_mode)
    {
        /*
         * 必须中间两路连续稳定抓线约40ms，
         * 且误差已经较小，才确认真正离开圆弧。
         */
        if (strong_center &&
            (abs_error <= CURVE_EXIT_ERROR))
        {
            if (g_center_lock_count <
                CURVE_EXIT_CENTER_CONFIRM_CYCLES)
            {
                g_center_lock_count++;
            }
        }
        else
        {
            g_center_lock_count = 0U;
        }

        if (g_center_lock_count >=
            CURVE_EXIT_CENTER_CONFIRM_CYCLES)
        {
            g_curve_mode = false;
            g_center_lock_count = 0U;

            g_curve_exit_recovery_count =
                CURVE_EXIT_RECOVERY_CYCLES;
        }
    }
    else
    {
        g_center_lock_count = 0U;

        if (g_curve_exit_recovery_count > 0U)
        {
            g_curve_exit_recovery_count--;
        }
    }
}


/*============================================================
 * 平滑转向修正量
 *============================================================*/

static int16_t SmoothSteeringCorrection(
    int16_t target_correction)
{
    int16_t step;
    bool same_direction;
    bool increasing_magnitude;

    same_direction =
        (((g_smoothed_correction >= 0) &&
          (target_correction >= 0)) ||
         ((g_smoothed_correction <= 0) &&
          (target_correction <= 0)));

    increasing_magnitude =
        (
            ((target_correction >= 0) ?
             target_correction :
             (int16_t)(-target_correction))
            >
            ((g_smoothed_correction >= 0) ?
             g_smoothed_correction :
             (int16_t)(-g_smoothed_correction))
        );

    /*
     * 同方向进入弯道时快速建立修正；
     * 出弯或释放转向时最慢；
     * 方向翻转时使用普通速度，避免突然左右打满。
     */
    if (same_direction &&
        increasing_magnitude)
    {
        step =
            STEERING_SLEW_ENTER_STEP;
    }
    else if (target_correction == 0)
    {
        step =
            STEERING_SLEW_RELEASE_STEP;
    }
    else
    {
        step =
            STEERING_SLEW_NORMAL_STEP;
    }

    g_smoothed_correction =
        ApproachI16(
            g_smoothed_correction,
            target_correction,
            step);

    return
        g_smoothed_correction;
}


/*============================================================
 * 六路循迹控制
 *============================================================*/

static void LineFollow_Control(
    uint8_t raw_bits)
{
    uint8_t line_bits;

    int16_t current_error;
    int16_t raw_delta_error;
    int16_t correction_target;
    int16_t correction_limit;
    int16_t correction;

    int16_t dynamic_base_pwm;
    int16_t left_target;
    int16_t right_target;

    int16_t abs_error;

    int32_t correction_32;

    bool strong_center;

    line_bits =
        NormalizeLineBits(raw_bits);

    g_last_line_bits =
        line_bits;

    /*
     * 停车线检测逻辑保持不变。
     */
    g_black_sensor_count =
        CountBlackBits(line_bits);

    if (g_black_sensor_count >=
        STOP_BLACK_MIN_COUNT)
    {
        if (g_stop_confirm_count <
            STOP_CONFIRM_COUNT)
        {
            g_stop_confirm_count++;
        }

        if (g_stop_confirm_count >=
            STOP_CONFIRM_COUNT)
        {
            StopSystem_Latch();
            return;
        }
    }
    else
    {
        g_stop_confirm_count = 0U;
    }

    /*
     * 六路全部丢线。
     */
    if (line_bits == 0U)
    {
        LineLost_Control();
        return;
    }

    /*
     * 重新检测到线，清除丢线计数。
     */
    g_line_lost_count = 0U;

    if (line_bits == 0x3FU)
    {
#if STOP_ON_ALL_BLACK

        Motor_StopImmediately();
        return;

#else

        current_error = 0;

#endif
    }
    else if (!CalculateLineError(
                 line_bits,
                 &current_error))
    {
        LineLost_Control();
        return;
    }

    strong_center =
        IsStrongCenterLock(
            line_bits);

    /*
     * 更新弯道状态。
     *
     * 注意必须在覆盖中心误差之前调用，
     * 否则无法判断弯道是否真正结束。
     */
    UpdateCurveState(
        line_bits,
        current_error,
        strong_center);

    /*
     * 非弯道且中间两路已经抓稳时，
     * 直接把期望误差设为0，让车辆沿黑线中心向前。
     *
     * 弯道状态下不强制清零，
     * 避免在圆弧中间两路短暂压线时过早直行。
     */
    if (strong_center &&
        (!g_curve_mode))
    {
        current_error = 0;
    }

    g_last_valid_error =
        current_error;

    abs_error =
        current_error;

    if (abs_error < 0)
    {
        abs_error =
            (int16_t)(-abs_error);
    }

    /*
     * 误差滤波：
     *
     * 弯道中使用1/2新误差，提高跟弯速度；
     * 直线和出弯阶段使用1/4新误差，减少摇头。
     */
    if (g_curve_mode)
    {
        g_filtered_error =
            (int16_t)(
                (
                    (int32_t)g_filtered_error +
                    current_error
                ) /
                2);
    }
    else
    {
        g_filtered_error =
            (int16_t)(
                (
                    (int32_t)g_filtered_error * 3 +
                    current_error
                ) /
                4);
    }

    raw_delta_error =
        (int16_t)(
            g_filtered_error -
            g_previous_filtered_error);

    g_previous_filtered_error =
        g_filtered_error;

    /*
     * 对D项再做一次低通。
     * 这是C点出弯后抑制左右摇晃的关键之一。
     */
    g_filtered_delta_error =
        (int16_t)(
            (
                (int32_t)g_filtered_delta_error *
                DERIVATIVE_FILTER_OLD_WEIGHT +
                raw_delta_error
            ) /
            DERIVATIVE_FILTER_TOTAL_WEIGHT);

    correction_32 =
        ((int32_t)g_filtered_error *
         LINE_KP_NUM) /
        LINE_KP_DEN +

        ((int32_t)g_filtered_delta_error *
         LINE_KD_NUM) /
        LINE_KD_DEN;

    /*
     * 根据状态决定基础速度和最大转向量。
     */
    if (g_curve_mode)
    {
        if (abs_error >=
            CURVE_SHARP_ERROR)
        {
            dynamic_base_pwm =
                MOTOR_SHARP_CURVE_BASE_PWM;
        }
        else
        {
            dynamic_base_pwm =
                MOTOR_CURVE_BASE_PWM;
        }

        correction_limit =
            CURVE_MAX_CORRECTION;
    }
    else if (g_curve_exit_recovery_count >
             0U)
    {
        dynamic_base_pwm =
            MOTOR_CURVE_EXIT_BASE_PWM;

        correction_limit =
            CURVE_EXIT_MAX_CORRECTION;
    }
    else
    {
        dynamic_base_pwm =
            MOTOR_BASE_PWM;

        correction_limit =
            STRAIGHT_MAX_CORRECTION;
    }

    correction_target =
        ClampI16(
            (int16_t)correction_32,
            (int16_t)(-correction_limit),
            correction_limit);

    /*
     * 圆弧中间两路短暂同时压线时，
     * 保留小转向量继续沿圆弧走。
     *
     * 只有中间两路连续抓稳达到确认时间，
     * 弯道状态才会退出。
     */
    if (g_curve_mode &&
        strong_center &&
        (g_curve_direction != 0))
    {
        int16_t hold_correction;

        hold_correction =
            (int16_t)(
                g_curve_direction *
                CURVE_CENTER_HOLD_CORRECTION);

        if (g_curve_direction > 0)
        {
            if (correction_target <
                hold_correction)
            {
                correction_target =
                    hold_correction;
            }
        }
        else
        {
            if (correction_target >
                hold_correction)
            {
                correction_target =
                    hold_correction;
            }
        }
    }

    /*
     * 出弯恢复阶段，只要中间两路抓住黑线，
     * 就平滑释放到0，不允许立刻反向打方向。
     */
    if ((!g_curve_mode) &&
        (g_curve_exit_recovery_count > 0U) &&
        strong_center)
    {
        correction_target = 0;
    }

    correction =
        SmoothSteeringCorrection(
            correction_target);

    left_target =
        (int16_t)(
            dynamic_base_pwm +
            correction);

    right_target =
        (int16_t)(
            dynamic_base_pwm -
            correction);

    /*
     * 仍然能看到黑线时，不让内轮突然停转。
     * 两轮保持前进，通过速度差完成圆弧转弯。
     */
    left_target =
        ClampI16(
            left_target,
            VISIBLE_LINE_INNER_MIN_PWM,
            MOTOR_MAX_PWM);

    right_target =
        ClampI16(
            right_target,
            VISIBLE_LINE_INNER_MIN_PWM,
            MOTOR_MAX_PWM);

    Motor_RampTo(
        left_target,
        right_target);
}


/*============================================================
 * OLED软件I2C与显示
 * PA0=SDA，PA1=SCL，SSD1306 128x64
 *============================================================*/

static void OLED_Delay(void)
{
    ShortDelay(OLED_SOFT_I2C_DELAY_LOOPS);
}

static void OLED_SDA_DriveLow(void)
{
    DL_GPIO_clearPins(
        OLED_SDA_PORT,
        OLED_SDA_PIN);

    DL_GPIO_enableOutput(
        OLED_SDA_PORT,
        OLED_SDA_PIN);
}

static void OLED_SDA_Release(void)
{
    DL_GPIO_disableOutput(
        OLED_SDA_PORT,
        OLED_SDA_PIN);
}

static bool OLED_SDA_Read(void)
{
    return (
        (DL_GPIO_readPins(
            OLED_SDA_PORT,
            OLED_SDA_PIN) &
         OLED_SDA_PIN) != 0U);
}

static void OLED_SCL_DriveLow(void)
{
    DL_GPIO_clearPins(
        OLED_SCL_PORT,
        OLED_SCL_PIN);

    DL_GPIO_enableOutput(
        OLED_SCL_PORT,
        OLED_SCL_PIN);
}

static void OLED_SCL_Release(void)
{
    DL_GPIO_disableOutput(
        OLED_SCL_PORT,
        OLED_SCL_PIN);
}

static bool OLED_SCL_Read(void)
{
    return (
        (DL_GPIO_readPins(
            OLED_SCL_PORT,
            OLED_SCL_PIN) &
         OLED_SCL_PIN) != 0U);
}

static bool OLED_SCL_ReleaseAndWaitHigh(void)
{
    uint32_t timeout =
        OLED_CLOCK_STRETCH_TIMEOUT;

    OLED_SCL_Release();

    while (timeout > 0U)
    {
        if (OLED_SCL_Read())
        {
            return true;
        }

        timeout--;
    }

    return false;
}

static bool OLED_I2C_Start(void)
{
    OLED_SDA_Release();

    if (!OLED_SCL_ReleaseAndWaitHigh())
    {
        return false;
    }

    OLED_Delay();

    OLED_SDA_DriveLow();
    OLED_Delay();

    OLED_SCL_DriveLow();
    OLED_Delay();

    return true;
}

static void OLED_I2C_Stop(void)
{
    OLED_SDA_DriveLow();
    OLED_Delay();

    (void)OLED_SCL_ReleaseAndWaitHigh();
    OLED_Delay();

    OLED_SDA_Release();
    OLED_Delay();
}

static bool OLED_I2C_WriteByte(uint8_t data)
{
    uint8_t i;
    bool ack;

    for (i = 0U; i < 8U; i++)
    {
        if ((data & 0x80U) != 0U)
        {
            OLED_SDA_Release();
        }
        else
        {
            OLED_SDA_DriveLow();
        }

        OLED_Delay();

        if (!OLED_SCL_ReleaseAndWaitHigh())
        {
            OLED_SCL_DriveLow();
            OLED_SDA_Release();
            return false;
        }

        OLED_Delay();
        OLED_SCL_DriveLow();
        OLED_Delay();

        data <<= 1U;
    }

    OLED_SDA_Release();
    OLED_Delay();

    if (!OLED_SCL_ReleaseAndWaitHigh())
    {
        OLED_SCL_DriveLow();
        return false;
    }

    OLED_Delay();
    ack = !OLED_SDA_Read();

    OLED_SCL_DriveLow();
    OLED_Delay();

    return ack;
}

static bool OLED_WriteCommandList(
    const uint8_t *commands,
    uint16_t length)
{
    uint16_t i;

    if ((commands == (void *)0) ||
        (length == 0U))
    {
        return false;
    }

    if (!OLED_I2C_Start())
    {
        return false;
    }

    if (!OLED_I2C_WriteByte(
            (uint8_t)(
                OLED_I2C_ADDRESS << 1U)))
    {
        OLED_I2C_Stop();
        return false;
    }

    /* 0x00表示后面是命令。 */
    if (!OLED_I2C_WriteByte(0x00U))
    {
        OLED_I2C_Stop();
        return false;
    }

    for (i = 0U; i < length; i++)
    {
        if (!OLED_I2C_WriteByte(
                commands[i]))
        {
            OLED_I2C_Stop();
            return false;
        }
    }

    OLED_I2C_Stop();
    return true;
}

static bool OLED_UpdatePage(uint8_t page)
{
    uint8_t commands[3];
    uint16_t x;
    uint16_t offset;

    if (page >= 8U)
    {
        return false;
    }

    commands[0] =
        (uint8_t)(0xB0U | page);

    commands[1] = 0x00U;
    commands[2] = 0x10U;

    if (!OLED_WriteCommandList(
            commands,
            3U))
    {
        return false;
    }

    if (!OLED_I2C_Start())
    {
        return false;
    }

    if (!OLED_I2C_WriteByte(
            (uint8_t)(
                OLED_I2C_ADDRESS << 1U)))
    {
        OLED_I2C_Stop();
        return false;
    }

    /* 0x40表示后面是显示数据。 */
    if (!OLED_I2C_WriteByte(0x40U))
    {
        OLED_I2C_Stop();
        return false;
    }

    offset =
        (uint16_t)page * 128U;

    for (x = 0U; x < 128U; x++)
    {
        if (!OLED_I2C_WriteByte(
                g_oled_buffer[
                    offset + x]))
        {
            OLED_I2C_Stop();
            return false;
        }
    }

    OLED_I2C_Stop();
    return true;
}

static void OLED_ClearBuffer(void)
{
    uint16_t i;

    for (i = 0U;
         i < sizeof(g_oled_buffer);
         i++)
    {
        g_oled_buffer[i] = 0U;
    }
}

static void OLED_SetPixel(
    int16_t x,
    int16_t y)
{
    uint16_t index;
    uint8_t mask;

    if ((x < 0) ||
        (x >= 128) ||
        (y < 0) ||
        (y >= 64))
    {
        return;
    }

    index =
        (uint16_t)(
            (uint16_t)x +
            ((uint16_t)y / 8U) *
            128U);

    mask =
        (uint8_t)(
            1U <<
            ((uint16_t)y & 0x07U));

    g_oled_buffer[index] |= mask;
}

