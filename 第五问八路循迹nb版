#include "ti_msp_dl_config.h"
#include <stdint.h>
#include <stdbool.h>

/*
 * MSPM0G3507 + Hiwonder 六路巡线传感器
 *
 * ============================================================
 * 当前 SysConfig 引脚
 * ============================================================
 *
 * 左电机：
 *   IN1 -> PB2
 *   IN2 -> PA7
 *   ENA -> PB8
 *
 * 右电机：
 *   IN3 -> PB9
 *   IN4 -> PB14
 *   ENB -> PB7
 *
 * 六路巡线传感器：
 *   SDA -> PA23
 *   SCL -> PB24
 *
 * 传感器：
 *   I2C地址             = 0x5C
 *   六路数字结果寄存器 = 0x05
 *
 * 状态LED：
 *   LED -> PA5
 *
 * ============================================================
 * 六路传感器方向
 * ============================================================
 *
 * 按照传感器正面文字正常的安装方向：
 *
 * 小车左侧                              小车右侧
 *
 * 通道6   通道5   通道4   通道3   通道2   通道1
 *
 * 本代码假定：
 *   原始 bit0 = 通道1
 *   原始 bit1 = 通道2
 *   ...
 *   原始 bit5 = 通道6
 *
 * 软件会转换为：
 *   bit0 = 最左
 *   bit5 = 最右
 *
 * ============================================================
 * 工作方式
 * ============================================================
 *
 * 1. 读取六路数字结果。
 * 2. 使用加权误差进行PD循迹。
 * 3. 中间两路稳定压线时锁定线中心。
 * 4. B-C、D-A弯道使用弯道状态锁存，保持圆弧转向。
 * 5. 出弯后进入短时恢复状态，抑制C点后的左右摇头。
 * 6. 两轮保持前进，以速度差完成丝滑转弯，不突然原地转向。
 * 7. 短暂丢线先保持原圆弧，持续丢线再平滑找线。
 * 8. I2C连续读取失败约100ms后停车。
 * 9. 软件PWM频率为100Hz，速度范围0~100。
 */


/*============================================================
 * 系统时钟
 *============================================================*/

#ifndef CPUCLK_FREQ
#define CPUCLK_FREQ                         (32000000UL)
#endif
/* 打开电源后等待15秒再开始循迹。 */
#define POWER_ON_START_DELAY_MS              (15000U)

/*============================================================
 * SysTick与软件PWM
 *============================================================*/

/* SysTick每100us进入一次中断。 */
#define SYSTICK_FREQUENCY_HZ                (10000U)

/* PWM分成100级，因此PWM频率为100Hz。 */
#define PWM_PERIOD_COUNT                    (100U)

/* 每50个SysTick执行一次循迹，即5ms。 */
#define CONTROL_INTERVAL_TICKS              (50U)


/*============================================================
 * 电机方向配置
 *============================================================*/

/*
 * 烧录后先把车轮架空测试。
 *
 * 如果左轮“前进”方向反了：
 * LEFT_MOTOR_REVERSE 改成1。
 *
 * 如果右轮“前进”方向反了：
 * RIGHT_MOTOR_REVERSE 改成1。
 */

#define LEFT_MOTOR_REVERSE                  (0)
#define RIGHT_MOTOR_REVERSE                 (0)


/*============================================================
 * 六路巡线传感器配置
 *============================================================*/

/*
 * 默认认为：
 *
 * 检测到学习过的目标颜色，也就是黑线时，对应位为1。
 *
 * 如果实际测试发现：
 *   全部放在白色区域时返回63；
 *   放到黑线上对应位反而变成0；
 *
 * 就把这个宏改成0。
 */
#define LINE_DETECTED_IS_1                  (1)


/*
 * 传感器板正面朝前，并且文字方向正常时保持为0。
 *
 * 如果传感器左右装反，小车左边变成通道1，
 * 就把此宏改成1。
 */
#define SENSOR_INSTALL_REVERSE              (1)


/*
 * 六路全部检测到黑线时：
 *
 * 0：当作十字线或较粗黑线，继续直行。
 * 1：立即停车。
 */
#define STOP_ON_ALL_BLACK                   (0)


/*============================================================
 * 循迹速度参数
 *============================================================*/

/*
 * 所有PWM范围均为0~100。
 *
 * 车速太快：
 *   减小 MOTOR_BASE_PWM。
 *
 * 车速太慢：
 *   增大 MOTOR_BASE_PWM。
 */

#define MOTOR_BASE_PWM                      (17)
#define MOTOR_MAX_PWM                       (28)

/*
 * 小于这个PWM时电机通常无法启动。
 * 因此低于该值时直接按0处理。
 */
#define MOTOR_MIN_EFFECTIVE_PWM             (8)


/*============================================================
 * 丢线后的找线速度
 *============================================================*/

/*
 * 黑线最后在左侧：
 *   左轮慢、右轮快，继续向左找线。
 *
 * 黑线最后在右侧：
 *   左轮快、右轮慢，继续向右找线。
 */

/*
 * 丢线时不再让内轮直接停转，避免弯道中突然原地打方向。
 * 外轮24、内轮9会以较平滑的圆弧重新找线。
 */
#define LOST_LINE_OUTER_PWM                 (24)
#define LOST_LINE_INNER_PWM                 (9)

/* 直线状态短暂丢线时继续低速直行。 */
#define LOST_LINE_STRAIGHT_PWM              (16)

/* 前4个控制周期（约20ms）先保持上一次圆弧，避免误判丢线。 */
#define LOST_LINE_HOLD_CYCLES               (4U)


/*============================================================
 * PWM平滑参数
 *============================================================*/

/*
 * 每5ms速度最多变化多少。
 *
 * 数值小：
 *   更平滑，但转弯反应稍慢。
 *
 * 数值大：
 *   转弯灵敏，但可能摇头。
 */
#define PWM_SLEW_STEP                       (3)
#define STARTUP_SLEW_STEP                   (1)


/*============================================================
 * PD循迹参数
 *============================================================*/

/*
 * 六路传感器位置权重：
 *
 * 最左     左中     左内     右内     右中     最右
 * -500     -300     -100     +100     +300     +500
 *
 * correction =
 *     error × 7 / 100
 *   + error变化量 × 4 / 100
 *
 * 左右摇晃较大：
 *   减小 LINE_KP_NUM；
 *   或者减小 LINE_KD_NUM。
 *
 * 转弯不够灵敏：
 *   增大 LINE_KP_NUM；
 *   或者增大 MAX_STEERING_CORRECTION。
 */

/*
 * P项保持足够的转弯能力，D项降低，避免C点出弯后左右反复修正。
 */
#define LINE_KP_NUM                         (5)
#define LINE_KP_DEN                         (140)

#define LINE_KD_NUM                         (3)
#define LINE_KD_DEN                         (120)

/* D项再做一次低通滤波。 */
#define DERIVATIVE_FILTER_OLD_WEIGHT        (3)
#define DERIVATIVE_FILTER_TOTAL_WEIGHT      (4)

/*
 * 不同阶段采用不同的最大修正量。
 * 直线限制较小，弯道允许更大，出弯恢复阶段再次限制。
 */
#define STRAIGHT_MAX_CORRECTION             (9)
#define CURVE_MAX_CORRECTION                (16)
#define CURVE_EXIT_MAX_CORRECTION           (7)

/*
 * 动态基础速度。
 * 弯道降低基础速度，但保持外轮有足够速度，防止脱线。
 */
#define MOTOR_CURVE_BASE_PWM                (16)
#define MOTOR_SHARP_CURVE_BASE_PWM          (14)
#define MOTOR_CURVE_EXIT_BASE_PWM           (15)

/*
 * 只要仍检测到黑线，两轮都尽量保持转动。
 * 防止内轮突然停转造成车身一顿一顿。
 */
#define VISIBLE_LINE_INNER_MIN_PWM          (8)

/*
 * 弯道识别与退出滞环。
 *
 * |error|达到220或最外侧传感器压线，进入弯道状态。
 * 中间两路连续稳定抓线约40ms后，才退出弯道状态。
 */
#define CURVE_ENTER_ERROR                   (220)
#define CURVE_SHARP_ERROR                   (380)
#define CURVE_EXIT_ERROR                    (130)
#define CURVE_EXIT_CENTER_CONFIRM_CYCLES    (8U)

/*
 * 弯道中即使中间两路短暂同时压线，
 * 仍保留一个小的转向量，沿圆弧继续走，避免过早直行脱线。
 */
#define CURVE_CENTER_HOLD_CORRECTION        (6)

/*
 * 出弯后约180ms使用恢复状态：
 * 降低基础速度、限制修正量，防止C点出去后左右摇头。
 */
#define CURVE_EXIT_RECOVERY_CYCLES          (36U)

/*
 * 转向量单独做斜率限制。
 *
 * 进入弯道可快一些；
 * 弯道中正常变化；
 * 出弯释放最慢，避免修正量瞬间反向。
 */
#define STEERING_SLEW_ENTER_STEP            (3)
#define STEERING_SLEW_NORMAL_STEP           (2)
#define STEERING_SLEW_RELEASE_STEP          (1)

#define MAX_STEERING_CORRECTION             (CURVE_MAX_CORRECTION)


/*============================================================
 * I2C错误保护
 *============================================================*/

/*
 * 5ms读取一次。
 * 连续20次失败约等于100ms，随后停车。
 */
#define SENSOR_FAIL_STOP_COUNT              (20U)


/*============================================================
 * 六路传感器I2C参数
 *============================================================*/

#define LINE_SENSOR_I2C_ADDRESS             (0x5CU)
#define LINE_SENSOR_DIGITAL_REGISTER        (0x05U)

/*
 * 软件I2C延时。
 *
 * CPU为32MHz时，实际通信速率大约50~100kHz。
 */
#define SOFT_I2C_DELAY_LOOPS                 (36U)

#define SOFT_I2C_CLOCK_STRETCH_TIMEOUT       (3000U)


/*============================================================
 * 起步、停车与OLED参数
 *============================================================*/

/* 起步前段限制最大PWM，先克服静摩擦，再逐渐放开速度。 */
#define STARTUP_INITIAL_PWM_LIMIT            (13)
#define STARTUP_HOLD_TIME_MS                 (150U)
#define STARTUP_RAMP_TIME_MS                 (1050U)

/* 至少4路持续检测到黑线约30ms后锁定停车。 */
#define STOP_BLACK_MIN_COUNT                 (4U)
#define STOP_CONFIRM_COUNT                   (6U)

/* SSD1306 OLED：128x64，常见I2C地址0x3C。 */
#define OLED_I2C_ADDRESS                     (0x3CU)
#define OLED_REFRESH_INTERVAL_MS             (100U)
#define OLED_SOFT_I2C_DELAY_LOOPS             (8U)
#define OLED_CLOCK_STRETCH_TIMEOUT            (3000U)


