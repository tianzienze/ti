static const uint8_t *OLED_GetGlyph(char character)
{
    switch (character)
    {
        case '0': return OLED_GLYPH_0;
        case '1': return OLED_GLYPH_1;
        case '2': return OLED_GLYPH_2;
        case '3': return OLED_GLYPH_3;
        case '4': return OLED_GLYPH_4;
        case '5': return OLED_GLYPH_5;
        case '6': return OLED_GLYPH_6;
        case '7': return OLED_GLYPH_7;
        case '8': return OLED_GLYPH_8;
        case '9': return OLED_GLYPH_9;
        case ':': return OLED_GLYPH_COLON;
        case '.': return OLED_GLYPH_DOT;
        case 'R': return OLED_GLYPH_R;
        case 'U': return OLED_GLYPH_U;
        case 'N': return OLED_GLYPH_N;
        case 'T': return OLED_GLYPH_T;
        case 'I': return OLED_GLYPH_I;
        case 'M': return OLED_GLYPH_M;
        case 'E': return OLED_GLYPH_E;
        case ' ':
        default:
            return OLED_GLYPH_SPACE;
    }
}

static void OLED_DrawChar2x(
    int16_t x,
    int16_t y,
    char character)
{
    const uint8_t *glyph;
    uint8_t column;
    uint8_t row;

    glyph =
        OLED_GetGlyph(character);

    for (column = 0U;
         column < 5U;
         column++)
    {
        for (row = 0U;
             row < 7U;
             row++)
        {
            if ((glyph[column] &
                 (uint8_t)(1U << row)) != 0U)
            {
                OLED_SetPixel(
                    (int16_t)(
                        x +
                        (int16_t)column * 2),
                    (int16_t)(
                        y +
                        (int16_t)row * 2));

                OLED_SetPixel(
                    (int16_t)(
                        x +
                        (int16_t)column * 2 +
                        1),
                    (int16_t)(
                        y +
                        (int16_t)row * 2));

                OLED_SetPixel(
                    (int16_t)(
                        x +
                        (int16_t)column * 2),
                    (int16_t)(
                        y +
                        (int16_t)row * 2 +
                        1));

                OLED_SetPixel(
                    (int16_t)(
                        x +
                        (int16_t)column * 2 +
                        1),
                    (int16_t)(
                        y +
                        (int16_t)row * 2 +
                        1));
            }
        }
    }
}

static void OLED_DrawString2x(
    int16_t x,
    int16_t y,
    const char *text)
{
    while ((text != (void *)0) &&
           (*text != '\0'))
    {
        OLED_DrawChar2x(
            x,
            y,
            *text);

        x = (int16_t)(x + 12);
        text++;
    }
}

static void OLED_FormatTime(
    uint32_t elapsed_ms,
    char text[9])
{
    uint32_t minutes;
    uint32_t seconds;
    uint32_t hundredths;

    minutes =
        elapsed_ms / 60000U;

    if (minutes > 99U)
    {
        minutes = 99U;
    }

    seconds =
        (elapsed_ms / 1000U) %
        60U;

    hundredths =
        (elapsed_ms / 10U) %
        100U;

    text[0] =
        (char)(
            '0' +
            (minutes / 10U));

    text[1] =
        (char)(
            '0' +
            (minutes % 10U));

    text[2] = ':';

    text[3] =
        (char)(
            '0' +
            (seconds / 10U));

    text[4] =
        (char)(
            '0' +
            (seconds % 10U));

    text[5] = '.';

    text[6] =
        (char)(
            '0' +
            (hundredths / 10U));

    text[7] =
        (char)(
            '0' +
            (hundredths % 10U));

    text[8] = '\0';
}

static void OLED_ShowRunTime(uint32_t elapsed_ms)
{
    char time_text[9];

    OLED_FormatTime(
        elapsed_ms,
        time_text);

    OLED_ClearBuffer();

    /* 8个字符×12像素=96像素，x=16后水平居中。 */
    OLED_DrawString2x(
        16,
        8,
        "RUN TIME");

    OLED_DrawString2x(
        16,
        40,
        time_text);

    /*
     * 只刷新有内容的4页，减少OLED刷新对循迹周期的影响。
     */
    (void)OLED_UpdatePage(1U);
    (void)OLED_UpdatePage(2U);
    (void)OLED_UpdatePage(5U);
    (void)OLED_UpdatePage(6U);
}

static void OLED_Init(void)
{
    static const uint8_t init_commands[] =
    {
        0xAEU,
        0x20U, 0x02U,
        0xB0U,
        0xC8U,
        0x00U,
        0x10U,
        0x40U,
        0x81U, 0x7FU,
        0xA1U,
        0xA6U,
        0xA8U, 0x3FU,
        0xA4U,
        0xD3U, 0x00U,
        0xD5U, 0x80U,
        0xD9U, 0xF1U,
        0xDAU, 0x12U,
        0xDBU, 0x40U,
        0x8DU, 0x14U,
        0xAFU
    };

    uint8_t page;

    OLED_SDA_Release();
    OLED_SCL_Release();

    ShortDelay(50000U);

    (void)OLED_WriteCommandList(
        init_commands,
        (uint16_t)sizeof(
            init_commands));

    OLED_ClearBuffer();

    for (page = 0U;
         page < 8U;
         page++)
    {
        (void)OLED_UpdatePage(page);
    }
}


/*============================================================
 * GPIO初始化
 *============================================================*/

static void ApplicationGPIO_Init(void)
{
    /*
     * 先把所有电机引脚拉低。
     */
    DL_GPIO_clearPins(
        GPIOB,
        LEFT_IN1_PIN |
        RIGHT_IN3_PIN |
        RIGHT_IN4_PIN |
        LEFT_EN_PIN |
        RIGHT_EN_PIN);

    DL_GPIO_clearPins(
        GPIOA,
        LEFT_IN2_PIN |
        STATUS_LED_PIN);

    /*
     * 将电机相关GPIO设置为输出。
     */
    DL_GPIO_enableOutput(
        GPIOB,
        LEFT_IN1_PIN |
        RIGHT_IN3_PIN |
        RIGHT_IN4_PIN |
        LEFT_EN_PIN |
        RIGHT_EN_PIN);

    DL_GPIO_enableOutput(
        GPIOA,
        LEFT_IN2_PIN |
        STATUS_LED_PIN);

    /*
     * 软件I2C空闲状态：
     * SDA和SCL均释放。
     */
    DL_GPIO_clearPins(
        LINE_SDA_PORT,
        LINE_SDA_PIN);

    DL_GPIO_clearPins(
        LINE_SCL_PORT,
        LINE_SCL_PIN);

    /*
     * OLED软件I2C空闲状态。
     */
    DL_GPIO_clearPins(
        OLED_SDA_PORT,
        OLED_SDA_PIN);

    DL_GPIO_clearPins(
        OLED_SCL_PORT,
        OLED_SCL_PIN);

    SDA_Release();
    SCL_Release();

    OLED_SDA_Release();
    OLED_SCL_Release();

    Motor_StopImmediately();

    SoftI2C_BusRecover();
}


/*============================================================
 * SysTick中断
 *============================================================*/

void SysTick_Handler(void)
{
    /*
     * 左电机软件PWM。
     */
    if (g_left_pwm > g_pwm_phase)
    {
        DL_GPIO_setPins(
            LEFT_EN_PORT,
            LEFT_EN_PIN);
    }
    else
    {
        DL_GPIO_clearPins(
            LEFT_EN_PORT,
            LEFT_EN_PIN);
    }

    /*
     * 右电机软件PWM。
     */
    if (g_right_pwm > g_pwm_phase)
    {
        DL_GPIO_setPins(
            RIGHT_EN_PORT,
            RIGHT_EN_PIN);
    }
    else
    {
        DL_GPIO_clearPins(
            RIGHT_EN_PORT,
            RIGHT_EN_PIN);
    }

    /*
     * 软件PWM相位更新。
     */
    g_pwm_phase++;

    if (g_pwm_phase >=
        PWM_PERIOD_COUNT)
    {
        g_pwm_phase = 0U;
    }

    /*
     * 每5ms启动一次循迹计算。
     */
    g_control_tick++;

    if (g_control_tick >=
        CONTROL_INTERVAL_TICKS)
    {
        g_control_tick = 0U;
        g_control_due = 1U;
    }

    /*
     * 100us累计成1ms。
     */
    g_ms_divider++;

    if (g_ms_divider >= 10U)
    {
        g_ms_divider = 0U;
        g_system_ms++;

        if (g_run_started &&
            (!g_stop_latched))
        {
            g_run_elapsed_ms++;
        }
    }
}


/*============================================================
 * 主函数
 *============================================================*/

int main(void)
{
    uint8_t raw_line_bits = 0U;
    uint32_t oled_time_snapshot;

    /*
     * 初始化SysConfig生成的外设。
     *
     * 注意：
     * PA0、PA1需要在SysConfig中配置成普通GPIO，
     * 不要配置成硬件I2C复用功能。
     */
    SYSCFG_DL_init();

    ApplicationGPIO_Init();

    OLED_Init();
    OLED_ShowRunTime(0U);

    /*
     * 启动10kHz SysTick。
     */
    DL_SYSTICK_config(
        CPUCLK_FREQ /
        SYSTICK_FREQUENCY_HZ);

    DL_SYSTICK_enable();

    /*
     * 上电等待300ms，让六路传感器稳定。
     */
    /*
 * 打开电源开关后保持停车15秒。
 *
 * 等待期间：
 * 1. 左右电机保持停止；
 * 2. OLED保持显示00:00.00；
 * 3. 15秒不计入小车运行时间；
 * 4. 15秒结束后才开始读取循迹传感器并启动。
 */
Motor_StopImmediately();

while (g_system_ms < POWER_ON_START_DELAY_MS)
{
    __WFI();
}

/*
 * 清除等待期间产生的控制请求，
 * 从等待结束时重新开始一个完整的5ms控制周期。
 */
__disable_irq();

g_control_due = 0U;
g_control_tick = 0U;

__enable_irq();

/* 清除循迹控制历史量，保证起步状态干净。 */
g_last_valid_error = 0;
g_filtered_error = 0;
g_previous_filtered_error = 0;
g_filtered_delta_error = 0;
g_smoothed_correction = 0;

g_curve_mode = false;
g_curve_direction = 0;
g_center_lock_count = 0U;
g_curve_exit_recovery_count = 0U;
g_line_lost_count = 0U;

g_sensor_fail_count = 0U;
g_stop_confirm_count = 0U;

g_last_oled_refresh_ms =
    g_system_ms;

    while (1)
    {
        /*
         * 停车线尚未触发时才继续循迹。
         */
        if ((g_control_due != 0U) &&
            (!g_stop_latched))
        {
            g_control_due = 0U;

            if (LineSensor_ReadDigital(
                    &raw_line_bits))
            {
                g_sensor_fail_count = 0U;

                DL_GPIO_setPins(
                    STATUS_LED_PORT,
                    STATUS_LED_PIN);

                LineFollow_Control(
                    raw_line_bits);
            }
            else
            {
                DL_GPIO_clearPins(
                    STATUS_LED_PORT,
                    STATUS_LED_PIN);

                if (g_sensor_fail_count <
                    255U)
                {
                    g_sensor_fail_count++;
                }

                /*
                 * 六路传感器连续通信失败约100ms后停车。
                 * 通信恢复后仍可继续循迹；
                 * 只有停车线触发才会永久锁存。
                 */
                if (g_sensor_fail_count >=
                    SENSOR_FAIL_STOP_COUNT)
                {
                    Motor_StopImmediately();
                }
            }
        }
        else if (g_stop_latched)
        {
            /*
             * 清除积累的控制请求，并持续保证电机关闭。
             */
            g_control_due = 0U;
            Motor_StopImmediately();
        }

        /*
         * OLED每100ms刷新一次。
         * 停车时强制立即刷新并锁定最终时间。
         */
        if (g_oled_force_refresh ||
            ((g_system_ms -
              g_last_oled_refresh_ms) >=
             OLED_REFRESH_INTERVAL_MS))
        {
            g_oled_force_refresh = false;

            g_last_oled_refresh_ms =
                g_system_ms;

            __disable_irq();
            oled_time_snapshot =
                g_run_elapsed_ms;
            __enable_irq();

            OLED_ShowRunTime(
                oled_time_snapshot);
        }

        __WFI();
    }
}
