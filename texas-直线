static uint32_t Encoder_ReadLeftState(uint32_t gpioValue)
{
    uint32_t a;
    uint32_t b;

    a = ((gpioValue & LEFT_ENCODER_A_PIN) != 0U) ?
        1U : 0U;

    b = ((gpioValue & LEFT_ENCODER_B_PIN) != 0U) ?
        1U : 0U;

    return (a << 1U) | b;
}

static uint32_t Encoder_ReadRightState(uint32_t gpioValue)
{
    uint32_t a;
    uint32_t b;

    a = ((gpioValue & RIGHT_ENCODER_A_PIN) != 0U) ?
        1U : 0U;

    b = ((gpioValue & RIGHT_ENCODER_B_PIN) != 0U) ?
        1U : 0U;

    return (a << 1U) | b;
}

static void Encoder_Initialize(void)
{
    uint32_t gpioValue;

    gpioValue = DL_GPIO_readPins(
        GPIOA,
        LEFT_ENCODER_A_PIN |
        LEFT_ENCODER_B_PIN |
        RIGHT_ENCODER_A_PIN |
        RIGHT_ENCODER_B_PIN
    );

    g_left_previous_state =
        Encoder_ReadLeftState(gpioValue);

    g_right_previous_state =
        Encoder_ReadRightState(gpioValue);

    g_left_period_count = 0U;
    g_right_period_count = 0U;
}

