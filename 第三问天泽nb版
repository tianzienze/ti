/*============================================================
 * 18. 延时函数
 *============================================================*/

static void DelayMs(uint32_t milliseconds)
{
    while (milliseconds > 0U) {
        DL_Common_delayCycles(
            CPUCLK_FREQ / 1000U
        );

        milliseconds--;
    }
}


/*============================================================
 * 19. 驱动使能电平设置
 *============================================================*/

static void SetEnableInactiveLatch(void)
{
#if EN_ACTIVE_HIGH == 1U

    DL_GPIO_clearPins(
        EN_PORT,
        EN_PIN
    );

    g_enable_output_level = 0U;

#else

    DL_GPIO_setPins(
        EN_PORT,
        EN_PIN
    );

    g_enable_output_level = 1U;

#endif
}


static void StepperEnable(uint32_t enable)
{
#if EN_ACTIVE_HIGH == 1U

    if (enable != 0U) {
        DL_GPIO_setPins(
            EN_PORT,
            EN_PIN
        );

        g_enable_output_level = 1U;
    }
    else {
        DL_GPIO_clearPins(
            EN_PORT,
            EN_PIN
        );

        g_enable_output_level = 0U;
    }

#else

    if (enable != 0U) {
        DL_GPIO_clearPins(
            EN_PORT,
            EN_PIN
        );

        g_enable_output_level = 0U;
    }
    else {
        DL_GPIO_setPins(
            EN_PORT,
            EN_PIN
        );

        g_enable_output_level = 1U;
    }

#endif
}


/*============================================================
 * 20. GPIO初始化
 *============================================================*/

static void StepperGPIOInit(void)
{
    /*
     * 重要：
     *
     * 先设置GPIO输出锁存状态，
     * 最后才调用DL_GPIO_enableOutput。
     *
     * 这样能够减少初始化瞬间的STEP误脉冲。
     */

    /* STEP先固定为低电平 */
    DL_GPIO_clearPins(
        STEP_PORT,
        STEP_PIN
    );

    g_step_output_level = 0U;


    /* DIR预先设置成左转方向 */
#if LEFT_DIR_LEVEL == 1U

    DL_GPIO_setPins(
        DIR_PORT,
        DIR_PIN
    );

    g_direction_output_level = 1U;

#else

    DL_GPIO_clearPins(
        DIR_PORT,
        DIR_PIN
    );

    g_direction_output_level = 0U;

#endif


    /* EN预先设置为关闭状态 */
    SetEnableInactiveLatch();


    /*
     * 所有锁存电平准备完成后，
     * 再将三个GPIO切换为输出。
     */
    DL_GPIO_enableOutput(
        GPIOB,
        STEP_PIN |
        DIR_PIN |
        EN_PIN
    );


    /*
     * 确保STEP保持低电平。
     */
    DL_GPIO_clearPins(
        STEP_PORT,
        STEP_PIN
    );

    g_step_output_level = 0U;


    DelayMs(10U);
}


/*============================================================
 * 21. 设置方向
 *============================================================*/

static void SetDirectionLevel(uint32_t level)
{
    uint32_t targetLevel;

    targetLevel = (level != 0U) ? 1U : 0U;


    /*
     * 设置方向之前保证STEP为低。
     */
    DL_GPIO_clearPins(
        STEP_PORT,
        STEP_PIN
    );

    g_step_output_level = 0U;


    if (targetLevel != 0U) {
        DL_GPIO_setPins(
            DIR_PORT,
            DIR_PIN
        );

        g_direction_output_level = 1U;
    }
    else {
        DL_GPIO_clearPins(
            DIR_PORT,
            DIR_PIN
        );

        g_direction_output_level = 0U;
    }


    /*
     * 给驱动器足够的方向建立时间。
     */
    DelayMs(
        DIR_SETTLE_MS
    );
}


static void SetLeftDirection(void)
{
    SetDirectionLevel(
        LEFT_DIR_LEVEL
    );
}


static void SetRightDirection(void)
{
#if LEFT_DIR_LEVEL == 1U

    SetDirectionLevel(0U);

#else

    SetDirectionLevel(1U);

#endif
}


/*============================================================
 * 22. 角度转换为脉冲
 *============================================================*/

static uint32_t AngleX100ToPulses(
    uint32_t angleX100)
{
    uint64_t numerator;

    numerator =
        (uint64_t)angleX100 *
        (uint64_t)MOTOR_PULSES_PER_REV;

    /*
     * 四舍五入。
     */
    numerator += 18000ULL;

    return (uint32_t)(
        numerator / 36000ULL
    );
}


/*============================================================
 * 23. 计算加速阶段脉冲数
 *============================================================*/

static uint32_t GetRampPulseCount(
    uint32_t totalPulses)
{
#if RAMP_ENABLE == 0U

    (void)totalPulses;

    return 0U;

#else

    uint32_t rampPulses;

    /*
     * 脉冲数太少时不使用加减速。
     */
    if (totalPulses < 4U) {
        return 0U;
    }


    rampPulses =
        (
            totalPulses *
            RAMP_PERCENT
        ) /
        100U;


    /*
     * 至少使用2个脉冲。
     */
    if (rampPulses < 2U) {
        rampPulses = 2U;
    }


    /*
     * 限制最大加速脉冲数。
     */
    if (rampPulses > RAMP_MAX_PULSES) {
        rampPulses = RAMP_MAX_PULSES;
    }


    /*
     * 加速和减速脉冲总和不能超过总脉冲数。
     */
    if (
        (rampPulses * 2U) >
        totalPulses
    ) {
        rampPulses =
            totalPulses / 2U;
    }


    return rampPulses;

#endif
}


/*============================================================
 * 24. 获取某一个脉冲的周期倍率
 *============================================================*/

static uint32_t GetRampFactorX1000(
    uint32_t pulseIndex,
    uint32_t totalPulses,
    uint32_t rampPulses)
{
    uint32_t factorDifference;
    uint32_t rampPosition;


    if (
        rampPulses < 2U ||
        totalPulses < 4U
    ) {
        return RAMP_NORMAL_FACTOR_X1000;
    }


    factorDifference =
        RAMP_START_FACTOR_X1000 -
        RAMP_NORMAL_FACTOR_X1000;


    /*
     * 加速阶段：
     *
     * 第一个脉冲最慢，
     * 随后逐渐加速到正常速度。
     */
    if (pulseIndex < rampPulses) {
        rampPosition =
            rampPulses -
            1U -
            pulseIndex;

        return
            RAMP_NORMAL_FACTOR_X1000 +
            (
                factorDifference *
                rampPosition
            ) /
            (rampPulses - 1U);
    }


    /*
     * 减速阶段：
     *
     * 从正常速度逐渐减速。
     */
    if (
        pulseIndex >=
        (totalPulses - rampPulses)
    ) {
        rampPosition =
            pulseIndex -
            (totalPulses - rampPulses);

        return
            RAMP_NORMAL_FACTOR_X1000 +
            (
                factorDifference *
                rampPosition
            ) /
            (rampPulses - 1U);
    }


    /*
     * 匀速阶段。
     */
    return RAMP_NORMAL_FACTOR_X1000;
}


/*============================================================
 * 25. 计算整个加减速曲线倍率总和
 *============================================================*/

static uint64_t CalculateRampFactorSum(
    uint32_t totalPulses,
    uint32_t rampPulses)
{
    uint32_t pulseIndex;
    uint64_t factorSum;

    factorSum = 0ULL;

    for (
        pulseIndex = 0U;
        pulseIndex < totalPulses;
        pulseIndex++
    ) {
        factorSum +=
            (uint64_t)GetRampFactorX1000(
                pulseIndex,
                totalPulses,
                rampPulses
            );
    }

    return factorSum;
}


/*============================================================
 * 26. 计算单段运动参数
 *============================================================*/

static uint32_t CalculateMotionParameters(
    uint32_t angleX100,
    uint32_t rotateTimeMs,

    volatile uint32_t *pulseCount,
    volatile uint32_t *baseHalfPeriodCycles,
    volatile uint32_t *rampPulseCount,

    volatile uint32_t *actualAngleX100,
    volatile uint32_t *frequencyHz,
    volatile uint32_t *actualTimeMs)
{
    uint32_t calculatedPulseCount;
    uint32_t calculatedRampPulses;
    uint32_t calculatedBaseHalfPeriod;

    uint32_t pulseIndex;
    uint32_t factorX1000;
    uint32_t currentHalfPeriod;

    uint64_t totalCpuCycles;
    uint64_t factorSum;
    uint64_t numerator;
    uint64_t denominator;
    uint64_t actualTotalCycles;


    /*
     * 角度为0时跳过此阶段。
     */
    if (angleX100 == 0U) {
        *pulseCount = 0U;
        *baseHalfPeriodCycles = 0U;
        *rampPulseCount = 0U;

        *actualAngleX100 = 0U;
        *frequencyHz = 0U;
        *actualTimeMs = 0U;

        g_error_code = ERROR_NONE;

        return 1U;
    }


    /*
     * 角度不为0，时间不能为0。
     */
    if (rotateTimeMs == 0U) {
        g_error_code =
            ERROR_TIME_ZERO;

        return 0U;
    }


    calculatedPulseCount =
        AngleX100ToPulses(
            angleX100
        );


    if (calculatedPulseCount == 0U) {
        g_error_code =
            ERROR_ANGLE_TOO_SMALL;

        return 0U;
    }


    calculatedRampPulses =
        GetRampPulseCount(
            calculatedPulseCount
        );


    factorSum =
        CalculateRampFactorSum(
            calculatedPulseCount,
            calculatedRampPulses
        );


    if (factorSum == 0ULL) {
        g_error_code =
            ERROR_SPEED_TOO_HIGH;

        return 0U;
    }


    /*
     * 设定时间对应的CPU总周期。
     */
    totalCpuCycles =
        (
            (uint64_t)CPUCLK_FREQ *
            (uint64_t)rotateTimeMs
        ) /
        1000ULL;


    /*
     * 计算匀速阶段的半周期。
     *
     * 每个脉冲：
     * 高电平半周期 + 低电平半周期。
     *
     * 加减速阶段通过倍率改变半周期。
     */
    numerator =
        totalCpuCycles *
        1000ULL;

    denominator =
        2ULL *
        factorSum;


    calculatedBaseHalfPeriod =
        (uint32_t)(
            (
                numerator +
                denominator / 2ULL
            ) /
            denominator
        );


    /*
     * 速度过高。
     */
    if (
        calculatedBaseHalfPeriod <
        MIN_HALF_PERIOD_CYCLES
    ) {
        g_error_code =
            ERROR_SPEED_TOO_HIGH;

        return 0U;
    }


    *pulseCount =
        calculatedPulseCount;

    *baseHalfPeriodCycles =
        calculatedBaseHalfPeriod;

    *rampPulseCount =
        calculatedRampPulses;


    /*
     * 计算整数脉冲对应的实际角度。
     */
    *actualAngleX100 =
        (uint32_t)(
            (
                (uint64_t)calculatedPulseCount *
                36000ULL +
                MOTOR_PULSES_PER_REV / 2U
            ) /
            MOTOR_PULSES_PER_REV
        );


    /*
     * 最大频率，也就是匀速阶段的频率。
     */
    *frequencyHz =
        CPUCLK_FREQ /
        (
            2U *
            calculatedBaseHalfPeriod
        );


    /*
     * 计算采用整数周期后的实际时间。
     */
    actualTotalCycles = 0ULL;

    for (
        pulseIndex = 0U;
        pulseIndex < calculatedPulseCount;
        pulseIndex++
    ) {
        factorX1000 =
            GetRampFactorX1000(
                pulseIndex,
                calculatedPulseCount,
                calculatedRampPulses
            );

        currentHalfPeriod =
            (uint32_t)(
                (
                    (uint64_t)calculatedBaseHalfPeriod *
                    (uint64_t)factorX1000 +
                    500ULL
                ) /
                1000ULL
            );


        if (
            currentHalfPeriod <
            MIN_HALF_PERIOD_CYCLES
        ) {
            currentHalfPeriod =
                MIN_HALF_PERIOD_CYCLES;
        }


        actualTotalCycles +=
            2ULL *
            (uint64_t)currentHalfPeriod;
    }


    *actualTimeMs =
        (uint32_t)(
            (
                actualTotalCycles *
                1000ULL +
                CPUCLK_FREQ / 2U
            ) /
            CPUCLK_FREQ
        );


    g_error_code =
        ERROR_NONE;

    return 1U;
}


/*============================================================
 * 27. 输出一个STEP脉冲
 *============================================================*/

static void OutputOneStepPulse(
    uint32_t halfPeriodCycles)
{
    if (
        halfPeriodCycles <
        MIN_HALF_PERIOD_CYCLES
    ) {
        halfPeriodCycles =
            MIN_HALF_PERIOD_CYCLES;
    }


    g_current_half_period_cycles =
        halfPeriodCycles;


    /*
     * STEP上升沿。
     */
    DL_GPIO_setPins(
        STEP_PORT,
        STEP_PIN
    );

    g_step_output_level = 1U;


    DL_Common_delayCycles(
        halfPeriodCycles
    );


    /*
     * STEP拉低。
     */
    DL_GPIO_clearPins(
        STEP_PORT,
        STEP_PIN
    );

    g_step_output_level = 0U;


    DL_Common_delayCycles(
        halfPeriodCycles
    );


    g_total_output_pulses++;
}


/*============================================================
 * 28. 输出带加减速的脉冲
 *============================================================*/

static void OutputSmoothPulses(
    uint32_t targetPulses,
    uint32_t baseHalfPeriodCycles,
    uint32_t rampPulses,
    volatile uint32_t *outputPulseCounter)
{
    uint32_t pulseIndex;
    uint32_t factorX1000;
    uint32_t currentHalfPeriod;


    *outputPulseCounter = 0U;


    if (targetPulses == 0U) {
        return;
    }


    for (
        pulseIndex = 0U;
        pulseIndex < targetPulses;
        pulseIndex++
    ) {
        g_current_pulse_index =
            pulseIndex;


        factorX1000 =
            GetRampFactorX1000(
                pulseIndex,
                targetPulses,
                rampPulses
            );


        currentHalfPeriod =
            (uint32_t)(
                (
                    (uint64_t)baseHalfPeriodCycles *
                    (uint64_t)factorX1000 +
                    500ULL
                ) /
                1000ULL
            );


        if (
            currentHalfPeriod <
            MIN_HALF_PERIOD_CYCLES
        ) {
            currentHalfPeriod =
                MIN_HALF_PERIOD_CYCLES;
        }


        OutputOneStepPulse(
            currentHalfPeriod
        );


        (*outputPulseCounter)++;
    }


    /*
     * 每段运动结束后保证STEP为低。
     */
    DL_GPIO_clearPins(
        STEP_PORT,
        STEP_PIN
    );

    g_step_output_level = 0U;
}


/*============================================================
 * 29. 执行左转
 *============================================================*/

static void RotateLeft(
    uint32_t processIndex)
{
    g_left_output_pulses[
        processIndex
    ] = 0U;


    if (
        g_left_target_pulses[
            processIndex
        ] == 0U
    ) {
        return;
    }


    SetLeftDirection();


    OutputSmoothPulses(
        g_left_target_pulses[
            processIndex
        ],

        g_left_half_period_cycles[
            processIndex
        ],

        g_left_ramp_pulses[
            processIndex
        ],

        &g_left_output_pulses[
            processIndex
        ]
    );
}


/*============================================================
 * 30. 执行右转
 *============================================================*/

static void RotateRight(
    uint32_t processIndex)
{
    g_right_output_pulses[
        processIndex
    ] = 0U;


    if (
        g_right_target_pulses[
            processIndex
        ] == 0U
    ) {
        return;
    }


    SetRightDirection();


    OutputSmoothPulses(
        g_right_target_pulses[
            processIndex
        ],

        g_right_half_period_cycles[
            processIndex
        ],

        g_right_ramp_pulses[
            processIndex
        ],

        &g_right_output_pulses[
            processIndex
        ]
    );
}


/*============================================================
 * 31. 进入错误状态
 *============================================================*/

static void EnterError(
    uint32_t processIndex,
    uint32_t errorStage)
{
    g_error_process =
        processIndex + 1U;

    g_error_stage =
        errorStage;

    g_run_state =
        STATE_ERROR;


    DL_GPIO_clearPins(
        STEP_PORT,
        STEP_PIN
    );

    g_step_output_level = 0U;


    /*
     * 参数错误时关闭驱动。
     */
    StepperEnable(0U);
}


/*============================================================
 * 32. 计算全部运动参数
 *============================================================*/

static uint32_t CalculateAllProcesses(void)
{
    uint32_t processIndex;


    for (
        processIndex = 0U;
        processIndex < PROCESS_COUNT;
        processIndex++
    ) {
        if (
            g_process_enable[
                processIndex
            ] == 0U
        ) {
            continue;
        }


        /*
         * 计算左转参数。
         */
        if (
            CalculateMotionParameters(
                g_left_angle_x100[
                    processIndex
                ],

                g_left_time_ms[
                    processIndex
                ],

                &g_left_target_pulses[
                    processIndex
                ],

                &g_left_half_period_cycles[
                    processIndex
                ],

                &g_left_ramp_pulses[
                    processIndex
                ],

                &g_left_actual_angle_x100[
                    processIndex
                ],

                &g_left_frequency_hz[
                    processIndex
                ],

                &g_left_actual_time_ms[
                    processIndex
                ]
            ) == 0U
        ) {
            EnterError(
                processIndex,
                1U
            );

            return 0U;
        }


        /*
         * 计算右转参数。
         */
        if (
            CalculateMotionParameters(
                g_right_angle_x100[
                    processIndex
                ],

                g_right_time_ms[
                    processIndex
                ],

                &g_right_target_pulses[
                    processIndex
                ],

                &g_right_half_period_cycles[
                    processIndex
                ],

                &g_right_ramp_pulses[
                    processIndex
                ],

                &g_right_actual_angle_x100[
                    processIndex
                ],

                &g_right_frequency_hz[
                    processIndex
                ],

                &g_right_actual_time_ms[
                    processIndex
                ]
            ) == 0U
        ) {
            EnterError(
                processIndex,
                2U
            );

            return 0U;
        }
    }


    return 1U;
}


/*============================================================
 * 33. 执行一组动作
 *============================================================*/

static void ExecuteOneProcess(
    uint32_t processIndex)
{
    uint32_t holdTimeMs;


    g_current_process =
        processIndex + 1U;

    g_current_process_index =
        processIndex;


    /*
     * 禁用的过程直接跳过。
     */
    if (
        g_process_enable[
            processIndex
        ] == 0U
    ) {
        g_process_finished[
            processIndex
        ] = 2U;

        return;
    }


    /*
     * 第一步：平滑向左转。
     */
    g_run_state =
        STATE_ROTATING_LEFT;

    RotateLeft(
        processIndex
    );


    /*
     * 第二步：左转结束后停留。
     */
    g_run_state =
        STATE_HOLDING_LEFT;


    holdTimeMs =
        g_middle_hold_ms[
            processIndex
        ];


    /*
     * 左右两段都存在时，强制加入最短换向停顿。
     */
    if (
        g_left_target_pulses[
            processIndex
        ] > 0U &&
        g_right_target_pulses[
            processIndex
        ] > 0U
    ) {
        if (
            holdTimeMs <
            MIN_REVERSE_HOLD_MS
        ) {
            holdTimeMs =
                MIN_REVERSE_HOLD_MS;
        }
    }


    if (holdTimeMs > 0U) {
        DelayMs(
            holdTimeMs
        );
    }


    /*
     * 第三步：平滑向右转。
     */
    g_run_state =
        STATE_ROTATING_RIGHT;

    RotateRight(
        processIndex
    );


    g_process_finished[
        processIndex
    ] = 1U;

    g_finished_process_count++;


    /*
     * 第四步：本组结束后停留。
     */
    g_run_state =
        STATE_HOLDING_AFTER_PROCESS;


    holdTimeMs =
        g_process_end_hold_ms[
            processIndex
        ];


    if (
        holdTimeMs <
        MIN_PROCESS_GAP_MS
    ) {
        holdTimeMs =
            MIN_PROCESS_GAP_MS;
    }


    DelayMs(
        holdTimeMs
    );
}


/*============================================================
 * 34. 初始化调试变量
 *============================================================*/

static void ResetDebugVariables(void)
{
    uint32_t processIndex;


    g_run_state =
        STATE_WAITING;

    g_current_process = 0U;
    g_current_process_index = 0U;

    g_error_code =
        ERROR_NONE;

    g_error_process = 0U;
    g_error_stage = 0U;

    g_total_output_pulses = 0U;
    g_finished_process_count = 0U;
    g_all_motion_finished = 0U;

    g_current_half_period_cycles = 0U;
    g_current_pulse_index = 0U;


    for (
        processIndex = 0U;
        processIndex < PROCESS_COUNT;
        processIndex++
    ) {
        g_left_output_pulses[
            processIndex
        ] = 0U;

        g_right_output_pulses[
            processIndex
        ] = 0U;

        g_process_finished[
            processIndex
        ] = 0U;
    }
}


/*============================================================
 * 35. 主函数
 *============================================================*/

int main(void)
{
    uint32_t processIndex;


    /*
     * SysConfig初始化。
     */
    SYSCFG_DL_init();


    /*
     * GPIO安全初始化。
     */
    StepperGPIOInit();


    /*
     * 初始化所有调试变量。
     */
    ResetDebugVariables();


    /*
     * 先计算所有参数。
     */
    if (
        CalculateAllProcesses() == 0U
    ) {
        while (1) {
            __WFI();
        }
    }


    /*
     * 尽早使能驱动并保持锁轴。
     *
     * 不再先关闭3秒，再突然使能。
     */
    StepperEnable(1U);

    g_run_state =
        STATE_DRIVER_ENABLED;


    /*
     * 等待驱动电流稳定。
     */
    DelayMs(
        ENABLE_SETTLE_MS
    );


    /*
     * 等待开始。
     *
     * 此时电机已经锁住，
     * 不能手动旋转电机。
     */
    g_run_state =
        STATE_WAITING;

    DelayMs(
        START_DELAY_MS
    );


    /*
     * 依次执行五组动作。
     */
    for (
        processIndex = 0U;
        processIndex < PROCESS_COUNT;
        processIndex++
    ) {
        ExecuteOneProcess(
            processIndex
        );
    }


    /*
     * 所有动作完成。
     */
    g_all_motion_finished = 1U;

    g_run_state =
        STATE_FINISHED;


    /*
     * 保证STEP最终为低。
     */
    DL_GPIO_clearPins(
        STEP_PORT,
        STEP_PIN
    );

    g_step_output_level = 0U;


#if HOLD_AFTER_FINISH == 0U

    /*
     * 关闭驱动，允许手动转动。
     */
    StepperEnable(0U);

#endif


    while (1) {
        __WFI();
    }
}
