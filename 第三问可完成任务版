/*
 * ============================================================
 * MSPM0G3507 + D36A 步进电机五组左右运动
 *
 * 每组动作：
 *
 * 向左转指定角度
 * -> 停留指定时间
 * -> 向右转指定角度
 * -> 组间停留
 *
 * 共执行5组，每一组参数均可独立修改。
 *
 * 不使用编码器。
 * 不使用K230。
 *
 * ============================================================
 * 接线：
 *
 * PB1 -> D36A ST1
 * PB2 -> D36A DIR1
 * PB4 -> D36A EN1
 *
 * 开发板GND必须与D36A GND共地。
 *
 * ============================================================
 * 电机参数：
 *
 * 步距角：1.8°
 * 一圈整步数：200
 * D36A细分：16
 *
 * 一圈脉冲数：
 *
 * 200 × 16 = 3200个脉冲
 * ============================================================
 */


/*============================================================
 * 1. 系统时钟
 *============================================================*/

#ifndef CPUCLK_FREQ
#define CPUCLK_FREQ                         (32000000UL)
#endif


/*============================================================
 * 2. GPIO引脚
 *============================================================*/

#define STEP_PORT                           (GPIOB)
#define STEP_PIN                            (DL_GPIO_PIN_1)

#define DIR_PORT                            (GPIOB)
#define DIR_PIN                             (DL_GPIO_PIN_2)

#define EN_PORT                             (GPIOB)
#define EN_PIN                              (DL_GPIO_PIN_4)


/*============================================================
 * 3. 总过程数量
 *============================================================*/

#define PROCESS_COUNT                       (5U)


/*============================================================
 * 4. 第1组参数
 *============================================================*/

/*
 * 1：执行该组
 * 0：跳过该组
 */
#define PROCESS_1_ENABLE                    (1U)

/* 左转角度，单位0.01°，2000表示20.00° */
#define PROCESS_1_LEFT_ANGLE_X100           (1000U)

/* 左转完成时间，单位ms */
#define PROCESS_1_LEFT_TIME_MS              (800U)

/* 左转完成后的停留时间，单位ms */
#define PROCESS_1_MIDDLE_HOLD_MS            (0000U)

/* 从当前位置向右转的角度 */
#define PROCESS_1_RIGHT_ANGLE_X100          (3000U)

/* 右转完成时间 */
#define PROCESS_1_RIGHT_TIME_MS             (1120U)

/* 第1组完成后，到第2组开始前的停留时间 */
#define PROCESS_1_END_HOLD_MS               (000U)


