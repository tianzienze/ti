/*============================================================
 * 18. 延时函数
 *============================================================*/

static void DelayMs(uint32_t milliseconds)
{
    while (milliseconds > 0U) {
        DL_Common_delayCycles(
            CPUCLK_FREQ / 1000U
        );

        milliseconds--;
    }
}


/*============================================================
 * 19. GPIO初始化
 *============================================================*/

static void StepperGPIOInit(void)
{
    /*
     * 强制将PB1、PB2、PB4设置为输出。
     */
    DL_GPIO_enableOutput(
        GPIOB,
        STEP_PIN |
        DIR_PIN |
        EN_PIN
    );


    /*
     * STEP初始为低电平。
     */
    DL_GPIO_clearPins(
        STEP_PORT,
        STEP_PIN
    );

    g_step_output_level = 0U;


    /*
     * DIR初始为低电平。
     */
    DL_GPIO_clearPins(
        DIR_PORT,
        DIR_PIN
    );

    g_direction_output_level = 0U;
}


/*============================================================
 * 20. 驱动使能
 *============================================================*/

static void StepperEnable(uint32_t enable)
{
#if EN_ACTIVE_HIGH == 1U

    if (enable != 0U) {
        DL_GPIO_setPins(
            EN_PORT,
            EN_PIN
        );

        g_enable_output_level = 1U;
    }
    else {
        DL_GPIO_clearPins(
            EN_PORT,
            EN_PIN
        );

        g_enable_output_level = 0U;
    }

#else

    if (enable != 0U) {
        DL_GPIO_clearPins(
            EN_PORT,
            EN_PIN
        );

        g_enable_output_level = 0U;
    }
    else {
        DL_GPIO_setPins(
            EN_PORT,
            EN_PIN
        );

        g_enable_output_level = 1U;
    }

#endif
}


/*============================================================
 * 21. 设置方向
 *============================================================*/

static void SetDirectionLevel(uint32_t level)
{
    if (level != 0U) {
        DL_GPIO_setPins(
            DIR_PORT,
            DIR_PIN
        );

        g_direction_output_level = 1U;
    }
    else {
        DL_GPIO_clearPins(
            DIR_PORT,
            DIR_PIN
        );

        g_direction_output_level = 0U;
    }


    /*
     * 改变方向后等待，避免第一个STEP方向错误。
     */
    DelayMs(
        DIR_SETTLE_MS
    );
}


static void SetLeftDirection(void)
{
    SetDirectionLevel(
        LEFT_DIR_LEVEL
    );
}


static void SetRightDirection(void)
{
    if (LEFT_DIR_LEVEL != 0U) {
        SetDirectionLevel(0U);
    }
    else {
        SetDirectionLevel(1U);
    }
}


/*============================================================
 * 22. 角度转换成STEP脉冲数
 *============================================================*/

/*
 * 输入：
 *
 * angleX100，单位0.01°。
 *
 * 计算：
 *
 * pulses =
 * angleX100 × 3200 / 36000
 */
static uint32_t AngleX100ToPulses(
    uint32_t angleX100)
{
    uint64_t numerator;

    numerator =
        (uint64_t)angleX100 *
        (uint64_t)MOTOR_PULSES_PER_REV;


    /*
     * 四舍五入。
     */
    numerator += 18000ULL;


    return (uint32_t)(
        numerator /
        36000ULL
    );
}


/*============================================================
 * 23. 计算单个运动阶段参数
 *============================================================*/

/*
 * 角度为0时，该阶段自动跳过，不会报错。
 */
static uint32_t CalculateMotionParameters(
    uint32_t angleX100,
    uint32_t rotateTimeMs,
    volatile uint32_t *pulseCount,
    volatile uint32_t *halfPeriodCycles,
    volatile uint32_t *actualAngleX100,
    volatile uint32_t *frequencyHz,
    volatile uint32_t *actualTimeMs)
{
    uint32_t calculatedPulseCount;

    uint64_t totalCpuCycles;
    uint64_t periodCycles;
    uint64_t actualTimeNumerator;


    /*
     * 角度为0：
     *
     * 表示跳过该方向的运动。
     */
    if (angleX100 == 0U) {
        *pulseCount = 0U;
        *halfPeriodCycles = 0U;
        *actualAngleX100 = 0U;
        *frequencyHz = 0U;
        *actualTimeMs = 0U;

        g_error_code =
            ERROR_NONE;

        return 1U;
    }


    /*
     * 角度不为0，运动时间不能为0。
     */
    if (rotateTimeMs == 0U) {
        g_error_code =
            ERROR_TIME_ZERO;

        return 0U;
    }


    calculatedPulseCount =
        AngleX100ToPulses(
            angleX100
        );


    if (calculatedPulseCount == 0U) {
        g_error_code =
            ERROR_ANGLE_TOO_SMALL;

        return 0U;
    }


    *pulseCount =
        calculatedPulseCount;


    /*
     * 实际整数脉冲对应角度。
     */
    *actualAngleX100 =
        (uint32_t)(
            (
                (uint64_t)calculatedPulseCount *
                36000ULL +
                MOTOR_PULSES_PER_REV / 2U
            ) /
            MOTOR_PULSES_PER_REV
        );


    /*
     * 设定时间对应的CPU总周期数。
     */
    totalCpuCycles =
        (
            (uint64_t)CPUCLK_FREQ *
            (uint64_t)rotateTimeMs
        ) /
        1000ULL;


    /*
     * 每个STEP完整周期的CPU周期数。
     */
    periodCycles =
        totalCpuCycles /
        (uint64_t)calculatedPulseCount;


    /*
     * 高低电平各占半个周期。
     */
    *halfPeriodCycles =
        (uint32_t)(
            periodCycles /
            2ULL
        );


    /*
     * 要求的运动速度过高。
     */
    if (
        *halfPeriodCycles <
        MIN_HALF_PERIOD_CYCLES
    ) {
        g_error_code =
            ERROR_SPEED_TOO_HIGH;

        return 0U;
    }


    *frequencyHz =
        CPUCLK_FREQ /
        (
            2U *
            (*halfPeriodCycles)
        );


    /*
     * 计算实际运动时间。
     */
    actualTimeNumerator =
        (uint64_t)calculatedPulseCount *
        2ULL *
        (uint64_t)(*halfPeriodCycles) *
        1000ULL;


    *actualTimeMs =
        (uint32_t)(
            (
                actualTimeNumerator +
                CPUCLK_FREQ / 2U
            ) /
            CPUCLK_FREQ
        );


    g_error_code =
        ERROR_NONE;

    return 1U;
}


/*============================================================
 * 24. 输出一个STEP脉冲
 *============================================================*/

static void OutputOneStepPulse(
    uint32_t halfPeriodCycles)
{
    /*
     * STEP拉高。
     */
    DL_GPIO_setPins(
        STEP_PORT,
        STEP_PIN
    );

    g_step_output_level = 1U;


    DL_Common_delayCycles(
        halfPeriodCycles
    );


    /*
     * STEP拉低。
     */
    DL_GPIO_clearPins(
        STEP_PORT,
        STEP_PIN
    );

    g_step_output_level = 0U;


    DL_Common_delayCycles(
        halfPeriodCycles
    );


    g_total_output_pulses++;
}


/*============================================================
 * 25. 执行左转
 *============================================================*/

static void RotateLeft(uint32_t processIndex)
{
    uint32_t pulseIndex;

    g_left_output_pulses[processIndex] = 0U;


    if (
        g_left_target_pulses[processIndex]
        == 0U
    ) {
        return;
    }


    SetLeftDirection();


    for (
        pulseIndex = 0U;
        pulseIndex <
        g_left_target_pulses[processIndex];
        pulseIndex++
    ) {
        OutputOneStepPulse(
            g_left_half_period_cycles[
                processIndex
            ]
        );

        g_left_output_pulses[
            processIndex
        ]++;
    }


    DL_GPIO_clearPins(
        STEP_PORT,
        STEP_PIN
    );

    g_step_output_level = 0U;
}


/*============================================================
 * 26. 执行右转
 *============================================================*/

static void RotateRight(uint32_t processIndex)
{
    uint32_t pulseIndex;

    g_right_output_pulses[processIndex] = 0U;


    if (
        g_right_target_pulses[processIndex]
        == 0U
    ) {
        return;
    }


    SetRightDirection();


    for (
        pulseIndex = 0U;
        pulseIndex <
        g_right_target_pulses[processIndex];
        pulseIndex++
    ) {
        OutputOneStepPulse(
            g_right_half_period_cycles[
                processIndex
            ]
        );

        g_right_output_pulses[
            processIndex
        ]++;
    }


    DL_GPIO_clearPins(
        STEP_PORT,
        STEP_PIN
    );

    g_step_output_level = 0U;
}


/*============================================================
 * 27. 进入错误状态
 *============================================================*/

static void EnterError(
    uint32_t processIndex,
    uint32_t errorStage)
{
    g_error_process =
        processIndex + 1U;

    g_error_stage =
        errorStage;

    g_run_state =
        STATE_ERROR;


    DL_GPIO_clearPins(
        STEP_PORT,
        STEP_PIN
    );

    g_step_output_level = 0U;


    /*
     * 参数错误时关闭驱动。
     */
    StepperEnable(0U);
}


/*============================================================
 * 28. 计算全部五组参数
 *============================================================*/

static uint32_t CalculateAllProcesses(void)
{
    uint32_t processIndex;


    for (
        processIndex = 0U;
        processIndex < PROCESS_COUNT;
        processIndex++
    ) {
        /*
         * 被禁用的组不需要计算。
         */
        if (
            g_process_enable[processIndex]
            == 0U
        ) {
            continue;
        }


        /*
         * 计算左转参数。
         */
        if (
            CalculateMotionParameters(
                g_left_angle_x100[
                    processIndex
                ],

                g_left_time_ms[
                    processIndex
                ],

                &g_left_target_pulses[
                    processIndex
                ],

                &g_left_half_period_cycles[
                    processIndex
                ],

                &g_left_actual_angle_x100[
                    processIndex
                ],

                &g_left_frequency_hz[
                    processIndex
                ],

                &g_left_actual_time_ms[
                    processIndex
                ]
            ) == 0U
        ) {
            EnterError(
                processIndex,
                1U
            );

            return 0U;
        }


        /*
         * 计算右转参数。
         */
        if (
            CalculateMotionParameters(
                g_right_angle_x100[
                    processIndex
                ],

                g_right_time_ms[
                    processIndex
                ],

                &g_right_target_pulses[
                    processIndex
                ],

                &g_right_half_period_cycles[
                    processIndex
                ],

                &g_right_actual_angle_x100[
                    processIndex
                ],

                &g_right_frequency_hz[
                    processIndex
                ],

                &g_right_actual_time_ms[
                    processIndex
                ]
            ) == 0U
        ) {
            EnterError(
                processIndex,
                2U
            );

            return 0U;
        }
    }


    return 1U;
}


/*============================================================
 * 29. 执行一组过程
 *============================================================*/

static void ExecuteOneProcess(
    uint32_t processIndex)
{
    /*
     * 当前执行组号。
     */
    g_current_process =
        processIndex + 1U;

    g_current_process_index =
        processIndex;


    /*
     * 如果该组关闭，直接跳过。
     */
    if (
        g_process_enable[processIndex]
        == 0U
    ) {
        g_process_finished[
            processIndex
        ] = 2U;

        return;
    }


    /*
     * 第一步：向左转。
     */
    g_run_state =
        STATE_ROTATING_LEFT;

    RotateLeft(
        processIndex
    );


    /*
     * 第二步：左转完成后停留。
     */
    g_run_state =
        STATE_HOLDING_LEFT;


    if (
        g_middle_hold_ms[processIndex]
        > 0U
    ) {
        DelayMs(
            g_middle_hold_ms[
                processIndex
            ]
        );
    }


    /*
     * 第三步：向右转。
     */
    g_run_state =
        STATE_ROTATING_RIGHT;

    RotateRight(
        processIndex
    );


    /*
     * 本组已经完成。
     */
    g_process_finished[
        processIndex
    ] = 1U;

    g_finished_process_count++;


    /*
     * 第四步：本组结束后停留。
     */
    g_run_state =
        STATE_HOLDING_AFTER_PROCESS;


    if (
        g_process_end_hold_ms[
            processIndex
        ] > 0U
    ) {
        DelayMs(
            g_process_end_hold_ms[
                processIndex
            ]
        );
    }
}


/*============================================================
 * 30. 主函数
 *============================================================*/

int main(void)
{
    uint32_t processIndex;


    /*
     * 初始化SysConfig。
     */
    SYSCFG_DL_init();


    StepperGPIOInit();


    /*
     * 上电先关闭驱动。
     *
     * 此时可以手动把机构调整到初始位置。
     */
    StepperEnable(0U);


    g_run_state =
        STATE_WAITING;

    g_current_process = 0U;
    g_current_process_index = 0U;

    g_error_code =
        ERROR_NONE;

    g_error_process = 0U;
    g_error_stage = 0U;

    g_total_output_pulses = 0U;
    g_finished_process_count = 0U;
    g_all_motion_finished = 0U;


    /*
     * 上电等待3秒。
     *
     * 可以在此期间手动调整初始位置。
     */
    DelayMs(
        START_DELAY_MS
    );


    /*
     * 先计算全部五组参数。
     *
     * 任何一组参数错误都会停止执行。
     */
    if (
        CalculateAllProcesses() == 0U
    ) {
        while (1) {
            __WFI();
        }
    }


    /*
     * 使能步进驱动。
     */
    StepperEnable(1U);

    g_run_state =
        STATE_DRIVER_ENABLED;


    DelayMs(
        ENABLE_SETTLE_MS
    );


    /*
     * 依次执行5组过程。
     */
    for (
        processIndex = 0U;
        processIndex < PROCESS_COUNT;
        processIndex++
    ) {
        ExecuteOneProcess(
            processIndex
        );
    }


    /*
     * 所有动作完成。
     */
    g_all_motion_finished = 1U;

    g_run_state =
        STATE_FINISHED;


#if HOLD_AFTER_FINISH == 0U

    /*
     * 关闭驱动，允许手动转动。
     */
    StepperEnable(0U);

#endif


    while (1) {
        __WFI();
    }
}
