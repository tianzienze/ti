/*
 * 小球平衡控制频率100Hz。
 *
 * 每10ms进行一次位置控制。
 */
#define CONTROL_FREQUENCY_HZ                (100U)

#define CONTROL_INTERVAL_TICKS              \
    (SYSTICK_FREQUENCY_HZ /                 \
     CONTROL_FREQUENCY_HZ)

#define CONTROL_DT_S                        (0.01f)


