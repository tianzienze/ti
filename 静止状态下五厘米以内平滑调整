static void StepperGPIOInit(void)
{
    DL_GPIO_enableOutput(
        GPIOB,
        STEP_PIN |
        DIR_PIN |
        EN_PIN);

    DL_GPIO_clearPins(
        STEP_PORT,
        STEP_PIN);

    DL_GPIO_clearPins(
        DIR_PORT,
        DIR_PIN);

    g_step_output_level = 0U;
    g_direction_output_level = 0U;
}


static void StepperEnable(uint32_t enable)
{
#if ENABLE_ACTIVE_HIGH == 1U

    if (enable != 0U)
    {
        DL_GPIO_setPins(
            EN_PORT,
            EN_PIN);

        g_enable_output_level = 1U;
    }
    else
    {
        DL_GPIO_clearPins(
            EN_PORT,
            EN_PIN);

        g_enable_output_level = 0U;
    }

#else

    if (enable != 0U)
    {
        DL_GPIO_clearPins(
            EN_PORT,
            EN_PIN);

        g_enable_output_level = 0U;
    }
    else
    {
        DL_GPIO_setPins(
            EN_PORT,
            EN_PIN);

        g_enable_output_level = 1U;
    }

#endif
}


static void SetMotorDirection(int32_t direction)
{
    uint32_t outputLevel;

    if (direction > 0)
    {
        outputLevel =
            POSITIVE_DIRECTION_LEVEL;
    }
    else
    {
        outputLevel =
            (POSITIVE_DIRECTION_LEVEL == 0U) ?
            1U : 0U;
    }

    if (outputLevel != 0U)
    {
        DL_GPIO_setPins(
            DIR_PORT,
            DIR_PIN);

        g_direction_output_level = 1U;
    }
    else
    {
        DL_GPIO_clearPins(
            DIR_PORT,
            DIR_PIN);

        g_direction_output_level = 0U;
    }
}


/*==============================================================
 * 17. 角度与脉冲换算
 *==============================================================*/

static int32_t MotorAngleToPulse(
    float angleDeg)
{
    float pulse;

    pulse =
        angleDeg *
        MOTOR_PULSES_PER_DEG;

    return FloatToInt32(pulse);
}


static float MotorPulseToAngle(
    int32_t pulse)
{
    return
        (float)pulse /
        MOTOR_PULSES_PER_DEG;
}


/*==============================================================
 * 18. STEP脉冲发生器
 *==============================================================*/

static void StepPulseService100us(void)
{
    static uint32_t phaseAccumulator = 0U;
    static uint8_t stepPinHigh = 0U;
    static int32_t appliedDirection = 0;

    int32_t requestedRate;
    int32_t direction;
    uint32_t magnitude;

    /*
     * 上一次STEP高电平先拉低。
     *
     * STEP高电平宽度为100us。
     */
    if (stepPinHigh != 0U)
    {
        DL_GPIO_clearPins(
            STEP_PORT,
            STEP_PIN);

        stepPinHigh = 0U;
        g_step_output_level = 0U;
    }

    requestedRate =
        g_step_rate_sps;

    if (requestedRate == 0)
    {
        phaseAccumulator = 0U;
        return;
    }

    if (requestedRate > 0)
    {
        direction = 1;
        magnitude =
            (uint32_t)requestedRate;
    }
    else
    {
        direction = -1;
        magnitude =
            (uint32_t)(-requestedRate);
    }

    /*
     * 方向变化时先设置DIR。
     *
     * 本周期不发STEP，给DIR留100us建立时间。
     */
    if (direction != appliedDirection)
    {
        SetMotorDirection(direction);

        appliedDirection = direction;
        phaseAccumulator = 0U;
        return;
    }

    /*
     * 防止越过软件位置限制。
     */
    if ((direction > 0) &&
        (g_motor_current_pulse >=
         MotorAngleToPulse(
             MAX_MOTOR_ANGLE_DEG)))
    {
        return;
    }

    if ((direction < 0) &&
        (g_motor_current_pulse <=
         MotorAngleToPulse(
             -MAX_MOTOR_ANGLE_DEG)))
    {
        return;
    }

    phaseAccumulator += magnitude;

    if (phaseAccumulator >=
        SYSTICK_FREQUENCY_HZ)
    {
        phaseAccumulator -=
            SYSTICK_FREQUENCY_HZ;

        DL_GPIO_setPins(
            STEP_PORT,
            STEP_PIN);

        stepPinHigh = 1U;
        g_step_output_level = 1U;

        g_motor_current_pulse +=
            direction;
    }
}


/*==============================================================
 * 19. K230坐标提交
 *==============================================================*/

static void CommitK230Coordinate(
    int32_t coordinateMm)
{
    if (coordinateMm >
        BALL_POSITION_LIMIT_MM)
    {
        coordinateMm =
            BALL_POSITION_LIMIT_MM;
    }

    if (coordinateMm <
        -BALL_POSITION_LIMIT_MM)
    {
        coordinateMm =
            -BALL_POSITION_LIMIT_MM;
    }

    g_k230_position_mm =
        coordinateMm;

    g_k230_last_rx_ms =
        g_system_ms;

    g_k230_new_sample = 1U;

    g_k230_valid_count++;
}


/*==============================================================
 * 20. K230字符解析
 *==============================================================*/

static void ParseK230Byte(uint8_t data)
{
    static int32_t value = 0;
    static int32_t sign = 1;

    static uint8_t receivingNumber = 0U;
    static uint8_t hasDigit = 0U;

    /*
     * 收到正负号，开始一帧新坐标。
     */
    if (data == '-')
    {
        value = 0;
        sign = -1;

        receivingNumber = 1U;
        hasDigit = 0U;

        return;
    }

    if (data == '+')
    {
        value = 0;
        sign = 1;

        receivingNumber = 1U;
        hasDigit = 0U;

        return;
    }

    /*
     * 收到数字。
     */
    if ((data >= '0') &&
        (data <= '9'))
    {
        if (receivingNumber == 0U)
        {
            value = 0;
            sign = 1;

            receivingNumber = 1U;
            hasDigit = 0U;
        }

        value =
            value * 10 +
            (int32_t)(data - '0');

        if (value > 999)
        {
            value = 999;
        }

        hasDigit = 1U;

        return;
    }

    /*
     * 收到换行、回车、空格、逗号或分号：
     *
     * 提交当前坐标。
     */
    if ((data == '\r') ||
        (data == '\n') ||
        (data == ' ')  ||
        (data == ',')  ||
        (data == ';'))
    {
        if ((receivingNumber != 0U) &&
            (hasDigit != 0U))
        {
            CommitK230Coordinate(
                sign * value);
        }

        value = 0;
        sign = 1;

        receivingNumber = 0U;
        hasDigit = 0U;
    }
}


/*==============================================================
 * 21. UART0接收中断
 *==============================================================*/

/*
 * 这里必须叫UART0_IRQHandler。
 *
 * 你的SysConfig中K230_UART实际使用UART0。
 *
 * 不能写成：
 *
 * void K230_UART_INST_IRQHandler(void)
 *
 * 否则启动文件找不到该中断函数。
 */
void UART0_IRQHandler(void)
{
    uint32_t pendingInterrupt;

    pendingInterrupt =
        DL_UART_Main_getPendingInterrupt(
            K230_UART_INST);

    switch (pendingInterrupt)
    {
        case DL_UART_MAIN_IIDX_RX:

            while (!DL_UART_Main_isRXFIFOEmpty(
                        K230_UART_INST))
            {
                uint8_t receivedByte;

                receivedByte =
                    (uint8_t)
                    DL_UART_Main_receiveData(
                        K230_UART_INST);

                ParseK230Byte(
                    receivedByte);
            }

            break;

        default:
            break;
    }
}


/*==============================================================
 * 22. 更新小球位置和速度
 *==============================================================*/

static void UpdateBallObserver(
    uint8_t hasNewSample,
    float measurementMm,
    uint32_t sampleTimeMs)
{
    float dt;
    float newVelocity;

    if (hasNewSample == 0U)
    {
        return;
    }

    /*
     * 第一次收到坐标：
     *
     * 直接使用该位置，速度设置为0。
     */
    if (g_observer_initialized == 0U)
    {
        g_filtered_position_mm =
            measurementMm;

        g_previous_filtered_position_mm =
            measurementMm;

        g_filtered_velocity_mm_s =
            0.0f;

        g_last_observer_time_ms =
            sampleTimeMs;

        g_observer_initialized = 1U;

        return;
    }

    dt =
        (float)(
            sampleTimeMs -
            g_last_observer_time_ms) /
        1000.0f;

    /*
     * 限制时间范围，避免除0或通信停顿。
     */
    if (dt < 0.010f)
    {
        dt = 0.010f;
    }

    if (dt > 0.100f)
    {
        dt = 0.100f;
    }

    /*
     * 对位置低通滤波。
     */
    g_filtered_position_mm +=
        POSITION_FILTER_ALPHA *
        (measurementMm -
         g_filtered_position_mm);

    /*
     * 根据滤波后坐标计算速度。
     */
    newVelocity =
        (g_filtered_position_mm -
         g_previous_filtered_position_mm) /
        dt;

    newVelocity =
        FloatClamp(
            newVelocity,
            -MAX_BALL_SPEED_MM_S,
            MAX_BALL_SPEED_MM_S);

    /*
     * 对速度再次滤波。
     */
    g_filtered_velocity_mm_s +=
        VELOCITY_FILTER_ALPHA *
        (newVelocity -
         g_filtered_velocity_mm_s);

    g_previous_filtered_position_mm =
        g_filtered_position_mm;

    g_last_observer_time_ms =
        sampleTimeMs;
}


/*==============================================================
 * 23. 计算电机目标角度
 *==============================================================*/

static float CalculateMotorTargetAngle(void)
{
    float position;
    float velocity;
    float absPosition;

    float effectivePosition;
    float positionAngle;
    float velocityAngle;
    float integralAngle;

    float targetAngle;

    position =
        g_filtered_position_mm;

    velocity =
        g_filtered_velocity_mm_s;

    absPosition =
        FloatAbs(position);

    /*
     * 平滑死区。
     *
     * 例如位置为+8mm、死区3mm：
     *
     * 有效误差 = +5mm。
     *
     * 这样越过3mm边界时不会突然跳变。
     */
    if (position >
        BALL_CENTER_DEADBAND_MM)
    {
        effectivePosition =
            position -
            BALL_CENTER_DEADBAND_MM;
    }
    else if (position <
             -BALL_CENTER_DEADBAND_MM)
    {
        effectivePosition =
            position +
            BALL_CENTER_DEADBAND_MM;
    }
    else
    {
        effectivePosition = 0.0f;
    }

    /*
     * 积分只在偏差不太大时启用。
     *
     * 偏差太大时逐渐释放积分。
     */
    if ((absPosition < 30.0f) &&
        (FloatAbs(velocity) < 150.0f))
    {
        g_ball_integral_mm_s +=
            position *
            CONTROL_DT_S;

        g_ball_integral_mm_s =
            FloatClamp(
                g_ball_integral_mm_s,
                -BALL_INTEGRAL_LIMIT_MM_S,
                BALL_INTEGRAL_LIMIT_MM_S);
    }
    else
    {
        g_ball_integral_mm_s *=
            0.98f;
    }

    /*
     * 小球已经在原点附近且速度很低：
     *
     * 缓慢释放积分，轨道逐渐回水平。
     */
    if ((absPosition <=
         BALL_CENTER_DEADBAND_MM) &&
        (FloatAbs(velocity) <=
         BALL_STABLE_SPEED_MM_S))
    {
        g_ball_integral_mm_s *=
            0.95f;
    }

    positionAngle =
        BALL_POSITION_KP *
        effectivePosition;

    velocityAngle =
        BALL_VELOCITY_KD *
        velocity;

    integralAngle =
        BALL_POSITION_KI *
        g_ball_integral_mm_s;

    integralAngle =
        FloatClamp(
            integralAngle,
            -MAX_INTEGRAL_ANGLE_DEG,
            MAX_INTEGRAL_ANGLE_DEG);

    targetAngle =
        positionAngle +
        velocityAngle +
        integralAngle;

    /*
     * 根据机械方向修正。
     */
    targetAngle *=
        BALL_CONTROL_POLARITY;

    targetAngle =
        FloatClamp(
            targetAngle,
            -MAX_MOTOR_ANGLE_DEG,
            MAX_MOTOR_ANGLE_DEG);

    return targetAngle;
}


/*==============================================================
 * 24. 限制目标角度变化速度
 *==============================================================*/

static float ApplyTargetAngleSlewLimit(
    float currentAngle,
    float requestedAngle)
{
    float maximumChange;
    float difference;

    maximumChange =
        MAX_TARGET_SLEW_DEG_S *
        CONTROL_DT_S;

    difference =
        requestedAngle -
        currentAngle;

    difference =
        FloatClamp(
            difference,
            -maximumChange,
            maximumChange);

    return
        currentAngle +
        difference;
}


/*==============================================================
 * 25. 电机软件位置控制
 *==============================================================*/

static void MotorPositionControl10ms(
    float targetAngleDeg)
{
    static float previousRate = 0.0f;

    int32_t targetPulse;
    int32_t positionError;

    float requestedRate;
    float maximumRateChange;

    targetPulse =
        MotorAngleToPulse(
            targetAngleDeg);

    targetPulse =
        (int32_t)FloatClamp(
            (float)targetPulse,
            (float)MotorAngleToPulse(
                -MAX_MOTOR_ANGLE_DEG),
            (float)MotorAngleToPulse(
                MAX_MOTOR_ANGLE_DEG));

    g_motor_target_pulse =
        targetPulse;

    positionError =
        targetPulse -
        g_motor_current_pulse;

    /*
     * 到达目标位置附近，停止发脉冲。
     */
    if (Int32Abs(positionError) <=
        MOTOR_POSITION_DEADBAND_PULSE)
    {
        requestedRate = 0.0f;
    }
    else
    {
        requestedRate =
            MOTOR_POSITION_KP *
            (float)positionError;

        /*
         * 保证还有位置误差时具有最低速度。
         */
        if ((requestedRate > 0.0f) &&
            (requestedRate <
             MOTOR_MIN_STEP_RATE_SPS))
        {
            requestedRate =
                MOTOR_MIN_STEP_RATE_SPS;
        }

        if ((requestedRate < 0.0f) &&
            (requestedRate >
             -MOTOR_MIN_STEP_RATE_SPS))
        {
            requestedRate =
                -MOTOR_MIN_STEP_RATE_SPS;
        }
    }

    requestedRate =
        FloatClamp(
            requestedRate,
            -MOTOR_MAX_STEP_RATE_SPS,
            MOTOR_MAX_STEP_RATE_SPS);

    /*
     * 加速度限制。
     */
    maximumRateChange =
        MOTOR_MAX_ACCEL_SPS2 *
        CONTROL_DT_S;

    requestedRate =
        FloatClamp(
            requestedRate,
            previousRate -
            maximumRateChange,
            previousRate +
            maximumRateChange);

    g_step_rate_sps =
        FloatToInt32(
            requestedRate);

    previousRate =
        requestedRate;

    g_debug_motor_angle_x100 =
        FloatToInt32(
            MotorPulseToAngle(
                g_motor_current_pulse) *
            100.0f);
}


/*==============================================================
 * 26. 10ms总控制
 *==============================================================*/

static void BalanceControl10ms(void)
{
    uint8_t hasNewSample;

    int32_t receivedPosition;
    uint32_t receivedTime;

    uint32_t uartAgeMs;

    float requestedAngle;

    /*
     * 原子读取中断中更新的UART变量。
     */
    __disable_irq();

    hasNewSample =
        g_k230_new_sample;

    receivedPosition =
        g_k230_position_mm;

    receivedTime =
        g_k230_last_rx_ms;

    g_k230_new_sample = 0U;

    __enable_irq();

    UpdateBallObserver(
        hasNewSample,
        (float)receivedPosition,
        receivedTime);

    uartAgeMs =
        g_system_ms -
        g_k230_last_rx_ms;

    g_debug_uart_age_ms =
        uartAgeMs;

    /*
     * 没收到第一帧数据。
     */
    if (g_observer_initialized == 0U)
    {
        g_balance_state = 0U;

        requestedAngle = 0.0f;
    }
    /*
     * K230通信超时。
     */
    else if (uartAgeMs >
             K230_TIMEOUT_MS)
    {
        g_balance_state = 2U;

        requestedAngle = 0.0f;

        g_filtered_velocity_mm_s *=
            0.90f;

        g_ball_integral_mm_s *=
            0.95f;
    }
    /*
     * 正常平衡控制。
     */
    else
    {
        g_balance_state = 1U;

        requestedAngle =
            CalculateMotorTargetAngle();
    }

    g_requested_motor_angle_deg =
        requestedAngle;

    g_applied_motor_angle_deg =
        ApplyTargetAngleSlewLimit(
            g_applied_motor_angle_deg,
            g_requested_motor_angle_deg);

    MotorPositionControl10ms(
        g_applied_motor_angle_deg);

    /*
     * 更新CCS调试变量。
     */
    g_debug_position_x10 =
        FloatToInt32(
            g_filtered_position_mm *
            10.0f);

    g_debug_velocity_x10 =
        FloatToInt32(
            g_filtered_velocity_mm_s *
            10.0f);

    g_debug_target_angle_x100 =
        FloatToInt32(
            g_applied_motor_angle_deg *
            100.0f);
}


/*==============================================================
 * 27. SysTick中断
 *==============================================================*/

void SysTick_Handler(void)
{
    static uint32_t millisecondDivider = 0U;
    static uint32_t controlDivider = 0U;

    /*
     * 每100us更新STEP脉冲。
     */
    StepPulseService100us();

    /*
     * 计算系统毫秒时间。
     */
    millisecondDivider++;

    if (millisecondDivider >= 10U)
    {
        millisecondDivider = 0U;

        g_system_ms++;
    }

    /*
     * 每10ms启动一次平衡控制。
     */
    controlDivider++;

    if (controlDivider >=
        CONTROL_INTERVAL_TICKS)
    {
        controlDivider = 0U;

        g_control_due = 1U;
    }
}


/*==============================================================
 * 28. 主函数
 *==============================================================*/

int main(void)
{
    /*
     * SysConfig初始化。
     */
    SYSCFG_DL_init();


    /*
     * 步进电机GPIO初始化。
     */
    StepperGPIOInit();


    /*
     * 上电先关闭D36A。
     *
     * 此时手动把轨道调整到水平位置。
     */
    StepperEnable(0U);


    /*
     * 打开UART0接收中断。
     */
    DL_UART_Main_enableInterrupt(
        K230_UART_INST,
        DL_UART_MAIN_INTERRUPT_RX);

    NVIC_ClearPendingIRQ(
        K230_UART_INST_INT_IRQN);

    NVIC_EnableIRQ(
        K230_UART_INST_INT_IRQN);


    /*
     * 开启10kHz SysTick。
     */
    if (SysTick_Config(
            CPUCLK_FREQ /
            SYSTICK_FREQUENCY_HZ) != 0U)
    {
        while (1)
        {
            __WFI();
        }
    }


    __enable_irq();


    /*
     * 等待2秒，手动调平轨道。
     */
    DelayMs(
        START_DELAY_MS);


    /*
     * 当前软件脉冲位置作为0°。
     */
    g_motor_current_pulse = 0;
    g_motor_target_pulse = 0;

    g_requested_motor_angle_deg = 0.0f;
    g_applied_motor_angle_deg = 0.0f;


    /*
     * 使能D36A并锁轴。
     */
    StepperEnable(1U);

    DelayMs(
        ENABLE_SETTLE_MS);


    while (1)
    {
        if (g_control_due != 0U)
        {
            __disable_irq();

            g_control_due = 0U;

            __enable_irq();

            BalanceControl10ms();
        }

        __WFI();
    }
}
