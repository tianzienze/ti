    (void)rawZ;

    return rawX;

#elif JY60_FORWARD_AXIS == 1U

    (void)rawX;
    (void)rawZ;

    return rawY;

#else

    (void)rawX;
    (void)rawY;

    return rawZ;

#endif
}


