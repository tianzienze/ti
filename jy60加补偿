#define CENTER_EXIT_CONFIRM_FRAMES          (2U)


/*==============================================================
 * 9. 钢球位置PID参数
 *==============================================================*/

/*
 * P：位置比例。
 *
 * 33mm约产生2.31°，100mm约产生7.0°。
 */
#define BALL_PID_KP                         (0.065f)

/*
 * I：消除轨道轻微不水平、机构间隙造成的长期静差。
 *
 * 积分只在距离原点较近时启用，并带防饱和限制。
 */
#define BALL_PID_KI                         (0.010f)

/*
 * D：使用预测速度作为阻尼。
 *
 * 小球向原点快速运动时，D项会提前减小拉回坡度；
 * 小球远离原点时，D项会加大回中坡度。
 */
#define BALL_PID_KD                         (0.018f)

/*
 * A：加速度前馈。
 *
 * 小球仍在向原点加速时提前卸力，
 * 小球正向外加速时提前加强修正。
 */
#define BALL_PID_KA                         (0.00015f)

/*
 * 只有在±35mm内才积累积分。
 */
#define PID_INTEGRAL_ACTIVE_MM              (24.0f)

/*
 * 速度过高时不积累积分，避免高速阶段积分过量。
 */
#define PID_INTEGRAL_MAX_SPEED_MM_S         (130.0f)

/*
 * 积分项最大只允许贡献±1.6°。
 */
#define PID_INTEGRAL_MAX_ANGLE_DEG          (0.7f)

/*
 * 不满足积分条件时，积分每个新坐标帧乘以0.90。
 */
#define PID_INTEGRAL_DECAY                  (0.90f)

/*
 * 加速度项最大只允许贡献±1.2°。
 */
#define PID_ACCEL_MAX_ANGLE_DEG             (0.45f)

