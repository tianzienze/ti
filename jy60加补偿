/*==============================================================
 * 19. 基础函数
 *==============================================================*/

static float FloatAbs(float value)
{
    if (value < 0.0f)
    {
        return -value;
    }

    return value;
}


static float FloatClamp(
    float value,
    float minimum,
    float maximum)
{
    if (value > maximum)
    {
        return maximum;
    }

    if (value < minimum)
    {
        return minimum;
    }

    return value;
}


static float FloatSign(float value)
{
    if (value > 0.0f)
    {
        return 1.0f;
    }

    if (value < 0.0f)
    {
        return -1.0f;
    }

    return 0.0f;
}


static int32_t Int32Abs(int32_t value)
{
    if (value < 0)
    {
        return -value;
    }

    return value;
}


static int32_t FloatToInt32(float value)
{
    if (value >= 0.0f)
    {
        return (int32_t)(value + 0.5f);
    }

    return (int32_t)(value - 0.5f);
}


/*
 * atan近似。
 *
 * 本项目只使用|a/g|<=0.30，
 * 使用x-x^3/3+x^5/5已经足够准确，
 * 同时避免引入math.h和额外数学库。
 */
static float AtanApproxRad(float value)
{
    float squared;


    value =
        FloatClamp(
            value,
            -0.50f,
            0.50f);


    squared =
        value *
        value;


    return
        value *
        (
            1.0f -
            squared /
            3.0f +
            squared *
            squared /
            5.0f
        );
}


/*
 * 根据宏选择JY60作为小车前后方向的轴。
 */
static int16_t SelectJY60ForwardRaw(
    int16_t rawX,
    int16_t rawY,
    int16_t rawZ)
{
#if JY60_FORWARD_AXIS == 0U

