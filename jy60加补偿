}


/*==============================================================
 * 26. STEP脉冲服务
 *
 * 调用频率10kHz。
 *==============================================================*/

static void StepPulseService100us(void)
{
    static uint32_t phaseAccumulator = 0U;

    static uint8_t stepPinHigh = 0U;

    static int32_t appliedDirection = 0;

    int32_t requestedRate;

    int32_t direction;

    uint32_t magnitude;


    requestedRate =
        g_step_rate_sps;


    /*
     * 上一次STEP为高电平：
     * 本周期先拉低。
     */
    if (stepPinHigh != 0U)
    {
        DL_GPIO_clearPins(
            STEP_PORT,
            STEP_PIN);

        stepPinHigh = 0U;

        g_step_output_level = 0U;
    }


    if (requestedRate == 0)
    {
        phaseAccumulator = 0U;

        return;
    }


    if (requestedRate > 0)
    {
        direction = 1;

        magnitude =
            (uint32_t)requestedRate;
    }
    else
    {
        direction = -1;

        magnitude =
            (uint32_t)(-requestedRate);
    }


    /*
     * 已经到达目标位置。
     */
    if ((direction > 0) &&
        (g_motor_current_pulse >=
         g_motor_target_pulse))
    {
        g_step_rate_sps = 0;

        phaseAccumulator = 0U;

        return;
    }


    if ((direction < 0) &&
        (g_motor_current_pulse <=
         g_motor_target_pulse))
    {
        g_step_rate_sps = 0;

        phaseAccumulator = 0U;

        return;
    }


    /*
     * 方向切换时，本周期只改变DIR。
     */
    if (direction != appliedDirection)
    {
        SetMotorDirection(
            direction);

        appliedDirection =
            direction;

        phaseAccumulator = 0U;

        return;
    }


    /*
     * 软件总角度限位。
     */
    if ((direction > 0) &&
        (g_motor_current_pulse >=
         MotorAngleToPulse(
             MAX_MOTOR_ANGLE_DEG)))
    {
        g_step_rate_sps = 0;

        phaseAccumulator = 0U;

        return;
    }


    if ((direction < 0) &&
        (g_motor_current_pulse <=
         MotorAngleToPulse(
             -MAX_MOTOR_ANGLE_DEG)))
    {
        g_step_rate_sps = 0;

        phaseAccumulator = 0U;

        return;
    }


    phaseAccumulator +=
        magnitude;


    if (phaseAccumulator >=
        SYSTICK_FREQUENCY_HZ)
    {
        phaseAccumulator -=
            SYSTICK_FREQUENCY_HZ;


        DL_GPIO_setPins(
            STEP_PORT,
            STEP_PIN);


        stepPinHigh = 1U;

        g_step_output_level = 1U;


        g_motor_current_pulse +=
            direction;
    }
}


/*==============================================================
 * 27. 提交K230坐标
 *==============================================================*/

static void CommitK230Coordinate(
    int32_t coordinateMm)
{
    if (coordinateMm >
        BALL_POSITION_LIMIT_MM)
    {
        coordinateMm =
            BALL_POSITION_LIMIT_MM;
    }

    if (coordinateMm <
        -BALL_POSITION_LIMIT_MM)
    {
        coordinateMm =
            -BALL_POSITION_LIMIT_MM;
    }

    g_k230_position_mm =
        coordinateMm;

    g_k230_last_rx_ms =
        g_system_ms;

    g_k230_new_sample = 1U;

    g_k230_valid_count++;
}


/*==============================================================
 * 28. 解析K230字符串
 *==============================================================*/

static void ParseK230Byte(uint8_t data)
{
    static int32_t value = 0;

    static int32_t sign = 1;

    static uint8_t receivingNumber = 0U;

    static uint8_t hasDigit = 0U;


    if (data == '-')
    {
        value = 0;

        sign = -1;

        receivingNumber = 1U;

        hasDigit = 0U;

        return;
    }


    if (data == '+')
    {
        value = 0;

        sign = 1;

        receivingNumber = 1U;

        hasDigit = 0U;

        return;
    }


    if ((data >= '0') &&
        (data <= '9'))
    {
        if (receivingNumber == 0U)
        {
            value = 0;

            sign = 1;

            receivingNumber = 1U;

            hasDigit = 0U;
        }


        value =
            value * 10 +
            (int32_t)(data - '0');


        if (value > 999)
        {
            value = 999;
        }


        hasDigit = 1U;

        return;
    }


    if ((data == '\r') ||
        (data == '\n') ||
        (data == ' ')  ||
        (data == ',')  ||
        (data == ';'))
    {
        if ((receivingNumber != 0U) &&
            (hasDigit != 0U))
        {
            CommitK230Coordinate(
                sign * value);
        }


        value = 0;

        sign = 1;

        receivingNumber = 0U;

        hasDigit = 0U;
    }
}


