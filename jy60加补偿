 */
#define K230_TIMEOUT_MS                     (500U)


/*==============================================================
 * 5A. JY60小车加速度前馈参数
 *==============================================================*/

/*
 * 本代码按WIT/JY60常见二进制输出格式解析：
 *
 * 0x55 0x51 AxL AxH AyL AyH AzL AzH TL TH SUM
 *
 * 加速度换算：
 *
 *      acceleration_g = raw / 32768 × 16
 *
 * PA17 = UART1_TX
 * PA18 = UART1_RX
 *
 * SysConfig中请把UART1实例命名为JY60_UART，
 * 这样会生成JY60_UART_INST和JY60_UART_INST_INT_IRQN。
 */
#define JY60_FRAME_LENGTH                   (11U)
#define JY60_FRAME_HEADER                   (0x55U)
#define JY60_FRAME_ACCELERATION             (0x51U)

#define JY60_TIMEOUT_MS                     (200U)

/*
 * JY60安装方向：
 *
 * 0：使用X轴作为小车前后方向
 * 1：使用Y轴作为小车前后方向
 * 2：使用Z轴作为小车前后方向
 *
 * 推荐把JY60的X轴箭头沿小车前进方向安装，
 * 此时保持0。
 */
#define JY60_FORWARD_AXIS                   (0U)

/*
 * 让“小车向前加速”最终得到正的g_vehicle_accel_g。
 *
 * 若调试时小车向前加速，
 * g_debug_vehicle_accel_mg却为负数，
 * 将1.0f改成-1.0f。
 */
#define JY60_ACCEL_AXIS_POLARITY            (1.0f)

/*
 * 加速度补偿角方向。
 *
 * 若启用后小球偏移更严重，
 * 只改这一项为-1.0f，不要先改BALL_CONTROL_POLARITY。
 */
#define VEHICLE_COMPENSATION_POLARITY       (1.0f)

/*
 * JY60加速度帧的标准比例。
 */
#define JY60_ACCEL_RAW_TO_G                     (16.0f / 32768.0f)

/*
 * 上电静止标定至少需要的有效加速度帧数。
 * 原程序有2秒启动等待，通常可以收到约200帧。
 */
#define JY60_CALIBRATION_MIN_SAMPLES        (30U)

/*
 * 最多累计2000帧，避免长时间不结束标定造成求和溢出。
 */
#define JY60_CALIBRATION_MAX_SAMPLES        (2000U)

/*
 * ==============================================================
 * 启动和停车使用两套独立的加速度补偿参数。
 *
 * 本程序约定：
 *
 *   g_vehicle_accel_filtered_g > 0：小车向前启动/加速
 *   g_vehicle_accel_filtered_g < 0：小车向前行驶时减速/停车
 *
 * 该约定适用于A到B向前行驶。
 * 若向前启动时g_debug_vehicle_accel_mg为负，
 * 请修改JY60_ACCEL_AXIS_POLARITY，而不是交换下面两套参数。
 * ==============================================================
 */

/*
 * 启动阶段加速度低通滤波。
 * 当前启动补偿已经较好，保留原来的0.34。
 */
#define VEHICLE_START_FILTER_ALPHA          (0.34f)

/*
 * 停车减速阶段加速度低通滤波。
 * 数值大于启动滤波，可以更快识别刹车产生的负加速度。
 * 推荐调节范围：0.40～0.65。
 */
#define VEHICLE_STOP_FILTER_ALPHA           (0.65f)

/*
 * 小于0.015g约等于0.147m/s²，视为噪声。
 */
#define VEHICLE_ACCEL_DEADBAND_G            (0.015f)

/*
 * 最大只使用±0.30g进行补偿。
 * 对应理论倾角约±16.7°，
 * 但后面还会再由角度上限限制。
 */
#define VEHICLE_ACCEL_LIMIT_G               (0.30f)

/*
 * 启动加速补偿增益。
 * 当前启动效果好，先保持1.00。
 */
#define VEHICLE_START_COMPENSATION_GAIN     (2.00f)

/*
 * 停车减速补偿增益。
 *
 * 停车时钢球仍继续向车头冲：逐步增大到1.20、1.25。
 * 停车时钢球反而明显向车尾冲：逐步减小到1.10、1.05。
 */
#define VEHICLE_STOP_COMPENSATION_GAIN      (8.00f)

/*
 * 加速度前馈最大只占用±8°，
 * 给钢球位置PID保留剩余角度。
 */
#define VEHICLE_COMPENSATION_MAX_ANGLE_DEG  (8.0f)

/*
 * 启动时补偿角最大变化速度。
 */
#define VEHICLE_START_SLEW_DEG_S            (520.0f)

/*
 * 停车通常比启动更突然，因此让停车补偿角响应更快。
 */
#define VEHICLE_STOP_SLEW_DEG_S             (720.0f)

/*
 * 加速度回到死区后，补偿角返回0°的速度。
 *
 * 太大：停车补偿撤得太快，钢球容易二次反弹。
 * 太小：停车后轨道长时间保持倾斜。
 */
#define VEHICLE_ZERO_RETURN_SLEW_DEG_S      (180.0f)

/*
 * JY60掉线后缓慢回到0°，避免轨道突然跳回水平。
 */
#define VEHICLE_COMPENSATION_RETURN_DEG_S   (220.0f)

#define RAD_TO_DEG                          (57.2957795f)


/*==============================================================
 * 6. 坐标、速度、加速度和预测参数
 *==============================================================*/

/*
 * 位置低通滤波。
 *
 * 数值越大越跟随新坐标，越小越平滑。
 */
#define POSITION_FILTER_ALPHA               (0.72f)

/*
 * 多帧趋势速度与单帧速度的融合比例。
 *
 * 0.72表示主要相信最近5帧的整体趋势。
 */
#define MULTIFRAME_VELOCITY_WEIGHT          (0.72f)

/*
 * 速度低通滤波。
 */
#define VELOCITY_FILTER_ALPHA               (0.44f)

/*
 * 加速度低通滤波。
 *
 * 加速度比速度更容易受K230坐标抖动影响，
 * 所以滤波系数不能太大。
 */
#define ACCELERATION_FILTER_ALPHA           (0.20f)

/*
 * 用最近5帧估计运动趋势。
 */
#define MOTION_HISTORY_SIZE                 (5U)

/*
 * 至少3帧后才允许使用预测。
 */
#define PREDICTION_MIN_HISTORY_FRAMES       (3U)

/*
 * 允许完整坐标跳变。
 */
#define MAX_POSITION_JUMP_PER_FRAME_MM      (125.0f)

/*
 * 最大速度估计。
 */
#define MAX_BALL_SPEED_MM_S                 (500.0f)

/*
 * 最大加速度估计。
 *
 * 限幅用于防止偶发识别跳点直接产生很大的预测量。
 */
#define MAX_BALL_ACCEL_MM_S2                (3500.0f)

/*
 * 很小的加速度直接当作0，减少原点附近噪声。
 */
#define ACCELERATION_DEADBAND_MM_S2         (60.0f)

/*
 * 预测时间随K230实际帧间隔自动变化：
