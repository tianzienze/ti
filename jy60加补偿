/*==============================================================
 * 29A. JY60加速度帧提交
 *==============================================================*/

static void CommitJY60AccelerationFrame(
    const uint8_t *frame)
{
    int16_t rawX;
    int16_t rawY;
    int16_t rawZ;
    int16_t forwardRaw;


    rawX =
        (int16_t)(
            (uint16_t)frame[2] |
            ((uint16_t)frame[3] << 8));


    rawY =
        (int16_t)(
            (uint16_t)frame[4] |
            ((uint16_t)frame[5] << 8));


    rawZ =
        (int16_t)(
            (uint16_t)frame[6] |
            ((uint16_t)frame[7] << 8));


    g_jy60_accel_raw_x =
        rawX;

    g_jy60_accel_raw_y =
        rawY;

    g_jy60_accel_raw_z =
        rawZ;


    g_jy60_last_rx_ms =
        g_system_ms;


    g_jy60_valid_count++;


    /*
     * 上电2秒内车辆必须静止。
     * 在中断中直接累加原始值，避免浮点计算。
     */
    if ((g_jy60_collect_calibration != 0U) &&
        (g_jy60_calibration_count <
         JY60_CALIBRATION_MAX_SAMPLES))
    {
        forwardRaw =
            SelectJY60ForwardRaw(
                rawX,
                rawY,
                rawZ);


        g_jy60_calibration_sum_raw +=
            (int32_t)forwardRaw;


        g_jy60_calibration_count++;
    }
}


/*==============================================================
 * 29B. JY60字节流解析
 *==============================================================*/

static void ParseJY60Byte(uint8_t data)
{
    static uint8_t frame[
        JY60_FRAME_LENGTH];

    static uint8_t index = 0U;

    uint8_t checksum;

    uint32_t i;


    /*
     * 等待帧头0x55。
     */
    if (index == 0U)
    {
        if (data ==
            JY60_FRAME_HEADER)
        {
            frame[0] =
                data;

            index =
                1U;
        }

        return;
    }


    frame[index] =
        data;

    index++;


    if (index <
        JY60_FRAME_LENGTH)
    {
        return;
    }


    checksum =
        0U;


    for (i = 0U;
         i < 10U;
         i++)
    {
        checksum =
            (uint8_t)(
                checksum +
                frame[i]);
    }


    if (checksum ==
        frame[10])
    {
        if (frame[1] ==
            JY60_FRAME_ACCELERATION)
        {
            CommitJY60AccelerationFrame(
                frame);
        }
    }
    else
    {
        g_jy60_checksum_error_count++;
    }


    /*
     * 一帧处理完后重新等待0x55。
     */
    index =
        0U;
}


