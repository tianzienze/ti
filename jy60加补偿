/*==============================================================
 * 30. 更新位置和速度估计
 *==============================================================*/

static void UpdateBallMeasurement(
    float measurementMm,
    uint32_t sampleTimeMs)
{
    float dt;

    float measurementJump;

    float acceptedMeasurement;

    float instantVelocity;

    float trendVelocity;

    float rawVelocity;

    float oldVelocity;

    float recentVelocity;

    float rawAcceleration;

    float historySpanS;

    float oldSpanS;

    float recentSpanS;

    float accelerationSpanS;

    float predictionCorrection;

    uint32_t middleIndex;

    uint32_t index;


    if (g_observer_initialized == 0U)
    {
        g_last_accepted_position_mm =
            measurementMm;

        g_filtered_position_mm =
            measurementMm;

        g_previous_filtered_position_mm =
            measurementMm;

        g_filtered_velocity_mm_s =
            0.0f;

        g_filtered_acceleration_mm_s2 =
            0.0f;

        g_predicted_position_mm =
            measurementMm;

        g_predicted_velocity_mm_s =
            0.0f;

        g_prediction_time_s =
            PREDICTION_MIN_TIME_S;

        g_last_measurement_dt_s =
            0.01f;

        g_motion_position_history_mm[0] =
            measurementMm;

        g_motion_time_history_ms[0] =
            sampleTimeMs;

        g_motion_history_count =
            1U;

        g_last_measurement_time_ms =
            sampleTimeMs;

        g_observer_initialized = 1U;

        g_measurement_updated_for_control =
            1U;

        g_debug_frame_dt_ms = 0U;

        g_frame_process_count++;

        return;
    }


    dt =
        (float)(
            sampleTimeMs -
            g_last_measurement_time_ms) /
        1000.0f;


    if (dt < 0.005f)
    {
        dt = 0.005f;
    }

    if (dt > 0.150f)
    {
        dt = 0.150f;
    }


    g_last_measurement_dt_s =
        dt;


    g_debug_frame_dt_ms =
        (uint32_t)(
            dt *
            1000.0f +
            0.5f);


    measurementJump =
        measurementMm -
        g_last_accepted_position_mm;


    measurementJump =
        FloatClamp(
            measurementJump,
            -MAX_POSITION_JUMP_PER_FRAME_MM,
            MAX_POSITION_JUMP_PER_FRAME_MM);


    acceptedMeasurement =
        g_last_accepted_position_mm +
        measurementJump;


    g_last_accepted_position_mm =
        acceptedMeasurement;


    g_filtered_position_mm +=
        POSITION_FILTER_ALPHA *
        (
            acceptedMeasurement -
            g_filtered_position_mm
        );


    instantVelocity =
        (
            g_filtered_position_mm -
            g_previous_filtered_position_mm
        ) /
        dt;


    instantVelocity =
        FloatClamp(
            instantVelocity,
            -MAX_BALL_SPEED_MM_S,
            MAX_BALL_SPEED_MM_S);


    /*
     * 更新最近5帧历史。
     */
    if (g_motion_history_count <
        MOTION_HISTORY_SIZE)
    {
        g_motion_position_history_mm[
            g_motion_history_count] =
            g_filtered_position_mm;

        g_motion_time_history_ms[
            g_motion_history_count] =
            sampleTimeMs;

        g_motion_history_count++;
    }
    else
    {
        for (index = 0U;
             index <
             (MOTION_HISTORY_SIZE - 1U);
             index++)
        {
            g_motion_position_history_mm[index] =
                g_motion_position_history_mm[
                    index + 1U];

            g_motion_time_history_ms[index] =
                g_motion_time_history_ms[
                    index + 1U];
        }

        g_motion_position_history_mm[
            MOTION_HISTORY_SIZE - 1U] =
            g_filtered_position_mm;

        g_motion_time_history_ms[
            MOTION_HISTORY_SIZE - 1U] =
            sampleTimeMs;
    }


    trendVelocity =
        instantVelocity;

    rawAcceleration =
        0.0f;


    /*
     * 3帧以上时，用最旧帧到最新帧的总体斜率
     * 估计更稳定的速度。
     */
    if (g_motion_history_count >=
        PREDICTION_MIN_HISTORY_FRAMES)
    {
        historySpanS =
            (float)(
                g_motion_time_history_ms[
                    g_motion_history_count - 1U] -
                g_motion_time_history_ms[0]) /
            1000.0f;

        if (historySpanS >= 0.010f)
        {
            trendVelocity =
                (
                    g_motion_position_history_mm[
                        g_motion_history_count - 1U] -
                    g_motion_position_history_mm[0]
                ) /
                historySpanS;
        }
    }


    rawVelocity =
        MULTIFRAME_VELOCITY_WEIGHT *
        trendVelocity +
        (
            1.0f -
            MULTIFRAME_VELOCITY_WEIGHT
        ) *
        instantVelocity;


    rawVelocity =
        FloatClamp(
            rawVelocity,
            -MAX_BALL_SPEED_MM_S,
            MAX_BALL_SPEED_MM_S);


    /*
     * 5帧时，将历史分成前半段和后半段：
     *
     * 前半段速度 = 中间帧 - 最旧帧
     * 后半段速度 = 最新帧 - 中间帧
     *
     * 两段速度之差除以时间，得到多帧加速度。
     */
    if (g_motion_history_count >=
        MOTION_HISTORY_SIZE)
    {
        middleIndex =
            g_motion_history_count /
            2U;

        oldSpanS =
            (float)(
                g_motion_time_history_ms[middleIndex] -
                g_motion_time_history_ms[0]) /
            1000.0f;

        recentSpanS =
            (float)(
                g_motion_time_history_ms[
                    g_motion_history_count - 1U] -
                g_motion_time_history_ms[middleIndex]) /
            1000.0f;

        accelerationSpanS =
            (float)(
                g_motion_time_history_ms[
                    g_motion_history_count - 1U] -
                g_motion_time_history_ms[0]) /
            2000.0f;

        if ((oldSpanS >= 0.010f) &&
            (recentSpanS >= 0.010f) &&
            (accelerationSpanS >= 0.010f))
        {
            oldVelocity =
                (
                    g_motion_position_history_mm[middleIndex] -
                    g_motion_position_history_mm[0]
                ) /
                oldSpanS;

            recentVelocity =
                (
                    g_motion_position_history_mm[
                        g_motion_history_count - 1U] -
                    g_motion_position_history_mm[middleIndex]
                ) /
                recentSpanS;

            rawAcceleration =
                (
                    recentVelocity -
                    oldVelocity
                ) /
                accelerationSpanS;
        }
    }
    else
    {
        rawAcceleration =
            (
                rawVelocity -
                g_filtered_velocity_mm_s
            ) /
            dt;
    }


    rawAcceleration =
        FloatClamp(
            rawAcceleration,
            -MAX_BALL_ACCEL_MM_S2,
            MAX_BALL_ACCEL_MM_S2);


    g_filtered_velocity_mm_s +=
        VELOCITY_FILTER_ALPHA *
        (
            rawVelocity -
            g_filtered_velocity_mm_s
        );


    g_filtered_acceleration_mm_s2 +=
        ACCELERATION_FILTER_ALPHA *
        (
            rawAcceleration -
            g_filtered_acceleration_mm_s2
        );


    if (FloatAbs(
            g_filtered_acceleration_mm_s2) <
        ACCELERATION_DEADBAND_MM_S2)
    {
        g_filtered_acceleration_mm_s2 =
            0.0f;
    }


    /*
     * 根据当前实际帧率自动选择预测时间。
     */
    g_prediction_time_s =
        FloatClamp(
            dt *
            PREDICTION_FRAME_MULTIPLIER,
            PREDICTION_MIN_TIME_S,
            PREDICTION_MAX_TIME_S);


    predictionCorrection =
        g_filtered_velocity_mm_s *
        g_prediction_time_s +
        0.5f *
        g_filtered_acceleration_mm_s2 *
        g_prediction_time_s *
        g_prediction_time_s;


    predictionCorrection =
        FloatClamp(
            predictionCorrection,
            -PREDICTION_MAX_CORRECTION_MM,
            PREDICTION_MAX_CORRECTION_MM);


    g_predicted_position_mm =
        g_filtered_position_mm +
        predictionCorrection;


    g_predicted_velocity_mm_s =
        g_filtered_velocity_mm_s +
        g_filtered_acceleration_mm_s2 *
        g_prediction_time_s;


    g_predicted_velocity_mm_s =
        FloatClamp(
            g_predicted_velocity_mm_s,
            -MAX_BALL_SPEED_MM_S,
            MAX_BALL_SPEED_MM_S);


    g_previous_filtered_position_mm =
        g_filtered_position_mm;


    g_last_measurement_time_ms =
        sampleTimeMs;


    g_measurement_updated_for_control =
        1U;


    g_frame_process_count++;
}


/*==============================================================
 * 31. 角度斜率限制
 *==============================================================*/

static float ApplyAngleSlewLimit(
    float currentAngle,
    float requestedAngle,
    float slewRateDegS)
{
    float maximumChange;

    float difference;


    maximumChange =
        slewRateDegS *
        BALL_CONTROL_DT_S;


    difference =
        requestedAngle -
        currentAngle;


    difference =
        FloatClamp(
            difference,
            -maximumChange,
            maximumChange);


    return
        currentAngle +
        difference;
}


/*==============================================================
 * 31A. 完成JY60上电静止零偏标定
 *==============================================================*/

static void FinishJY60Calibration(void)
{
    int32_t calibrationSum;

    uint32_t calibrationCount;

    int16_t rawX;
    int16_t rawY;
    int16_t rawZ;


    __disable_irq();


    g_jy60_collect_calibration =
        0U;


    calibrationSum =
        g_jy60_calibration_sum_raw;


    calibrationCount =
        g_jy60_calibration_count;


    rawX =
        g_jy60_accel_raw_x;

    rawY =
        g_jy60_accel_raw_y;

    rawZ =
        g_jy60_accel_raw_z;


    __enable_irq();


    if (calibrationCount >=
        JY60_CALIBRATION_MIN_SAMPLES)
    {
        g_jy60_zero_raw =
            calibrationSum /
            (int32_t)calibrationCount;


        g_jy60_calibrated =
            1U;
    }
    else
    {
        /*
         * 帧数不足时只记录当前值，
         * 但不启用前馈，避免无效串口数据造成突然倾斜。
         */
        g_jy60_zero_raw =
            (int32_t)
            SelectJY60ForwardRaw(
                rawX,
                rawY,
                rawZ);


        g_jy60_calibrated =
            0U;
    }


    g_vehicle_accel_filtered_g =
        0.0f;


    g_vehicle_comp_target_angle_deg =
        0.0f;


    g_vehicle_comp_angle_deg =
        0.0f;


    g_debug_jy60_zero_raw =
        g_jy60_zero_raw;


    g_debug_jy60_calibrated =
        g_jy60_calibrated;
}


/*==============================================================
 * 31B. 100Hz更新小车加速度前馈角
 *==============================================================*/

static void UpdateVehicleCompensation100Hz(void)
{
    int16_t rawX;
    int16_t rawY;
    int16_t rawZ;

    int16_t forwardRaw;

    uint32_t lastRxMs;

    uint32_t ageMs;

    uint8_t calibrated;

    float measuredAccelG;

    float filteredForControl;

    float targetAngleDeg;

    float filterAlpha;

    float compensationGain;

    float compensationSlewDegS;

    uint32_t compensationPhase;


    __disable_irq();


    rawX =
        g_jy60_accel_raw_x;

    rawY =
        g_jy60_accel_raw_y;

    rawZ =
        g_jy60_accel_raw_z;


    lastRxMs =
        g_jy60_last_rx_ms;


    calibrated =
        g_jy60_calibrated;


    __enable_irq();


    ageMs =
        g_system_ms -
        lastRxMs;


    g_debug_jy60_age_ms =
        ageMs;


    forwardRaw =
        SelectJY60ForwardRaw(
            rawX,
            rawY,
            rawZ);


    g_debug_jy60_forward_raw =
        (int32_t)forwardRaw;


    if ((calibrated == 0U) ||
        (ageMs >
         JY60_TIMEOUT_MS))
    {
        g_debug_jy60_online =
            0U;


        g_vehicle_accel_filtered_g *=
            0.82f;


        g_vehicle_comp_target_angle_deg =
            0.0f;


        g_vehicle_comp_angle_deg =
            ApplyAngleSlewLimit(
                g_vehicle_comp_angle_deg,
                0.0f,
                VEHICLE_COMPENSATION_RETURN_DEG_S);


        g_debug_vehicle_accel_mg =
            FloatToInt32(
                g_vehicle_accel_filtered_g *
                1000.0f);


        g_debug_vehicle_comp_target_x100 =
            0;


        g_debug_vehicle_comp_angle_x100 =
            FloatToInt32(
                g_vehicle_comp_angle_deg *
                100.0f);


        g_debug_vehicle_comp_phase =
            3U;


        g_debug_vehicle_filter_alpha_x1000 =
            0;


        g_debug_vehicle_comp_gain_x1000 =
            0;


        g_debug_vehicle_comp_slew_deg_s =
            FloatToInt32(
                VEHICLE_COMPENSATION_RETURN_DEG_S);


        return;
    }


    g_debug_jy60_online =
        1U;


    measuredAccelG =
        (
            (float)(
                (int32_t)forwardRaw -
                g_jy60_zero_raw)
        ) *
        JY60_ACCEL_RAW_TO_G *
        JY60_ACCEL_AXIS_POLARITY;


    measuredAccelG =
        FloatClamp(
            measuredAccelG,
            -VEHICLE_ACCEL_LIMIT_G,
            VEHICLE_ACCEL_LIMIT_G);


    /*
     * 根据“本次刚测到的加速度方向”选择滤波响应速度。
     *
     * 向前启动为正，使用启动滤波；
     * 向前停车为负，使用停车滤波。
     *
     * 零附近仍使用启动滤波，避免静止噪声在两套参数间频繁切换。
     */
    if (measuredAccelG <
        -VEHICLE_ACCEL_DEADBAND_G)
    {
        filterAlpha =
            VEHICLE_STOP_FILTER_ALPHA;
    }
    else
    {
        filterAlpha =
            VEHICLE_START_FILTER_ALPHA;
    }


    g_vehicle_accel_filtered_g +=
        filterAlpha *
        (
            measuredAccelG -
            g_vehicle_accel_filtered_g
        );


    filteredForControl =
        g_vehicle_accel_filtered_g;


    if (FloatAbs(
            filteredForControl) <
        VEHICLE_ACCEL_DEADBAND_G)
    {
        filteredForControl =
            0.0f;
    }


    /*
     * 根据滤波后的加速度方向，选择真正用于角度计算的增益和斜率。
     *
     * 0：匀速、静止或加速度进入死区
     * 1：向前启动/加速
     * 2：向前减速/停车
     */
    if (filteredForControl <
        -VEHICLE_ACCEL_DEADBAND_G)
    {
        compensationPhase =
            2U;

        compensationGain =
            VEHICLE_STOP_COMPENSATION_GAIN;

        compensationSlewDegS =
            VEHICLE_STOP_SLEW_DEG_S;
    }
    else if (filteredForControl >
             VEHICLE_ACCEL_DEADBAND_G)
    {
        compensationPhase =
            1U;

        compensationGain =
            VEHICLE_START_COMPENSATION_GAIN;

        compensationSlewDegS =
            VEHICLE_START_SLEW_DEG_S;
    }
    else
    {
        compensationPhase =
            0U;

        /*
         * 此时目标角为0°。
         * 使用单独的慢回零速度，避免停车补偿突然撤销。
         */
        compensationGain =
            VEHICLE_START_COMPENSATION_GAIN;

        compensationSlewDegS =
            VEHICLE_ZERO_RETURN_SLEW_DEG_S;
    }


    /*
     * 非惯性系中钢球沿轨道的加速度近似：
     *
     *      a_ball = g*sin(theta) - a_car*cos(theta)
     *
     * 令a_ball=0：
     *
     *      tan(theta) = a_car/g
     *
     * JY60这里已经用g为单位，
     * 因而theta=atan(acceleration_g)。
     */
    targetAngleDeg =
        AtanApproxRad(
            filteredForControl) *
        RAD_TO_DEG *
        compensationGain *
        VEHICLE_COMPENSATION_POLARITY;


    targetAngleDeg =
        FloatClamp(
            targetAngleDeg,
            -VEHICLE_COMPENSATION_MAX_ANGLE_DEG,
            VEHICLE_COMPENSATION_MAX_ANGLE_DEG);


    g_vehicle_comp_target_angle_deg =
        targetAngleDeg;


    g_vehicle_comp_angle_deg =
        ApplyAngleSlewLimit(
            g_vehicle_comp_angle_deg,
            g_vehicle_comp_target_angle_deg,
            compensationSlewDegS);


    g_debug_vehicle_accel_mg =
        FloatToInt32(
            g_vehicle_accel_filtered_g *
            1000.0f);


    g_debug_vehicle_comp_target_x100 =
        FloatToInt32(
            g_vehicle_comp_target_angle_deg *
            100.0f);


    g_debug_vehicle_comp_angle_x100 =
        FloatToInt32(
            g_vehicle_comp_angle_deg *
            100.0f);


    g_debug_vehicle_comp_phase =
        compensationPhase;


    g_debug_vehicle_filter_alpha_x1000 =
        FloatToInt32(
            filterAlpha *
            1000.0f);


    g_debug_vehicle_comp_gain_x1000 =
        FloatToInt32(
            compensationGain *
            1000.0f);


    g_debug_vehicle_comp_slew_deg_s =
        FloatToInt32(
            compensationSlewDegS);
}


/*
 * 把小车加速度前馈角加入钢球反馈角，
 * 最后再做总软件角度限位。
 *
 * 输入和输出均为“乘BALL_CONTROL_POLARITY之前”的控制角。
 */
static float AddVehicleCompensation(
    float ballFeedbackAngleDeg)
{
    return
        FloatClamp(
            ballFeedbackAngleDeg +
            g_vehicle_comp_angle_deg,
            -MAX_MOTOR_ANGLE_DEG,
            MAX_MOTOR_ANGLE_DEG);
}


/*==============================================================
 * 32. 根据预测速度和加速度计算捕获制动角度
 *==============================================================*/

static float CalculateCaptureBrakeAngle(
    float velocityMmS,
    float accelerationMmS2)
{
    float brakeAngle;

    float velocitySign;


    velocitySign =
        FloatSign(
            velocityMmS);


    brakeAngle =
        BALL_CAPTURE_KD *
        velocityMmS +
        BALL_CAPTURE_KA *
        accelerationMmS2;


    /*
     * 低速时仍保证有足够的制动角度。
     */
    if ((velocitySign != 0.0f) &&
        (FloatAbs(brakeAngle) <
         BALL_CAPTURE_MIN_ANGLE_DEG))
    {
        brakeAngle =
            velocitySign *
            BALL_CAPTURE_MIN_ANGLE_DEG;
    }


    return
        FloatClamp(
            brakeAngle,
            -BALL_CAPTURE_MAX_ANGLE_DEG,
            BALL_CAPTURE_MAX_ANGLE_DEG);
}


/*==============================================================
 * 33. 进入原点软着陆
 *==============================================================*/

static void EnterCenterSettling(void)
{
    g_balance_state =
        BALL_STATE_BRAKING;

    g_center_confirm_count =
        0U;

    g_center_exit_confirm_count =
        0U;

    g_static_bias_angle_deg =
        0.0f;

    g_pid_integral_mm_s =
        0.0f;

    g_breakaway_target_angle_deg =
        0.0f;

    g_capture_brake_angle_deg =
        0.0f;

    g_capture_started_predictively =
        0U;

    g_debug_predictive_capture =
        0U;

    g_progress_initialized =
        0U;
}


/*==============================================================
 * 34. 进入原点锁定
 *==============================================================*/

static void EnterCenterHolding(void)
{
    g_balance_state =
        BALL_STATE_HOLDING;

    g_center_confirm_count =
        BALL_CENTER_CONFIRM_FRAMES;

    g_static_bias_angle_deg =
        0.0f;

    g_breakaway_target_angle_deg =
        0.0f;

    g_capture_brake_angle_deg =
        0.0f;

    g_breakaway_level =
        0U;

    g_progress_initialized =
        0U;

    g_capture_cooldown_remaining_ms =
        CAPTURE_COOLDOWN_MS;

    g_center_exit_confirm_count =
        0U;

    g_capture_started_predictively =
        0U;

    g_debug_predictive_capture =
        0U;

    g_pid_integral_mm_s =
        0.0f;

    g_pid_p_angle_deg =
        0.0f;

    g_pid_i_angle_deg =
        0.0f;

    g_pid_d_angle_deg =
        0.0f;

    g_pid_a_angle_deg =
        0.0f;

    /*
     * 不再把轨道角度瞬间清零。
     * 保留已经学习到的小偏置，并由锁定状态慢慢调整。
     */
    g_requested_motor_angle_deg =
        AddVehicleCompensation(
            g_center_trim_angle_deg) *
        BALL_CONTROL_POLARITY;
}


/*==============================================================
 * 35. 钢球100Hz控制
 *==============================================================*/

static void BallPositionControl100Hz(
    uint8_t receivedNewMeasurement)
{
    float controlPosition;

    float velocity;

    float acceleration;

    float predictedPosition;

    float predictedVelocity;

    float pidPosition;

    float absPosition;

    float absVelocity;

    float absPredictedPosition;

    float positionSign;

    float integralLimit;

    float requestedBeforePolarity;

    float limitedRequested;

    float angleLimit;

    float progressMm;

    float breakawayExtraAngle;

    float timeToCenterS;

    uint32_t uartAgeMs;

    uint32_t stateElapsedMs;

    uint8_t movingTowardCenter;

    uint8_t crossedCenter;

    uint8_t predictionReady;

    uint8_t predictedCrossing;

    uint8_t predictiveCaptureCondition;


    g_debug_predictive_capture =
        g_capture_started_predictively;


    /*
     * 每个100Hz控制周期先更新JY60车辆加速度前馈角。
     */
    UpdateVehicleCompensation100Hz();


    /*
     * 捕获冷却时间递减。
     */
    if (g_capture_cooldown_remaining_ms >
        0U)
    {
        if (g_capture_cooldown_remaining_ms >
            10U)
        {
            g_capture_cooldown_remaining_ms -=
                10U;
        }
        else
        {
            g_capture_cooldown_remaining_ms =
                0U;
        }
    }


    uartAgeMs =
        g_system_ms -
        g_k230_last_rx_ms;


    g_debug_uart_age_ms =
        uartAgeMs;


    /*
     * 通信未初始化或者超时。
     */
    if ((g_observer_initialized == 0U) ||
        (uartAgeMs >
         K230_TIMEOUT_MS))
    {
        g_balance_state =
            BALL_STATE_WAITING;

        g_capture_started_predictively =
            0U;

        g_debug_predictive_capture =
            0U;

        g_center_confirm_count =
            0U;

        g_static_bias_angle_deg *=
            0.90f;

        g_pid_integral_mm_s *=
            0.85f;

        g_pid_p_angle_deg =
            0.0f;

        g_pid_i_angle_deg =
            BALL_PID_KI *
            g_pid_integral_mm_s;

        g_pid_d_angle_deg =
            0.0f;

        g_pid_a_angle_deg =
            0.0f;

        g_progress_initialized =
            0U;

        g_breakaway_target_angle_deg =
            0.0f;

        g_capture_brake_angle_deg =
            0.0f;

        g_requested_motor_angle_deg =
            0.0f;

        g_applied_motor_angle_deg =
            ApplyAngleSlewLimit(
                g_applied_motor_angle_deg,
                0.0f,
                LEVEL_RETURN_SLEW_DEG_S);

        g_debug_pid_position_x10 =
            0;

        UpdateControlDebug(
            0.0f,
            0.0f);

        return;
    }


    /*
     * 状态判定使用K230当前原始位置。
     */
    controlPosition =
        (float)g_k230_position_mm;


    velocity =
        g_filtered_velocity_mm_s;


    acceleration =
        g_filtered_acceleration_mm_s2;


    predictedPosition =
        g_predicted_position_mm;


    predictedVelocity =
        g_predicted_velocity_mm_s;


    if (g_motion_history_count >=
        PREDICTION_MIN_HISTORY_FRAMES)
    {
        predictionReady = 1U;
    }
    else
    {
        predictionReady = 0U;

        predictedPosition =
            g_filtered_position_mm;

        predictedVelocity =
            velocity;
    }


    absPosition =
        FloatAbs(
            controlPosition);


    absVelocity =
        FloatAbs(
            velocity);


    absPredictedPosition =
        FloatAbs(
            predictedPosition);


    positionSign =
        FloatSign(
            controlPosition);


    /*
     * 位置和速度异号：小球正在向0运动。
     */
    if ((controlPosition *
         velocity) < 0.0f)
    {
        movingTowardCenter = 1U;
    }
    else
    {
        movingTowardCenter = 0U;
    }


    /*
     * 判断实际位置是否已经穿过原点。
     */
    if ((controlPosition *
         g_previous_control_position_mm) <
        0.0f)
    {
        crossedCenter = 1U;
    }
    else
    {
        crossedCenter = 0U;
    }


    g_previous_control_position_mm =
        controlPosition;


    /*
     * 判断预测轨迹是否会在预测时间内穿过0点。
     */
    if ((predictionReady != 0U) &&
        (controlPosition != 0.0f) &&
        ((controlPosition *
          predictedPosition) <= 0.0f))
    {
        predictedCrossing = 1U;
    }
    else
    {
        predictedCrossing = 0U;
    }


    timeToCenterS =
        1000.0f;


    if ((movingTowardCenter != 0U) &&
        (absVelocity >=
         BALL_CAPTURE_MIN_SPEED_MM_S))
    {
        timeToCenterS =
            absPosition /
            absVelocity;
    }


    /*
     * 穿过原点时立即清除旧方向积分和静摩擦补偿。
     */
    if (crossedCenter != 0U)
    {
        g_static_bias_angle_deg =
            0.0f;

        g_pid_integral_mm_s =
            0.0f;

        g_breakaway_level =
            0U;

        g_progress_initialized =
            0U;
    }


    /*
     * ==========================================================
     * 原点锁定状态
     * ==========================================================
     */
    if (g_balance_state ==
        BALL_STATE_HOLDING)
    {
        float holdVelocity;
        float holdBeforePolarity;
        float trimError;


        if (receivedNewMeasurement != 0U)
        {
            if (absPosition >
                BALL_CENTER_EXIT_MM)
            {
                g_center_exit_confirm_count++;
            }
            else
            {
                g_center_exit_confirm_count =
                    0U;
            }


            /*
             * 只在低速时慢慢学习轨道的真实水平偏置。
             * 这样不会因为轨道略微不水平而每次都漂出中心区。
             */
            if (absVelocity <=
                CENTER_TRIM_ACTIVE_SPEED_MM_S)
            {
                trimError =
                    g_filtered_position_mm;

                if (FloatAbs(trimError) <=
                    CENTER_POSITION_DEADBAND_MM)
                {
                    trimError =
                        0.0f;
                }

                g_center_trim_angle_deg +=
                    CENTER_TRIM_KI *
                    trimError *
                    g_last_measurement_dt_s;

                g_center_trim_angle_deg =
                    FloatClamp(
                        g_center_trim_angle_deg,
                        -CENTER_TRIM_MAX_ANGLE_DEG,
                        CENTER_TRIM_MAX_ANGLE_DEG);
            }
        }


        if (g_center_exit_confirm_count >=
            CENTER_EXIT_CONFIRM_FRAMES)
        {
            EnterCenterSettling();

            UpdateControlDebug(
                controlPosition,
                velocity);

            return;
        }


        holdVelocity =
            velocity;

        if (FloatAbs(holdVelocity) <=
            CENTER_VELOCITY_DEADBAND_MM_S)
        {
            holdVelocity =
                0.0f;
        }


        holdBeforePolarity =
            g_center_trim_angle_deg +
            CENTER_HOLD_KD *
            holdVelocity;


        holdBeforePolarity =
            FloatClamp(
                holdBeforePolarity,
                -CENTER_HOLD_MAX_ANGLE_DEG,
                CENTER_HOLD_MAX_ANGLE_DEG);


        g_requested_motor_angle_deg =
            AddVehicleCompensation(
                holdBeforePolarity) *
            BALL_CONTROL_POLARITY;


        g_applied_motor_angle_deg =
            ApplyAngleSlewLimit(
                g_applied_motor_angle_deg,
                g_requested_motor_angle_deg,
                CENTER_HOLD_SLEW_DEG_S);


        g_static_bias_angle_deg =
            0.0f;

        g_pid_integral_mm_s =
            0.0f;

        g_pid_p_angle_deg =
            0.0f;

        g_pid_i_angle_deg =
            0.0f;

        g_pid_d_angle_deg =
            CENTER_HOLD_KD *
            holdVelocity;

        g_pid_a_angle_deg =
            0.0f;

        g_breakaway_target_angle_deg =
            0.0f;

        g_capture_brake_angle_deg =
            0.0f;

        g_debug_pid_position_x10 =
            FloatToInt32(
                controlPosition *
                10.0f);

        UpdateControlDebug(
            controlPosition,
            velocity);

        return;
    }


    /*
     * ==========================================================
     * 预测捕获状态
     * ==========================================================
     */
    if (g_balance_state ==
        BALL_STATE_CAPTURE)
    {
        stateElapsedMs =
            g_system_ms -
            g_capture_start_ms;


        g_debug_capture_elapsed_ms =
            stateElapsedMs;


        /*
         * 每收到一帧都根据最新预测速度和加速度
         * 动态更新制动角度。
         */
        if ((receivedNewMeasurement != 0U) &&
            (absVelocity >=
             (BALL_CAPTURE_MIN_SPEED_MM_S *
              0.5f)))
        {
            g_capture_brake_angle_deg =
                CalculateCaptureBrakeAngle(
                    predictedVelocity,
                    acceleration);
        }


        g_requested_motor_angle_deg =
            AddVehicleCompensation(
                g_capture_brake_angle_deg) *
            BALL_CONTROL_POLARITY;


        g_applied_motor_angle_deg =
            ApplyAngleSlewLimit(
                g_applied_motor_angle_deg,
                g_requested_motor_angle_deg,
                BALL_CAPTURE_SLEW_DEG_S);


        /*
         * 真正满足“位置小、速度低”后才锁定。
         * 不再因为刚穿过0点就立即撤掉制动。
         */
        if (
            (stateElapsedMs >=
             BALL_CAPTURE_MIN_TIME_MS) &&
            (absPosition <=
             BALL_CENTER_ENTER_MM) &&
            (absVelocity <=
             BALL_CENTER_ENTER_SPEED_MM_S)
        )
        {
            EnterCenterHolding();

            UpdateControlDebug(
                controlPosition,
                velocity);

            return;
        }


        if (
            (stateElapsedMs >=
             BALL_CAPTURE_MIN_TIME_MS) &&
            (absPosition <=
             CENTER_SETTLE_ENTER_MM) &&
            (absVelocity <=
             BALL_CAPTURE_STOP_SPEED_MM_S)
        )
        {
            EnterCenterSettling();

            UpdateControlDebug(
                controlPosition,
                velocity);

            return;
        }


        /*
         * 已经被制停并开始向远离0点方向返回时，
         * 退出捕获，交回PID重新拉回。
         */
        if (
            (stateElapsedMs >=
             BALL_CAPTURE_MIN_TIME_MS) &&
            ((controlPosition *
              velocity) > 0.0f) &&
            (absPosition >
             BALL_CENTER_ENTER_MM)
        )
        {
            if (absPosition <=
                CENTER_SETTLE_EXIT_MM)
            {
                EnterCenterSettling();
            }
            else
            {
                g_balance_state =
                    BALL_STATE_PULLING;
            }

            g_capture_started_predictively =
                0U;

            g_debug_predictive_capture =
                0U;

            g_capture_brake_angle_deg =
                0.0f;

            g_capture_cooldown_remaining_ms =
                CAPTURE_COOLDOWN_MS;

            g_progress_initialized =
                0U;

            g_pid_integral_mm_s =
                0.0f;

            UpdateControlDebug(
                controlPosition,
                velocity);

            return;
        }


        if (stateElapsedMs >=
            BALL_CAPTURE_MAX_TIME_MS)
        {
            if ((absPosition <=
                 BALL_CENTER_EXIT_MM) &&
                (absVelocity <=
                 BALL_CENTER_ENTER_SPEED_MM_S))
            {
                EnterCenterHolding();
            }
            else
            {
                if (absPosition <=
                    CENTER_SETTLE_EXIT_MM)
                {
                    EnterCenterSettling();
                }
                else
                {
                    g_balance_state =
                        BALL_STATE_PULLING;
                }

                g_capture_started_predictively =
                    0U;

                g_debug_predictive_capture =
                    0U;

                g_capture_brake_angle_deg =
                    0.0f;

                g_capture_cooldown_remaining_ms =
                    CAPTURE_COOLDOWN_MS;

                g_progress_initialized =
                    0U;

                g_pid_integral_mm_s =
                    0.0f;
            }


            UpdateControlDebug(
                controlPosition,
                velocity);

            return;
        }


        UpdateControlDebug(
            controlPosition,
            velocity);

        return;
    }


    /*
     * ==========================================================
     * 破静摩擦脉冲状态
     * ==========================================================
     */
    if (g_balance_state ==
        BALL_STATE_BREAKAWAY)
    {
        stateElapsedMs =
            g_system_ms -
            g_breakaway_start_ms;


        g_debug_breakaway_elapsed_ms =
            stateElapsedMs;


        g_requested_motor_angle_deg =
            AddVehicleCompensation(
                g_breakaway_target_angle_deg) *
            BALL_CONTROL_POLARITY;


        g_applied_motor_angle_deg =
            ApplyAngleSlewLimit(
                g_applied_motor_angle_deg,
                g_requested_motor_angle_deg,
                BREAKAWAY_SLEW_DEG_S);


        if (
            (stateElapsedMs >=
             BREAKAWAY_MIN_TIME_MS) &&
            (movingTowardCenter != 0U) &&
            (absVelocity >=
             BREAKAWAY_RELEASE_SPEED_MM_S)
        )
        {
            g_balance_state =
                BALL_STATE_PULLING;

            g_breakaway_target_angle_deg =
                0.0f;

            g_progress_reference_abs_mm =
                absPosition;

            g_progress_reference_ms =
                g_system_ms;

            g_progress_initialized =
                1U;

            UpdateControlDebug(
                controlPosition,
                velocity);

            return;
        }


        /*
         * 已经接近捕获区域，立即结束冲击，
         * 下一次控制周期由预测捕获判断接管。
         */
        if ((absPosition <=
             BALL_CAPTURE_ENTER_MM) ||
            (predictedCrossing != 0U) ||
            (absPredictedPosition <=
             PREDICTIVE_CAPTURE_WINDOW_MM))
        {
            g_balance_state =
                BALL_STATE_PULLING;

            g_breakaway_target_angle_deg =
                0.0f;

            g_progress_initialized =
                0U;

            UpdateControlDebug(
                controlPosition,
                velocity);

            return;
        }


        if (stateElapsedMs >=
            BREAKAWAY_MAX_TIME_MS)
        {
            g_balance_state =
                BALL_STATE_PULLING;

            g_breakaway_target_angle_deg =
                0.0f;

            g_progress_reference_abs_mm =
                absPosition;

            g_progress_reference_ms =
                g_system_ms;

            g_progress_initialized =
                1U;

            UpdateControlDebug(
                controlPosition,
                velocity);

            return;
        }


        UpdateControlDebug(
            controlPosition,
            velocity);

        return;
    }


    /*
     * ==========================================================
     * 原点附近低增益软着陆状态
     * ==========================================================
     */
    if ((g_balance_state ==
         BALL_STATE_BRAKING) ||
        ((g_balance_state ==
          BALL_STATE_PULLING) &&
         (absPosition <=
          CENTER_SETTLE_ENTER_MM) &&
         (absVelocity <=
          CENTER_SETTLE_ENTRY_SPEED_MM_S)))
    {
        float settlePosition;
        float settleVelocity;
        float settleBeforePolarity;
        float trimError;


        if (g_balance_state !=
            BALL_STATE_BRAKING)
        {
            EnterCenterSettling();
        }


        if (absPosition >
            CENTER_SETTLE_EXIT_MM)
        {
            g_balance_state =
                BALL_STATE_PULLING;

            g_center_confirm_count =
                0U;
        }
        else
        {
            settlePosition =
                g_filtered_position_mm;

            settleVelocity =
                velocity;


            if (FloatAbs(settlePosition) <=
                CENTER_POSITION_DEADBAND_MM)
            {
                settlePosition =
                    0.0f;
            }


            if (FloatAbs(settleVelocity) <=
                CENTER_VELOCITY_DEADBAND_MM_S)
            {
                settleVelocity =
                    0.0f;
            }


            if ((receivedNewMeasurement != 0U) &&
                (absVelocity <=
                 CENTER_TRIM_ACTIVE_SPEED_MM_S))
            {
                trimError =
                    settlePosition;

                g_center_trim_angle_deg +=
                    CENTER_TRIM_KI *
                    trimError *
                    g_last_measurement_dt_s;

                g_center_trim_angle_deg =
                    FloatClamp(
                        g_center_trim_angle_deg,
                        -CENTER_TRIM_MAX_ANGLE_DEG,
                        CENTER_TRIM_MAX_ANGLE_DEG);
            }


            if (receivedNewMeasurement != 0U)
            {
                if ((absPosition <=
                     BALL_CENTER_ENTER_MM) &&
                    (absVelocity <=
                     BALL_CENTER_ENTER_SPEED_MM_S))
                {
                    g_center_confirm_count++;
                }
                else
                {
                    g_center_confirm_count =
                        0U;
                }
            }


            if (g_center_confirm_count >=
                BALL_CENTER_CONFIRM_FRAMES)
            {
                EnterCenterHolding();

                UpdateControlDebug(
                    controlPosition,
                    velocity);

                return;
            }


            settleBeforePolarity =
                g_center_trim_angle_deg +
                CENTER_SETTLE_KP *
                settlePosition +
                CENTER_SETTLE_KD *
                settleVelocity;


            settleBeforePolarity =
                FloatClamp(
                    settleBeforePolarity,
                    -CENTER_SETTLE_MAX_ANGLE_DEG,
                    CENTER_SETTLE_MAX_ANGLE_DEG);


            g_requested_motor_angle_deg =
                AddVehicleCompensation(
                    settleBeforePolarity) *
                BALL_CONTROL_POLARITY;


            g_applied_motor_angle_deg =
                ApplyAngleSlewLimit(
                    g_applied_motor_angle_deg,
                    g_requested_motor_angle_deg,
                    CENTER_SETTLE_SLEW_DEG_S);


            g_pid_p_angle_deg =
                CENTER_SETTLE_KP *
                settlePosition;

            g_pid_i_angle_deg =
                g_center_trim_angle_deg;

            g_pid_d_angle_deg =
                CENTER_SETTLE_KD *
                settleVelocity;

            g_pid_a_angle_deg =
                0.0f;

            g_pid_integral_mm_s =
                0.0f;

            g_static_bias_angle_deg =
                0.0f;

            g_breakaway_target_angle_deg =
                0.0f;

            g_capture_brake_angle_deg =
                0.0f;

            g_debug_pid_position_x10 =
                FloatToInt32(
                    settlePosition *
                    10.0f);


            UpdateControlDebug(
                controlPosition,
                velocity);

            return;
        }
    }


    /*
     * ==========================================================
     * 位置和速度都进入中心范围后锁定
     * ==========================================================
     */
    if (receivedNewMeasurement != 0U)
    {
        if ((absPosition <=
             BALL_CENTER_ENTER_MM) &&
            (absVelocity <=
             BALL_CENTER_ENTER_SPEED_MM_S))
        {
            g_center_confirm_count++;


            if (g_center_confirm_count >=
                BALL_CENTER_CONFIRM_FRAMES)
            {
                EnterCenterHolding();

                UpdateControlDebug(
                    controlPosition,
                    velocity);

                return;
            }
        }
        else
        {
            g_center_confirm_count =
                0U;
        }
    }


    /*
     * ==========================================================
     * 预测捕获判断
     * ==========================================================
     */
    predictiveCaptureCondition =
        0U;


    if ((predictionReady != 0U) &&
        (absPosition <=
         PREDICTIVE_CAPTURE_MAX_DISTANCE_MM))
    {
        if ((predictedCrossing != 0U) ||
            (absPredictedPosition <=
             PREDICTIVE_CAPTURE_WINDOW_MM) ||
            (timeToCenterS <=
             PREDICTIVE_CAPTURE_MAX_TTC_S))
        {
            predictiveCaptureCondition =
                1U;
        }
    }


    if (
        (receivedNewMeasurement != 0U) &&
        (g_capture_cooldown_remaining_ms ==
         0U) &&
        (absPosition >
         CENTER_SETTLE_ENTER_MM) &&
        (movingTowardCenter != 0U) &&
        (absVelocity >=
         BALL_CAPTURE_MIN_SPEED_MM_S) &&
        (
            (absPosition <=
             BALL_CAPTURE_ENTER_MM) ||
            (predictiveCaptureCondition != 0U)
        )
    )
    {
        g_balance_state =
            BALL_STATE_CAPTURE;


        g_capture_start_ms =
            g_system_ms;


        g_capture_brake_angle_deg =
            CalculateCaptureBrakeAngle(
                predictedVelocity,
                acceleration);


        g_static_bias_angle_deg =
            0.0f;


        g_pid_integral_mm_s =
            0.0f;


        g_breakaway_target_angle_deg =
            0.0f;


        g_progress_initialized =
            0U;


        g_requested_motor_angle_deg =
            AddVehicleCompensation(
                g_capture_brake_angle_deg) *
            BALL_CONTROL_POLARITY;


        g_applied_motor_angle_deg =
            ApplyAngleSlewLimit(
                g_applied_motor_angle_deg,
                g_requested_motor_angle_deg,
                BALL_CAPTURE_SLEW_DEG_S);


        g_debug_capture_elapsed_ms =
            0U;


        if (predictiveCaptureCondition != 0U)
        {
            g_capture_started_predictively =
                1U;
        }
        else
        {
            g_capture_started_predictively =
                0U;
        }


        g_debug_predictive_capture =
            g_capture_started_predictively;


        UpdateControlDebug(
            controlPosition,
            velocity);

        return;
    }


    /*
     * ==========================================================
     * 回中进度检测及静摩擦处理
     * ==========================================================
     */
    if (g_progress_initialized == 0U)
    {
        g_progress_reference_abs_mm =
            absPosition;

        g_progress_reference_ms =
            g_system_ms;

        g_progress_initialized =
            1U;
    }
    else if ((uint32_t)(
                 g_system_ms -
                 g_progress_reference_ms) >=
             BALL_PROGRESS_CHECK_MS)
    {
        progressMm =
            g_progress_reference_abs_mm -
            absPosition;


        if ((absPosition >
             BALL_CENTER_EXIT_MM) &&
            (progressMm <
             BALL_MIN_PROGRESS_MM))
        {
            if ((g_static_bias_angle_deg *
                 positionSign) < 0.0f)
            {
                g_static_bias_angle_deg =
                    0.0f;

                g_breakaway_level =
                    0U;
            }


            g_static_bias_angle_deg +=
                positionSign *
                STATIC_BIAS_STEP_DEG;


            g_static_bias_angle_deg =
                FloatClamp(
                    g_static_bias_angle_deg,
                    -STATIC_BIAS_MAX_DEG,
                    STATIC_BIAS_MAX_DEG);


            if (g_breakaway_level <
                BREAKAWAY_MAX_LEVEL)
            {
                g_breakaway_level++;
            }


            breakawayExtraAngle =
                BREAKAWAY_BASE_ANGLE_DEG +
                (
                    (float)g_breakaway_level *
                    BREAKAWAY_LEVEL_STEP_DEG
                );


            g_breakaway_target_angle_deg =
                BALL_PID_KP *
                controlPosition +
                g_static_bias_angle_deg +
                positionSign *
                breakawayExtraAngle;


            g_breakaway_target_angle_deg =
                FloatClamp(
                    g_breakaway_target_angle_deg,
                    -MAX_MOTOR_ANGLE_DEG,
                    MAX_MOTOR_ANGLE_DEG);


            g_breakaway_start_ms =
                g_system_ms;


            g_balance_state =
                BALL_STATE_BREAKAWAY;


            g_breakaway_count++;


            g_progress_initialized =
                0U;


            g_pid_integral_mm_s =
                0.0f;


            UpdateControlDebug(
                controlPosition,
                velocity);

            return;
        }
        else
        {
            if (progressMm >=
                BALL_MIN_PROGRESS_MM)
            {
                g_static_bias_angle_deg *=
                    STATIC_BIAS_DECAY;


                if (g_breakaway_level >
                    0U)
                {
                    g_breakaway_level--;
                }
            }
        }


        g_progress_reference_abs_mm =
            absPosition;


        g_progress_reference_ms =
            g_system_ms;
    }


    /*
     * ==========================================================
     * 位置PID + 多帧加速度预测控制
     * ==========================================================
     */

    if (predictionReady != 0U)
    {
        float predictionWeight;


        if (absPosition <=
            25.0f)
        {
            predictionWeight =
                0.30f;
        }
        else
        {
            predictionWeight =
                PREDICTION_POSITION_WEIGHT;
        }


        pidPosition =
            predictionWeight *
            predictedPosition +
            (
                1.0f -
                predictionWeight
            ) *
            controlPosition;
    }
    else
    {
        pidPosition =
            controlPosition;
    }


    g_debug_pid_position_x10 =
        FloatToInt32(
            pidPosition *
            10.0f);


    /*
     * 积分只在新坐标到达时更新，
     * 避免100Hz控制循环重复积分同一帧数据。
     */
    if (receivedNewMeasurement != 0U)
    {
        if ((absPosition <=
             PID_INTEGRAL_ACTIVE_MM) &&
            (absVelocity <=
             PID_INTEGRAL_MAX_SPEED_MM_S) &&
            (crossedCenter == 0U))
        {
            g_pid_integral_mm_s +=
                g_filtered_position_mm *
                g_last_measurement_dt_s;
        }
        else
        {
            g_pid_integral_mm_s *=
                PID_INTEGRAL_DECAY;
        }
    }


    integralLimit =
        PID_INTEGRAL_MAX_ANGLE_DEG /
        BALL_PID_KI;


    g_pid_integral_mm_s =
        FloatClamp(
            g_pid_integral_mm_s,
            -integralLimit,
            integralLimit);


    g_pid_p_angle_deg =
        BALL_PID_KP *
        pidPosition;


    g_pid_i_angle_deg =
        BALL_PID_KI *
        g_pid_integral_mm_s;


    g_pid_d_angle_deg =
        BALL_PID_KD *
        predictedVelocity;


    if (absPosition <=
        25.0f)
    {
        /*
         * 中心附近不使用加速度项，避免坐标噪声被二次差分放大。
         */
        g_pid_a_angle_deg =
            0.0f;
    }
    else
    {
        g_pid_a_angle_deg =
            BALL_PID_KA *
            acceleration;

        g_pid_a_angle_deg =
            FloatClamp(
                g_pid_a_angle_deg,
                -PID_ACCEL_MAX_ANGLE_DEG,
                PID_ACCEL_MAX_ANGLE_DEG);
    }


    requestedBeforePolarity =
        g_pid_p_angle_deg +
        g_pid_i_angle_deg +
        g_pid_d_angle_deg +
        g_pid_a_angle_deg +
        g_static_bias_angle_deg;


    if (absPosition >
        FAR_POSITION_MM)
    {
        angleLimit =
            FAR_MAX_ANGLE_DEG;
    }
    else if (absPosition >
             MIDDLE_POSITION_MM)
    {
        angleLimit =
            MIDDLE_MAX_ANGLE_DEG;
    }
    else
    {
        angleLimit =
            NEAR_MAX_ANGLE_DEG;
    }


    limitedRequested =
        FloatClamp(
            requestedBeforePolarity,
            -angleLimit,
            angleLimit);


    /*
     * 简单积分防饱和：
     * 如果输出已经饱和且积分还在继续把输出推向饱和方向，
     * 立即轻微释放积分。
     */
    if ((limitedRequested !=
         requestedBeforePolarity) &&
        ((g_pid_i_angle_deg *
          requestedBeforePolarity) > 0.0f))
    {
        g_pid_integral_mm_s *=
            0.96f;

        g_pid_i_angle_deg =
            BALL_PID_KI *
            g_pid_integral_mm_s;
    }


    g_requested_motor_angle_deg =
        AddVehicleCompensation(
            limitedRequested) *
        BALL_CONTROL_POLARITY;


    g_applied_motor_angle_deg =
        ApplyAngleSlewLimit(
            g_applied_motor_angle_deg,
            g_requested_motor_angle_deg,
            NORMAL_TARGET_SLEW_DEG_S);


    g_balance_state =
        BALL_STATE_PULLING;


    g_debug_capture_elapsed_ms =
        0U;


    g_debug_breakaway_elapsed_ms =
        0U;


    UpdateControlDebug(
        controlPosition,
        velocity);
}


/*==============================================================
 * 35. 电机1kHz软件位置控制
 *==============================================================*/

static void MotorPositionControl1ms(
    float targetAngleDeg)
{
    static float previousRate = 0.0f;

    int32_t targetPulse;

    int32_t positionError;

    float requestedRate;

    float maximumRateChange;


    targetPulse =
        MotorAngleToPulse(
            targetAngleDeg);


    if (targetPulse >
        MotorAngleToPulse(
            MAX_MOTOR_ANGLE_DEG))
    {
        targetPulse =
            MotorAngleToPulse(
                MAX_MOTOR_ANGLE_DEG);
    }


    if (targetPulse <
        MotorAngleToPulse(
            -MAX_MOTOR_ANGLE_DEG))
    {
        targetPulse =
            MotorAngleToPulse(
                -MAX_MOTOR_ANGLE_DEG);
    }


    g_motor_target_pulse =
        targetPulse;


    positionError =
        targetPulse -
        g_motor_current_pulse;


    /*
     * 到达目标位置后立即停止。
     */
    if (Int32Abs(positionError) <=
        MOTOR_POSITION_DEADBAND_PULSE)
    {
        g_step_rate_sps = 0;

        previousRate = 0.0f;


        g_debug_motor_angle_x100 =
            FloatToInt32(
                MotorPulseToAngle(
                    g_motor_current_pulse) *
                100.0f);

        return;
    }


    /*
     * 目标方向反转时立即清除旧速度。
     */
    if (((positionError > 0) &&
         (previousRate < 0.0f)) ||
        ((positionError < 0) &&
         (previousRate > 0.0f)))
    {
        previousRate = 0.0f;
    }


    requestedRate =
        MOTOR_POSITION_KP *
        (float)positionError;


    /*
     * 保证小误差时仍能快速动作。
     */
    if ((requestedRate > 0.0f) &&
        (requestedRate <
         MOTOR_MIN_STEP_RATE_SPS))
    {
        requestedRate =
            MOTOR_MIN_STEP_RATE_SPS;
    }


    if ((requestedRate < 0.0f) &&
        (requestedRate >
         -MOTOR_MIN_STEP_RATE_SPS))
    {
        requestedRate =
            -MOTOR_MIN_STEP_RATE_SPS;
    }


    requestedRate =
        FloatClamp(
            requestedRate,
            -MOTOR_MAX_STEP_RATE_SPS,
            MOTOR_MAX_STEP_RATE_SPS);


    maximumRateChange =
        MOTOR_MAX_ACCEL_SPS2 *
        MOTOR_CONTROL_DT_S;


    requestedRate =
        FloatClamp(
            requestedRate,
            previousRate -
            maximumRateChange,
            previousRate +
            maximumRateChange);


    g_step_rate_sps =
        FloatToInt32(
            requestedRate);


    previousRate =
        requestedRate;


    g_debug_motor_angle_x100 =
        FloatToInt32(
            MotorPulseToAngle(
                g_motor_current_pulse) *
            100.0f);
}


/*==============================================================
 * 36. SysTick中断
 *==============================================================*/

void SysTick_Handler(void)
{
    static uint32_t millisecondDivider = 0U;

    static uint32_t ballControlDivider = 0U;

    static uint32_t motorControlDivider = 0U;


    /*
     * STEP脉冲服务10kHz。
     */
    StepPulseService100us();


    /*
     * 毫秒计时。
     */
    millisecondDivider++;


    if (millisecondDivider >= 10U)
    {
        millisecondDivider = 0U;

        g_system_ms++;
    }


    /*
     * 钢球控制100Hz。
     */
    ballControlDivider++;


    if (ballControlDivider >=
        BALL_CONTROL_INTERVAL_TICKS)
    {
        ballControlDivider = 0U;

        g_ball_control_due = 1U;
    }


    /*
     * 电机控制1kHz。
     */
    motorControlDivider++;


    if (motorControlDivider >=
        MOTOR_CONTROL_INTERVAL_TICKS)
    {
        motorControlDivider = 0U;

        g_motor_control_due = 1U;
    }
}


/*==============================================================
 * 37. 主函数
 *==============================================================*/

int main(void)
{
    uint8_t hasNewSample;

    uint8_t ballControlDue;

    uint8_t motorControlDue;

    uint8_t measurementUpdated;

    int32_t receivedPosition;

    uint32_t receivedTime;


    SYSCFG_DL_init();


    StepperGPIOInit();


    /*
     * 上电先关闭驱动。
     */
    StepperEnable(0U);


    /*
     * 打开UART0接收中断。
     */
    DL_UART_Main_enableInterrupt(
        K230_UART_INST,
        DL_UART_MAIN_INTERRUPT_RX);


    NVIC_ClearPendingIRQ(
        K230_UART_INST_INT_IRQN);


    NVIC_EnableIRQ(
        K230_UART_INST_INT_IRQN);


    /*
     * 打开UART1接收中断，用于JY60。
     */
    DL_UART_Main_enableInterrupt(
        JY60_UART_INST,
        DL_UART_MAIN_INTERRUPT_RX);


    NVIC_ClearPendingIRQ(
        JY60_UART_INST_INT_IRQN);


    NVIC_EnableIRQ(
        JY60_UART_INST_INT_IRQN);


    /*
     * 开启10kHz SysTick。
     */
    if (SysTick_Config(
            CPUCLK_FREQ /
            SYSTICK_FREQUENCY_HZ) != 0U)
    {
        while (1)
        {
            __WFI();
        }
    }


    __enable_irq();


    /*
     * 等待2秒，手动调平轨道。
     */
    DelayMs(
        START_DELAY_MS);


    /*
     * 结束JY60静止零偏标定。
     *
     * 这2秒内小车和JY60必须保持静止，
     * 同时手动把摆杆调到水平零位。
     */
    FinishJY60Calibration();


    /*
     * 将当前位置作为软件水平零点。
     */
    g_motor_current_pulse = 0;

    g_motor_target_pulse = 0;

    g_step_rate_sps = 0;


    g_requested_motor_angle_deg =
        0.0f;

    g_applied_motor_angle_deg =
        0.0f;


    g_center_trim_angle_deg =
        0.0f;

    g_center_exit_confirm_count =
        0U;


    g_static_bias_angle_deg =
        0.0f;

    g_breakaway_target_angle_deg =
        0.0f;

    g_capture_brake_angle_deg =
        0.0f;


    g_filtered_position_mm =
        0.0f;

    g_previous_filtered_position_mm =
        0.0f;

    g_filtered_velocity_mm_s =
        0.0f;

    g_filtered_acceleration_mm_s2 =
        0.0f;

    g_predicted_position_mm =
        0.0f;

    g_predicted_velocity_mm_s =
        0.0f;

    g_prediction_time_s =
        PREDICTION_MIN_TIME_S;

    g_motion_history_count =
        0U;

    g_last_measurement_dt_s =
        0.01f;

    g_pid_integral_mm_s =
        0.0f;

    g_pid_p_angle_deg =
        0.0f;

    g_pid_i_angle_deg =
        0.0f;

    g_pid_d_angle_deg =
        0.0f;

    g_pid_a_angle_deg =
        0.0f;


    g_observer_initialized =
        0U;


    g_balance_state =
        BALL_STATE_WAITING;


    g_center_confirm_count =
        0U;

    g_progress_initialized =
        0U;

    g_previous_control_position_mm =
        0.0f;


    g_breakaway_level =
        0U;

    g_breakaway_count =
        0U;

    g_capture_cooldown_remaining_ms =
        0U;

    g_capture_started_predictively =
        0U;

    g_debug_predictive_capture =
        0U;


    /*
     * JY60补偿角从0开始。
     */
    g_vehicle_accel_filtered_g =
        0.0f;

    g_vehicle_comp_target_angle_deg =
        0.0f;

    g_vehicle_comp_angle_deg =
        0.0f;


    /*
     * 清除启动等待期间的旧帧标志。
     */
    __disable_irq();


    g_k230_new_sample =
        0U;


    __enable_irq();


    /*
     * 使能D36A并锁轴。
     */
    StepperEnable(1U);


    DelayMs(
        ENABLE_SETTLE_MS);


    while (1)
    {
        /*
         * ======================================================
         * 读取K230坐标
         * ======================================================
         */
        __disable_irq();


        hasNewSample =
            g_k230_new_sample;


        receivedPosition =
            g_k230_position_mm;


        receivedTime =
            g_k230_last_rx_ms;


        if (hasNewSample != 0U)
        {
            g_k230_new_sample = 0U;
        }


        __enable_irq();


        if (hasNewSample != 0U)
        {
            UpdateBallMeasurement(
                (float)receivedPosition,
                receivedTime);
        }


        /*
         * ======================================================
         * 读取100Hz钢球控制标志
         * ======================================================
         */
        __disable_irq();


        ballControlDue =
            g_ball_control_due;


        if (ballControlDue != 0U)
        {
            g_ball_control_due = 0U;
        }


        __enable_irq();


        if (ballControlDue != 0U)
        {
            measurementUpdated =
                g_measurement_updated_for_control;


            g_measurement_updated_for_control =
                0U;


            BallPositionControl100Hz(
                measurementUpdated);
        }


        /*
         * ======================================================
         * 读取1kHz电机控制标志
         * ======================================================
         */
        __disable_irq();


        motorControlDue =
            g_motor_control_due;


        if (motorControlDue != 0U)
        {
            g_motor_control_due = 0U;
        }


        __enable_irq();


        if (motorControlDue != 0U)
        {
            MotorPositionControl1ms(
                g_applied_motor_angle_deg);
        }


        __WFI();
    }
}
