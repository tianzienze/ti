 */
#define PREDICTION_FRAME_MULTIPLIER         (2.5f)
#define PREDICTION_MIN_TIME_S               (0.055f)
#define PREDICTION_MAX_TIME_S               (0.120f)

/*
 * 预测位置相对当前滤波位置最多修正25mm。
 *
 * 防止加速度估计异常时预测过远。
 */
#define PREDICTION_MAX_CORRECTION_MM        (25.0f)

/*
 * PID位置项中，75%使用预测位置，
 * 25%保留K230当前原始位置。
 */
#define PREDICTION_POSITION_WEIGHT          (0.58f)

/*==============================================================
 * 7. 控制状态
 *==============================================================*/

#define BALL_STATE_WAITING                  (0U)

/* 正常向原点拉回。 */
#define BALL_STATE_PULLING                  (1U)

