 * 1：驱动A是物理右轮；驱动B是物理左轮。
 *
 * 按你目前一直使用的接线，先保持0。
 */
#define MOTOR_CHANNELS_SWAPPED              0

/* 单个驱动方向相反时，把对应值从0改成1。 */
#define DRIVER_A_FORWARD_REVERSE            0
#define DRIVER_B_FORWARD_REVERSE            0

#define TURN_RIGHT                          1
#define TURN_LEFT                          (-1)

