/*==================================================
 * 180度掉头参数
 *==================================================*/

#define TURN_TARGET_X100                    18000L
#define TURN_SIGN_DETECT_X100               150L

/* 最大掉头时间：10秒。到时无条件结束调整。 */
#define TURN_MAX_DURATION_MS                10000U

/* 换向修正前先断电停车，避免带电瞬间反接。 */
#define TURN_DIRECTION_CHANGE_SETTLE_MS     150U

/*
 * 起转短暂提高到32%，保证正反两个轮子都能启动。
 * 如果仍有一侧完全不动，可临时提高到38测试反转通道。
 */
#define TURN_START_KICK_MS                  220U
#define TURN_START_LEFT_PWM                 26
#define TURN_START_RIGHT_PWM                26

/* 正常掉头速度，已经设置得比较慢。 */
#define TURN_FAR_LEFT_PWM                   20
#define TURN_FAR_RIGHT_PWM                  21

#define TURN_MEDIUM_LEFT_PWM                17
#define TURN_MEDIUM_RIGHT_PWM               18

#define TURN_NEAR_LEFT_PWM                  17
#define TURN_NEAR_RIGHT_PWM                 17

#define TURN_FINAL_LEFT_PWM                 17
#define TURN_FINAL_RIGHT_PWM                17

/*
 * 超过180度后的反向回调速度。
 * 不能继续使用12%，否则电机可能有声音但轮子带不动。
 * 这里只影响“转过头往回调”，不影响正常接近180度的慢速。
 */
#define TURN_CORRECT_LEFT_PWM               19
#define TURN_CORRECT_RIGHT_PWM              19

/* JY60短暂掉线时继续原地转，直到数据恢复或10秒到。 */
#define TURN_FALLBACK_LEFT_PWM              23
#define TURN_FALLBACK_RIGHT_PWM             23

#define TURN_MEDIUM_ZONE_X100               6000L
#define TURN_NEAR_ZONE_X100                 2500L
#define TURN_FINAL_ZONE_X100                800L

/*
 * 最终目标允许误差改为±1度。
 *
 * 以前连续5次只相当于约50ms，车刚进入范围就永久结束，
 * 随后机械惯性可能继续把车带出180度，但程序已经不会再修正。
 *
 * 现在必须连续50次，也就是约500ms都保持在±1度范围内才结束。
 * 在这500ms内只要偏离目标范围，稳定计数立即清零，并重新调整。
 */
#define TURN_TOLERANCE_X100                 100L
#define TURN_STABLE_CYCLES                  50U

