/*==================================================
 * 工具函数
 *==================================================*/

static int32_t ClampInt32(
    int32_t value,
    int32_t minimum,
    int32_t maximum)
{
    if (value < minimum) {
        return minimum;
    }

    if (value > maximum) {
        return maximum;
    }

    return value;
}

static int32_t AbsInt32(int32_t value)
{
    return (value < 0) ? -value : value;
}

static int32_t WrapAngleErrorX100(int32_t error)
{
    while (error > 18000L) {
        error -= 36000L;
    }

    while (error < -18000L) {
        error += 36000L;
    }

    return error;
}

static uint32_t TimeElapsedMs(uint32_t now, uint32_t start)
{
    return (uint32_t)(now - start);
}

