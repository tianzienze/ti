/*
 *============================================================
 * MSPM0G3507 + 四路红外循迹 + 双路直流电机
 *============================================================
 *
 * 四路传感器实际物理顺序：
 *
 * 小车左侧                                  小车右侧
 *
 * S1              S2              S3              S4
 * X4              X3              X2              X1
 * PA17            PA18            PB19            PA21
 *
 * 模块输出：
 *
 * 低电平 = 黑线
 * 高电平 = 白色
 *
 * 电机：
 *
 * 电机A：
 * IN1 = PB2
 * IN2 = PA7
 * ENA = PB8
 *
 * 电机B：
 * IN3 = PB9
 * IN4 = PB14
 * ENB = PB7
 *
 * 本程序功能：
 *
 * 1. 上电后等待300ms。
 * 2. 检测到黑线后开始循迹。
 * 3. 使用手册中的四路真值表控制方向。
 * 4. 检测不到黑线时，保持丢线前的方向继续寻找。
 * 5. 使用软件PWM控制速度。
 * 6. 带速度渐变，避免电机突然全速和一冲一冲。
 *
 *============================================================
 */


/*============================================================
 * 系统参数
 *============================================================*/

#ifndef CPUCLK_FREQ
#define CPUCLK_FREQ                     (32000000UL)
#endif

/*
 * SysTick频率为10kHz：
 *
 * 每个中断周期 = 0.1ms
 * PWM周期       = 100个中断
 * PWM频率       = 100Hz
 */
#define SYSTICK_FREQUENCY_HZ            (10000U)
#define PWM_PERIOD_COUNT                (100U)

/*
 * 每50个SysTick运行一次循迹控制：
 *
 * 50 × 0.1ms = 5ms
 */
#define CONTROL_INTERVAL_TICKS          (50U)


/*============================================================
 * 用户可调参数
 *============================================================*/

/*
 * 黑线电平。
 *
 * 手册规定：
 * 低电平 = 黑线
 *
 * 如果你实际测试发现黑线为高电平，改成0。
 */
#define BLACK_IS_LOW                    (1)


/*
 * 传感器安装方向。
 *
 * 当前代码已经按照：
 *
 * 左 -> 右
 * X4、X3、X2、X1
 *
 * 排列。
 *
 * 如果实际安装完全相反，改成1。
 */
#define LINE_SENSOR_REVERSE             (0)


/*
 * 转向方向修正。
 *
 * 如果左侧检测到黑线，小车却向右转，
 * 将此参数改成1。
 */
#define STEERING_REVERSE                (0)


/*
 * 电机A是否为左轮。
 *
 * 1：
 * 电机A = 左轮
 * 电机B = 右轮
 *
 * 0：
 * 电机A = 右轮
 * 电机B = 左轮
 */
#define MOTOR_A_IS_LEFT                 (1)


/*
 * 单独修正电机转向。
 *
 * 如果小车前进指令下某个轮子反转，
 * 将对应参数在0和1之间切换。
 */
#define MOTOR_A_REVERSED                (0)
#define MOTOR_B_REVERSED                (0)


/*
 * 丢线处理：
 *
 * 0 = 检测不到黑线立即停车
 * 1 = 保持丢线前的方向继续寻找黑线
 *
 * 当前按照你之前的要求设置为1。
 */
#define LOST_LINE_MODE                  (1)


/*
 * 上电时必须先检测到黑线才允许启动。
 *
 * 这样小车放在全白区域上电时不会直接冲出去。
 */
#define START_ONLY_AFTER_LINE_FOUND     (1)


/*
 * 左右电机补偿。
 *
 * 某个轮子明显较慢，可以增加对应数值。
 *
 * 例如左轮较慢：
 *
 * LEFT_MOTOR_TRIM = 2
 */
#define LEFT_MOTOR_TRIM                 (0)
#define RIGHT_MOTOR_TRIM                (0)


/*
 * 基础直行速度。
 *
 * 范围0~100。
 * 建议先使用25~35测试。
 */
#define LEFT_BASE_PWM                   (16)
#define RIGHT_BASE_PWM                  (16)


/*
 * 微调速度。
 *
 * 左微调：
 * 左轮较慢，右轮较快。
 *
 * 右微调：
 * 左轮较快，右轮较慢。
 */
#define MICRO_INNER_PWM                 (15)
#define MICRO_OUTER_PWM                 (17)


/*
 * 大弯速度。
 *
 * 内侧轮停止，外侧轮转动。
 */
#define BIG_TURN_INNER_PWM              (10)
#define BIG_TURN_OUTER_PWM              (22)


/*
 * 直角弯速度。
 *
 * 内侧轮反转，外侧轮正转。
 *
 * SHARP_REVERSE_PWM不要设置太大，
 * 否则小车容易原地快速旋转。
 */
#define SHARP_REVERSE_PWM               (12)
#define SHARP_FORWARD_PWM               (20)


/*
 * 每5ms允许PWM变化的最大值。
 *
 * 数值越小越平滑，但响应越慢。
 * 数值越大响应越快，但更容易顿挫。
 */
#define PWM_RAMP_STEP                   (2)


/*
 * 传感器状态连续出现多少次才接受。
 *
 * 控制周期为5ms：
 *
 * 2次 = 10ms滤波
 * 3次 = 15ms滤波
 */
#define TRACK_FILTER_SAMPLES            (3U)


/*
 * 转弯退出缓冲：
 *
 * 大弯或直角弯结束后，不立刻恢复普通微调。
 * 先用较小的左右速度差稳定一段时间，
 * 防止传感器在中线两侧来回切换导致小车摇头。
 */
#define TURN_EXIT_RECOVERY_ENABLE       (1)

#define TURN_EXIT_MIN_TIME_MS           (150U)
#define TURN_EXIT_MAX_TIME_MS           (500U)
#define TURN_EXIT_CENTER_SAMPLES        (6U)

#define TURN_EXIT_STRAIGHT_PWM          (15)
#define TURN_EXIT_MICRO_INNER_PWM       (15)
#define TURN_EXIT_MICRO_OUTER_PWM       (16)


/*
 * 中线锁定：
 *
 * 当中间两路同时检测到黑线（1001）时，认为车身已经回到
 * 赛道中央。此时左右轮使用接近相同的速度，不再因为一次
 * 左微调/右微调信号就立刻大幅改变两轮速度。
 *
 * 只有同一侧微调状态连续出现若干次后，才使用1个PWM的
 * 很小速度差进行修正。大弯和直角弯仍然立即响应。
 */
#define CENTER_LOCK_ENABLE              (1)

/* 离开1001后，继续保持中线锁定的时间 */
#define CENTER_LOCK_HOLD_MS             (100U)

/* 同一侧微调连续出现4次（约20ms）后才修正 */
#define CENTER_MICRO_CONFIRM_SAMPLES    (3U)

/* 中间两路都在黑线上时的左右轮直行速度 */
#define CENTER_STRAIGHT_LEFT_PWM        (16)
#define CENTER_STRAIGHT_RIGHT_PWM       (16)

/* 中线锁定期间的轻微修正，速度差只有1 */
#define CENTER_MICRO_INNER_PWM          (15)
#define CENTER_MICRO_OUTER_PWM          (16)


/*
 * LED有效电平。
 *
 * 1 = PA5输出高电平时点亮
 * 0 = PA5输出低电平时点亮
 */
#define LED_ACTIVE_HIGH                 (1)


