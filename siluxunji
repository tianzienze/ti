/*============================================================
 * 电机补偿
 *============================================================*/

static int16_t AddMotorTrim(
    int16_t command,
    int16_t trim
)
{
    if (command > 0)
    {
        command += trim;
    }
    else if (command < 0)
    {
        command -= trim;
    }

    return ClampPWM(command);
}


/*============================================================
 * 设置左右电机目标速度
 *============================================================*/

static void SetMotorTarget(
    int16_t leftPWM,
    int16_t rightPWM,
    uint8_t rememberCommand
)
{
    int16_t temporary;

#if STEERING_REVERSE

    temporary = leftPWM;
    leftPWM = rightPWM;
    rightPWM = temporary;

#else

    /*
     * 防止部分编译器提示temporary未使用。
     */
    (void)temporary;

#endif

    leftPWM = AddMotorTrim(
        leftPWM,
        LEFT_MOTOR_TRIM
    );

    rightPWM = AddMotorTrim(
        rightPWM,
        RIGHT_MOTOR_TRIM
    );

    g_left_target_pwm = ClampPWM(leftPWM);
    g_right_target_pwm = ClampPWM(rightPWM);

    if (rememberCommand != 0U)
    {
        g_last_valid_left_pwm =
            g_left_target_pwm;

        g_last_valid_right_pwm =
            g_right_target_pwm;
    }
}


/*============================================================
 * PWM缓慢变化
 *============================================================*/

static int16_t RampPWM(
    int16_t current,
    int16_t target
)
{
    if (current < target)
    {
        current += PWM_RAMP_STEP;

        if (current > target)
        {
            current = target;
        }
    }
    else if (current > target)
    {
        current -= PWM_RAMP_STEP;

        if (current < target)
        {
            current = target;
        }
    }

    return current;
}


static void UpdateMotorRamp(void)
{
    g_left_output_pwm = RampPWM(
        g_left_output_pwm,
        g_left_target_pwm
    );

    g_right_output_pwm = RampPWM(
        g_right_output_pwm,
        g_right_target_pwm
    );
}


/*============================================================
 * 判断当前传感器状态是否为大弯或直角弯
 *============================================================*/

static uint8_t IsStrongTurnPattern(
    uint8_t pattern
)
{
    if (
        (pattern == 0x01U) ||
        (pattern == 0x08U) ||
        (pattern == 0x07U) ||
        (pattern == 0x0EU)
    )
    {
        return 1U;
    }

    return 0U;
}


/*============================================================
 * 退出中线锁定
 *============================================================*/

static void CancelCenterLock(void)
{
    g_center_lock_active = 0U;
    g_center_micro_candidate = 0xFFU;
    g_center_micro_count = 0U;
}


/*============================================================
 * 中线锁定时直行
 *
 * 中间两路同时检测到黑线后，左右轮使用固定且接近相同的
 * 速度。这样可以把刚才弯道留下的左右速度差逐渐消除。
 *============================================================*/

static void ControlCenterStraight(void)
{
    g_last_direction =
        TRACK_DIRECTION_STRAIGHT;

    SetMotorTarget(
        CENTER_STRAIGHT_LEFT_PWM,
        CENTER_STRAIGHT_RIGHT_PWM,
        1U
    );
}


/*============================================================
 * 中线锁定与小幅迟滞控制
 *
 * 1001：中间两路检测到黑线，立即进入中线锁定并直行。
 * 1011/1101：先确认同一方向连续出现，再只做1个PWM的微调。
 * 0111/1110/0001/1000：真实大弯，立即退出锁定正常转弯。
 *
 * 这样能够避免：
 * 左微调 -> 直行 -> 右微调 -> 直行
 * 在很短时间内反复切换造成的大幅摇头。
 *============================================================*/

static uint8_t HandleCenterLock(
    uint8_t pattern
)
{
#if CENTER_LOCK_ENABLE

    uint32_t elapsedFromCenter;

    /*
     * 1001表示中间两路同时在黑线上。
     * 每次看到1001都重新刷新锁定时间。
     */
    if (pattern == 0x09U)
    {
        g_center_lock_active = 1U;
        g_center_last_seen_ms = g_system_ms;
        g_center_micro_candidate = 0xFFU;
        g_center_micro_count = 0U;

        /* 中线锁定已经接管，不再需要转弯退出缓冲。 */
        CancelTurnExitRecovery();

        ControlCenterStraight();
        return 1U;
    }

    if (g_center_lock_active == 0U)
    {
        return 0U;
    }

    /*
     * 最外侧传感器或直角状态出现时，说明真的进入弯道，
     * 不能继续锁直线，立即恢复正常强转向。
     */
    if (IsStrongTurnPattern(pattern) != 0U)
    {
        CancelCenterLock();
        return 0U;
    }

    elapsedFromCenter =
        (uint32_t)(
            g_system_ms -
            g_center_last_seen_ms
        );

    if (elapsedFromCenter > CENTER_LOCK_HOLD_MS)
    {
        CancelCenterLock();
        return 0U;
    }

    switch (pattern)
    {
        /*
         * 四路都检测到黑线时继续直行。
         * 这类状态常出现在宽线或路口。
         */
        case 0x00U:

            g_center_micro_candidate = 0xFFU;
            g_center_micro_count = 0U;
            ControlCenterStraight();
            return 1U;


        /*
         * 左微调。必须连续多次确认。
         */
        case 0x0BU:

            if (g_center_micro_candidate == 0x0BU)
            {
                if (g_center_micro_count < 255U)
                {
                    g_center_micro_count++;
                }
            }
            else
            {
                g_center_micro_candidate = 0x0BU;
                g_center_micro_count = 1U;
            }

            if (
                g_center_micro_count <
                CENTER_MICRO_CONFIRM_SAMPLES
            )
            {
                ControlCenterStraight();
            }
            else
            {
                g_last_direction =
                    TRACK_DIRECTION_LEFT_MICRO;

                SetMotorTarget(
                    CENTER_MICRO_INNER_PWM,
                    CENTER_MICRO_OUTER_PWM,
                    1U
                );
            }

            return 1U;


        /*
         * 右微调。必须连续多次确认。
         */
        case 0x0DU:

            if (g_center_micro_candidate == 0x0DU)
            {
                if (g_center_micro_count < 255U)
                {
                    g_center_micro_count++;
                }
            }
            else
            {
                g_center_micro_candidate = 0x0DU;
                g_center_micro_count = 1U;
            }

            if (
                g_center_micro_count <
                CENTER_MICRO_CONFIRM_SAMPLES
            )
            {
                ControlCenterStraight();
            }
            else
            {
                g_last_direction =
                    TRACK_DIRECTION_RIGHT_MICRO;

                SetMotorTarget(
                    CENTER_MICRO_OUTER_PWM,
                    CENTER_MICRO_INNER_PWM,
                    1U
                );
            }

            return 1U;


        /*
         * 在刚刚位于中线时发生很短的丢线，先保持直行，
         * 不立刻恢复之前的大弯速度。
         */
        case 0x0FU:

            g_center_micro_candidate = 0xFFU;
            g_center_micro_count = 0U;
            ControlCenterStraight();
            return 1U;


        default:

            /*
             * 其他不稳定组合在150ms锁定窗口内暂时按直行
             * 处理。真正的大弯状态在前面已经直接放行。
             */
            g_center_micro_candidate = 0xFFU;
            g_center_micro_count = 0U;
            ControlCenterStraight();
            return 1U;
    }

#else

    (void)pattern;

#endif

    return 0U;
}


/*============================================================
 * 判断上一次是否为大弯或直角弯
 *============================================================*/

static uint8_t IsStrongTurnDirection(
    TrackDirection direction
)
{
    if (
        (direction == TRACK_DIRECTION_LEFT_BIG) ||
        (direction == TRACK_DIRECTION_LEFT_SHARP) ||
        (direction == TRACK_DIRECTION_RIGHT_BIG) ||
        (direction == TRACK_DIRECTION_RIGHT_SHARP)
    )
    {
        return 1U;
    }

    return 0U;
}


/*============================================================
 * 退出转弯缓冲
 *============================================================*/

static void CancelTurnExitRecovery(void)
{
    g_turn_exit_recovery_active = 0U;
    g_turn_exit_center_count = 0U;
}


/*============================================================
 * 转弯结束缓冲处理
 *
 * 大弯或直角弯结束后，传感器往往会在：
 *
 * 左微调 -> 直行 -> 右微调
 *
 * 之间快速切换。如果立即使用普通微调速度，小车会出现
 * 转完弯后大幅度左右摇头。
 *
 * 缓冲期间：
 *
 * 1. 直行速度略微降低。
 * 2. 微调左右轮速度差缩小到1。
 * 3. 中线状态稳定一段时间后再恢复正常循迹。
 *============================================================*/

static uint8_t HandleTurnExitRecovery(
    uint8_t pattern
)
{
#if TURN_EXIT_RECOVERY_ENABLE

    uint32_t elapsedMs;

    /*
     * 从大弯或直角弯进入直行、左微调或右微调时，
     * 自动进入转弯退出缓冲。
     */
    if (g_turn_exit_recovery_active == 0U)
    {
        if (
            (IsStrongTurnDirection(g_last_direction) != 0U) &&
            (
                (pattern == 0x00U) ||
                (pattern == 0x09U) ||
                (pattern == 0x0BU) ||
                (pattern == 0x0DU)
            )
        )
        {
            g_turn_exit_recovery_active = 1U;
            g_turn_exit_start_ms = g_system_ms;
            g_turn_exit_center_count = 0U;
        }
        else
        {
            return 0U;
        }
    }

    elapsedMs =
        (uint32_t)(
            g_system_ms -
            g_turn_exit_start_ms
        );

    /*
     * 如果再次检测到大弯或直角弯，
     * 说明弯还没真正结束，退出缓冲并正常执行转弯。
     */
    if (
        (pattern == 0x01U) ||
        (pattern == 0x08U) ||
        (pattern == 0x07U) ||
        (pattern == 0x0EU)
    )
    {
        CancelTurnExitRecovery();
        return 0U;
    }

    /*
     * 防止异常状态下长时间停留在缓冲模式。
     */
    if (elapsedMs >= TURN_EXIT_MAX_TIME_MS)
    {
        CancelTurnExitRecovery();
        return 0U;
    }

    switch (pattern)
    {
        /*
         * 0000或1001都按照缓慢直行处理。
         */
        case 0x00U:
        case 0x09U:

            if (g_turn_exit_center_count < 255U)
            {
                g_turn_exit_center_count++;
            }

            /*
             * 至少经过设定时间，并且中线连续稳定若干次，
             * 才恢复普通循迹。
             */
            if (
                (elapsedMs >= TURN_EXIT_MIN_TIME_MS) &&
                (
                    g_turn_exit_center_count >=
                    TURN_EXIT_CENTER_SAMPLES
                )
            )
            {
                CancelTurnExitRecovery();
                return 0U;
            }

            g_last_direction =
                TRACK_DIRECTION_STRAIGHT;

            SetMotorTarget(
                TURN_EXIT_STRAIGHT_PWM,
                TURN_EXIT_STRAIGHT_PWM,
                1U
            );

            return 1U;


        /*
         * 左微调：只保留很小的速度差。
         */
        case 0x0BU:

            g_turn_exit_center_count = 0U;

            g_last_direction =
                TRACK_DIRECTION_LEFT_MICRO;

            SetMotorTarget(
                TURN_EXIT_MICRO_INNER_PWM,
                TURN_EXIT_MICRO_OUTER_PWM,
                1U
            );

            return 1U;


        /*
         * 右微调：只保留很小的速度差。
         */
        case 0x0DU:

            g_turn_exit_center_count = 0U;

            g_last_direction =
                TRACK_DIRECTION_RIGHT_MICRO;

            SetMotorTarget(
                TURN_EXIT_MICRO_OUTER_PWM,
                TURN_EXIT_MICRO_INNER_PWM,
                1U
            );

            return 1U;


        /*
         * 短暂丢线时保持缓冲期间最后一次温和指令，
         * 不恢复到刚才的大弯或直角弯速度。
         */
        case 0x0FU:

            g_turn_exit_center_count = 0U;

            SetMotorTarget(
                g_last_valid_left_pwm,
                g_last_valid_right_pwm,
                0U
            );

            return 1U;


        default:

            g_turn_exit_center_count = 0U;
            break;
    }

#else

    (void)pattern;

#endif

    return 0U;
}


/*============================================================
 * 各种循迹动作
 *============================================================*/

static void ControlStraight(void)
{
    g_last_direction =
        TRACK_DIRECTION_STRAIGHT;

    SetMotorTarget(
        LEFT_BASE_PWM,
        RIGHT_BASE_PWM,
        1U
    );
}


static void ControlLeftMicro(void)
{
    g_last_direction =
        TRACK_DIRECTION_LEFT_MICRO;

    SetMotorTarget(
        MICRO_INNER_PWM,
        MICRO_OUTER_PWM,
        1U
    );
}


static void ControlRightMicro(void)
{
    g_last_direction =
        TRACK_DIRECTION_RIGHT_MICRO;

    SetMotorTarget(
        MICRO_OUTER_PWM,
        MICRO_INNER_PWM,
        1U
    );
}


static void ControlLeftBig(void)
{
    CancelTurnExitRecovery();

    g_last_direction =
        TRACK_DIRECTION_LEFT_BIG;

    SetMotorTarget(
        BIG_TURN_INNER_PWM,
        BIG_TURN_OUTER_PWM,
        1U
    );
}


static void ControlRightBig(void)
{
    CancelTurnExitRecovery();

    g_last_direction =
        TRACK_DIRECTION_RIGHT_BIG;

    SetMotorTarget(
        BIG_TURN_OUTER_PWM,
        BIG_TURN_INNER_PWM,
        1U
    );
}


static void ControlLeftSharp(void)
{
    CancelTurnExitRecovery();

    g_last_direction =
        TRACK_DIRECTION_LEFT_SHARP;

    SetMotorTarget(
        -SHARP_REVERSE_PWM,
        SHARP_FORWARD_PWM,
        1U
    );
}


static void ControlRightSharp(void)
{
    CancelTurnExitRecovery();

    g_last_direction =
        TRACK_DIRECTION_RIGHT_SHARP;

    SetMotorTarget(
        SHARP_FORWARD_PWM,
        -SHARP_REVERSE_PWM,
        1U
    );
}


/*============================================================
 * 丢线处理
 *============================================================*/

static void HandleLostLine(void)
{
#if LOST_LINE_MODE == 0

    SetMotorTarget(
        0,
        0,
        0U
    );

#else

    /*
     * 没有任何有效历史状态时停车。
     */
    if (
        (g_last_valid_left_pwm == 0) &&
        (g_last_valid_right_pwm == 0)
    )
    {
        SetMotorTarget(
            0,
            0,
            0U
        );

        return;
    }

    /*
     * 保持丢线前的方向和速度继续行驶。
     */
    SetMotorTarget(
        g_last_valid_left_pwm,
        g_last_valid_right_pwm,
        0U
    );

#endif
}


/*============================================================
 * 处理真值表中未单独列出的状态
 *
 * 使用四路传感器位置权重：
 *
 * S1 = -3
 * S2 = -1
 * S3 = +1
 * S4 = +3
 *
 * 黑线偏左时向左修正，
 * 黑线偏右时向右修正。
 *============================================================*/

static void HandleUnknownPattern(
    uint8_t pattern
)
{
    int16_t error = 0;
    uint8_t blackCount = 0U;

    /* S1检测到黑线 */
    if ((pattern & 0x08U) == 0U)
    {
        error -= 3;
        blackCount++;
    }

    /* S2检测到黑线 */
    if ((pattern & 0x04U) == 0U)
    {
        error -= 1;
        blackCount++;
    }

    /* S3检测到黑线 */
    if ((pattern & 0x02U) == 0U)
    {
        error += 1;
        blackCount++;
    }

    /* S4检测到黑线 */
    if ((pattern & 0x01U) == 0U)
    {
        error += 3;
        blackCount++;
    }


    if (blackCount == 0U)
    {
        HandleLostLine();
    }
    else if (blackCount == 4U)
    {
        ControlStraight();
    }
    else if (error <= -3)
    {
        ControlLeftBig();
    }
    else if (error < 0)
    {
        ControlLeftMicro();
    }
    else if (error >= 3)
    {
        ControlRightBig();
    }
    else if (error > 0)
    {
        ControlRightMicro();
    }
    else
    {
        ControlStraight();
    }
}


/*============================================================
 * 四路循迹真值表
 *
 * 四位数据顺序：
 *
 * S1 S2 S3 S4
 *
 * 0 = 黑线
 * 1 = 白色
 *============================================================*/

static void TrackControl(
    uint8_t pattern
)
{
    /*
     * 上电后第一次检测到黑线。
     */
    if (pattern != 0x0FU)
    {
        g_line_has_been_found = 1U;

        SetStatusLED(1U);
    }
    else
    {
        SetStatusLED(0U);
    }


#if START_ONLY_AFTER_LINE_FOUND

    /*
     * 如果上电后从未检测到黑线，
     * 保持停车。
     */
    if (g_line_has_been_found == 0U)
    {
        SetMotorTarget(
            0,
            0,
            0U
        );

        return;
    }

#endif


    /*
     * 中间两路同时检测到黑线后，优先使用中线锁定。
     * 返回1表示本次控制已经完成。
     */
    if (HandleCenterLock(pattern) != 0U)
    {
        return;
    }


    /*
     * 大弯或直角弯结束后，再执行转弯退出缓冲。
     * 返回1表示本次控制已经由缓冲逻辑处理。
     */
    if (HandleTurnExitRecovery(pattern) != 0U)
    {
        return;
    }


    switch (pattern)
    {
        /*
         * 0000：
         * 四路全部检测到黑线。
         *
         * 手册定义为十字路口。
         * 默认继续直行。
         */
        case 0x00U:

            ControlStraight();
            break;


        /*
         * 0001：
         * 左直角弯。
         */
        case 0x01U:

            ControlLeftSharp();
            break;


        /*
         * 1000：
         * 右直角弯。
         */
        case 0x08U:

            ControlRightSharp();
            break;


        /*
         * 0111：
         * 左侧最外传感器检测到黑线。
         */
        case 0x07U:

            ControlLeftBig();
            break;


        /*
         * 1110：
         * 右侧最外传感器检测到黑线。
         */
        case 0x0EU:

            ControlRightBig();
            break;


        /*
         * 1011：
         * 左中传感器检测到黑线。
         */
        case 0x0BU:

            ControlLeftMicro();
            break;


        /*
         * 1101：
         * 右中传感器检测到黑线。
         */
        case 0x0DU:

            ControlRightMicro();
            break;


        /*
         * 1001：
         * 中间两路检测到黑线。
         */
        case 0x09U:

            ControlStraight();
            break;


        /*
         * 1111：
         * 四路全部为白色，丢线。
         */
        case 0x0FU:

            HandleLostLine();
            break;


        /*
         * 处理其他组合。
         */
        default:

            HandleUnknownPattern(pattern);
            break;
    }
}


/*============================================================
 * 毫秒延时
 *============================================================*/

static void DelayMs(
    uint32_t delayMs
)
{
    uint32_t startTime;

    startTime = g_system_ms;

    while (
        (uint32_t)(g_system_ms - startTime) <
        delayMs
    )
    {
        __WFI();
    }
}


/*============================================================
 * SysTick中断
 *============================================================*/

void SysTick_Handler(void)
{
    static uint16_t pwmPhase = 0U;
    static uint16_t controlDivider = 0U;
    static uint8_t millisecondDivider = 0U;

    /*
     * 每0.1ms更新一次软件PWM。
     */
    ApplyMotorOutputs(pwmPhase);

    pwmPhase++;

    if (pwmPhase >= PWM_PERIOD_COUNT)
    {
        pwmPhase = 0U;
    }


    /*
     * 每5ms通知主循环运行一次循迹控制。
     */
    controlDivider++;

    if (
        controlDivider >=
        CONTROL_INTERVAL_TICKS
    )
    {
        controlDivider = 0U;
        g_control_due = 1U;
    }


    /*
     * 10个SysTick = 1ms。
     */
    millisecondDivider++;

    if (millisecondDivider >= 10U)
    {
        millisecondDivider = 0U;
        g_system_ms++;
    }
}


/*============================================================
 * 主函数
 *============================================================*/

int main(void)
{
    uint8_t rawPattern;
    uint8_t filteredPattern;

    /*
     * 初始化SysConfig中的GPIO、UART和系统时钟。
     */
    SYSCFG_DL_init();


    /*
     * 上电后立即关闭电机。
     */
    HardwareMotorStop();

    g_left_target_pwm = 0;
    g_right_target_pwm = 0;

    g_left_output_pwm = 0;
    g_right_output_pwm = 0;

    g_last_valid_left_pwm = 0;
    g_last_valid_right_pwm = 0;

    SetStatusLED(0U);


    /*
     * 启动10kHz SysTick。
     */
    if (
        SysTick_Config(
            CPUCLK_FREQ /
            SYSTICK_FREQUENCY_HZ
        ) != 0U
    )
    {
        /*
         * SysTick配置失败，永久停车。
         */
        HardwareMotorStop();

        while (1)
        {
            SetStatusLED(1U);
        }
    }


    /*
     * 等待电源及循迹模块稳定。
     */
    DelayMs(300U);


    while (1)
    {
        if (g_control_due != 0U)
        {
            g_control_due = 0U;

            /*
             * 读取原始四路状态。
             */
            rawPattern =
                ReadTrackPattern();

            /*
             * 对四路状态进行连续采样滤波。
             */
            filteredPattern =
                FilterTrackPattern(
                    rawPattern
                );

            g_track_pattern =
                filteredPattern;

            /*
             * 根据四路真值表设置目标速度。
             */
            TrackControl(
                filteredPattern
            );

            /*
             * 缓慢接近目标速度，减少顿挫。
             */
            UpdateMotorRamp();
        }

        __WFI();
    }
}
