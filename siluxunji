/*============================================================
 * PWM限幅
 *============================================================*/

static int16_t ClampPWM(int16_t pwm)
{
    if (pwm > 100)
    {
        return 100;
    }

    if (pwm < -100)
    {
        return -100;
    }

    return pwm;
}


/*============================================================
 * 立即关闭两个电机
 *============================================================*/

static void HardwareMotorStop(void)
{
    /* 先关闭使能 */
    DL_GPIO_clearPins(
        MOTOR_A_EN_PORT,
        MOTOR_A_EN_PIN
    );

    DL_GPIO_clearPins(
        MOTOR_B_EN_PORT,
        MOTOR_B_EN_PIN
    );

    /* 再关闭方向引脚 */
    DL_GPIO_clearPins(
        MOTOR_A_IN1_PORT,
        MOTOR_A_IN1_PIN
    );

    DL_GPIO_clearPins(
        MOTOR_A_IN2_PORT,
        MOTOR_A_IN2_PIN
    );

    DL_GPIO_clearPins(
        MOTOR_B_IN1_PORT,
        MOTOR_B_IN1_PIN
    );

    DL_GPIO_clearPins(
        MOTOR_B_IN2_PORT,
        MOTOR_B_IN2_PIN
    );
}


/*============================================================
 * 电机A软件PWM输出
 *============================================================*/

static void ApplyMotorA(
    int16_t command,
    uint16_t pwmPhase
)
{
    uint16_t magnitude;

    command = ClampPWM(command);

    if (command == 0)
    {
        DL_GPIO_clearPins(
            MOTOR_A_EN_PORT,
            MOTOR_A_EN_PIN
        );

        DL_GPIO_clearPins(
            MOTOR_A_IN1_PORT,
            MOTOR_A_IN1_PIN
        );

        DL_GPIO_clearPins(
            MOTOR_A_IN2_PORT,
            MOTOR_A_IN2_PIN
        );

        return;
    }

    if (command > 0)
    {
        magnitude = (uint16_t)command;

#if MOTOR_A_REVERSED

        DL_GPIO_clearPins(
            MOTOR_A_IN1_PORT,
            MOTOR_A_IN1_PIN
        );

        DL_GPIO_setPins(
            MOTOR_A_IN2_PORT,
            MOTOR_A_IN2_PIN
        );

#else

        DL_GPIO_setPins(
            MOTOR_A_IN1_PORT,
            MOTOR_A_IN1_PIN
        );

        DL_GPIO_clearPins(
            MOTOR_A_IN2_PORT,
            MOTOR_A_IN2_PIN
        );

#endif
    }
    else
    {
        magnitude = (uint16_t)(-command);

#if MOTOR_A_REVERSED

        DL_GPIO_setPins(
            MOTOR_A_IN1_PORT,
            MOTOR_A_IN1_PIN
        );

        DL_GPIO_clearPins(
            MOTOR_A_IN2_PORT,
            MOTOR_A_IN2_PIN
        );

#else

        DL_GPIO_clearPins(
            MOTOR_A_IN1_PORT,
            MOTOR_A_IN1_PIN
        );

        DL_GPIO_setPins(
            MOTOR_A_IN2_PORT,
            MOTOR_A_IN2_PIN
        );

#endif
    }

    if (pwmPhase < magnitude)
    {
        DL_GPIO_setPins(
            MOTOR_A_EN_PORT,
            MOTOR_A_EN_PIN
        );
    }
    else
    {
        DL_GPIO_clearPins(
            MOTOR_A_EN_PORT,
            MOTOR_A_EN_PIN
        );
    }
}


