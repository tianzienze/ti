/*============================================================
 * 按照左右轮关系输出电机
 *============================================================*/

static void ApplyMotorOutputs(
    uint16_t pwmPhase
)
{
#if MOTOR_A_IS_LEFT

    ApplyMotorA(
        g_left_output_pwm,
        pwmPhase
    );

    ApplyMotorB(
        g_right_output_pwm,
        pwmPhase
    );

#else

    ApplyMotorA(
        g_right_output_pwm,
        pwmPhase
    );

    ApplyMotorB(
        g_left_output_pwm,
        pwmPhase
    );

#endif
}


/*============================================================
 * 将原始电平转换成手册中的格式
 *
 * 返回：
 *
 * 0 = 黑线
 * 1 = 白色
 *============================================================*/

static uint8_t ConvertToWhiteBit(
    uint8_t rawHigh
)
{
#if BLACK_IS_LOW

    /*
     * 黑线低电平、白色高电平时，
     * 原始电平正好就是手册格式。
     */
    return rawHigh;

#else

    /*
     * 黑线高电平时进行反相，
     * 保证程序内部始终使用：
     *
     * 0 = 黑线
     * 1 = 白色
     */
    return (uint8_t)(rawHigh ^ 1U);

#endif
}


/*============================================================
 * 读取四路传感器
 *============================================================*/

static uint8_t ReadTrackPattern(void)
{
    uint8_t s1;
    uint8_t s2;
    uint8_t s3;
    uint8_t s4;

    /*
     * 根据实际安装顺序：
     *
     * 左 -> 右
     *
     * S1 = X4 = PA17
     * S2 = X3 = PA18
     * S3 = X2 = PB19
     * S4 = X1 = PA21
     */

    s1 = ConvertToWhiteBit(
        (DL_GPIO_readPins(
            TRACK_X4_PORT,
            TRACK_X4_PIN
        ) != 0U) ? 1U : 0U
    );

    s2 = ConvertToWhiteBit(
        (DL_GPIO_readPins(
            TRACK_X3_PORT,
            TRACK_X3_PIN
        ) != 0U) ? 1U : 0U
    );

    s3 = ConvertToWhiteBit(
        (DL_GPIO_readPins(
            TRACK_X2_PORT,
            TRACK_X2_PIN
        ) != 0U) ? 1U : 0U
    );

    s4 = ConvertToWhiteBit(
        (DL_GPIO_readPins(
            TRACK_X1_PORT,
            TRACK_X1_PIN
        ) != 0U) ? 1U : 0U
    );


#if LINE_SENSOR_REVERSE

    {
        uint8_t temporary;

        temporary = s1;
        s1 = s4;
        s4 = temporary;

        temporary = s2;
        s2 = s3;
        s3 = temporary;
    }

#endif


    /* 黑线调试变量，1表示黑线 */
    g_black_s1 = (s1 == 0U) ? 1U : 0U;
    g_black_s2 = (s2 == 0U) ? 1U : 0U;
    g_black_s3 = (s3 == 0U) ? 1U : 0U;
    g_black_s4 = (s4 == 0U) ? 1U : 0U;


    /*
     * bit3 = S1
     * bit2 = S2
     * bit1 = S3
     * bit0 = S4
     */
    return (uint8_t)(
        (s1 << 3) |
        (s2 << 2) |
        (s3 << 1) |
        s4
    );
}


/*============================================================
 * 简单连续采样滤波
 *============================================================*/

static uint8_t FilterTrackPattern(
    uint8_t rawPattern
)
{
    static uint8_t initialized = 0U;
    static uint8_t acceptedPattern = 0x0FU;
    static uint8_t candidatePattern = 0x0FU;
    static uint8_t candidateCount = 0U;

    if (initialized == 0U)
    {
        initialized = 1U;

        acceptedPattern = rawPattern;
        candidatePattern = rawPattern;
        candidateCount = 0U;

        return acceptedPattern;
    }

    if (rawPattern == acceptedPattern)
    {
        candidatePattern = rawPattern;
        candidateCount = 0U;

        return acceptedPattern;
    }

    if (rawPattern == candidatePattern)
    {
        if (candidateCount < 255U)
        {
            candidateCount++;
        }
    }
    else
    {
        candidatePattern = rawPattern;
        candidateCount = 1U;
    }

    if (candidateCount >= TRACK_FILTER_SAMPLES)
    {
        acceptedPattern = candidatePattern;
        candidateCount = 0U;
    }

    return acceptedPattern;
}


