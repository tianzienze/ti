/*==============================================================
 * 19. 基础函数
 *==============================================================*/

static float FloatAbs(float value)
{
    if (value < 0.0f)
    {
        return -value;
    }

    return value;
}


static float FloatClamp(
    float value,
    float minimum,
    float maximum)
{
    if (value > maximum)
    {
        return maximum;
    }

    if (value < minimum)
    {
        return minimum;
    }

    return value;
}


static float FloatSign(float value)
{
    if (value > 0.0f)
    {
        return 1.0f;
    }

    if (value < 0.0f)
    {
        return -1.0f;
    }

    return 0.0f;
}


static int32_t Int32Abs(int32_t value)
{
    if (value < 0)
    {
        return -value;
    }

    return value;
}


static int32_t FloatToInt32(float value)
{
    if (value >= 0.0f)
    {
        return (int32_t)(value + 0.5f);
    }

    return (int32_t)(value - 0.5f);
}


/*
 * 根据钢球离中心的距离连续计算K230反馈角上限。
 *
 * 与旧代码不同，这里没有14mm处突然切换到10°的台阶，
 * 因而不会再出现电机长期卡在9°～10°的现象。
 */
static float CalculateBallFeedbackAngleLimit(
    float absPositionMm)
{
    float ratio;
    float limitDeg;

    absPositionMm =
        FloatAbs(
            absPositionMm);

    if (absPositionMm <=
        MIDDLE_POSITION_MM)
    {
        ratio =
            absPositionMm /
            MIDDLE_POSITION_MM;

        limitDeg =
            NEAR_MAX_ANGLE_DEG +
            ratio *
            (
                MIDDLE_MAX_ANGLE_DEG -
                NEAR_MAX_ANGLE_DEG
            );
    }
    else if (absPositionMm <
             FAR_POSITION_MM)
    {
        ratio =
            (
                absPositionMm -
                MIDDLE_POSITION_MM
            ) /
            (
                FAR_POSITION_MM -
                MIDDLE_POSITION_MM
            );

        limitDeg =
            MIDDLE_MAX_ANGLE_DEG +
            ratio *
            (
                FAR_MAX_ANGLE_DEG -
                MIDDLE_MAX_ANGLE_DEG
            );
    }
    else
    {
        limitDeg =
            FAR_MAX_ANGLE_DEG;
    }

    limitDeg =
        FloatClamp(
            limitDeg,
            NEAR_MAX_ANGLE_DEG,
            BALL_FEEDBACK_MAX_ANGLE_DEG);

    g_feedback_angle_limit_deg =
        limitDeg;

    g_debug_feedback_limit_x100 =
        FloatToInt32(
            limitDeg *
            100.0f);

    return limitDeg;
}


/*
 * K230位置反馈与JY60前馈的优先融合。
 *
 * 当钢球明显偏离中心时，如果JY60前馈与K230回中方向相反，
 * 自动削弱JY60；同方向时仍完整保留JY60，以便快速抵消车辆惯性。
 */
static float FuseBallFeedbackAndJY60(
    float ballFeedbackAngleDeg,
    float jy60CommandAngleDeg,
    float ballPositionMm)
{
    float absPosition;
    float priority;
    float jy60DynamicAngle;
    float jy60Scale;
    float combinedBeforeLimit;
    float combinedAfterLimit;

    absPosition =
        FloatAbs(
            ballPositionMm);

    if (absPosition <=
        POSITION_PRIORITY_START_MM)
    {
        priority = 0.0f;
    }
    else if (absPosition >=
             POSITION_PRIORITY_FULL_MM)
    {
        priority = 1.0f;
    }
    else
    {
        priority =
            (
                absPosition -
                POSITION_PRIORITY_START_MM
            ) /
            (
                POSITION_PRIORITY_FULL_MM -
                POSITION_PRIORITY_START_MM
            );
    }

    priority =
        FloatClamp(
            priority,
            0.0f,
            1.0f);

    jy60DynamicAngle =
        jy60CommandAngleDeg -
        MOTOR_LEVEL_OFFSET_DEG;

    jy60Scale = 1.0f;

    if ((ballFeedbackAngleDeg *
         jy60DynamicAngle) < 0.0f)
    {
        jy60Scale =
            1.0f -
            priority *
            (1.0f -
             OPPOSING_JY60_MIN_SCALE);
    }

    jy60Scale =
        FloatClamp(
            jy60Scale,
            OPPOSING_JY60_MIN_SCALE,
            1.0f);

    g_effective_jy60_angle_deg =
        jy60DynamicAngle *
        jy60Scale;

    g_position_priority =
        priority;

    combinedBeforeLimit =
        ballFeedbackAngleDeg +
        MOTOR_LEVEL_OFFSET_DEG +
        g_effective_jy60_angle_deg;

    combinedAfterLimit =
        FloatClamp(
            combinedBeforeLimit,
            -MAX_MOTOR_ANGLE_DEG,
            MAX_MOTOR_ANGLE_DEG);

    if (combinedAfterLimit !=
        combinedBeforeLimit)
    {
        g_debug_combined_saturated = 1U;
    }
    else
    {
        g_debug_combined_saturated = 0U;
    }

    g_debug_effective_jy60_angle_x100 =
        FloatToInt32(
            g_effective_jy60_angle_deg *
            100.0f);

    g_debug_position_priority_x1000 =
        FloatToInt32(
            g_position_priority *
            1000.0f);

    return combinedAfterLimit;
}



/*
 * atan近似。
 *
 * 本项目只使用|a/g|<=0.30，
 * x-x^3/3+x^5/5在此范围内精度足够，
 * 不需要链接math库。
 */
static float AtanApproxRad(float value)
{
    float squared;

    value =
        FloatClamp(
            value,
            -0.50f,
            0.50f);

    squared =
        value *
        value;

    return
        value *
        (
            1.0f -
            squared / 3.0f +
            squared * squared / 5.0f
        );
}


/* 根据宏选择JY60的小车前后方向轴。 */
static int16_t SelectJY60ForwardRaw(
    int16_t rawX,
    int16_t rawY,
    int16_t rawZ)
{
#if JY60_FORWARD_AXIS == 0U

    (void)rawY;
    (void)rawZ;
    return rawX;

#elif JY60_FORWARD_AXIS == 1U

    (void)rawX;
    (void)rawZ;
    return rawY;

#else

    (void)rawX;
    (void)rawY;
    return rawZ;

#endif
}


