 */
#define K230_TIMEOUT_MS                     (500U)


/*==============================================================
 * 5A. JY60帧格式和安装方向
 *==============================================================*/

/*
 * WIT/JY60加速度帧：
 *
 * 0x55 0x51 AxL AxH AyL AyH AzL AzH TL TH SUM
 */
#define JY60_FRAME_LENGTH                   (11U)
#define JY60_FRAME_HEADER                   (0x55U)
#define JY60_FRAME_ACCELERATION             (0x51U)

/* 超过200ms没有有效加速度帧，认为JY60离线。 */
#define JY60_TIMEOUT_MS                     (200U)

/*
 * 选择JY60哪一个轴作为小车前后方向：
 *
 * 0 = X轴
 * 1 = Y轴
 * 2 = Z轴
 */
#define JY60_FORWARD_AXIS                   (0U)

/*
 * 让“小车向前加速”在Watch中显示为正加速度。
 *
 * 如果g_debug_raw_accel_mg在向前启动时为负数，
 * 将1.0f改成-1.0f。
 */
#define JY60_ACCEL_AXIS_POLARITY            (1.0f)

/*
 * JY60前馈角对应的电机方向。
 *
 * 如果车辆向前启动后，小球反而被加速推向错误方向，
 * 只修改这个宏的正负号。
 */
#define MOTOR_COMPENSATION_POLARITY         (1.0f)

/* 软件水平零点固定修正，一般保持0。 */
#define MOTOR_LEVEL_OFFSET_DEG              (0.0f)

/* JY60 ±16g量程换算。 */
#define JY60_ACCEL_RAW_TO_G                 (16.0f / 32768.0f)

/* 上电标定所需有效0x51帧数量。 */
#define JY60_CALIBRATION_MIN_SAMPLES        (30U)
#define JY60_CALIBRATION_MAX_SAMPLES        (2000U)


/*==============================================================
 * 5B. JY60加速度滤波和前馈补偿参数
 *==============================================================*/

/*
 * 正加速度响应系数。
 * 越大启动反应越快，也越容易受噪声影响。
 */
#define VEHICLE_START_FILTER_ALPHA          (0.80f)

/*
 * 负加速度/停车响应系数。
 */
#define VEHICLE_STOP_FILTER_ALPHA           (0.65f)

/* 小于该加速度时视为静止或匀速。 */
#define VEHICLE_ACCEL_DEADBAND_G            (0.015f)

/* 输入加速度限幅。 */
#define VEHICLE_ACCEL_LIMIT_G               (0.30f)

/*
 * 启动和停车前馈增益。
 *
 * 启动时钢球仍向后移动：增大START；
 * 启动时钢球被推向前：减小START；
 * 停车时钢球仍向前冲：增大STOP；
 * 停车时钢球反向冲：减小STOP。
 */
#define VEHICLE_START_COMPENSATION_GAIN     (6.00f)
#define VEHICLE_STOP_COMPENSATION_GAIN      (8.00f)

/* JY60单独贡献的最大前馈角。 */
#define VEHICLE_COMPENSATION_MAX_ANGLE_DEG  (8.0f)

/* 启动、停车、回零和掉线时的前馈角变化速度。 */
#define VEHICLE_START_SLEW_DEG_S            (520.0f)
#define VEHICLE_STOP_SLEW_DEG_S             (720.0f)
#define VEHICLE_ZERO_RETURN_SLEW_DEG_S      (180.0f)
#define VEHICLE_OFFLINE_RETURN_DEG_S        (220.0f)

#define RAD_TO_DEG                          (57.2957795f)


/*==============================================================
 * 6. 坐标、速度、加速度和预测参数
 *==============================================================*/

/*
 * 位置低通滤波。
 *
 * 数值越大越跟随新坐标，越小越平滑。
 */
#define POSITION_FILTER_ALPHA               (0.72f)

/*
 * 多帧趋势速度与单帧速度的融合比例。
 *
 * 0.72表示主要相信最近5帧的整体趋势。
 */
#define MULTIFRAME_VELOCITY_WEIGHT          (0.72f)

/*
 * 速度低通滤波。
 */
#define VELOCITY_FILTER_ALPHA               (0.44f)

/*
 * 加速度低通滤波。
 *
 * 加速度比速度更容易受K230坐标抖动影响，
 * 所以滤波系数不能太大。
 */
#define ACCELERATION_FILTER_ALPHA           (0.20f)

/*
 * 用最近5帧估计运动趋势。
 */
#define MOTION_HISTORY_SIZE                 (5U)

/*
 * 至少3帧后才允许使用预测。
 */
#define PREDICTION_MIN_HISTORY_FRAMES       (3U)

/*
 * 允许完整坐标跳变。
 */
#define MAX_POSITION_JUMP_PER_FRAME_MM      (125.0f)

/*
 * 最大速度估计。
 */
#define MAX_BALL_SPEED_MM_S                 (500.0f)

/*
 * 最大加速度估计。
 *
 * 限幅用于防止偶发识别跳点直接产生很大的预测量。
 */
#define MAX_BALL_ACCEL_MM_S2                (3500.0f)

/*
 * 很小的加速度直接当作0，减少原点附近噪声。
 */
#define ACCELERATION_DEADBAND_MM_S2         (60.0f)

/*
 * 预测时间随K230实际帧间隔自动变化：
 *
 * T = 帧间隔 × 2.5
 *
 * 并限制在55ms～120ms。
 */
#define PREDICTION_FRAME_MULTIPLIER         (2.5f)
#define PREDICTION_MIN_TIME_S               (0.055f)
#define PREDICTION_MAX_TIME_S               (0.120f)

/*
 * 预测位置相对当前滤波位置最多修正25mm。
 *
 * 防止加速度估计异常时预测过远。
 */
#define PREDICTION_MAX_CORRECTION_MM        (25.0f)

/*
 * PID位置项中，75%使用预测位置，
 * 25%保留K230当前原始位置。
 */
#define PREDICTION_POSITION_WEIGHT          (0.58f)

/*==============================================================
 * 7. 控制状态
 *==============================================================*/

#define BALL_STATE_WAITING                  (0U)

/* 正常向原点拉回。 */
#define BALL_STATE_PULLING                  (1U)

/* 原点附近软着陆状态。 */
#define BALL_STATE_BRAKING                  (2U)

/* 已经锁定在原点附近。 */
#define BALL_STATE_HOLDING                  (3U)

/* 自适应增加基础坡度。 */
#define BALL_STATE_STATIC_BIAS              (4U)

/* 一次性捕获制动。 */
#define BALL_STATE_CAPTURE                  (5U)

/* 快速破静摩擦脉冲。 */
#define BALL_STATE_BREAKAWAY                (6U)


/*==============================================================
 * 8. 原点立即锁定参数
 *==============================================================*/

/*
 * 检测到小球进入±3mm，
 * 立即认为已到达原点附近。
 */
#define BALL_CENTER_ENTER_MM                (4.0f)

/*
 * 锁定后超过±11mm才重新进入软着陆控制。
 * 更大的滞环可以避免K230坐标在中心附近来回跳变时反复接管。
 */
#define BALL_CENTER_EXIT_MM                 (11.0f)

/*
 * 真正锁定要求速度已经很低。
 */
#define BALL_CENTER_ENTER_SPEED_MM_S        (7.0f)

/*
 * 连续4个新坐标帧满足条件后才锁定，避免高速穿过0点时误锁定。
 */
#define BALL_CENTER_CONFIRM_FRAMES          (4U)

/*
 * 进入±11mm且速度不高时，切换到低增益软着陆状态。
 */
#define CENTER_SETTLE_ENTER_MM              (11.0f)
#define CENTER_SETTLE_EXIT_MM               (14.0f)
#define CENTER_SETTLE_ENTRY_SPEED_MM_S      (32.0f)

/*
 * 中心软着陆只使用低增益PD，不使用预测加速度和普通积分。
 */
#define CENTER_SETTLE_KP                    (0.026f)
#define CENTER_SETTLE_KD                    (0.018f)
#define CENTER_SETTLE_MAX_ANGLE_DEG         (0.72f)
#define CENTER_SETTLE_SLEW_DEG_S            (55.0f)

/*
 * 中心位置和速度小死区，滤掉K230整数坐标抖动。
 */
#define CENTER_POSITION_DEADBAND_MM         (1.5f)
#define CENTER_VELOCITY_DEADBAND_MM_S       (3.0f)

/*
 * 锁定状态只保留很小的速度阻尼和慢速水平偏置学习。
 */
#define CENTER_HOLD_KD                      (0.010f)
#define CENTER_HOLD_MAX_ANGLE_DEG           (0.45f)
#define CENTER_HOLD_SLEW_DEG_S              (25.0f)
#define CENTER_TRIM_KI                      (0.022f)
#define CENTER_TRIM_MAX_ANGLE_DEG           (2.50f)
#define CENTER_TRIM_ACTIVE_SPEED_MM_S       (16.0f)
#define CENTER_EXIT_CONFIRM_FRAMES          (2U)


/*==============================================================
 * 9. 钢球位置PID参数
 *==============================================================*/

/*
 * P：位置比例。
 *
 * 33mm约产生2.71°，100mm约产生8.2°。
 */
#define BALL_PID_KP                         (0.082f)

/*
 * I：消除轨道轻微不水平、机构间隙造成的长期静差。
 *
 * 积分只在距离原点较近时启用，并带防饱和限制。
 */
#define BALL_PID_KI                         (0.018f)

/*
 * D：使用预测速度作为阻尼。
 *
 * 小球向原点快速运动时，D项会提前减小拉回坡度；
 * 小球远离原点时，D项会加大回中坡度。
 */
#define BALL_PID_KD                         (0.030f)

/*
 * A：加速度前馈。
 *
 * 小球仍在向原点加速时提前卸力，
 * 小球正向外加速时提前加强修正。
 */
#define BALL_PID_KA                         (0.00015f)

/*
 * 在±85mm内允许积累积分，用于消除长期单侧漂移。
 */
#define PID_INTEGRAL_ACTIVE_MM              (85.0f)

/*
 * 速度过高时不积累积分，避免高速阶段积分过量。
 */
#define PID_INTEGRAL_MAX_SPEED_MM_S         (160.0f)

/*
 * 积分项最大允许贡献±3.0°。
 */
#define PID_INTEGRAL_MAX_ANGLE_DEG          (3.0f)

/*
 * 不满足积分条件时，积分每个新坐标帧乘以0.90。
 */
#define PID_INTEGRAL_DECAY                  (0.98f)

/*
 * 加速度项最大只允许贡献±1.2°。
 */
#define PID_ACCEL_MAX_ANGLE_DEG             (0.45f)


/*
 * 长时间单侧漂移补偿。
 *
 * 当小球已经偏离中心、速度较低且车辆本身没有明显加减速时，
 * 缓慢学习轨道水平误差和机构间隙，并把学习结果保存在
 * g_center_trim_angle_deg中。该偏置在普通拉回状态也会参与控制。
 */
#define DRIFT_TRIM_MIN_POSITION_MM           (5.0f)
#define DRIFT_TRIM_MAX_POSITION_MM           (95.0f)
#define DRIFT_TRIM_MAX_SPEED_MM_S            (28.0f)
#define DRIFT_TRIM_MAX_VEHICLE_ACCEL_G       (0.035f)
#define DRIFT_TRIM_KI                        (0.010f)

/*==============================================================
 * 10. 回中进度检查
 *==============================================================*/

