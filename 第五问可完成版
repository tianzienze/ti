#include "ti_msp_dl_config.h"
#include <stdint.h>

/*
 * ================================================================
 * MSPM0G3507 + K230 + JY60 + D36A + MS42C 联合控制
 *
 * 控制结构：
 *
 *   JY60车辆纵向加速度
 *          ↓
 *   启动/停车惯性前馈角
 *          ┐
 *          ├── 相加、统一限幅 ──> 步进电机位置环
 *          ┘
 *   K230钢球位置PID/预测反馈角
 *
 * 作用分工：
 *
 * 1. JY60在小车刚启动、加速、减速和停车时提前动作，
 *    抵消车体加速度引起的钢球惯性位移；
 * 2. K230继续检测钢球相对原点的位置，负责消除剩余误差，
 *    包括PID、速度/加速度预测、捕获制动和静摩擦补偿；
 * 3. 两个控制量经过“位置优先融合”后再控制电机：
 *
 *      最终电机角 =
 *          K230位置反馈角
 *        + 有效JY60加速度前馈角
 *        + 水平零点偏置
 *
 *    当钢球明显偏离原点且JY60前馈方向与K230回中方向相反时，
 *    自动削弱反向JY60前馈，避免两路控制互相抵消；
 * 4. 已取消原来14～50mm区间固定10°的硬限制，
 *    K230反馈角会按距离连续放宽，最大可到18°；
 * 5. K230掉线时，位置反馈角平滑回零，JY60仍可工作；
 * 6. JY60掉线时，加速度前馈角平滑回零，K230仍可工作；
 * 7. 两者都掉线时，轨道平滑回到软件水平零位。
 *
 * K230发送格式：
 *
 *      -25\n
 *      0\n
 *      18\n
 *
 * 单位：mm
 *
 * 接线：
 *
 *   K230 TX  -> PA1，MSPM0 UART0 RX
 *   K230 RX  <- PA0，MSPM0 UART0 TX（只接收时可不接）
 *
 *   JY60 TX  -> PA18，MSPM0 UART1 RX
 *   JY60 RX  <- PA17，MSPM0 UART1 TX（只接收时可不接）
 *
 *   PB1 -> D36A ST1
 *   PB2 -> D36A DIR1
 *   PB4 -> D36A EN1
 *
 *   K230、JY60、MSPM0、D36A必须共地。
 *
 * SysConfig要求：
 *
 *   UART0实例名称：K230_UART，按原K230波特率配置；
 *   UART1实例名称：JY60_UART，9600，8N1，无校验；
 *
 * 上电后的2秒内：
 *
 *   1. 小车保持静止；
 *   2. 手动将轨道调到机械水平；
 *   3. 程序把当前位置作为步进电机软件零点；
 *   4. 同时标定JY60纵向加速度零偏。
 *
 * 当前不使用MS42C编码器，
 * 通过累计实际发送的STEP脉冲估计电机位置。
 * ================================================================
 */


/*==============================================================
 * 1. 系统时钟与控制频率
 *==============================================================*/

#ifndef CPUCLK_FREQ
#define CPUCLK_FREQ                         (32000000UL)
#endif

/*
 * SysTick为10kHz。
 *
 * 每100us进入一次中断。
 */
#define SYSTICK_FREQUENCY_HZ                (10000U)

/*
 * 钢球外环100Hz。
 *
 * 每10ms执行一次。
 */
#define BALL_CONTROL_FREQUENCY_HZ           (100U)

#define BALL_CONTROL_INTERVAL_TICKS         \
    (SYSTICK_FREQUENCY_HZ /                 \
     BALL_CONTROL_FREQUENCY_HZ)

#define BALL_CONTROL_DT_S                   (0.01f)

/*
 * JY60车辆加速度前馈100Hz。
 */
#define COMPENSATION_CONTROL_FREQUENCY_HZ   (100U)

#define COMPENSATION_CONTROL_INTERVAL_TICKS \
    (SYSTICK_FREQUENCY_HZ /                 \
     COMPENSATION_CONTROL_FREQUENCY_HZ)

#define COMPENSATION_CONTROL_DT_S           (0.01f)

/*
 * 电机位置内环1kHz。
 *
 * 每1ms执行一次。
 */
#define MOTOR_CONTROL_FREQUENCY_HZ          (1000U)

#define MOTOR_CONTROL_INTERVAL_TICKS        \
    (SYSTICK_FREQUENCY_HZ /                 \
     MOTOR_CONTROL_FREQUENCY_HZ)

#define MOTOR_CONTROL_DT_S                  (0.001f)


/*==============================================================
 * 2. D36A控制引脚
 *==============================================================*/

#define STEP_PORT                           (GPIOB)
#define STEP_PIN                            (DL_GPIO_PIN_1)

#define DIR_PORT                            (GPIOB)
#define DIR_PIN                             (DL_GPIO_PIN_2)

#define EN_PORT                             (GPIOB)
#define EN_PIN                              (DL_GPIO_PIN_4)


/*==============================================================
 * 3. 步进电机参数
 *==============================================================*/

/*
 * MS42C步距角1.8°：
 *
 * 一圈200整步。
 */
#define MOTOR_FULL_STEPS_PER_REV            (200.0f)

/*
 * D36A使用16细分。
 */
#define MOTOR_MICROSTEP                     (16.0f)

/*
 * 一圈脉冲数：
 *
 * 200 × 16 = 3200。
 */
#define MOTOR_PULSES_PER_REV                \
    (MOTOR_FULL_STEPS_PER_REV *             \
     MOTOR_MICROSTEP)

/*
 * 每旋转1°需要的脉冲：
 *
 * 3200 / 360 = 8.8889。
 */
#define MOTOR_PULSES_PER_DEG                \
    (MOTOR_PULSES_PER_REV / 360.0f)


/*==============================================================
 * 4. 方向及使能极性
 *==============================================================*/

/*
 * PB4高电平使能D36A。
 */
#define ENABLE_ACTIVE_HIGH                  (1U)

/*
 * 正方向时PB2输出高电平。
 */
#define POSITIVE_DIRECTION_LEVEL            (1U)

/*
 * 你当前使用-1时方向正确，所以保留。
 *
 * 如果小球越来越远，改为1.0f。
 */
#define BALL_CONTROL_POLARITY               (-1.0f)


/*==============================================================
 * 5. K230通信参数
 *==============================================================*/

/*
 * 25cm轨道中心两侧约125mm。
 */
