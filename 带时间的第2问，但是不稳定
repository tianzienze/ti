        case 'W': return FONT_W;

        case ' ':
        default:
            return FONT_SPACE;
    }
}

static void OLED_WriteSmallText(
    uint32_t page,
    uint32_t column,
    const char *text)
{
    uint8_t data[128];

    uint32_t dataLength = 0U;
    uint32_t characterIndex = 0U;
    uint32_t glyphColumn;

    const uint8_t *glyph;

    while (
        (text[characterIndex] != '\0') &&
        ((dataLength + 6U) <= sizeof(data))
    ) {
        glyph =
            OLED_GetGlyph(
                text[characterIndex]);

        for (glyphColumn = 0U;
             glyphColumn < 5U;
             glyphColumn++) {
            data[dataLength++] =
                glyph[glyphColumn];
        }

        data[dataLength++] = 0x00U;

        characterIndex++;
    }

    OLED_SetPosition(
        page,
        column);

    OLED_WriteDataBuffer(
        data,
        dataLength);
}

static void OLED_WriteBigText(
    uint32_t startPage,
    uint32_t column,
    const char *text)
{
    uint8_t upperData[128];
    uint8_t lowerData[128];

    uint32_t dataLength = 0U;
    uint32_t characterIndex = 0U;
    uint32_t glyphColumn;
    uint32_t row;

    uint16_t expandedColumn;

    const uint8_t *glyph;

    while (
        (text[characterIndex] != '\0') &&
        ((dataLength + 12U) <= sizeof(upperData))
    ) {
        glyph =
            OLED_GetGlyph(
                text[characterIndex]);

        for (glyphColumn = 0U;
             glyphColumn < 5U;
             glyphColumn++) {
            expandedColumn = 0U;

            for (row = 0U;
                 row < 7U;
                 row++) {
                if (
                    (glyph[glyphColumn] &
                     (1U << row)) != 0U
                ) {
                    expandedColumn |=
                        (uint16_t)(
                            3U <<
                            (row * 2U));
                }
            }

            upperData[dataLength] =
                (uint8_t)(
                    expandedColumn &
                    0xFFU);

            lowerData[dataLength] =
                (uint8_t)(
                    (expandedColumn >> 8) &
                    0xFFU);

            dataLength++;

            upperData[dataLength] =
                (uint8_t)(
                    expandedColumn &
                    0xFFU);

            lowerData[dataLength] =
                (uint8_t)(
                    (expandedColumn >> 8) &
                    0xFFU);

            dataLength++;
        }

        upperData[dataLength] = 0U;
        lowerData[dataLength] = 0U;
        dataLength++;

        upperData[dataLength] = 0U;
        lowerData[dataLength] = 0U;
        dataLength++;

        characterIndex++;
    }

    OLED_SetPosition(
        startPage,
        column);

    OLED_WriteDataBuffer(
        upperData,
        dataLength);

    OLED_SetPosition(
        startPage + 1U,
        column);

    OLED_WriteDataBuffer(
        lowerData,
        dataLength);
}

/*==================================================
 * 时间显示
 *==================================================*/

static void FormatMotionTime(
    uint32_t timeMs,
    char output[9])
{
    uint32_t minutes;
    uint32_t seconds;
    uint32_t centiseconds;

    if (timeMs > MOTION_TIME_MAX_MS) {
        timeMs = MOTION_TIME_MAX_MS;
    }

    minutes =
        timeMs / 60000U;

    seconds =
        (timeMs / 1000U) % 60U;

    centiseconds =
        (timeMs / 10U) % 100U;

    output[0] =
        (char)(
            '0' +
            (minutes / 10U));

    output[1] =
        (char)(
            '0' +
            (minutes % 10U));

    output[2] = ':';

    output[3] =
        (char)(
            '0' +
            (seconds / 10U));

    output[4] =
        (char)(
            '0' +
            (seconds % 10U));

    output[5] = '.';

    output[6] =
        (char)(
            '0' +
            (centiseconds / 10U));

    output[7] =
        (char)(
            '0' +
            (centiseconds % 10U));

    output[8] = '\0';
}

static void OLED_ShowMotionTime(void)
{
    uint32_t timeSnapshot;
    uint32_t runningSnapshot;
    uint32_t finishedSnapshot;

    char timeText[9];

    __disable_irq();

    timeSnapshot =
        g_motion_time_ms;

    runningSnapshot =
        g_motion_timer_running;

    finishedSnapshot =
        g_motion_timer_finished;

    __enable_irq();

    FormatMotionTime(
        timeSnapshot,
        timeText);

    if (runningSnapshot != 0U) {
        OLED_WriteSmallText(
            2U,
            49U,
            "RUN  ");
    } else if (finishedSnapshot != 0U) {
        OLED_WriteSmallText(
            2U,
            49U,
            "STOP ");
    } else {
        OLED_WriteSmallText(
            2U,
            49U,
            "WAIT ");
    }

    OLED_WriteBigText(
        4U,
        16U,
        timeText);
}

/*==================================================
 * 电机控制
