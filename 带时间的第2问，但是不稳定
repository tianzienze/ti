/*==================================================
 * 工具函数
 *==================================================*/

static int32_t ClampInt32(
    int32_t value,
    int32_t minimum,
    int32_t maximum)
{
    if (value < minimum) {
        return minimum;
    }

    if (value > maximum) {
        return maximum;
    }

    return value;
}

static int32_t AbsInt32(int32_t value)
{
    return (value < 0) ? -value : value;
}

static int32_t MoveToward(
    int32_t current,
    int32_t target,
    int32_t step)
{
    if (current < target) {
        current += step;

        if (current > target) {
            current = target;
        }
    } else if (current > target) {
        current -= step;

        if (current < target) {
            current = target;
        }
    }

    return current;
}

/*==================================================
 * OLED计时控制
 *==================================================*/

static void MotionTimerStartOnce(void)
{
    if (s_motion_timer_started_once != 0U) {
        return;
    }

    __disable_irq();

    g_motion_time_ms = 0U;
    s_motion_ms_divider = 0U;

    g_motion_timer_finished = 0U;
    s_motion_timer_started_once = 1U;
    g_motion_timer_running = 1U;

    s_oled_refresh_due = 1U;

    __enable_irq();
}

static void MotionTimerStop(void)
{
    if (g_motion_timer_running == 0U) {
        return;
    }

    __disable_irq();

    g_motion_timer_running = 0U;
    g_motion_timer_finished = 1U;
    s_oled_refresh_due = 1U;

    __enable_irq();
}

/*==================================================
 * SSD1306软件I2C
 *==================================================*/

static void OLED_I2CDelay(void)
{
    delay_cycles(24U);
}

static void OLED_SDALow(void)
{
    DL_GPIO_clearPins(
        OLED_SDA_PORT,
        OLED_SDA_PIN);

    DL_GPIO_enableOutput(
        OLED_SDA_PORT,
        OLED_SDA_PIN);
}

static void OLED_SDARelease(void)
{
    DL_GPIO_disableOutput(
        OLED_SDA_PORT,
        OLED_SDA_PIN);
}

static void OLED_SCLLow(void)
{
    DL_GPIO_clearPins(
        OLED_SCL_PORT,
        OLED_SCL_PIN);

    DL_GPIO_enableOutput(
        OLED_SCL_PORT,
        OLED_SCL_PIN);
}

static void OLED_SCLRelease(void)
{
    DL_GPIO_disableOutput(
        OLED_SCL_PORT,
        OLED_SCL_PIN);
}

static uint32_t OLED_ReadSDA(void)
{
    uint32_t level;

    level = DL_GPIO_readPins(
        OLED_SDA_PORT,
        OLED_SDA_PIN);

    return ((level & OLED_SDA_PIN) != 0U)
        ? 1U
        : 0U;
}

static void OLED_I2CStart(void)
{
    OLED_SDARelease();
    OLED_SCLRelease();

    OLED_I2CDelay();

    OLED_SDALow();

    OLED_I2CDelay();

    OLED_SCLLow();

    OLED_I2CDelay();
}

static void OLED_I2CStop(void)
{
    OLED_SDALow();

    OLED_I2CDelay();

    OLED_SCLRelease();

    OLED_I2CDelay();

    OLED_SDARelease();

    OLED_I2CDelay();
}

static uint32_t OLED_I2CWriteByte(uint8_t data)
{
    uint32_t bitIndex;
    uint32_t acknowledge;

    for (bitIndex = 0U;
         bitIndex < 8U;
         bitIndex++) {
        if ((data & 0x80U) != 0U) {
            OLED_SDARelease();
        } else {
            OLED_SDALow();
        }

        OLED_I2CDelay();

        OLED_SCLRelease();

        OLED_I2CDelay();

        OLED_SCLLow();

        OLED_I2CDelay();

        data <<= 1;
    }

    OLED_SDARelease();

    OLED_I2CDelay();

    OLED_SCLRelease();

    OLED_I2CDelay();

    acknowledge =
        (OLED_ReadSDA() == 0U)
        ? 1U
        : 0U;

    OLED_SCLLow();

    OLED_I2CDelay();

    return acknowledge;
}

static void OLED_WriteCommand(uint8_t command)
{
    OLED_I2CStart();

    (void)OLED_I2CWriteByte(
        (uint8_t)(OLED_I2C_ADDRESS << 1));

    (void)OLED_I2CWriteByte(0x00U);

    (void)OLED_I2CWriteByte(command);

    OLED_I2CStop();
}

static void OLED_WriteDataBuffer(
    const uint8_t *data,
    uint32_t length)
{
    uint32_t index;

    OLED_I2CStart();

    (void)OLED_I2CWriteByte(
        (uint8_t)(OLED_I2C_ADDRESS << 1));

    (void)OLED_I2CWriteByte(0x40U);

    for (index = 0U;
         index < length;
         index++) {
        (void)OLED_I2CWriteByte(data[index]);
    }

    OLED_I2CStop();
}

static void OLED_SetPosition(
    uint32_t page,
    uint32_t column)
{
    OLED_WriteCommand(
        (uint8_t)(0xB0U + page));

    OLED_WriteCommand(
        (uint8_t)(
            0x00U |
            (column & 0x0FU)));

    OLED_WriteCommand(
        (uint8_t)(
            0x10U |
            ((column >> 4) & 0x0FU)));
}

static void OLED_GPIOInit(void)
{
    DL_GPIO_clearPins(
        GPIOA,
        OLED_SDA_PIN |
        OLED_SCL_PIN);

    OLED_SDARelease();
    OLED_SCLRelease();
}

static void OLED_ClearScreen(void)
{
    uint8_t zeroData[128];
    uint32_t index;
    uint32_t page;

    for (index = 0U;
         index < 128U;
         index++) {
        zeroData[index] = 0U;
    }

    for (page = 0U;
         page < 8U;
         page++) {
        OLED_SetPosition(page, 0U);

        OLED_WriteDataBuffer(
            zeroData,
            128U);
    }
}

static void OLED_Init(void)
{
    OLED_GPIOInit();

    delay_cycles(CPUCLK_FREQ / 10U);

    OLED_WriteCommand(0xAEU);

    OLED_WriteCommand(0xD5U);
    OLED_WriteCommand(0x80U);

    OLED_WriteCommand(0xA8U);
    OLED_WriteCommand(0x3FU);

    OLED_WriteCommand(0xD3U);
    OLED_WriteCommand(0x00U);

    OLED_WriteCommand(0x40U);

    OLED_WriteCommand(0x8DU);
    OLED_WriteCommand(0x14U);

    OLED_WriteCommand(0x20U);
    OLED_WriteCommand(0x02U);

    OLED_WriteCommand(0xA1U);
    OLED_WriteCommand(0xC8U);

    OLED_WriteCommand(0xDAU);
    OLED_WriteCommand(0x12U);

    OLED_WriteCommand(0x81U);
    OLED_WriteCommand(0x7FU);

    OLED_WriteCommand(0xD9U);
    OLED_WriteCommand(0xF1U);

    OLED_WriteCommand(0xDBU);
    OLED_WriteCommand(0x40U);

    OLED_WriteCommand(0xA4U);
    OLED_WriteCommand(0xA6U);

    OLED_WriteCommand(0xAFU);

    OLED_ClearScreen();
}

