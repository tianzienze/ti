static void LeftMotorEnable(void)
{
    DL_GPIO_setPins(
        LEFT_EN_PORT,
        LEFT_EN_PIN);
}

static void LeftMotorDisable(void)
{
    DL_GPIO_clearPins(
        LEFT_EN_PORT,
        LEFT_EN_PIN);
}

static void RightMotorEnable(void)
{
    DL_GPIO_setPins(
        RIGHT_EN_PORT,
        RIGHT_EN_PIN);
}

static void RightMotorDisable(void)
{
    DL_GPIO_clearPins(
        RIGHT_EN_PORT,
        RIGHT_EN_PIN);
}

static void MotorGPIOInit(void)
{
    DL_GPIO_clearPins(
        GPIOA,
        LEFT_IN2_PIN);

    DL_GPIO_clearPins(
        GPIOB,
        LEFT_IN1_PIN |
        LEFT_EN_PIN |
        RIGHT_IN3_PIN |
        RIGHT_IN4_PIN |
        RIGHT_EN_PIN);

    DL_GPIO_enableOutput(
        GPIOA,
        LEFT_IN2_PIN);

    DL_GPIO_enableOutput(
        GPIOB,
        LEFT_IN1_PIN |
        LEFT_EN_PIN |
        RIGHT_IN3_PIN |
        RIGHT_IN4_PIN |
        RIGHT_EN_PIN);
}

static void MotorSetForwardDirection(void)
{
    LeftMotorDisable();
    RightMotorDisable();

#if LEFT_FORWARD_REVERSE == 0

    DL_GPIO_clearPins(
        LEFT_IN2_PORT,
        LEFT_IN2_PIN);

    DL_GPIO_setPins(
        LEFT_IN1_PORT,
        LEFT_IN1_PIN);

#else

    DL_GPIO_clearPins(
        LEFT_IN1_PORT,
        LEFT_IN1_PIN);

    DL_GPIO_setPins(
        LEFT_IN2_PORT,
        LEFT_IN2_PIN);

#endif

#if RIGHT_FORWARD_REVERSE == 0

    DL_GPIO_clearPins(
        RIGHT_IN4_PORT,
        RIGHT_IN4_PIN);

    DL_GPIO_setPins(
        RIGHT_IN3_PORT,
        RIGHT_IN3_PIN);

#else

    DL_GPIO_clearPins(
        RIGHT_IN3_PORT,
        RIGHT_IN3_PIN);

    DL_GPIO_setPins(
        RIGHT_IN4_PORT,
        RIGHT_IN4_PIN);

#endif
}

static void MotorStop(void)
{
    MotionTimerStop();

    s_motor_output_enabled = 0U;

    g_left_target_pwm = 0;
    g_right_target_pwm = 0;

    g_left_pwm = 0;
    g_right_pwm = 0;

    LeftMotorDisable();
    RightMotorDisable();
}

/*==================================================
 * 八路传感器读取
 *==================================================*/

static uint32_t ReadSensorActive(
    GPIO_Regs *port,
    uint32_t pin)
{
    uint32_t isHigh;

    isHigh =
        ((DL_GPIO_readPins(port, pin) &
          pin) != 0U)
        ? 1U
        : 0U;

#if BLACK_IS_HIGH == 1

    return isHigh;

#else

    return (isHigh == 0U) ? 1U : 0U;

#endif
}

static void ReadLineSensors(
    uint32_t *sensorMask,
    uint32_t *activeCount,
    int32_t *lineError)
{
    uint32_t sensor[8];

    uint32_t mask = 0U;
    uint32_t count = 0U;
    uint32_t i;

    int32_t weightedSum = 0;

    static const int32_t positionWeight[8] = {
        -700,
        -500,
        -300,
        -100,
         100,
         300,
         500,
         700
    };

    sensor[7] =
        ReadSensorActive(
            TRACK_X1_PORT,
            TRACK_X1_PIN);

    sensor[6] =
        ReadSensorActive(
            TRACK_X2_PORT,
            TRACK_X2_PIN);

    sensor[5] =
        ReadSensorActive(
            TRACK_X3_PORT,
            TRACK_X3_PIN);

    sensor[4] =
        ReadSensorActive(
            TRACK_X4_PORT,
            TRACK_X4_PIN);

    sensor[3] =
        ReadSensorActive(
            TRACK_X5_PORT,
            TRACK_X5_PIN);

    sensor[2] =
        ReadSensorActive(
            TRACK_X6_PORT,
            TRACK_X6_PIN);

    sensor[1] =
        ReadSensorActive(
            TRACK_X7_PORT,
            TRACK_X7_PIN);

    sensor[0] =
        ReadSensorActive(
            TRACK_X8_PORT,
            TRACK_X8_PIN);

    for (i = 0U;
         i < 8U;
         i++) {
        if (sensor[i] != 0U) {
            uint32_t logicalIndex;

            mask |=
                (1UL << i);

            count++;

#if LINE_SENSOR_REVERSE == 0

            logicalIndex = i;

#else

            logicalIndex = 7U - i;

#endif

            weightedSum +=
                positionWeight[logicalIndex];
        }
    }

    *sensorMask = mask;
    *activeCount = count;

    if (count != 0U) {
        *lineError =
            weightedSum /
            (int32_t)count;
    }
}

/*==================================================
 * 弯道增强
 *==================================================*/

static int32_t CalculateCurveBoost(int32_t error)
{
    int32_t boost = 0;
    int32_t absoluteError;

    absoluteError =
        AbsInt32(error);

    if (
        absoluteError >=
        LARGE_CURVE_ERROR
    ) {
        boost =
            LARGE_CURVE_BOOST;
    } else if (
        absoluteError >=
        MEDIUM_CURVE_ERROR
    ) {
        boost =
            MEDIUM_CURVE_BOOST;
    }

    return (error < 0)
        ? -boost
        : boost;
}

/*==================================================
 * 循迹控制
 *==================================================*/

static void LineControlUpdate(void)
{
    uint32_t sensorMask;
    uint32_t activeCount;

    int32_t rawError =
        g_line_error;

    int32_t previousFilteredError;
    int32_t correction;
    int32_t curveBoost;

    int32_t leftBasePWM;
    int32_t rightBasePWM;

    int32_t leftCorrection;
    int32_t rightCorrection;

    int32_t leftTarget;
    int32_t rightTarget;

    /*
     * 已经触发终点停车，
     * 始终保持停止。
     */
    if (g_stop_line_latched != 0U) {
        g_run_state =
            RUN_STATE_STOP_LINE;

        DL_GPIO_clearPins(
            STATUS_LED_PORT,
            STATUS_LED_PIN);

        MotorStop();

        return;
    }

    ReadLineSensors(
        &sensorMask,
        &activeCount,
        &rawError);

    g_sensor_mask =
        sensorMask;

    g_active_sensor_count =
        activeCount;

#if STOP_LINE_ENABLE == 1U

    /*
     * 至少4路同时检测到黑线，
     * 立即停车并锁存。
     */
    if (
        activeCount >=
        STOP_BLACK_SENSOR_COUNT
    ) {
        g_stop_line_latched = 1U;

        g_run_state =
            RUN_STATE_STOP_LINE;

        g_line_lost_cycles = 0U;

        DL_GPIO_clearPins(
            STATUS_LED_PORT,
            STATUS_LED_PIN);

        MotorStop();

        s_oled_refresh_due = 1U;

        return;
    }

#endif

    /*
     * 没有检测到黑线。
     */
    if (activeCount == 0U) {
        if (g_seen_line_once == 0U) {
            g_run_state =
                RUN_STATE_WAIT_LINE;

            DL_GPIO_clearPins(
                STATUS_LED_PORT,
                STATUS_LED_PIN);

            MotorStop();

            return;
        }

        /*
         * 短暂丢线，
         * 保持最后PWM 100ms。
         */
        if (
            (s_motor_output_enabled != 0U) &&
            (g_line_lost_cycles <
             LINE_LOST_HOLD_CYCLES)
        ) {
            g_line_lost_cycles++;

            g_run_state =
                RUN_STATE_LINE_LOST_HOLD;

            return;
        }

        /*
         * 丢线超过100ms停车。
         */
        g_run_state =
            RUN_STATE_LINE_LOST_STOP;

        g_line_lost_cycles =
            LINE_LOST_HOLD_CYCLES;

        DL_GPIO_clearPins(
            STATUS_LED_PORT,
            STATUS_LED_PIN);

        MotorStop();

        return;
    }

    /*
     * 检测到正常黑线。
     */
    g_line_lost_cycles = 0U;
    g_seen_line_once = 1U;

    g_run_state =
        RUN_STATE_TRACKING;

    g_line_error =
        rawError;

    DL_GPIO_setPins(
        STATUS_LED_PORT,
        STATUS_LED_PIN);

    /*
     * 第一次开始运动时开始计时。
     */
    MotionTimerStartOnce();

    /*
     * 原误差滤波。
     */
    previousFilteredError =
        g_filtered_error;

    g_filtered_error =
        (previousFilteredError +
         rawError) / 2;

    g_error_derivative =
        g_filtered_error -
        previousFilteredError;

    /*
     * 原PD控制。
     */
    if (
        AbsInt32(g_filtered_error) <=
        LINE_CENTER_DEADBAND
    ) {
        correction = 0;
    } else {
        correction =
            (g_filtered_error *
             LINE_KP_NUM) /
            LINE_KP_DEN;

        correction +=
            (g_error_derivative *
             LINE_KD_NUM) /
            LINE_KD_DEN;

        curveBoost =
            CalculateCurveBoost(
                g_filtered_error);

        correction +=
            curveBoost;
    }

#if STEERING_REVERSE == 1

    correction =
        -correction;

#endif

    /*
     * 根据误差选择直线、中弯或大弯基础速度。
     */
    if (
        AbsInt32(g_filtered_error) >=
        LARGE_CURVE_ERROR
    ) {
        leftBasePWM =
            LEFT_LARGE_CURVE_PWM;

        rightBasePWM =
            RIGHT_LARGE_CURVE_PWM;
    } else if (
        AbsInt32(g_filtered_error) >=
        MEDIUM_CURVE_ERROR
    ) {
        leftBasePWM =
            LEFT_MEDIUM_CURVE_PWM;

        rightBasePWM =
            RIGHT_MEDIUM_CURVE_PWM;
    } else {
        leftBasePWM =
            LEFT_STRAIGHT_PWM;

        rightBasePWM =
            RIGHT_STRAIGHT_PWM;
    }

    g_left_base_pwm =
        leftBasePWM;

    g_right_base_pwm =
        rightBasePWM;

    /*
     * 左右轮分别计算修正量。
     */
    leftCorrection =
        (correction *
         LEFT_CORRECTION_NUM) /
        LEFT_CORRECTION_DEN;

    rightCorrection =
        (correction *
         RIGHT_CORRECTION_NUM) /
        RIGHT_CORRECTION_DEN;

    /*
     * 分别限制左右轮最大修正量。
     */
    leftCorrection =
        ClampInt32(
            leftCorrection,
            -LEFT_MAX_CORRECTION,
            LEFT_MAX_CORRECTION);

    rightCorrection =
        ClampInt32(
            rightCorrection,
            -RIGHT_MAX_CORRECTION,
            RIGHT_MAX_CORRECTION);

    g_steering_correction =
        correction;

    g_left_correction =
        leftCorrection;

    g_right_correction =
        rightCorrection;

    /*
     * 双轮差速。
     *
     * correction > 0：
     *   左轮加速，右轮减速。
     *
     * correction < 0：
     *   左轮减速，右轮加速。
     */
    leftTarget =
        leftBasePWM +
        leftCorrection;

    rightTarget =
        rightBasePWM -
        rightCorrection;

    /*
     * 左右轮分别限制PWM。
     */
    leftTarget =
        ClampInt32(
            leftTarget,
            LEFT_MOTOR_MIN_PWM,
            LEFT_MOTOR_MAX_PWM);

    rightTarget =
        ClampInt32(
            rightTarget,
            RIGHT_MOTOR_MIN_PWM,
            RIGHT_MOTOR_MAX_PWM);

    g_left_target_pwm =
        leftTarget;

    g_right_target_pwm =
        rightTarget;

    /*
     * 左右轮分别进行PWM平滑变化。
     */
    g_left_pwm =
        MoveToward(
            g_left_pwm,
            leftTarget,
            LEFT_PWM_CHANGE_LIMIT);

    g_right_pwm =
        MoveToward(
            g_right_pwm,
            rightTarget,
            RIGHT_PWM_CHANGE_LIMIT);

    s_motor_output_enabled = 1U;
}

/*==================================================
 * SysTick中断
 *==================================================*/

void SysTick_Handler(void)
{
    g_systick_heartbeat++;

    /*
     * 计时：
     *
     * 10次SysTick = 1ms
     */
    if (g_motion_timer_running != 0U) {
        s_motion_ms_divider++;

        if (s_motion_ms_divider >= 10U) {
            s_motion_ms_divider = 0U;

            if (
                g_motion_time_ms <
                MOTION_TIME_MAX_MS
            ) {
                g_motion_time_ms++;
            }
        }
    }

    /*
     * 每100ms刷新OLED。
     */
    s_oled_refresh_tick++;

    if (
        s_oled_refresh_tick >=
        OLED_REFRESH_TICKS
    ) {
        s_oled_refresh_tick = 0U;
        s_oled_refresh_due = 1U;
    }

    /*
     * 软件PWM。
     */
    s_pwm_phase++;

    if (
        s_pwm_phase >=
        PWM_PERIOD_COUNT
    ) {
        s_pwm_phase = 0U;
    }

    if (s_motor_output_enabled == 0U) {
        LeftMotorDisable();
        RightMotorDisable();
    } else {
        if (
            s_pwm_phase <
            (uint32_t)g_left_pwm
        ) {
            LeftMotorEnable();
        } else {
            LeftMotorDisable();
        }

        if (
            s_pwm_phase <
            (uint32_t)g_right_pwm
        ) {
            RightMotorEnable();
        } else {
            RightMotorDisable();
        }
    }

    /*
     * 每5ms进行一次循迹控制。
     */
    s_control_tick++;

    if (
        s_control_tick >=
        CONTROL_INTERVAL_TICKS
    ) {
        s_control_tick = 0U;
        s_control_due = 1U;
    }
}

/*==================================================
 * 主函数
 *==================================================*/

int main(void)
{
    uint32_t systickResult;

    SYSCFG_DL_init();

    MotorGPIOInit();

    MotorSetForwardDirection();

    MotorStop();

    /*
     * 初始化OLED：
     *
     * SDA = PA0
     * SCL = PA1
     */
    OLED_Init();

    /*
     * 固定标题。
     */
    OLED_WriteSmallText(
        0U,
        52U,
        "TIME");

    /*
     * 初始显示：
     *
     * TIME
     * WAIT
     * 00:00.00
     */
    OLED_ShowMotionTime();

    DL_GPIO_clearPins(
        STATUS_LED_PORT,
        STATUS_LED_PIN);

    g_run_state =
        RUN_STATE_INIT;

    systickResult =
        SysTick_Config(
            CPUCLK_FREQ /
            SYSTICK_FREQUENCY_HZ);

    if (systickResult != 0U) {
        g_run_state =
            RUN_STATE_SYSTICK_ERROR;

        MotorStop();

        g_motion_timer_finished = 1U;

        OLED_ShowMotionTime();

        while (1) {
            __WFI();
        }
    }

    /*
     * 保留原来的上电等待2秒。
     */
    delay_cycles(
        CPUCLK_FREQ * 2U);

    g_run_state =
        RUN_STATE_WAIT_LINE;

    while (1) {
        /*
         * 循迹控制。
         */
        if (s_control_due != 0U) {
            __disable_irq();

            s_control_due = 0U;

            __enable_irq();

            LineControlUpdate();
        }

        /*
         * OLED刷新。
         */
        if (s_oled_refresh_due != 0U) {
            __disable_irq();

            s_oled_refresh_due = 0U;

            __enable_irq();

            OLED_ShowMotionTime();
        }

        __WFI();
    }
}
